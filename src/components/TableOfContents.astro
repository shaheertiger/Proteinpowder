---
// Collapsible "In This Guide" list. Closed on phones so the article starts on
// the first screen; opened on wider screens by the inline script below. Links
// go in the default slot as plain <a href="#anchor">Label</a> and are numbered
// by CSS (see .toc-links in src/styles/global.css).
const html = await Astro.slots.render("default");
const count = (html.match(/<a\s/g) ?? []).length;
---

<div class="max-w-3xl mx-auto px-4 pt-6 pb-7 md:pt-10 md:pb-10">
  <details class="toc group bg-white border border-gray-200 rounded-2xl" data-toc>
    <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none">
      <span class="flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path></svg>
        <span class="text-base font-black text-gray-900">In This Guide</span>
        {count > 0 && <span class="text-xs font-bold text-gray-500">{count} sections</span>}
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="toc-chevron text-gray-700 transition-transform" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </summary>
    <nav class="toc-links px-5 pb-3" aria-label="In this guide">
      <Fragment set:html={html} />
    </nav>
  </details>
</div>

<script is:inline>
  (function () {
    var el = document.currentScript && document.currentScript.previousElementSibling;
    var toc = el && el.querySelector("[data-toc]");
    if (toc && window.matchMedia("(min-width: 768px)").matches) toc.open = true;
  })();
</script>
