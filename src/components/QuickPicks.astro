---
// "Our Top Picks" near the top of a roundup: a row of swipeable cards on phones
// (the next card peeks in so it is obvious the row scrolls), with arrows and
// dots underneath. Each card names the award, links down to the full review and
// carries its own buy button.
import { amazonLink } from "../data/affiliate";
import productImages from "../data/product-images.json";
import AdUnit from "./AdUnit.astro";

interface Product {
  id: string;
  name: string;
  badge?: string;
  category?: string;
  bottomLine?: string;
  amazonUrl?: string;
}
interface Props {
  products: Product[];
  heading?: string;
}
const { products, heading = "Our Top Picks" } = Astro.props;
const top = products[0];
const images = productImages as Record<string, string>;
---

<div id="quick-picks" class="not-prose my-8 -mx-4 md:mx-0" data-carousel>
  <div class="flex items-end justify-between gap-4 px-4 md:px-0 mb-4">
    <p class="text-xl md:text-2xl font-black text-gray-900 m-0" data-md="heading">{heading}</p>
    <a href={`#${top?.id ?? ""}`} class="text-sm font-bold text-[#0B64C0] no-underline hover:underline whitespace-nowrap">See full reviews</a>
  </div>

  <ul
    class="no-scrollbar list-none m-0 flex gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth px-4 md:px-0 pt-3 pb-1 scroll-px-4 md:scroll-px-0"
    data-track
    aria-label={heading}
  >
    {products.map((product, index) => (
      <li class:list={[
        "relative snap-start shrink-0 w-[82%] sm:w-[60%] md:w-[calc(50%-0.375rem)] flex flex-col rounded-2xl border bg-white",
        index === 0 ? "border-2 border-amber-300" : "border-gray-200 bg-gray-50",
      ]}>
        {index === 0 && (
          <span class="absolute -top-3 left-4 bg-amber-300 text-gray-900 text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-md">
            Our #1 Pick
          </span>
        )}
        <div class="flex flex-col flex-1 p-4 pt-5">
          <a href={`#${product.id}`} data-md="name" class="text-sm text-gray-700 underline decoration-gray-300 underline-offset-2 hover:text-gray-900 leading-snug">
            {index + 1}. {product.name}
          </a>
          {product.badge && <p class="text-lg font-black text-gray-900 leading-tight m-0 mt-1.5" data-md="award">{product.badge}</p>}
          {product.bottomLine && <p class="text-[0.9375rem] text-gray-600 leading-relaxed m-0 mt-2.5 line-clamp-4" data-md="summary">{product.bottomLine}</p>}
          <div class="mt-auto pt-4 flex items-end justify-between gap-3">
            <div>
              <a
                href={amazonLink(product.amazonUrl, product.name, product.id)}
                target="_blank"
                rel="sponsored nofollow noopener"
                class="inline-flex items-center bg-[#FF4500] hover:bg-[#E63E00] text-white text-sm font-black px-4 py-2.5 rounded-lg no-underline whitespace-nowrap"
              >
                Check Price
              </a>
              <p class="text-[11px] text-gray-500 m-0 mt-1">On Amazon</p>
            </div>
            {images[product.id] && (
              <img
                src={images[product.id]}
                alt=""
                loading="lazy"
                decoding="async"
                width="64"
                height="64"
                class="w-16 h-16 rounded-xl bg-white border border-gray-200 object-contain p-1 shrink-0"
              />
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <div class="hidden items-center justify-center gap-3 mt-4 px-4" data-controls>
    <button type="button" class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 grid place-items-center disabled:opacity-40" aria-label="Previous pick" data-prev>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
    </button>
    <div class="flex items-center gap-1.5 bg-gray-100 rounded-full px-3 py-2.5" data-dots aria-hidden="true">
      {products.map(() => <span class="w-1.5 h-1.5 rounded-full bg-gray-300 transition-colors"></span>)}
    </div>
    <button type="button" class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 grid place-items-center disabled:opacity-40" aria-label="Next pick" data-next>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
  </div>

  <p class="text-xs text-gray-500 m-0 mt-3 px-4 md:px-0">
    We may earn a commission when you buy through these links, at no extra cost to you.
  </p>
</div>

<!-- On phones the layout's top ad sat above the headline and pushed the picks
     several screens down. Pages with a picks box hide it below md and show the
     same unit here instead; display:none units are not requested by AdSense. -->
<div class="qp-ad md:hidden my-8">
  <AdUnit variant="top" />
</div>

<style is:global>
  @media (max-width: 767px) {
    body:has(#quick-picks) .top-ad {
      display: none;
    }
  }
  [data-carousel] [data-dots] span.is-active {
    background: #111827;
    width: 0.875rem;
  }
</style>

{top && (
  <div
    data-qp-sticky
    hidden
    class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-4 py-2.5 z-50 shadow-[0_-4px_10px_rgba(0,0,0,0.05)]"
  >
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="text-[10px] font-black uppercase tracking-widest text-[#C93500] m-0">{top.badge ?? "Our Top Pick"}</p>
        <p class="text-sm font-bold text-gray-900 m-0 truncate">{top.name}</p>
      </div>
      <a
        href={amazonLink(top.amazonUrl, top.name, top.id)}
        target="_blank"
        rel="sponsored nofollow noopener"
        class="shrink-0 bg-[#FF4500] hover:bg-[#E63E00] text-white text-sm font-black px-5 py-3 rounded-xl no-underline whitespace-nowrap"
      >
        Check Price
      </a>
    </div>
  </div>
)}

<script is:inline>
  // Carousel arrows and dots. The row is a plain scroll-snap list, so it still
  // swipes without this script.
  (function () {
    var root = document.querySelector("[data-carousel]");
    if (!root) return;
    var track = root.querySelector("[data-track]");
    var controls = root.querySelector("[data-controls]");
    var dots = root.querySelectorAll("[data-dots] span");
    var prev = root.querySelector("[data-prev]");
    var next = root.querySelector("[data-next]");
    var cards = track.children;
    function step() {
      return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
    }
    function update() {
      var overflow = track.scrollWidth > track.clientWidth + 4;
      controls.style.display = overflow ? "flex" : "none";
      var max = track.scrollWidth - track.clientWidth;
      var i = Math.round(track.scrollLeft / step());
      if (track.scrollLeft >= max - 4) i = cards.length - 1;
      for (var d = 0; d < dots.length; d++) dots[d].classList.toggle("is-active", d === i);
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= max - 4;
    }
    prev.addEventListener("click", function () { track.scrollBy({ left: -step(), behavior: "smooth" }); });
    next.addEventListener("click", function () { track.scrollBy({ left: step(), behavior: "smooth" }); });
    var raf;
    track.addEventListener("scroll", function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();

  // The layout renders its own sticky CTA after the page body, so wait for the
  // whole document before deciding which bar to keep.
  document.addEventListener("DOMContentLoaded", function () {
    var bar = document.querySelector("[data-qp-sticky]");
    var box = document.getElementById("quick-picks");
    if (!bar || !box) return;
    // A page-level sticky CTA that already sends readers to a retailer wins;
    // one that only jumps down the page gives way to the direct #1-pick bar.
    var layout = document.querySelector("[data-layout-sticky]");
    if (layout) {
      var href = layout.querySelector("a") && layout.querySelector("a").getAttribute("href");
      if (href && /^https?:/.test(href)) { bar.remove(); return; }
      layout.remove();
    }
    // Show the bar once the picks box has scrolled out of view above.
    if (!("IntersectionObserver" in window)) { bar.hidden = false; return; }
    new IntersectionObserver(function (entries) {
      var e = entries[0];
      bar.hidden = e.isIntersecting || e.boundingClientRect.top > 0;
    }).observe(box);
  });
</script>
