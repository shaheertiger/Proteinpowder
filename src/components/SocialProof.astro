---
// A plain statement of how the guide was made, in the byline strip. It used to
// show a reader count; a count the site cannot back up is worse than none, so
// this says only what is true of every guide.
const MARKS = ["#1E90FF", "#38BDF8", "#FF4500", "#0F766E"];
---

<div class="flex items-center gap-3 text-gray-500 text-sm italic">
  <div class="flex -space-x-2 flex-shrink-0" aria-hidden="true">
    {
      MARKS.map((color) => (
        <span
          class="w-7 h-7 rounded-full border-2 border-white inline-block"
          style={`background:linear-gradient(135deg, ${color} 0%, ${color}66 100%)`}
        />
      ))
    }
  </div>
  <span class="leading-tight"
    >No paid placements. <strong class="text-gray-700 not-italic">Commission never sets a ranking.</strong></span
  >
</div>
