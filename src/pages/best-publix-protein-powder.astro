          item: `${SITE_URL}/best-publix-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Does Publix have its own protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Publix's GreenWise brand sells a whey protein in vanilla and chocolate, in a large tub of about 32 servings and a small vanilla tub of about 17, and a GreenWise Organic Plant Protein in vanilla and chocolate. The whey gives 15 g of protein per scoop and the plant powder 21 g, per their labels."
