---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Sprouts Protein Powder",
    "url": "/sprouts-protein-powder/"
  },
  {
    "title": "Trader Joe's Protein Powder",
    "url": "/trader-joes-protein-powder/"
  },
  {
    "title": "Best Costco Protein Powder",
    "url": "/best-costco-protein-powder/"
  },
  {
    "title": "Best Whole Food Protein Powder",
    "url": "/best-whole-food-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Whole Foods Protein Powder: Is 365 Whey Isolate Worth It?";
const description =
  "Yes for most: 365 Whey Isolate at Whole Foods gives 25 g protein in about 120 calories and is NSF Certified for Sport, near $1.76 per 25 g. Labels and swaps.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "whole-foods-protein-powder-365-whey-isolate-vanilla",
