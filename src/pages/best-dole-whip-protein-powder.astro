const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Dole Whip Protein Powder",
          item: `${SITE_URL}/best-dole-whip-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Does Dole make a protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dole does not make protein powder itself, but it licenses the Dole Whip name to Be Amazing (BEAM), which sells Dole Whip Pineapple and Dole Whip Strawberry vegan protein powders. Each label carries a Dole Food Company trademark line. Per the labels at the time of writing, both flavors give 20 g of pea and pumpkin seed protein and 140 calories per scoop."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Dole Whip protein powder?",
