const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best Protein Powder with Creatine: Which Ones Hit a Real Dose";
const description =
  "The best protein powder with creatine, checked against the 3-5 g daily dose the research supports, with the cost of each blend compared to adding your own creatine monohydrate.";

