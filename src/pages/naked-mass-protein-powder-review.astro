---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Dymatize Protein Powder Review",
    "url": "/dymatize-protein-powder-review/"
  },
  {
    "title": "Best Lactose-Free Protein Powder",
    "url": "/best-lactose-free-protein-powder/"
  },
  {
    "title": "Best NSF-Certified Protein Powder",
    "url": "/best-nsf-certified-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-19", modified: "2026-11-19" });
const title = "Naked Mass Protein Powder Review: Is It Third-Party Tested?";
const description =
  "Per Naked, it's NSF Contents Certified, not Certified for Sport; NSF's listing doesn't show it. 1,250 calories, 50 g protein, about $3.64 per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
