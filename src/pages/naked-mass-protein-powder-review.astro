const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Naked Mass Review",
          item: `${SITE_URL}/naked-mass-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Naked Mass third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, per Naked. The product pages for Naked Mass and Vegan Naked Mass say they are Contents Certified by NSF, meaning the contents are tested for accuracy and for harmful levels of contaminants such as heavy metals and pesticides. It is not NSF Certified for Sport, and when we searched NSF's public supplement listing in November 2026 we could not find Naked Mass there."
          }
        },
        {
          "@type": "Question",
          "name": "Is Naked Mass healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By label standards it is one of the cleanest gainers: the unflavored version has three ingredients and no sweeteners, flavors, gums or colors. Healthy depends on your needs, though. One serving has 1,250 calories and 252 g of carbohydrate, which suits someone trying to gain weight and is far too much for most people. People with diabetes or kidney disease should ask a doctor first."
          }
        },
        {
          "@type": "Question",
          "name": "Does Naked Mass contain sugar or artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Naked Mass contains no artificial sweeteners in any flavor, per Naked. Unflavored lists 21 g of sugars, which come from the tapioca maltodextrin rather than added sugar. The flavored versions add organic coconut sugar, which pushes sugars to 58 g in Chocolate and Vanilla and 98 g in Strawberry, per the labels at the time of writing."
          }
        },
        {
          "@type": "Question",
          "name": "Which Naked Mass flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chocolate and Vanilla are the two flavors Naked's review summary calls particularly popular; buyers say they taste good and are not chalky. We have not tasted them. Unflavored is the most flexible and lowest in sugar but tastes of very little on its own, so buyers blend it with milk, banana, oats or peanut butter."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common Naked Mass complaints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The main complaint is the serving size: about seven scoops in 24 oz of liquid, which buyers say is huge and expands when blended, so many split it. Price draws mixed reactions, and the vegan version gets some comments that it is bland or gritty. Many reviewers say it causes less bloating than other gainers they tried, per Naked's review summary."
          }
        },
        {
          "@type": "Question",
          "name": "Is Naked Mass vegan or lactose-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Regular Naked Mass is not vegan or lactose-free: it contains whey protein concentrate and micellar casein and declares milk. Vegan Naked Mass is the dairy-free version, made with yellow pea protein and organic brown rice protein, and gives 1,230 calories and 50 g of protein per six-scoop serving, per the label. Naked recommends it for people with lactose intolerance."
          }
        },
        {
          "@type": "Question",
          "name": "How many scoops of Naked Mass should I take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Naked lists a full serving as about seven scoops (321 g) for the whey version and about six scoops (315 g) for the vegan version, mixed in 24 oz of liquid. Most people do better starting with half that, around 625 calories, and increasing only if their weight is not moving. Naked recommends no more than two servings a day."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
