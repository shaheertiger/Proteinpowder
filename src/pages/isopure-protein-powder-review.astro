---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Optimum Nutrition Protein Powder Review",
    "url": "/optimum-nutrition-protein-powder-review/"
  },
  {
    "title": "Dymatize Protein Powder Review",
    "url": "/dymatize-protein-powder-review/"
  },
  {
    "title": "Transparent Labs Protein Powder Review",
    "url": "/transparent-labs-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Isopure Protein Powder Review: Zero Carb, Low Carb or Clear, and Who Should Pay for Isolate";
const description =
  "Isopure protein powder from the label: Zero Carb, Low Carb, Unflavored and Clear compared on protein, calories, sweeteners, testing and cost per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "isopure-zero-carb",
    "name": "Isopure Zero Carb Protein Powder",
    "brand": "Isopure",
    "badge": "Flagship Pick",
    "category": "Whey protein isolate, zero carb",
