const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Vitamin Shoppe Protein Powder",
          item: `${SITE_URL}/best-vitamin-shoppe-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder at The Vitamin Shoppe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Optimum Nutrition Gold Standard 100% Whey: 24 g of protein per scoop, NSF Certified for Sport in Double Rich Chocolate, and about $1.76 per 25 g in the 5 lb tub at the list price on November 23, 2026. The cheapest good option is the store's BodyTech Whey Tech Pro 24 at about $1.69 per 25 g, or about $1.43 with Auto Delivery."
          }
        },
        {
          "@type": "Question",
          "name": "Is BodyTech a Vitamin Shoppe brand?",
