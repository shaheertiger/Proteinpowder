                    <td class="px-4 py-4 text-gray-700">Pea, chia, pumpkin</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">150</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Energizing Soy Protein (Vanilla)</td>
