                    <td class="px-4 py-4 text-gray-700">180</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">About $2.29</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Hemp Protein Powder</td>
                    <td class="px-4 py-4 text-gray-700">12 g per 31 g</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                    <td class="px-4 py-4 text-gray-700">No, no longer produced gluten free</td>
                    <td class="px-4 py-4 text-gray-700">About $1.71</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pea Protein (old)</td>
                    <td class="px-4 py-4 text-gray-700">No longer listed</td>
                    <td class="px-4 py-4 text-gray-700">n/a</td>
                    <td class="px-4 py-4 text-gray-700">n/a</td>
                    <td class="px-4 py-4 text-gray-700">Discontinued</td>
                  </tr>
                </tbody>
