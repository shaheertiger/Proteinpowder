                <p class="text-gray-400 text-xs mt-1">Share of cow's milk protein that is casein</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">19-26 g</p>
                <p class="text-gray-400 text-xs mt-1">Protein per serving across our picks</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">30-40 g</p>
                <p class="text-gray-400 text-xs mt-1">Pre-sleep casein dose studied most</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">5</p>
                <p class="text-gray-400 text-xs mt-1">Picks, all micellar casein</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Best Casein Protein Powders
          </h2>

          <p>
