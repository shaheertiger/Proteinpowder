---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Momentous Protein Powder Review",
    "url": "/momentous-protein-powder-review/"
  },
  {
    "title": "Best Casein Protein Powder",
    "url": "/best-casein-protein-powder/"
  },
  {
    "title": "Whey vs Whey Isolate",
    "url": "/whey-vs-whey-isolate/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Legion Protein Powder Review: Whey+, Casein+ and Plant+ Checked Against the Label";
const description =
  "Legion Whey+, Casein+, Plant+ and whey concentrate compared on protein per scoop, Labdoor testing and cost per 25 g of protein, and who should shop elsewhere.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
