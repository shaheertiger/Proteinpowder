const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Legion Protein Powder Review",
          item: `${SITE_URL}/legion-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Legion protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for recreational lifters who want natural sweeteners. Legion Whey+ provides 22 g of Irish grass-fed whey isolate protein in about 100 calories with stevia instead of sucralose. It is not NSF Certified for Sport, and at about $2.50 per 25 g of protein it costs more than mainstream wheys and slightly more than Transparent Labs."
          }
