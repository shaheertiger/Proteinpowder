const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-18", modified: "2026-11-18" });
const title = "1UP Protein Powder Review: Is It Third-Party Tested?";
const description =
  "Not by NSF or Informed Sport: 1UP says every batch is lab tested in an NSF-GMP plant. We check its ISO, Clear and Vegan labels and the $3+ cost per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "1up-protein-powder-review-iso-protein",
    "name": "1UP ISO Protein (Premium Whey Isolate), 25 Servings",
    "brand": "1UP Nutrition",
    "badge": "Best 1UP Whey",
    "category": "Whey protein isolate",
    "description": "1UP's main whey is a straight whey isolate. Per the supplement facts panel on 1UP's site at the time of writing, a 26 g scoop gives 20 g of protein, 90 calories, 0.5 g of fat, 1 g of carbohydrate and 0 g of sugar, with 25 servings per tub. Each flavor comes two ways: sweetened with sucralose, or with 1UP's stevia and monk fruit blend. Birthday Cake is sold only in the stevia and monk fruit version. At $64.99 that works out to about $3.25 per 25 g.",
    "pros": [
      "Whey isolate is the only protein source; short ingredient list",
      "90 calories and 0 g sugar per scoop, per the label",
      "Sucralose or stevia plus monk fruit, your choice in most flavors",
      "13 flavor options listed, including Birthday Cake"
    ],
    "cons": [
      "About $3.25 per 25 g, roughly double most Amazon isolates",
      "20 g per scoop on the current panel, though some page copy still says 25 g",
      "No NSF Certified for Sport or Informed Sport listing we could find"
    ],
    "bottomLine": "A clean isolate with a sweetener choice, priced like a boutique brand. Buy it for the flavors, not the value.",
    "specs": {
      "Protein / serving": "20 g (26 g scoop, label)",
      "Calories": "90",
      "Third-party testing": "In-house batch testing (brand); no product cert found",
      "Cost per 25 g": "About $3.25 (1UP site price seen)"
    }
  },
  {
