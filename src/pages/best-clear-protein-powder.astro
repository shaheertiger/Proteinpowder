];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-17", modified: "2026-10-17" });
const title = "Best Clear Protein Powder: Juice-Like Whey, Honestly Rated";
const description =
  "The best clear protein powders and drinks, what clear whey isolate actually is, and the trade-offs on cost, foam, smaller servings and acidity before you buy.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
