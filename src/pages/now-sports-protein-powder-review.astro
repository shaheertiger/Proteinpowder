const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "NOW Sports Protein Powder Review",
          item: `${SITE_URL}/now-sports-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is NOW Sports protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The whey isolate is: NOW Sports Whey Protein Isolate appears on the Informed Sport registry, which tests listed batches for banned substances, with unflavored batches recorded into 2025 and 2026. The pea, soy and egg white listings show the Informed Sport mark, but we could not confirm product-level entries. Informed Sport does not test for heavy metals or verify protein content."
          }
