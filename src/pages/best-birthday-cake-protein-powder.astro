---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Tasting Protein Powder",
    "url": "/best-tasting-protein-powder/"
  },
  {
    "title": "Best Vanilla Protein Powder",
    "url": "/best-vanilla-protein-powder/"
  },
  {
    "title": "Best Cookies and Cream Protein Powder",
    "url": "/best-cookies-and-cream-protein-powder/"
  },
  {
    "title": "Best Salted Caramel Protein Powder",
    "url": "/best-salted-caramel-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best Birthday Cake Protein Powder: Sprinkles, Sweeteners and Cost per 25 g";
const description =
  "The best birthday cake protein powder picks compared on label protein, sugar, sweeteners and real sprinkles, with cost per 25 g of protein and recipe uses.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
