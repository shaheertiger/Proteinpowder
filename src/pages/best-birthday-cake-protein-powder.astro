    ],
    "bottomLine": "Pick it if you bake with protein or want a dessert-thick shake.",
    "specs": {
      "Protein per serving": "24 g (label)",
      "Calories": "120",
      "Sweeteners": "Sucralose, acesulfame K",
      "Best for": "Baking, pudding, thick shakes"
    }
  },
  {
    "id": "ryse-loaded-protein",
    "name": "RYSE Loaded Protein, Jet-Puffed Birthday Cake",
