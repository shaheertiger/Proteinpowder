const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Muscle Milk vs Premier Protein",
          item: `${SITE_URL}/muscle-milk-vs-premier-protein/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Muscle Milk or Premier Protein healthier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on what you mean by healthier. Premier has less sugar and fewer carbs, 1 g and 4 g per carton against Muscle Milk's 3 g and 11 g, plus 24 added vitamins and minerals. Muscle Milk has a shorter ingredient list, no artificial sweeteners or flavors and less fat. Both are reasonable shakes; choose on the trade-off that matters to you."
          }
        },
        {
          "@type": "Question",
          "name": "Does Muscle Milk still use artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The shakes do not. Since the spring 2026 reformulation, Muscle Milk and Muscle Milk Pro shakes are sweetened with stevia and contain no artificial sweeteners, flavors or added colors, per the brand. The Muscle Milk powders, including Pro Series and Genuine, were not reformulated and still list sucralose and acesulfame potassium on the labels we checked."
          }
        },
        {
          "@type": "Question",
          "name": "Which has more protein, Muscle Milk Pro or Premier Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muscle Milk Pro has more in the carton size: 33 g per 11 fl oz against Premier's 30 g, per the labels at the time of writing. In the 14 oz bottles they tie at 42 g, Muscle Milk Pro against Premier Ultimate. Premier gets its protein in fewer calories in both sizes, so it wins on protein per calorie."
          }
        },
        {
          "@type": "Question",
          "name": "Can you drink Muscle Milk or Premier if you are lactose intolerant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many people with mild lactose intolerance can, because both shakes are low in lactose. Neither brand prints a lactose figure, but lactose counts toward total sugars, so a Premier carton holds at most 1 g and a standard Muscle Milk carton at most about 3 g. Start with a small amount, and avoid both if you have a milk allergy."
          }
        },
        {
          "@type": "Question",
          "name": "Is Premier Protein or Muscle Milk third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We found no NSF Certified for Sport, Informed Choice or Informed Sport listing for Premier shakes or powders, or for the new Muscle Milk shakes. Muscle Milk's Pro Series and Genuine powders are listed as NSF Certified for Sport by the brand and on Amazon. Tested athletes should confirm the exact product and flavor in the NSF database."
          }
        },
        {
          "@type": "Question",
          "name": "Which is cheaper, Muscle Milk or Premier Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muscle Milk was cheaper per gram of protein in cartons at the Amazon prices we saw: about $1.68 per 25 g for the 26 g shake and $1.69 for Pro 33 g, against $1.86 for Premier 30 g. In 14 oz bottles Premier Ultimate was cheaper, about $2.23 against $2.55. Warehouse club sales can change the order."
          }
        },
        {
          "@type": "Question",
          "name": "Is Muscle Milk or Premier better for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier is slightly better, because 30 g of protein in 160 calories with 4 g of carbs is the leanest ratio here. The standard Muscle Milk shake gives 26 g in the same calories with 11 g of carbs. The difference is modest, so either works in a calorie deficit. Talk to a doctor or dietitian before a large diet change."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
