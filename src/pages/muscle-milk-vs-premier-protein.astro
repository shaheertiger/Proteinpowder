---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Premier Protein vs Ensure",
    "url": "/premier-protein-vs-ensure/"
  },
  {
    "title": "Premier Protein Powder Review",
    "url": "/premier-protein-powder-review/"
  },
  {
    "title": "Muscle Milk Genuine vs Premier Protein Powder",
    "url": "/compare/muscle-milk-genuine-protein-powder-vs-premier-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-16", modified: "2026-11-16" });
const title = "Muscle Milk vs Premier Protein: Which Shake Is Better?";
const description =
  "Premier is leaner (30 g protein, 1 g sugar, 160 cal); Muscle Milk's 2026 shakes are cheaper per 25 g and drop artificial sweeteners. Label and price math.";

const PRODUCTS: {
