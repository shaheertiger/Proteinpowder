];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-05", modified: "2026-11-05" });
const title = "Best Protein Supplements: The Top Pick in Every Format, From Whey to Bars";
const description =
  "The best protein supplements by format: whey, plant, clear whey, shakes, bars and collagen, with cost per 25 g of protein and what each one cannot do.";

