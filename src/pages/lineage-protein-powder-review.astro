---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Levels Protein Powder Review",
    "url": "/levels-protein-powder-review/"
  },
  {
    "title": "Paleovalley Bone Broth Protein Review",
    "url": "/paleovalley-bone-broth-protein-review/"
  },
  {
    "title": "Bobby Approved Protein Powder Review",
    "url": "/bobby-approved-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-19", modified: "2026-11-19" });
const title = "Lineage Protein Powder Review: Is It Third-Party Tested?";
const description =
  "Yes: Lineage says every batch is tested by ISO-accredited Light Labs, with COAs posted. Its ABC powder gives 20 g protein a scoop at about $3 per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "lineage-protein-powder-review-abc-original",
    "name": "Lineage Provisions Animal-Based Complete Protein (Original, Unflavored)",
    "brand": "Lineage Provisions",
    "badge": "Best Overall",
    "category": "Grass-fed milk and whey protein concentrate with organs and colostrum",
    "description": "The unflavored Animal-Based Complete is Lineage's core powder. Per the supplement facts panel on Lineage's site at the time of writing, a 25.9 g scoop gives 20 g of protein, 100 calories, 1 g of fat, 2 g of carbohydrate and 2 g of sugar, with 30 servings per bag. The protein is grass-fed milk protein concentrate plus whey protein concentrate, with an 800 mg organ blend, 250 mg of bovine colostrum, 250 mg of a berry blend and 500 mg of coconut water. There is no sweetener, gum or flavoring.",
    "pros": [
      "No sweetener, gums, lecithin or flavoring, per the label",
      "Every batch tested by ISO-accredited Light Labs, per Lineage",
      "77% protein by weight, the leanest Lineage option",
      "Neutral taste works in coffee, smoothies and baking"
    ],
    "cons": [
      "About $3.08 per 25 g on Amazon, around double plain grass-fed whey",
      "20 g of protein per scoop, less than most whey",
      "Clumps when stirred with a spoon, per Lineage itself",
      "No NSF Certified for Sport or Informed Sport claim"
    ],
    "bottomLine": "The cleanest Lineage label and the one to buy if you want the brand. You are paying a premium for sourcing and the extras, not for more protein.",
    "specs": {
      "Protein / serving": "20 g (25.9 g scoop, label)",
      "Calories": "100",
      "Third-party testing": "Light Labs, every batch (brand); no NSF or Informed Sport",
      "Cost per 25 g": "About $3.08 ($73.94 Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0H6CBHQCT"
  },
  {
    "id": "lineage-protein-powder-review-abc-chocolate",
    "name": "Lineage Provisions Animal-Based Complete Protein (Chocolate)",
    "brand": "Lineage Provisions",
    "badge": "Best Flavored Pick",
    "category": "Grass-fed dairy protein with cocoa and coconut sugar",
    "description": "Chocolate uses the same grass-fed milk and whey concentrate base, organ blend and colostrum, then adds organic alkalized cocoa and organic coconut sugar. Per Lineage's panel at the time of writing, a 46.7 g scoop gives 20 g of protein, 170 calories, 19 g of carbohydrate, 2 g of fiber and 13 g of total sugar, 12 g of it added. There are no artificial or zero-calorie sweeteners. It is the better choice for drinking in water, at a real sugar and calorie cost.",
    "pros": [
      "Sweetened only with organic coconut sugar, no stevia or sucralose",
      "Same testing and sourcing as the unflavored powder",
      "Easier to drink plain than the unflavored version"
    ],
    "cons": [
      "12 g of added sugar per scoop, about 24% of the daily value",
      "170 calories for 20 g of protein",
      "Cocoa-based powders tend to carry more lead than unflavored ones"
    ],
    "bottomLine": "Buy it if you will not drink an unflavored shake and you are fine with 12 g of added sugar. Otherwise get Original and add your own cocoa.",
    "specs": {
      "Protein / serving": "20 g (46.7 g scoop, label)",
      "Calories": "170",
      "Third-party testing": "Light Labs, every batch (brand)",
      "Cost per 25 g": "About $3.08 ($73.94 Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0H6C1DQ82"
  },
  {
    "id": "lineage-protein-powder-review-ballerina-farm",
    "name": "Ballerina Farm Grass Fed Whey Protein Powder (Maple Cinnamon), 20 Servings",
    "brand": "Ballerina Farm",
    "badge": "Closest Amazon Alternative",
    "category": "Grass-fed whey with collagen and colostrum",
    "description": "Ballerina Farm is the closest match to Lineage's idea: a grass-fed whey powder with bovine colostrum and other add-ins, sold at a similar premium. The Amazon listing describes 24 g of protein per serving with collagen peptides, bovine colostrum, hemp hearts and prebiotic fiber and no artificial ingredients, in a 20-serving bag. Its flavors are sweetened with stevia and monk fruit, per our <a href=\"/ballerina-farm-protein-powder-review/\">Ballerina Farm review</a>. At $62.99 for 20 servings it costs slightly more per gram than Lineage.",
    "pros": [
      "4 g more protein per scoop than Lineage",
      "Also includes bovine colostrum",
      "No artificial sweeteners or flavors, per the listing"
    ],
    "cons": [
      "About $3.28 per 25 g, slightly more than Lineage on Amazon",
      "Part of the protein is collagen, which is not a complete protein",
      "Uses stevia and monk fruit, which some buyers dislike"
    ],
    "bottomLine": "The pick if you want the same premium grass-fed, colostrum-added style with more protein per scoop and a sweet flavor.",
    "specs": {
      "Protein / serving": "24 g (listing)",
      "Calories": "About 120 to 140 (trackers, varies by flavor)",
      "Third-party testing": "No NSF or Informed Sport claim found",
      "Cost per 25 g": "About $3.28 ($62.99 Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0GCQ8XHBM"
  },
  {
    "id": "lineage-protein-powder-review-levels-grass-fed-whey",
    "name": "Levels Grass-Fed Whey Protein (Vanilla Bean), 5 lb",
    "brand": "Levels Nutrition",
    "badge": "Budget Grass-Fed Whey",
    "category": "Grass-fed whey protein concentrate",
    "description": "If what you want from Lineage is grass-fed dairy protein with a short ingredient list, Levels delivers it for less than half the price per gram. The Amazon listing gives 24 g of protein and 5.4 g of BCAAs per serving, with no fillers and no added sugar, and our database lists 71 servings in the 5 lb bag. It has no organs or colostrum and is sweetened with stevia and monk fruit. See our <a href=\"/levels-protein-powder-review/\">Levels protein review</a> for the full label.",
    "pros": [
      "About $1.43 per 25 g, less than half of Lineage",
      "24 g of protein per scoop",
      "Unflavored version also sold on Amazon"
    ],
    "cons": [
      "No organs, colostrum or extras",
      "Vanilla is sweetened with stevia and monk fruit",
      "No NSF or Informed Sport claim"
    ],
    "bottomLine": "The value choice for grass-fed whey. Buy it if the organ blend is not the reason you were looking at Lineage.",
    "specs": {
      "Protein / serving": "24 g (listing)",
      "Calories": "About 130 (label)",
      "Third-party testing": "No NSF or Informed Sport claim found",
      "Cost per 25 g": "About $1.43 ($97.49 Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B072M8FKRW"
  },
  {
    "id": "lineage-protein-powder-review-equip-prime-unflavored",
    "name": "Equip Foods Prime Protein Grass-Fed Beef Isolate (Unflavored), 30 Servings",
    "brand": "Equip Foods",
    "badge": "Best If You Want Beef Protein",
    "category": "Grass-fed beef protein isolate",
    "description": "Many searches for Lineage protein come from people expecting a beef protein, and Lineage's own product page now points beef-protein shoppers to Equip Foods. Unflavored Prime Protein lists one ingredient, grass-fed beef protein isolate, and about 21 g of protein per scoop, per our <a href=\"/equip-protein-powder-review/\">Equip review</a>, with 30 servings per tub per the Amazon listing. It is dairy-free, which no Lineage powder is, because even Lineage's beef formula contains colostrum.",
    "pros": [
      "Dairy-free and whey-free",
      "One ingredient in the unflavored version",
      "About $2.02 per 25 g, cheaper than Lineage"
    ],
    "cons": [
      "Beef isolate is mostly collagen-type protein, lower in leucine than whey",
      "Mild beef taste in plain water, per Equip",
      "No organs or colostrum"
    ],
    "bottomLine": "The pick for a true beef protein with no milk at all. Buy it if you avoid dairy.",
    "specs": {
      "Protein / serving": "About 21 g (label)",
      "Calories": "About 100 (label)",
      "Third-party testing": "Publishes lab results (brand); no NSF or Informed Sport",
      "Cost per 25 g": "About $2.02 ($50.99 Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0B41YX3VR"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Lineage Protein Powder Review",
          item: `${SITE_URL}/lineage-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Lineage third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Lineage Provisions says every batch of Animal-Based Complete is tested by Light Labs, an ISO 17025 accredited lab, for more than 300 contaminants including heavy metals, glyphosate, mycotoxins and pesticides, and it posts the certificates of analysis on its product pages. It does not claim NSF Certified for Sport or Informed Sport certification, so it is not the right pick for drug-tested athletes."
          }
        },
        {
          "@type": "Question",
          "name": "Is Lineage protein powder healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By label, yes: the Original contains grass-fed milk and whey protein concentrate, sea salt and small organ, colostrum, berry and coconut water blends, with no sweetener, gums, fillers or artificial flavors. It gives 20 g of protein for 100 calories. The Chocolate version adds 12 g of coconut sugar per scoop, which is the main thing to watch if you are limiting added sugar."
          }
        },
        {
          "@type": "Question",
          "name": "Does Lineage protein contain casein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The current dairy formula uses grass-fed milk protein concentrate, which naturally contains roughly 80% casein and 20% whey, alongside whey protein concentrate. That makes Lineage a casein and whey blend rather than a pure whey. The beef formula still offered on Lineage's site uses beef protein isolate instead, but it contains colostrum, so it is not milk-free either."
          }
        },
        {
          "@type": "Question",
          "name": "Does Lineage protein powder taste like liver?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lineage says no, and most buyer feedback describes the Original as mild and neutral. The organ blend is only 800 mg per scoop, which helps. A small number of reviewers report a faint organ note, for example in the chocolate version mixed with coconut milk alone. Buyers who blend it into coffee, smoothies or yogurt report the fewest taste issues."
          }
        },
        {
          "@type": "Question",
          "name": "Which Lineage flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyer feedback favors Chocolate for drinking with just water or milk, since it is sweetened with organic coconut sugar and cocoa. The Original is the more popular choice for coffee, smoothies and baking because it has no flavor or sweetener. If you are watching sugar, choose Original: Chocolate has 13 g of sugar and 170 calories per scoop, against 2 g and 100."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common complaints about Lineage protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common complaints are clumping when stirred with a spoon, which Lineage attributes to having no gums or emulsifiers, and the price of about $3 per 25 g of protein. Some buyers also note 20 g of protein per scoop is lower than most whey, and a few mention a faint organ taste. Lineage offers a money-back guarantee if you dislike it."
          }
        },
        {
          "@type": "Question",
          "name": "Can people with lactose intolerance use Lineage protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Possibly, but check with care. Lineage says milk and whey protein concentrates are naturally low in lactose and that many dairy-sensitive people tolerate them, but it does not publish a lactose figure. Anyone with a true milk allergy should avoid it entirely. If lactose bothers you, an isolate-based or plant protein is a safer choice; ask a doctor or dietitian if unsure."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "lineage protein powder",
      "lineage provisions protein powder",
      "lineage animal based complete",
      "lineage abc protein",
      "paul saladino protein powder"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Grass-Fed Whey Picks",
    link: "/best-grass-fed-whey-protein/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Brand Review"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Lineage Protein Powder Review</Fragment>
      For anyone looking at Lineage Provisions' Animal-Based Complete powder: what the current dairy label says, what the Light Labs testing covers, what it costs per 25 g, and cheaper grass-fed swaps on Amazon.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#what-lineage-sells">What Lineage Sells</a>
      <a href="#top-picks">The Products</a>
      <a href="#whats-in-it">What Is in It</a>
      <a href="#third-party-tested">Third-Party Testing</a>
      <a href="#cost">Cost per 25 g</a>
      <a href="#taste-and-mixing">Taste and Mixing</a>
      <a href="#organs-colostrum">Organs and Colostrum</a>
      <a href="#vs">Lineage vs Alternatives</a>
      <a href="#who-should-buy">Who Should Buy It</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Lineage protein powder is a third-party tested, grass-fed dairy protein that gives 20 g of protein per scoop for about $3 per 25 g, roughly double the price of plain grass-fed whey. What changes the verdict is how much you value the small organ, colostrum and fruit blend and the no-gum label. Below: the label, testing, cost, buyer feedback and alternatives.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Lineage Protein Powder: The Short Answer
          </h2>

          <p>
            Lineage protein powder is worth buying if you want a grass-fed dairy protein with no gums, no artificial sweeteners and published batch testing, and you accept paying about $3 per 25 g of protein for it. Lineage Provisions' only protein powder is Animal-Based Complete, or ABC, which gives 20 g of protein per scoop from grass-fed milk and whey protein concentrate, plus small amounts of beef organs, colostrum and fruit, per the label at the time of writing.
          </p>

          <p>
            <strong>Buy it if</strong> you want the unflavored version for coffee, smoothies or baking, you like the animal-based approach that co-founder Paul Saladino is known for, and batch testing for glyphosate and heavy metals matters more to you than price. <strong>Skip it if</strong> you want the most protein for your money, you need a dairy-free or beef-only protein, or you need NSF Certified for Sport or Informed Sport certification for drug-tested sport.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">By the Numbers</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">20 g</p>
                <p class="text-gray-400 text-xs mt-1">Protein per scoop, both flavors (label)</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">100</p>
                <p class="text-gray-400 text-xs mt-1">Calories per unflavored scoop</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">$3.08</p>
                <p class="text-gray-400 text-xs mt-1">Per 25 g of protein at the Amazon price we saw</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">300+</p>
                <p class="text-gray-400 text-xs mt-1">Contaminants Lineage says each batch is screened for</p>
              </div>
            </div>
          </div>

          <p>
            The short version of the value question: a plain grass-fed whey such as Levels costs about $1.43 per 25 g, so roughly half of what you pay for Lineage goes to the extras, the sourcing and the brand. Whether that is a good deal depends on how much you value an 800 mg organ blend and a 250 mg dose of colostrum, which we look at honestly further down. For the full field, see our ranking of the <a href="/best-grass-fed-whey-protein/">best grass-fed whey protein</a>.
          </p>
        </div>

        <div id="what-lineage-sells" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. What Does Lineage Provisions Sell, and Which One Is the Protein Powder?
          </h2>

          <p>
            Lineage Provisions sells one protein powder, Animal-Based Complete, alongside grass-fed beef sticks, air-dried steak, protein bars, nose-to-tail collagen, creatine, raw honey, beef tallow and coffee. The brand says it was founded by Paul Saladino, MD, and Anthony Gustin, and that it partners with regenerative farms. When people search "lineage protein powder" or "lineage provisions protein powder", Animal-Based Complete is the product they mean.
          </p>

          <p>
            The powder has changed shape over the past year, which explains some confusing reviews. Lineage launched ABC as a <strong>beef protein</strong> made from grass-fed beef protein isolate, organs and colostrum. Its current catalog leads with a <strong>dairy protein</strong> version instead: Lineage's FAQ says the ABC Dairy recipe "as of June 2026" uses milk and whey protein concentrates. At the time of writing the product page still offers the beef formula as an option in its formula selector, but the same page also tells shoppers looking for grass-fed beef protein to check out Equip Foods, and both Amazon listings are the dairy version.
          </p>

          <h3 class="text-2xl font-bold text-gray-900 mt-10 mb-4">The current Animal-Based Complete lineup</h3>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Version</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein base</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein / scoop</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Where sold</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Original, Dairy Protein</td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed milk + whey protein concentrate</td>
                    <td class="px-4 py-4 text-gray-700">20 g (25.9 g scoop)</td>
                    <td class="px-4 py-4 text-gray-700">100</td>
                    <td class="px-4 py-4 text-gray-700">Lineage site, Amazon</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chocolate, Dairy Protein</td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed milk + whey protein concentrate</td>
                    <td class="px-4 py-4 text-gray-700">20 g (46.7 g scoop)</td>
                    <td class="px-4 py-4 text-gray-700">170</td>
                    <td class="px-4 py-4 text-gray-700">Lineage site, Amazon</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Original, Beef Protein</td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed beef protein isolate</td>
                    <td class="px-4 py-4 text-gray-700">20 g (23 g scoop)</td>
                    <td class="px-4 py-4 text-gray-700">90</td>
                    <td class="px-4 py-4 text-gray-700">Lineage site (formula option)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            All three use the same add-in blend: beef heart, liver, kidney, spleen and pancreas, bovine whole colostrum, an organic berry blend and freeze-dried coconut water. All three also contain milk, because colostrum is a dairy ingredient; even the beef label declares milk and tree nuts (coconut). That matters if you came to Lineage looking for a dairy-free animal protein. It is not one, in any version.
          </p>

          <p>
            This review focuses on the dairy formula, since it is what Lineage now leads with and what most buyers will receive. The bags hold 30 servings and sell for $79 each on lineageprovisions.com, or $71.10 on subscription, and $73.94 on Amazon when we checked. Lineage also sells a nose-to-tail collagen, which is a different product: collagen is not a complete protein, as we explain in <a href="/collagen-vs-protein-powder/">collagen vs protein powder</a>.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Lineage Animal-Based Complete and the Closest Amazon Alternatives
          </h2>

          <p>
            Lineage sells both Animal-Based Complete flavors on Amazon as well as on lineageprovisions.com. The first two cards are the Lineage powders; the last three are alternatives we could verify on Amazon: a colostrum-boosted grass-fed whey, a budget grass-fed whey and a true beef protein isolate. Cost per 25 g uses each label's servings and protein and the Amazon price we saw on 19 November 2026.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="whats-in-it" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Is in Lineage Animal-Based Complete Protein?
          </h2>

          <p>
            Lineage Animal-Based Complete Original contains grass-fed milk protein concentrate, grass-fed whey protein concentrate and sea salt, plus four listed blends: 500 mg of organic freeze-dried coconut water, an 800 mg grass-fed beef organ blend, a 250 mg organic berry blend and 250 mg of grass-fed bovine whole colostrum, per the supplement facts panel at the time of writing. There is no sweetener, flavoring, gum, lecithin or added fiber.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
