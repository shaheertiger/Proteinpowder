      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Highest Protein Powder",
          item: `${SITE_URL}/best-high-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What protein powder has the most protein per scoop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Among mainstream powders, Optimum Nutrition Platinum Hydrowhey lists about 30 g per scoop and Transparent Labs Grass-Fed Isolate about 28 g, per the labels at the time of writing. Remember that per-scoop numbers depend on scoop size, so check protein by weight before assuming either is denser than a 25 g isolate with a smaller scoop."
          }
        },
        {
          "@type": "Question",
          "name": "What protein powder has the most protein per calorie?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unflavored and lightly flavored whey isolates lead. Isopure Zero Carb lists about 25 g of protein for roughly 100 calories, and NOW Sports Whey Isolate about 24 to 25 g for roughly 110, per the label. Because labels round, anything above about 90 percent of calories from protein is effectively pure protein."
          }
        },
        {
          "@type": "Question",
          "name": "How do I calculate protein percentage by weight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Divide the grams of protein per serving by the serving weight in grams, both from the nutrition panel, and multiply by 100. A 25 g dose in a 28 g scoop is about 89 percent protein. Plain isolates usually land in the mid to high 80s; flavored blends in the mid to high 70s."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey isolate higher in protein than concentrate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Isolate is at least 90 percent protein on a dry basis, while sports concentrates are commonly around 80 percent. On a finished label that typically means about 85 to 90 percent protein by weight for plain isolate versus the 70s for flavored concentrate. For muscle gain the two perform similarly when the dose is matched."
          }
