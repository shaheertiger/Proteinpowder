const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Runners",
          item: `${SITE_URL}/best-protein-powder-for-runners/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Should runners drink protein shakes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Runners do not need protein shakes, but they can help. Most runners need 1.2 to 2.0 g of protein per kilogram a day, and a shake is a convenient way to get about 20 to 25 g after a hard run when appetite is low. If meals already cover your needs, a shake adds little beyond convenience."
          }
        },
        {
          "@type": "Question",
          "name": "When should runners take protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Spread it across the day in 20 to 30 g doses, including one within a couple of hours after long runs and workouts. The timing window is wider than once thought, so there is no need to rush. Before bed, a slower protein such as casein or Greek yogurt is a reasonable option during heavy training."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey or plant protein better for runners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey isolate is generally easier to digest, higher in leucine and well studied, so it is the default for runners who tolerate dairy. Plant proteins work well too, especially blends of pea and rice, but use slightly larger servings. Choose based on your stomach and diet, and prefer a certified product either way."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best recovery drink for runners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "After long runs, a drink with roughly three to four times as much carbohydrate as protein works well. Low-fat chocolate milk fits that profile and is backed by small studies. A purpose-built mix such as Tailwind Recovery Mix, or a whey isolate blended with fruit and oats, does the same job."
          }
        },
        {
          "@type": "Question",
          "name": "Will protein powder make me bulky as a runner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Muscle growth of any size requires a calorie surplus and resistance training aimed at it. A runner using protein to meet a daily target while logging miles is supporting repair and adaptation, not building bulk. Protein can help preserve muscle during weight loss, which most runners want."
          }
        },
        {
          "@type": "Question",
          "name": "Can protein before a run cause stomach problems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can, especially with thick shakes, dairy concentrates, fat, fiber or sugar alcohols. If you want protein before running, try a small whey isolate shake an hour or more beforehand and test it in training. Many runners prefer to save protein for after the session."
          }
        },
        {
          "@type": "Question",
          "name": "Do drug-tested runners need NSF certified protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you compete in events covered by anti-doping rules, using a product certified by NSF Certified for Sport or Informed Sport is strongly advised, because supplements can contain undeclared banned substances. Certification lowers that risk. Check the exact product and flavor in the registry before using it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "By Goal",
    tags: [
      "best protein powder for runners",
      "protein powder for runners",
      "recovery drink for runners",
      "protein for endurance athletes",
      "best protein shake after running"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Buyer's Guide"} badge={"Updated November 2026"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Best Protein Powder for Runners</Fragment>
      Runners need more protein than the RDA but less than lifters think, and after a long run they need carbohydrate even more. Here is how to get both, and which products are worth carrying in a race bag.
    </ArticleHeader>

    <TableOfContents>
      <a href="#quick-answer">Quick Answer</a>
      <a href="#how-much-protein-do-runners-need">Protein Needs for Runners</a>
      <a href="#top-picks">Our Picks</a>
      <a href="#carb-protein-recovery">Carbs + Protein Recovery</a>
      <a href="#easy-digestion">Easy Digestion</a>
      <a href="#tested-products">Tested Products for Racers</a>
      <a href="#runner-types">By Runner Type</a>
      <a href="#how-we-chose">How We Chose</a>
