                    <td class="px-4 py-4 text-gray-700">About 90</td>
                    <td class="px-4 py-4 text-gray-700">Low; check label</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (brand)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">ON Gold Standard Whey</td>
                    <td class="px-4 py-4 text-gray-700">About 24 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">Informed Choice (brand)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">NOW Sports Soy Isolate</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">About 90</td>
                    <td class="px-4 py-4 text-gray-700">0 g carbs</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">Informed Sport (label)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Casein</td>
                    <td class="px-4 py-4 text-gray-700">26 g</td>
                    <td class="px-4 py-4 text-gray-700">About 110</td>
                    <td class="px-4 py-4 text-gray-700">Low; check label</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">NSF Contents Certified (brand)</td>
