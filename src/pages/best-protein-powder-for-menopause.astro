const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Menopause",
          item: `${SITE_URL}/best-protein-powder-for-menopause/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for menopause?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our top pick is Transparent Labs Grass-Fed Whey Protein Isolate, which gives 28 g of protein, about 1 g of sugar and roughly 2.7 g of leucine per scoop per its label and retailer listings, and is Informed Choice certified per the brand. Momentous is the NSF certified option, Gold Standard is the budget choice, and NOW Sports Soy Isolate is the best soy pick."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein should a woman in menopause eat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The RDA is 0.8 g per kilogram a day, but expert groups such as PROT-AGE recommend 1.0-1.2 g per kilogram for adults over 65, and many dietitians apply a similar range from menopause onward. Aim for about 25-30 g at each meal. Talk to your doctor before increasing protein if you have kidney disease."
          }
        },
        {
          "@type": "Question",
          "name": "Does soy protein help with menopause symptoms?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Possibly a little, but the evidence is inconsistent. Some meta-analyses found isoflavone supplements reduced hot flashes modestly, while a Cochrane review found no conclusive benefit, and The Menopause Society does not recommend soy for hot flashes. Soy protein powders rarely list isoflavone content. Soy is a good protein for muscle, but treat any symptom relief as a bonus."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey or soy better for menopause?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For muscle, whey has the edge because it contains more leucine per gram, so a smaller serving reaches the per-meal threshold. Soy is a complete protein and works well if you eat a slightly bigger serving, about 30 g or more. Choose soy if you avoid dairy or like soy foods, and whey if you want the most efficient dose."
          }
        },
        {
          "@type": "Question",
          "name": "Can protein powder help prevent osteoporosis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Protein supports bone, and research shows higher protein intakes are not harmful and may help slightly when calcium is adequate. But protein alone does not prevent osteoporosis. Strength and impact training, enough calcium and vitamin D, avoiding smoking and getting a bone density test when recommended matter more. Some women also need prescription treatment."
          }
        },
        {
          "@type": "Question",
          "name": "Does protein powder help with menopause weight gain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can help indirectly. Protein is filling, helps preserve muscle while you eat a little less, and a lean whey isolate adds protein with few calories. Combined with strength training, that helps limit the shift from muscle to fat common in midlife. A shake does not cause weight loss on its own; total calories and activity still decide the outcome."
          }
        },
        {
          "@type": "Question",
          "name": "Is collagen good for menopause?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Collagen is not a good primary protein for muscle because it is low in leucine and lacks tryptophan. A few small studies suggest specific collagen peptides may modestly affect bone markers or skin, but the evidence is limited. If you enjoy it, use collagen as an extra on top of a complete protein such as whey, casein, soy or pea."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
