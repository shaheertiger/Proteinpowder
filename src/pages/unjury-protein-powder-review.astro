];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Unjury Protein Powder Review: Is the Bariatric Favorite Worth the Price?";
const description =
  "Our Unjury review reads each whey label, from Chocolate to Chicken Soup, compares cost per 25 g, and explains what bariatric patients should check first.";

const PRODUCTS: {
