];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Unjury Protein Powder Review",
          item: `${SITE_URL}/unjury-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Unjury protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For its purpose, yes. Every Unjury whey powder lists 21 g of protein from whey isolate in a small scoop, with about 90 to 110 calories and 2 g of sugar or less, and the range includes savory and unflavored options. It costs more per gram than mainstream isolates and carries no third-party certification, so it suits specific needs better than general use."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Unjury?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Each Unjury whey powder flavor we checked lists 21 g of protein per scoop, with scoop sizes from about 24 g for Unflavored to about 31 g for Chocolate. The pea-protein Chocolate plant powder lists about 20 g per serving. Figures are per Unjury's labels at the time of writing and may change, so check the tub you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Is Unjury good after bariatric surgery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unjury is designed with surgical patients in mind, and its small scoop, low sugar, isolate base and savory flavors suit many post-surgery plans. But programs differ in protein targets, sugar limits and when each product is allowed. This is not medical advice: ask your bariatric surgeon or registered dietitian before using Unjury or any protein supplement."
          }
        },
        {
          "@type": "Question",
          "name": "Does Unjury contain lactose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unjury uses whey protein isolate, which is filtered to remove most lactose, and its Chocolate label claims zero grams of lactose. That makes it usually better tolerated than whey concentrate by lactose-sensitive people. If you are highly sensitive or have a milk allergy, check with your doctor; all Unjury whey powders contain milk and soy lecithin."
          }
        },
        {
          "@type": "Question",
          "name": "Can you mix Unjury into hot food or drinks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only warm, not hot. Unjury's labels say not to use the powders in liquids hotter than about 140 degrees Fahrenheit, because the protein clumps. For soups or coffee, let the liquid cool to warm before stirring in the powder. Unflavored is the best version for mixing into foods such as yogurt, pudding or lukewarm soup."
          }
        },
        {
          "@type": "Question",
          "name": "What sweeteners does Unjury use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The sweet flavors, such as Chocolate and Vanilla, contain fructose, acesulfame potassium and sucralose, which keeps sugar at about 2 g per scoop. Unflavored has no sweeteners at all, and the Chicken Soup label lists none. The pea-protein plant Chocolate uses organic cane sugar and stevia. Check each label if you avoid a specific sweetener."
          }
        },
        {
          "@type": "Question",
          "name": "Is Unjury sold on Amazon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unjury sells primarily through its own site, with subscription pricing and stick packets. We could not confirm a current brand-run Amazon US listing for every flavor, so check the seller if you buy on Amazon. The brand site lists 15-serving tubs at about $30, which is a useful reference point when comparing prices."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
