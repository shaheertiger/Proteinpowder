];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-16", modified: "2026-11-16" });
const title = "KOS Protein Powder Review: Is It Third-Party Tested?";
const description =
  "Yes: KOS says every batch is lab-tested for lead, arsenic, cadmium and mercury. 20 g organic plant protein, 160 calories, about $2.45 per 25 g on Amazon.";

const PRODUCTS: {
