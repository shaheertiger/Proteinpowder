const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "KOS Protein Powder Review",
          item: `${SITE_URL}/kos-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is KOS protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, according to KOS. The brand says raw materials and finished products are tested at independent ISO 17025-accredited labs for lead, arsenic, cadmium, mercury, microbes and pesticide residues, and it offers a Certificate of Analysis lookup by lot number and UPC on its Quality and Safety page. It is not NSF Certified for Sport or Informed Sport certified."
          }
