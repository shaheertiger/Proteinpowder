const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-16", modified: "2026-11-16" });
const title = "Premier Protein Flavors: 7 Best, Ranked by Consensus";
const description =
  "Caramel is the best Premier Protein flavor by consensus: top five in 3 of 4 published rankings. Plus Café Latte for caffeine, label gaps and cost per shake.";

