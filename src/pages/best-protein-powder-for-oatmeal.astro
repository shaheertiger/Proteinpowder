const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Oatmeal",
          item: `${SITE_URL}/best-protein-powder-for-oatmeal/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for oatmeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A casein or whey-casein blend. PEScience Select is our top pick because its milk protein isolate makes oats creamy and it also works in shakes. Optimum Nutrition Gold Standard Casein is the best pure casein, and BSN Syntha-6 is the creamiest budget blend. Whey isolate works too if you stir it in off the heat."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put protein powder in oatmeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Cook the oats first, take them off the heat for a minute, then stir in a scoop mixed with a little milk. Adding powder to boiling oats is what causes clumps. The protein still counts toward your daily total either way; the method only affects texture."
          }
        },
        {
          "@type": "Question",
          "name": "Does heating protein powder destroy the protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Heat denatures, or unfolds, whey proteins, which changes texture, but your body digests denatured protein just as well. Cooking and baking with protein powder do not reduce the amount of protein you absorb in any meaningful way. The reason to add it off the heat is texture, not nutrition."
          }
        },
        {
          "@type": "Question",
          "name": "Is casein or whey better in oatmeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Casein. It is relatively heat-stable and thickens oats into a creamy texture, while whey isolate tends to clump and turn rubbery in hot liquid. Blends with milk protein isolate are a good middle ground. Whey works if you follow the stir-in-after-cooking method."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in protein oatmeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Half a cup of dry oats has about 5 g of protein. Adding one scoop of powder brings it to roughly 29 g, and cooking the oats in a cup of milk adds about 8 g more, for a bowl near 37 g of protein and about 390 calories. Exact figures depend on your powder, milk and toppings."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use plant protein in oatmeal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Pea and rice blends thicken oats rather than clumping, but they absorb a lot of liquid and bring an earthy flavor. Add an extra splash of milk per scoop and pair with cinnamon, banana or peanut butter. Choose a brand that publishes heavy-metal testing if you eat it daily."
          }
        },
        {
          "@type": "Question",
          "name": "What are proats?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Proats is a nickname for protein oats: oatmeal with protein powder stirred in, either hot or as overnight oats. The goal is a high-protein, high-fiber breakfast that keeps you full. Casein and whey-casein blends give the creamiest result, and the stir-in-after-cooking method prevents clumps."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
