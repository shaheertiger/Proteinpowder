    "cons": [
      "16 oz box runs out fast if you feed more than one person",
      "Serving size differs between label versions, which complicates comparisons",
      "Plant protein version has noticeably less protein, so do not mix them up"
    ],
    "bottomLine": "The easiest box to make on a weekday morning, with protein close to Kodiak's.",
    "specs": {
      "Protein / serving": "About 15-16 g with water (label)",
      "Calories": "Check panel; varies by serving size",
      "Protein source": "Whey-based protein blend",
      "Best for": "Water-only weekday batter"
    }
  },
  {
    "id": "premier-protein-complete-pancake-waffle-mix",
    "name": "Premier Protein Complete Protein Pancake & Waffle Mix",
    "brand": "Premier Protein",
    "badge": "Best for a Milk-and-Egg Batter",
    "category": "Protein pancake and waffle mix",
    "description": "Premier Protein, best known for its ready-to-drink shakes, sells a Complete pancake and waffle mix in Original and Buttermilk. Retailer labels at the time of writing list about 15 g of protein per serving made with water, about 18 g with milk and about 21 g with milk and an egg, in a 20 oz box. That is in line with Kodiak, and buyers who already like the Premier brand report a soft, mild pancake. It is newer than Kodiak, so expect fewer flavors.",
    "pros": [
      "About 15 g of protein with water and about 21 g with milk and egg, per labels",
      "Two flavors, Original and Buttermilk",
      "Widely stocked in grocery stores as well as online"
    ],
    "cons": [
      "Newer product, so Amazon stock and pricing are less consistent",
      "Headline protein number assumes milk and egg",
      "No whole-grain claim comparable to Kodiak's"
    ],
    "bottomLine": "A solid Kodiak alternative if you make your batter with milk and an egg anyway.",
    "specs": {
      "Protein / serving": "About 15 g with water; about 21 g with milk and egg (label)",
      "Calories": "Check panel; rises with milk and egg",
      "Protein source": "Dairy-based protein blend",
      "Best for": "Weekend batter with milk and egg"
    }
  },
  {
    "id": "krusteaz-protein-buttermilk-pancake-mix",
    "name": "Krusteaz Protein Buttermilk Pancake Mix",
