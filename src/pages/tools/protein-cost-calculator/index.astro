---
// Cost-per-gram calculator: turns a tub price into cost per serving, per gram
// and per 25 g of protein, and places it against the database median.
import Layout from "../../../layouts/Layout.astro";
import { PRODUCTS, MEDIANS, money } from "../../../lib/db.mjs";
import { SITE_NAME, SITE_URL } from "../../../data/site";

const priced = PRODUCTS.filter((p: any) => p.costPer25 != null).sort((a: any, b: any) => a.costPer25 - b.costPer25);
const cheapest = priced.slice(0, 5);
const costs = priced.map((p: any) => +p.costPer25.toFixed(3));
const title = "Protein Powder Cost Calculator: Price per 25 g of Protein";
const description = "Work out what a protein powder really costs: price per serving, per gram and per 25 g of protein, compared with the median across our label database.";
const faq: [string, string][] = [
  ["How do you calculate the cost per gram of protein?", "Divide the tub price by the number of servings to get the price per serving, then divide that by the grams of protein in one serving. Multiply by 25 to get the cost of a typical 25 g dose. This puts tubs of any size and scoop on the same footing."],
  ["What is a good price per 25 g of protein?", `Across the ${priced.length} powders with a dated price in our database, the median is ${money(MEDIANS.costPer25)} per 25 g of protein. Under about ${money(MEDIANS.costPer25 * 0.85)} is budget territory; over ${money(MEDIANS.costPer25 * 1.2)} you are paying for certification, sourcing or branding.`],
  ["Why is protein powder so expensive?", "Isolates and hydrolysates take extra filtration steps, grass-fed and organic sourcing costs more, third-party certification is paid per product, and brand marketing is built into the price. Bigger tubs nearly always cost less per gram, so compare on cost per 25 g rather than tub price."],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "Protein Cost Calculator", item: `${SITE_URL}/tools/protein-cost-calculator/` },
      ],
    },
    {
      "@type": "SoftwareApplication",
      name: "Protein Powder Cost Calculator",
      applicationCategory: "HealthApplication",
      operatingSystem: "Web",
      url: `${SITE_URL}/tools/protein-cost-calculator/`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "HowTo",
      name: "How to calculate the cost per 25 g of protein",
      step: [
        { "@type": "HowToStep", text: "Divide the tub price by the servings per container." },
        { "@type": "HowToStep", text: "Divide the price per serving by the grams of protein per serving." },
        { "@type": "HowToStep", text: "Multiply by 25 to get the cost of 25 g of protein." },
      ],
    },
    { "@type": "FAQPage", mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <div data-article-header class="max-w-3xl mx-auto px-4 pb-16">
    <nav aria-label="Breadcrumb" class="text-xs text-gray-500 pt-5 mb-4">
      <a href="/" class="text-gray-500 no-underline hover:text-[#0b64c0]">Home</a> › Tools
    </nav>
    <h1 class="text-[1.875rem] leading-[1.15] md:text-5xl font-black tracking-tight text-gray-900 m-0 mb-4">Protein Powder Cost Calculator</h1>
    <p class="text-[1.0625rem] md:text-xl leading-relaxed text-gray-600 m-0 mb-8">Enter the numbers from any tub to see what 25 g of protein really costs, and how that compares with the {priced.length} powders in our database.</p>

    <form class="grid sm:grid-cols-3 gap-4 bg-[#F6F7F9] border border-gray-200 rounded-2xl p-5" data-calc>
      <label class="block"><span class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-1">Tub price ($)</span><input name="price" type="number" step="0.01" min="0" value="59.99" class="w-full border border-gray-300 rounded-xl px-3 py-3" /></label>
      <label class="block"><span class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-1">Servings per tub</span><input name="servings" type="number" step="1" min="1" value="30" class="w-full border border-gray-300 rounded-xl px-3 py-3" /></label>
      <label class="block"><span class="block text-xs font-black uppercase tracking-wider text-gray-500 mb-1">Protein per serving (g)</span><input name="protein" type="number" step="0.5" min="1" value="25" class="w-full border border-gray-300 rounded-xl px-3 py-3" /></label>
    </form>
    <dl class="grid grid-cols-3 gap-3 my-6 text-center" data-calc-out>
      <div class="border border-gray-200 rounded-2xl p-4"><dt class="text-xs uppercase font-bold text-gray-500">Per serving</dt><dd class="m-0 text-2xl font-black" data-o="serving">–</dd></div>
      <div class="border border-gray-200 rounded-2xl p-4"><dt class="text-xs uppercase font-bold text-gray-500">Per 25 g protein</dt><dd class="m-0 text-2xl font-black text-[#C93500]" data-o="per25">–</dd></div>
      <div class="border border-gray-200 rounded-2xl p-4"><dt class="text-xs uppercase font-bold text-gray-500">Per gram</dt><dd class="m-0 text-2xl font-black" data-o="perg">–</dd></div>
    </dl>
    <p class="text-base text-gray-800 mb-10" data-o="verdict"></p>

    <div class="prose max-w-none">
      <h2 class="text-2xl font-black text-gray-900">Cheapest protein per gram in our database</h2>
      <ol>
        {cheapest.map((p: any) => <li><a href={p.url}>{p.fullName}</a>: {money(p.costPer25)} per 25 g ({p.price.retailer}, {p.price.checked})</li>)}
      </ol>
      <p>See every price in the <a href="/protein-powder/">full table</a>, or read our guide to the <a href="/best-cheap-protein-powder/">best cheap protein powders</a>. To work out how much protein you need per day, use the <a href="/protein-calculator/">protein calculator</a>.</p>
    </div>
    <section id="faq" class="mt-10">
      <h2 class="text-2xl font-black text-gray-900 mb-4">FAQ</h2>
      <div class="faq-list">
        {faq.map(([q, a]) => (
          <details class="faq-item"><summary><h3>{q}</h3></summary><div class="faq-answer"><p>{a}</p></div></details>
        ))}
      </div>
    </section>
  </div>
  <script type="application/json" id="calc-data" set:html={JSON.stringify({ costs, median: MEDIANS.costPer25 })}></script>
  <script>
    const { costs, median } = JSON.parse(document.getElementById("calc-data")!.textContent!);
    const form = document.querySelector<HTMLFormElement>("[data-calc]")!;
    const o = (k: string) => document.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    function run() {
      const v = (n: string) => parseFloat((form.elements.namedItem(n) as HTMLInputElement).value);
      const price = v("price"), servings = v("servings"), protein = v("protein");
      if (!(price > 0 && servings > 0 && protein > 0)) return;
      const per = price / servings;
      const per25 = (per / protein) * 25;
      o("serving").textContent = `$${per.toFixed(2)}`;
      o("per25").textContent = `$${per25.toFixed(2)}`;
      o("perg").textContent = `${((per / protein) * 100).toFixed(1)}¢`;
      if (costs.length) {
        const cheaper = costs.filter((c: number) => c < per25).length;
        const pct = Math.round((1 - cheaper / costs.length) * 100);
        o("verdict").textContent = `That is ${per25 <= median ? "cheaper" : "more expensive"} than the database median of $${median.toFixed(2)} per 25 g. It beats ${pct}% of the ${costs.length} priced powders we track.`;
      }
    }
    form.addEventListener("input", run);
    run();
  </script>
</Layout>
