      "Three flavors"
    ],
    "bottomLine": "Pay more for a certified isolate with no artificial sweetener.",
    "specs": {
      "Protein / serving": "25 g (brand label)",
      "Cost per 25 g": "About $1.82-2.60",
      "Third-party tested": "NSF Certified for Sport (brand)",
      "Best for": "Certified, no sucralose"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
