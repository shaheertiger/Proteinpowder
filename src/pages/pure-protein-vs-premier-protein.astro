---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Premier Protein Powder Review",
    "url": "/premier-protein-powder-review/"
  },
  {
    "title": "Premier Protein vs Ensure",
    "url": "/premier-protein-vs-ensure/"
  },
  {
    "title": "MuscleTech Protein Powder Review",
    "url": "/muscletech-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-18", modified: "2026-11-18" });
const title = "Pure Protein vs Premier Protein: Which Shake Is Better?";
const description =
  "Both shakes give 30 g protein; Pure Protein has 140 calories and 4 g fiber vs Premier's 160, but Premier is cheaper per 25 g on Amazon. Powders compared too.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "pure-protein-vs-premier-protein-pure-shake-chocolate-12pk",
