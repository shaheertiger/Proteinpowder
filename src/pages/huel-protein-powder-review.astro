---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Owyn Protein Powder Review",
    "url": "/owyn-protein-powder-review/"
  },
  {
    "title": "Vega Protein Powder Review",
    "url": "/vega-protein-powder-review/"
  },
  {
    "title": "Whey vs Plant Protein",
    "url": "/whey-vs-plant-protein/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Huel Protein Powder Review: Complete Protein or Black Edition, and When a Meal Beats a Shake";
const description =
  "Huel protein powder review: Complete Protein vs Black Edition label-checked, cost per 25 g, sweeteners and testing, and who should buy a plain protein instead.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "huel-complete-protein",
    "name": "Huel Complete Protein",
    "brand": "Huel",
    "badge": "Best Huel Protein Powder",
    "category": "Plant protein powder with vitamins and minerals",
    "description": "Complete Protein is Huel's dedicated protein powder. Huel's US label lists a 29 g scoop with 20 g of protein from pea, faba bean and brown rice protein, about 110 calories, 0 g of sugar and 27 added vitamins and minerals. It is sweetened with sucralose in the US formula. It suits vegan buyers who want a lean shake with micronutrients rather than a meal.",
    "pros": [
      "20 g of plant protein in about 110 calories, per the label",
      "27 vitamins and minerals added",
      "0 g sugar and a blended protein source",
      "Sold by Huel Inc on Amazon and direct with subscription savings"
