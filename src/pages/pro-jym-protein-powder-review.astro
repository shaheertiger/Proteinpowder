---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Optimum Nutrition Protein Powder Review",
    "url": "/optimum-nutrition-protein-powder-review/"
  },
  {
    "title": "Dymatize Protein Powder Review",
    "url": "/dymatize-protein-powder-review/"
  },
  {
    "title": "Muscle Milk Protein Powder Review",
    "url": "/muscle-milk-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-17", modified: "2026-11-17" });
const title = "Pro JYM Protein Powder Review: Whey, Casein or Both?";
const description =
  "Both: Pro JYM blends 8.5 g whey isolate with casein and milk protein isolate for 24 g per scoop, about $1.74 per 25 g. No sport certification claimed.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "pro-jym-review-tahitian-vanilla-45",
    "name": "Pro JYM Tahitian Vanilla Bean, 3.6 lb (45 Servings)",
    "brand": "JYM Supplement Science",
    "badge": "Best Value Pro JYM",
    "category": "Whey isolate and casein blend",
