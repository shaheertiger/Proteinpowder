---
import Layout from "../layouts/Layout.astro";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import { AUTHORS, DEFAULT_AUTHOR, SITE_URL } from "../data/authors";
import { SITE_NAME } from "../data/site";

const title = "How We Test";
const description =
  "How we evaluate protein powders: the label checks, cost per gram of protein, third-party certification, how we handle affiliate links, and what our verdicts mean.";

const author = AUTHORS[DEFAULT_AUTHOR];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "How We Test", item: `${SITE_URL}/how-we-test/` },
      ],
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      url: `${SITE_URL}/how-we-test/`,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
  ],
};

const STEPS = [
  {
    n: "01",
    title: "We start from the goal, not the bestseller list",
    body: "Every guide begins with what the reader is trying to do — hit a protein target on a budget, avoid dairy, pass a sports drug test, find something that does not upset their stomach. The shortlist comes from what that goal demands, not from what is selling well this week.",
  },
  {
    n: "02",
    title: "We read the whole nutrition panel",
    body: "Protein per serving, serving size in grams, and protein as a share of the scoop — a 30 g scoop with 25 g of protein is a different product from a 45 g scoop with the same 25 g. We read the full ingredient list for sweeteners, thickeners, added sugars and fillers, and we check flavours separately because the numbers change between them.",
  },
  {
    n: "03",
    title: "We work out the cost per 25 g of protein",
    body: "Price per tub is meaningless when serving sizes and protein content vary this much. We divide the typical retail price by the grams of protein in the container and compare products on cost per 25 g of protein — the number that actually tells you what you are paying for.",
  },
  {
    n: "04",
    title: "We check who else has checked it",
    body: "Supplements are not approved before sale, so independent verification matters. We look for third-party certification such as NSF Certified for Sport or Informed Sport / Informed Choice, which test for banned substances and label accuracy, and we look up the specific product in the certifier's database rather than trusting a logo on a web page.",
  },
  {
    n: "05",
    title: "We look for the tricks",
    body: "Amino spiking (padding the protein number with cheap free amino acids such as glycine or taurine), proprietary blends that hide quantities, \"protein blends\" that are mostly the cheapest ingredient, and serving sizes chosen to flatter the label. A powder that relies on any of these does not get recommended.",
  },
  {
    n: "06",
    title: "We publish the trade-offs",
    body: "Every product in every guide gets a cons list, and it is never padded with fake weaknesses. If a product is wrong for the reader most likely to buy it — too much lactose, sweeteners that cause trouble, a price that is mostly branding — that goes in the verdict.",
  },
];
---

<Layout title={title} description={description} jsonLd={schema}>
  <article class="max-w-3xl mx-auto px-4 py-16 lg:py-24">
    <p class="text-xs font-black uppercase tracking-widest text-[#FF4500] mb-4">Editorial Standards</p>
    <h1 class="text-4xl lg:text-5xl font-black text-gray-900 leading-tight mb-6">How We Test</h1>
    <p class="text-xl text-gray-600 leading-relaxed mb-10">
      Anyone can rank the top ten sellers on a retail site and call it a review. Here is what we check instead, what we will not do, and how we make money — so you can judge our recommendations for yourself.
    </p>

    <div class="space-y-8 mb-14">
      {STEPS.map((step) => (
        <div class="flex gap-5">
          <span class="text-sm font-black text-[#1E90FF] pt-1 shrink-0 tabular-nums">{step.n}</span>
          <div>
            <h2 class="text-xl font-black text-gray-900 mb-2">{step.title}</h2>
            <p class="text-gray-700 leading-relaxed m-0">{step.body}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-black text-gray-900 mb-4">How we handle money</h2>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8 space-y-4 mb-14">
      <p class="text-gray-700 leading-relaxed m-0">
        <strong class="text-gray-900">We earn commission on some links.</strong> When you buy through a link in one of our guides we may receive a share of the sale at no additional cost to you, as a participant in the Amazon Services LLC Associates Program. That commission is identical across the products in a guide, so it cannot influence which product we rank first.
      </p>
      <p class="text-gray-700 leading-relaxed m-0">
        <strong class="text-gray-900">We do not sell coverage.</strong> No brand can pay to appear in a guide, to move up a ranking, or to have a criticism removed. We do not run sponsored reviews, and no brand sees a guide before it is published.
      </p>
      <p class="text-gray-700 leading-relaxed m-0">
        <strong class="text-gray-900">Label figures come from the label.</strong> Protein, calorie and serving figures are taken from the manufacturer's nutrition panel at the time of writing and vary by flavour and by reformulation. The tub in your hand is always the authority.
      </p>
    </div>

    <h2 class="text-2xl font-black text-gray-900 mb-4">What our guides are not</h2>
    <p class="text-gray-700 leading-relaxed mb-14">
      Our guides explain published nutrition research and what is on the label. They are not medical or dietary advice for you personally. If you have kidney disease, are pregnant or breastfeeding, have a food allergy, or take medication, speak to a doctor or registered dietitian before adding a supplement.
    </p>

    <h2 class="text-2xl font-black text-gray-900 mb-4">When we get it wrong</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Formulas change, certifications lapse, and sometimes we simply miss something. If a guide is wrong, tell us and we will correct it and note the change. Guides are revisited when a product is reformulated or discontinued, when a certification changes, or when readers report a problem we did not see.
    </p>
    <p class="text-gray-700 leading-relaxed mb-14">
      Corrections and questions go to <a href="/contact/" class="text-[#1E90FF] font-bold no-underline hover:underline">our contact page</a>.
    </p>

    <div class="bg-gray-900 text-white rounded-2xl p-8">
      <div class="flex items-start gap-4">
        <AuthorAvatar author={author.slug} size={56} />
        <div>
          <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-1">Who writes the guides</p>
          <p class="text-lg font-black text-white mb-2">{author.name}, {author.role}</p>
          <p class="text-gray-300 text-sm leading-relaxed m-0">{author.short}</p>
          <p class="mt-3 m-0">
            <a href={`/authors/${author.slug}/`} class="text-[#38BDF8] font-bold text-sm no-underline hover:underline">Read the full profile &rarr;</a>
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>
