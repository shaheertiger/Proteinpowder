const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Vanilla Protein Powder",
          item: `${SITE_URL}/best-vanilla-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best vanilla protein powder overall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Dymatize ISO100 Gourmet Vanilla. It gives about 25 g of protein for roughly 110 to 120 calories per scoop per the label, dissolves cleanly in smoothies and iced coffee, is very low in lactose and carries Informed Choice certification per Dymatize. Choose Gold Standard Vanilla Ice Cream instead if lowest cost per gram matters most."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best vanilla protein powder for baking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A whey and casein blend such as PEScience Select Gourmet Vanilla, because casein holds moisture and gives a softer crumb than pure isolate. Replace a quarter to a third of the flour, add moisture with yogurt, banana or pumpkin, and bake slightly less. Naked's coconut-sugar vanilla is the alternative if you want a sweetener that behaves like sugar."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put vanilla protein powder in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Iced coffee is easiest: froth the powder with cold milk and pour it over cold brew. For hot coffee, let it cool for a few minutes and mix the powder into a little cold milk first, because whey clumps in near-boiling liquid. A thin isolate with mild sweetness, such as Momentous or ISO100, dissolves best."
          }
        },
        {
          "@type": "Question",
          "name": "Which vanilla protein powder has no artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Transparent Labs French Vanilla uses stevia, Momentous Vanilla uses monk fruit and stevia, Orgain Vanilla Bean uses stevia, and Naked Vanilla Whey uses organic coconut sugar, per their ingredient lists at the time of writing. If you want no sweetener at all, use unflavored whey with vanilla extract and sweeten to taste yourself."
          }
        },
        {
          "@type": "Question",
          "name": "Is vanilla protein powder healthier than chocolate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nutritionally they are close; chocolate usually adds a few calories and grams of carbohydrate from cocoa. The bigger difference is heavy metals: the Clean Label Project's 2025 report found chocolate powders carried about four times the lead and far more cadmium than vanilla on average. Daily drinkers can lower exposure by choosing vanilla or rotating flavors."
          }
