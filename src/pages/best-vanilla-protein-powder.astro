const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Best Vanilla Protein Powder: Picks That Work in Baking, Smoothies and Coffee";
const description =
  "The best vanilla protein powder for baking, smoothies and coffee, compared on protein, sweetener (sucralose, stevia, monk fruit or sugar) and cost per 25 g.";

