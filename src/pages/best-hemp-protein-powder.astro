                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fiber per 30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 6-8 g</td>
                    <td class="px-4 py-4 text-gray-700">Usually under 2 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Limiting amino acid</td>
                    <td class="px-4 py-4 text-gray-700">Lysine</td>
                    <td class="px-4 py-4 text-gray-700">Methionine</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Processing</td>
                    <td class="px-4 py-4 text-gray-700">Pressed and milled seed</td>
