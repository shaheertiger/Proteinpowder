---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Isopure Protein Powder Review",
    "url": "/isopure-protein-powder-review/"
  },
  {
    "title": "Clean Simple Eats Protein Powder Review",
    "url": "/clean-simple-eats-protein-powder-review/"
  },
  {
    "title": "SEEQ Protein Powder Review",
    "url": "/seeq-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-20", modified: "2026-11-20" });
const title = "Isopure Clear Protein Powder Review: Is It Third-Party Tested?";
const description =
  "No NSF or Informed Sport listing that we could find. Isopure Clear gives 20 g of whey isolate in 90 calories, stevia-sweetened, at about $2.22 per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "isopure-clear-protein-powder-review-isopure-clear-36",
    "name": "Isopure Clear Whey Isolate Protein Powder, 1.9 lb (about 36 servings)",
    "brand": "Isopure",
    "badge": "Best Value Isopure Clear",
    "category": "Clear whey protein isolate",
    "description": "The big tub is the cheapest way to buy Isopure Clear. Each 25 g scoop gives 20 g of protein from whey protein isolate for 90 calories, 0 g of fat, 2 g of carbohydrate and 15 mg of sodium, per the Citrus Lemonade label at the time of writing; carbs run 2 to 3 g by flavor. It is sweetened with steviol glycosides and naturally flavored. At the Amazon price we saw on November 20, 2026 ($63.99), it works out to about $2.22 per 25 g of protein.",
    "pros": [
      "20 g of whey isolate protein for 90 calories",
      "Stevia-sweetened, no artificial sweeteners or flavors, per Isopure",
      "Four- or five-ingredient label with 0 g added sugar",
