                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Extra calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Extra carbs</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Potassium</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Taste</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Banana-flavored whey (1 scoop)</td>
                    <td class="px-4 py-4 text-gray-700">None beyond the scoop</td>
                    <td class="px-4 py-4 text-gray-700">About 2-3 g</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">Candy-style banana</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Unflavored whey + medium banana</td>
                    <td class="px-4 py-4 text-gray-700">About 105</td>
                    <td class="px-4 py-4 text-gray-700">About 27 g</td>
                    <td class="px-4 py-4 text-gray-700">About 420 mg</td>
                    <td class="px-4 py-4 text-gray-700">Fresh banana</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Real banana powder blend (1 scoop)</td>
                    <td class="px-4 py-4 text-gray-700">Included</td>
                    <td class="px-4 py-4 text-gray-700">About 7 g total</td>
