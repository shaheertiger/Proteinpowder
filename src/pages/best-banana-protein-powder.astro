const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Banana Protein Powder",
          item: `${SITE_URL}/best-banana-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best banana protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Optimum Nutrition Gold Standard Banana Cream, which gives about 24 g of protein per scoop at a low cost per gram. Truvani Banana Cinnamon is best if you want real banana on the label, Isopure Banana Cream is best for low carb, and unflavored whey plus a frozen banana makes the best-tasting shake."
          }
        },
        {
          "@type": "Question",
          "name": "Does banana protein powder contain real banana?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Most banana protein powders use natural or artificial banana flavor, and the fruit appears only in the name. A few, such as Truvani Banana Cinnamon, list banana powder as an ingredient. Look for banana powder, dried banana or freeze-dried banana on the ingredient list to be sure."
          }
        },
        {
          "@type": "Question",
          "name": "Is it better to add a real banana to protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For taste, usually yes: a frozen banana blended with unflavored or vanilla protein tastes fuller than banana flavoring. It also adds about 105 calories, 27 g of carbs and roughly 420 mg of potassium. That is ideal after training, less ideal on a low-carb plan or a tight calorie budget."
          }
        },
        {
          "@type": "Question",
          "name": "Why does banana protein powder taste artificial?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Banana flavoring leans on isoamyl acetate, a sweet ester that tastes like banana sweets more than fresh fruit, and protein sweeteners amplify it. Mixing with milk, adding cinnamon or peanut butter, and serving it very cold all make it taste rounder. If you still dislike it, switch to a real-banana blend."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a banana protein powder without sucralose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Truvani Banana Cinnamon uses monk fruit only, and Jocko Molk Banana Cream uses allulose, monk fruit and Reb M, with no sucralose or ace-K. If you want no sweetener at all, use unflavored whey with a real banana, which sweetens the shake by itself."
          }
        },
        {
          "@type": "Question",
          "name": "Can I bake with banana protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Replace no more than about a quarter to a third of the flour with protein powder, keep mashed real banana as the main moisture, and check the bake a few minutes early because protein dries out faster than flour. Whey-casein blends and plant proteins tend to stay moister than pure whey isolate."
          }
        },
        {
          "@type": "Question",
          "name": "Is banana protein powder safe for people with kidney disease?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flavored banana powders contain little potassium, but real banana does, and protein intake itself may need to be limited with kidney disease. Anyone with kidney disease, or on medication that affects potassium, should ask their doctor or a registered dietitian before adding banana or a protein shake to their routine."
