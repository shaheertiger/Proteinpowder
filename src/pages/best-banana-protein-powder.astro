                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">ON Gold Standard Banana Cream</td>
                    <td class="px-4 py-4 text-gray-700">About 24 g</td>
                    <td class="px-4 py-4 text-gray-700">Flavoring</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose, ace-K</td>
                    <td class="px-4 py-4 text-gray-700">Everyday value</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Truvani Banana Cinnamon</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">Organic banana powder</td>
                    <td class="px-4 py-4 text-gray-700">Monk fruit</td>
                    <td class="px-4 py-4 text-gray-700">Real banana, vegan</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Zero Carb Banana Cream</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">Flavoring</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose</td>
                    <td class="px-4 py-4 text-gray-700">Low carb</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Jocko Molk Banana Cream</td>
                    <td class="px-4 py-4 text-gray-700">About 22 g</td>
                    <td class="px-4 py-4 text-gray-700">Natural flavor</td>
                    <td class="px-4 py-4 text-gray-700">Allulose, monk fruit, Reb M</td>
                    <td class="px-4 py-4 text-gray-700">No artificial sweeteners</td>
                  </tr>
