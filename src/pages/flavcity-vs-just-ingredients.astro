---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "FlavCity vs Clean Simple Eats",
    "url": "/flavcity-vs-clean-simple-eats/"
  },
  {
    "title": "Clean Simple Eats vs Just Ingredients",
    "url": "/clean-simple-eats-vs-just-ingredients/"
  },
  {
    "title": "Orgain vs Truvani",
    "url": "/orgain-vs-truvani/"
  },
  {
    "title": "Levels vs Ascent Protein",
    "url": "/levels-vs-ascent-protein/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "FlavCity vs Just Ingredients: Which Collagen Blend Wins?";
const description =
  "Just Ingredients wins for most: about $2.46 per 25 g of protein vs $3.00 for FlavCity, and five flavors are NSF-listed. FlavCity suits a breakfast shake.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "flavcity-vs-just-ingredients-just-ingredients-protein",
    "name": "Just Ingredients Protein Powder, French Vanilla",
    "brand": "Just Ingredients",
    "badge": "Best Value and NSF-Listed Flavors",
    "category": "Grass-fed whey concentrate, collagen, pea and chia blend",
    "description": "Per the brand-site label at the time of writing, a 35.5 g scoop of French Vanilla gives 22 g of protein, 160 calories, 5 g of carbohydrate, 1 g of sugar, 7 g of fat and 125 mg of sodium, sweetened with organic monk fruit. At $64.99 for 30 servings on justingredients.us (checked 1 November 2026) it costs about $2.46 per 25 g. Five other flavors, including Chocolate and Vanilla Bean, are in the NSF Certified for Sport registry.",
    "pros": [
      "About $2.46 per 25 g, roughly 18% less than FlavCity",
      "About 62% protein by weight, the denser scoop of the two",
      "Five flavors listed by NSF Certified for Sport",
      "Monk fruit only in French Vanilla; no gums; Label Score 43 / 100"
    ],
    "cons": [
      "Collagen share of the 22 g is not disclosed",
      "7 g of fat per scoop; declares coconut",
      "French Vanilla itself is not on the NSF registry"
    ],
    "bottomLine": "The better buy for most people: more protein per dollar and per gram of powder, with certified flavors you can look up. Skip it if you avoid coconut or want a low-fat shake.",
    "specs": {
      "Protein / serving": "22 g in 35.5 g (label)",
      "Calories": "About 160",
      "Third-party testing": "NSF Certified for Sport (5 flavors, per registry)",
      "Cost per 25 g": "About $2.46 ($64.99, 30 servings, brand site)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0D1W2865C"
  },
  {
    "id": "flavcity-vs-just-ingredients-flavcity-chocolate",
    "name": "FlavCity All-in-One Protein Smoothie, Chocolate",
    "brand": "FlavCity",
    "badge": "Best Breakfast Smoothie",
    "category": "Grass-fed whey, collagen and milk protein smoothie mix",
    "description": "Per the brand's nutrition panel at the time of writing, a 49.5 g scoop of Chocolate gives 25 g of protein, 200 calories, 13 g of carbohydrate, 3 g of fiber, 3 g of sugar, 4 g of fat and 200 mg of sodium, sweetened with stevia. FlavCity says about 10 g of each scoop is grass-fed collagen. At $59.99 for 20 servings on shopflavcity.com (checked 19 November 2026) it costs about $3.00 per 25 g; its Amazon store listed $50.99.",
    "pros": [
      "Full 25 g of protein in one scoop, with 3 g of fiber",
      "States its collagen dose: about 10 g per scoop",
      "Stevia only, 0 g added sugar per FlavCity",
      "Sold at its own store, Amazon, Target and TikTok Shop"
    ],
    "cons": [
      "About $3.00 per 25 g at the brand-site price",
      "Only about 51% protein by weight; roughly 15 g complete protein",
      "No third-party certification; Prop 65 notice; Label Score 23 / 100"
    ],
    "bottomLine": "Worth it only if you want one scoop to cover breakfast, collagen included. Skip it if you are drug tested or want the most protein for your money.",
    "specs": {
      "Protein / serving": "25 g in 49.5 g (label)",
      "Calories": "About 200",
      "Third-party testing": "None claimed or found",
      "Cost per 25 g": "About $3.00 ($59.99, 20 servings, brand site)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0C5FJ9GHD"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "FlavCity vs Just Ingredients",
          item: `${SITE_URL}/flavcity-vs-just-ingredients/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "FlavCity vs Just Ingredients: which is better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most buyers, Just Ingredients. It costs about $2.46 per 25 g of protein against $3.00 for FlavCity at brand-site prices, it is about 62 percent protein by weight against 51 percent, and five of its flavors are in the NSF Certified for Sport registry. FlavCity is better if you want a breakfast-style smoothie with fruit, fiber and a stated 10 g of collagen."
          }
        },
        {
          "@type": "Question",
          "name": "Is Just Ingredients protein NSF certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some flavors are. The NSF Certified for Sport registry listed Chocolate, Creamy Peanut Butter Chocolate, Snickerdoodle, Strawberries and Cream and Vanilla Bean when our database was checked on 1 November 2026. French Vanilla was not listed, despite an NSF logo on its bag image. Search the registry for your exact flavor before relying on it."
          }
        },
        {
          "@type": "Question",
          "name": "Is FlavCity protein third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not that we could find. FlavCity's product pages make no testing claim, and we found no NSF Certified for Sport, Informed Sport or Clean Label Project listing. The bag carries a California Prop 65 notice for lead and cadmium, which is a legal warning rather than a test result. Drug-tested athletes should choose a certified product instead."
          }
        },
        {
          "@type": "Question",
          "name": "Do FlavCity and Just Ingredients both have collagen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. FlavCity says about 10 g of each 25 g scoop is grass-fed collagen. Just Ingredients lists grass-fed collagen third in its French Vanilla ingredients but does not publish the amount. Collagen counts toward the protein total but lacks tryptophan and is low in leucine, so it does less for muscle than whey."
          }
        },
        {
          "@type": "Question",
          "name": "Which has fewer calories, FlavCity or Just Ingredients?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Just Ingredients, per scoop and per gram of protein. A scoop is 160 calories against FlavCity's 200, per the labels at the time of writing. Scaled to 25 g of protein, Just Ingredients is about 182 calories and FlavCity 200. Just Ingredients has more fat, 7 g against 4 g, while FlavCity has far more carbohydrate, 13 g against 5 g."
          }
        },
        {
          "@type": "Question",
          "name": "What sweeteners do FlavCity and Just Ingredients use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FlavCity Chocolate uses organic stevia leaf extract (Reb A) and stevia Reb M. Just Ingredients French Vanilla lists organic monk fruit extract only, though other flavors and some retailer listings have shown stevia plus monk fruit. Neither lists sucralose, acesulfame potassium or sugar alcohols on the panels we read."
          }
        },
        {
          "@type": "Question",
          "name": "Where can you buy FlavCity and Just Ingredients?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FlavCity lists its own store, Amazon, Target and TikTok Shop as authorized retailers; Costco is not on that list. Just Ingredients sells through its own site, Amazon, Whole Foods Market, Sprouts and Target, per our review. On Amazon, check the seller and compare the listed panel with the brand's, since protein figures have differed."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "flavcity vs just ingredients",
      "just ingredients vs flavcity",
      "flavcity protein smoothie vs just ingredients protein powder",
      "flavcity protein vs just ingredients protein",
      "flavcity protein smoothie",
      "just ingredients protein powder"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Clean Protein Picks",
    link: "/best-clean-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">FlavCity vs Just Ingredients</Fragment>
      FlavCity and Just Ingredients both sell grass-fed whey blends with collagen built in, both skip artificial sweeteners, and both grew out of a food or wellness personality's following. Here is how the two labels, prices and testing records actually compare.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Two Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#collagen">How Much Is Collagen</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#meal">Meal or Supplement</a>
      <a href="#pros-cons">Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Just Ingredients is the better buy for most people: it costs about $2.46 per 25 g of protein against $3.00 for the FlavCity Protein Smoothie at brand-site prices, it is denser in protein, and five of its flavors sit in the NSF Certified for Sport registry. FlavCity wins only if you want one scoop to stand in for a blended breakfast. Below we compare the collagen in each scoop, the cost math, testing, sweeteners and buyer-reported taste.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. FlavCity vs Just Ingredients: The Short Answer
          </h2>

          <p>
            Just Ingredients is the better protein powder and FlavCity is the more complete smoothie mix. Per the labels at the time of writing, a Just Ingredients French Vanilla scoop gives 22 g of protein in 35.5 g of powder for 160 calories, while a FlavCity Chocolate scoop gives 25 g in 49.5 g for 200 calories. Just Ingredients costs about 18 percent less per gram of protein and is the only one of the two with flavors you can look up in a certification registry.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">FlavCity Protein Smoothie</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Just Ingredients Protein Powder</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 49.5 g (51%)</td>
                    <td class="px-4 py-4 text-gray-700">22 g in 35.5 g (62%)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Collagen</td>
                    <td class="px-4 py-4 text-gray-700">About 10 g per scoop, per FlavCity</td>
                    <td class="px-4 py-4 text-gray-700">Included, amount not disclosed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $3.00 (brand site)</td>
                    <td class="px-4 py-4 text-gray-700">About $2.46 (brand site)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sport certification</td>
                    <td class="px-4 py-4 text-gray-700">None claimed or found</td>
                    <td class="px-4 py-4 text-gray-700">5 flavors in NSF Certified for Sport registry</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweetener</td>
                    <td class="px-4 py-4 text-gray-700">Stevia (Reb A and Reb M)</td>
                    <td class="px-4 py-4 text-gray-700">Monk fruit (French Vanilla)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">23 / 100</td>
                    <td class="px-4 py-4 text-gray-700">43 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Just Ingredients for value and verification; pick FlavCity for a ready-made breakfast.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Just Ingredients if</strong> you want more protein per dollar, a denser scoop, a monk-fruit option, or a flavor listed by NSF Certified for Sport. <strong>Pick FlavCity if</strong> you want banana, coconut milk and fiber already in the bag so one scoop with milk replaces breakfast, and you like stevia. <strong>Pick neither if</strong> you want pure whey protein with no collagen counted in the total.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare FlavCity and Just Ingredients at a Glance
          </h2>

          <p>
            The fastest way to decide is to name the job the scoop has to do. If it is a daily protein top-up, Just Ingredients does more of it for less money. If it is breakfast in a shaker bottle, FlavCity carries the carbohydrate and fiber a breakfast needs. The table pairs each with the buyer it suits and the buyer who should pass, plus the two numbers we publish for every product: the <a href='/methodology/'>Label Score</a> out of 100 and the cost per 25 g of protein.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/just-ingredients-protein-powder/'>Just Ingredients Protein Powder</a></td>
                    <td class="px-4 py-4 text-gray-700">Daily shakes, drug-tested buyers on a listed flavor, stevia avoiders</td>
                    <td class="px-4 py-4 text-gray-700">You count fat grams or avoid coconut</td>
                    <td class="px-4 py-4 text-gray-700">43</td>
                    <td class="px-4 py-4 text-gray-700">About $2.46</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/flavcity-protein-smoothie/'>FlavCity Protein Smoothie</a></td>
                    <td class="px-4 py-4 text-gray-700">A one-scoop breakfast with fruit, fiber and collagen</td>
                    <td class="px-4 py-4 text-gray-700">You are drug tested or watch cost per gram</td>
                    <td class="px-4 py-4 text-gray-700">23</td>
                    <td class="px-4 py-4 text-gray-700">About $3.00</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The 20-point Label Score gap has three main causes. Just Ingredients carries more protein per gram of powder, it costs less per 25 g, and some of its flavors hold a sport certification while FlavCity has none. FlavCity's score is also pulled down by its low protein density, which is the price of putting banana powder, coconut milk powder and cocoa into the scoop. A low score does not mean FlavCity is unsafe; it means less of what you pay for is protein.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which FlavCity and Just Ingredients Products Are We Comparing?
          </h2>

          <p>
            Each brand sells one core whey formula in many flavors, so we compare the flagship from each: the FlavCity All-in-One Protein Smoothie in Chocolate and Just Ingredients Protein Powder in French Vanilla. Those are the flavors with a readable panel and a visible price on the brand sites when our database was checked (19 November 2026 for FlavCity, 1 November 2026 for Just Ingredients). Prices will move. Both cards link to the full label pages in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            These are the full label figures for each flagship flavor, per each brand's nutrition panel at the time of writing. FlavCity's figures come from the Chocolate bag's nutrition facts and bag-back images on shopflavcity.com, re-read on 19 November 2026. Just Ingredients' figures come from the French Vanilla nutrition panel on justingredients.us, checked on 1 November 2026. Other flavors differ slightly.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">FlavCity (Chocolate)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Just Ingredients (French Vanilla)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Scoop size</td>
                    <td class="px-4 py-4 text-gray-700">49.5 g</td>
                    <td class="px-4 py-4 text-gray-700">35.5 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">51%</td>
                    <td class="px-4 py-4 text-gray-700">62%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">200</td>
                    <td class="px-4 py-4 text-gray-700">160</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">13 g</td>
                    <td class="px-4 py-4 text-gray-700">5 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fiber</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                    <td class="px-4 py-4 text-gray-700">Under 1 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar</td>
                    <td class="px-4 py-4 text-gray-700">3 g (0 g added, per brand)</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat</td>
                    <td class="px-4 py-4 text-gray-700">4 g</td>
                    <td class="px-4 py-4 text-gray-700">7 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sodium</td>
                    <td class="px-4 py-4 text-gray-700">200 mg</td>
                    <td class="px-4 py-4 text-gray-700">125 mg</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein sources</td>
                    <td class="px-4 py-4 text-gray-700">Whey concentrate, collagen, milk protein concentrate, yeast protein</td>
                    <td class="px-4 py-4 text-gray-700">Whey concentrate, collagen, pea protein, chia protein</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweeteners</td>
                    <td class="px-4 py-4 text-gray-700">Organic stevia (Reb A), stevia (Reb M)</td>
                    <td class="px-4 py-4 text-gray-700">Organic monk fruit extract</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
