  },
  {
    "id": "walgreens-protein-powder-on-gold-standard-small",
    "name": "Optimum Nutrition Gold Standard 100% Whey, Double Rich Chocolate, 0.68 lb",
    "brand": "Optimum Nutrition",
    "badge": "Best Name Brand at Walgreens",
    "category": "Whey isolate, concentrate and peptide blend",
