---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "CVS Protein Powder",
    "url": "/cvs-protein-powder/"
  },
  {
    "title": "Equate Protein Powder",
    "url": "/equate-protein-powder/"
  },
  {
    "title": "Best Target Protein Powder",
    "url": "/best-target-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Walgreens Protein Powder: Store-Brand Whey vs Amazon Prices";
const description =
  "Yes: Walgreens sells its own 32 oz whey with 30 g protein, about $1.39 per 25 g at $29.99. Name brands there cost up to 70% more than on Amazon. Full list.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "walgreens-protein-powder-walgreens-whey-blend",
    "name": "Walgreens Whey Protein Powder Blend, Vanilla or Chocolate, 32 oz",
    "brand": "Walgreens",
    "badge": "Walgreens Store Brand",
