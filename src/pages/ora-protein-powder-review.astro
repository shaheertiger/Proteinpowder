                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Benchmark</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Lead per day</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Where it comes from</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Prop 65 warning level</td>
                    <td class="px-4 py-4 text-gray-700">0.5 mcg</td>
