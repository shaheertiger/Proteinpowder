const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-27", modified: "2026-11-27" });
const title = "Kroger Protein Powder: Simple Truth Whey and 5 Best Picks";
const description =
  "Yes, Kroger has its own: Simple Truth Grass Fed Whey, 19 g protein a scoop, $19.99 for 13.5 oz (about $1.65 per 25 g). No third-party seal found.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "kroger-simple-truth-grass-fed-whey",
    "name": "Simple Truth Grass Fed Whey Protein Powder (Vanilla, 13.5 oz)",
    "brand": "Simple Truth",
    "badge": "Best Kroger Protein Powder",
    "category": "Whey (Kroger house brand)",
