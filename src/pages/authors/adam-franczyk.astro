---
import Layout from "../../layouts/Layout.astro";
import AuthorAvatar from "../../components/AuthorAvatar.astro";
import { AUTHORS, SITE_URL, authorSchema } from "../../data/authors";
import { SITE_NAME } from "../../data/site";

const author = AUTHORS["adam-franczyk"];
const title = `${author.name} — ${author.role}`;
const description = `${author.name} at ${SITE_NAME}. ${author.short}`;

const GUIDES = [
  { title: "Best Protein Powder", url: "/best-protein-powder/" },
  { title: "Best Whey Protein Isolate", url: "/best-whey-protein-isolate/" },
  { title: "Best Plant-Based Protein Powder", url: "/best-plant-based-protein-powder/" },
  { title: "How Much Protein Do I Need?", url: "/how-much-protein-do-i-need/" },
  { title: "Is Protein Powder Safe?", url: "/is-protein-powder-safe/" },
  { title: "Whey vs Whey Isolate", url: "/whey-vs-whey-isolate/" },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "About", item: `${SITE_URL}/about/` },
        { "@type": "ListItem", position: 3, name: author.name, item: `${SITE_URL}/authors/${author.slug}/` },
      ],
    },
    {
      "@type": "ProfilePage",
      name: title,
      description,
      url: `${SITE_URL}/authors/${author.slug}/`,
      mainEntity: authorSchema(author.slug),
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={schema}>
  <article class="max-w-3xl mx-auto px-4 py-16 lg:py-24">
    <div class="flex items-center gap-5 mb-8">
      <AuthorAvatar author={author.slug} size={80} />
      <div>
        <p class="text-xs font-black uppercase tracking-widest text-[#FF4500] mb-2">Author</p>
        <h1 class="text-3xl lg:text-4xl font-black text-gray-900 leading-tight m-0">{author.name}</h1>
        <p class="text-gray-500 font-bold uppercase tracking-widest text-xs mt-2 m-0">{author.role}</p>
      </div>
    </div>

    <div class="space-y-4 mb-12">
      {author.bio.map((p) => <p class="text-gray-700 leading-relaxed text-lg m-0">{p}</p>)}
    </div>

    {author.background && (
      <>
        <h2 class="text-2xl font-black text-gray-900 mb-4">Background</h2>
        <ul class="list-none p-0 m-0 mb-6 space-y-3">
          {author.background.map((b) => (
            <li class="bg-gray-50 border border-gray-200 rounded-2xl px-5 py-4">
              <span class="font-black text-gray-900">{b.org}</span>
              <span class="text-gray-700">, {b.role}</span>
              {b.place && <span class="text-gray-500"> · {b.place}</span>}
            </li>
          ))}
        </ul>
        {author.sameAs?.[0] && (
          <p class="text-gray-700 mb-12">Profile: <a href={author.sameAs[0]} rel="noopener" target="_blank" class="text-[#1E90FF] font-bold no-underline hover:underline">LinkedIn</a></p>
        )}
      </>
    )}

    {author.publications && (
      <>
        <h2 class="text-2xl font-black text-gray-900 mb-4">Selected publications</h2>
        <ul class="list-none p-0 m-0 mb-12 space-y-3">
          {author.publications.map((pub) => (
            <li class="bg-gray-50 border border-gray-200 rounded-2xl px-5 py-4">
              <a href={pub.url} rel="noopener" target="_blank" class="font-bold text-gray-900 no-underline hover:text-[#1E90FF]">{pub.title}</a>
              <span class="block text-sm text-gray-500 mt-1">{pub.venue}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <h2 class="text-2xl font-black text-gray-900 mb-4">How he works</h2>
    <p class="text-gray-700 leading-relaxed text-lg mb-12">
      Every guide follows our published <a href="/how-we-test/" class="text-[#1E90FF] font-bold no-underline hover:underline">scoring method and editorial policy</a>. Powders are scored from their supplement-facts panels, dated prices and the certifiers' own registries, and every page says what was checked and what could not be verified. We do not run taste panels or lab tests; taste is reported from buyer reviews.
    </p>

    <h2 class="text-2xl font-black text-gray-900 mb-4">Areas covered</h2>
    <div class="flex flex-wrap gap-2 mb-12">
      {author.beat.map((b) => (
        <span class="bg-gray-50 border border-gray-200 rounded-full px-4 py-2 text-sm font-bold text-gray-700">{b}</span>
      ))}
    </div>

    <h2 class="text-2xl font-black text-gray-900 mb-4">Selected guides</h2>
    <div class="grid sm:grid-cols-2 gap-3 mb-12">
      {GUIDES.map((g) => (
        <a href={g.url} class="bg-gray-50 border border-gray-200 rounded-2xl px-5 py-4 no-underline hover:shadow-md transition-shadow group">
          <span class="text-gray-900 font-bold group-hover:text-[#1E90FF] transition-colors">{g.title}</span>
        </a>
      ))}
    </div>

    {author.disclosure && (
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 mb-8">
        <p class="text-xs font-black uppercase tracking-widest text-amber-700 mb-2">Disclosure</p>
        <p class="text-gray-700 leading-relaxed m-0">{author.disclosure}</p>
      </div>
    )}

    <div class="bg-gray-900 text-white rounded-2xl p-8">
      <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">Editorial independence</p>
      <p class="text-gray-300 leading-relaxed m-0">
        Adam does not accept payment for coverage, and no brand sees a guide before it is published. Our full process and funding model are set out on <a href="/how-we-test/" class="text-[#38BDF8] font-bold no-underline hover:underline">How We Test</a>.
      </p>
    </div>
  </article>
</Layout>
