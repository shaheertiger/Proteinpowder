                    <td class="px-4 py-4 text-gray-700">About 100</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (2 flavors)</td>
                  </tr>
