const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best NSF Certified Protein Powder",
          item: `${SITE_URL}/best-nsf-certified-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What does NSF certified mean on protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It usually refers to NSF Certified for Sport, which means NSF has verified the label contents, screened for contaminants, audited the factory and tested for about 290 banned substances. NSF Contents Certified is a separate mark covering contents and contaminants only, without banned-substance testing. Check which mark the tub carries."
          }
        },
        {
          "@type": "Question",
          "name": "How do I check if a protein powder is NSF certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Search the Certified Products database at nsfsport.com, or use the free NSF Certified for Sport app, by brand or product name. Match the exact product, flavor and market to a listing, then confirm the NSF mark is printed on your tub. If the product is not in the registry, treat it as uncertified."
          }
        },
        {
          "@type": "Question",
          "name": "Is NSF Certified for Sport better than Informed Sport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are generally treated as comparable top-tier programs. Informed Sport tests every batch before release; NSF Certified for Sport adds label-content verification and contaminant screening with ongoing monitoring. Check which programs your league or governing body recognizes, then pick whichever certifies the product you want."
          }
        },
        {
          "@type": "Question",
          "name": "Is Optimum Nutrition Gold Standard NSF certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Partly. When we checked the registry on November 8, 2026, Gold Standard 100% Whey in Double Rich Chocolate and Vanilla Ice Cream were listed as NSF Certified for Sport. Other flavors were not. If certification matters to you, buy one of those flavors and check for the NSF mark on the tub."
          }
        },
        {
          "@type": "Question",
          "name": "Does NSF certification mean a protein powder has no heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No product is completely free of trace heavy metals, since they occur naturally in soil and water. NSF certification means the product stays under NSF's contaminant limits. It does not rank certified products against each other, so if heavy metals are your priority, also look at published independent test results."
          }
        },
        {
          "@type": "Question",
          "name": "Are NSF certified protein powders more expensive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Often, but not always. Thorne, Klean and Momentous are premium-priced, while certified flavors of Optimum Nutrition Gold Standard and Muscle Milk Genuine are among the cheapest well-known powders per gram. Certification is now available at most price points, so it rarely forces a big trade-off."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need NSF certified protein if I am not an athlete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You do not need it, but it is a useful quality filter. Certification confirms that the protein on the label is in the tub and that contaminants are screened, which matters to anyone using a powder daily. If you are not drug tested, NSF Contents Certified or Informed Choice offer similar quality assurance."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
