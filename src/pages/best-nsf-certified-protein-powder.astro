                    <td class="px-4 py-4 text-gray-700">About 80-100</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (4 versions)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">ON Gold Standard 100% Whey</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">About 1-3 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (2 flavors)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Transparent Labs Whey Isolate</td>
                    <td class="px-4 py-4 text-gray-700">About 28 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120-150</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
