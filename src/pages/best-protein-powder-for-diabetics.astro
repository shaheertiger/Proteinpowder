const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Diabetics",
          item: `${SITE_URL}/best-protein-powder-for-diabetics/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for diabetics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A whey isolate or simple plant protein with close to zero sugar and about 5 g of total carbohydrate or less per serving. Isopure Zero Carb is our top pick, with about 25 g of protein and essentially no carbohydrate per the label. Dymatize ISO100 and Quest are good alternatives, and Naked Pea suits people who are dairy-free or want to avoid sweeteners."
          }
        },
        {
          "@type": "Question",
          "name": "Do protein shakes raise blood sugar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A protein-only shake made with water or unsweetened milk usually causes little rise in blood glucose for people with type 2 diabetes, though protein does stimulate insulin. Shakes with maltodextrin, sugar or fruit and juice can raise it significantly. People with type 1 diabetes may see a delayed rise after large protein servings, so monitor readings when starting."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey protein good for type 2 diabetes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey is a reasonable choice for many people with type 2 diabetes. It is low in carbohydrate in isolate form, and a 2014 study in Diabetologia found that whey taken before a high-glycemic breakfast lowered the post-meal glucose response. That was a small study with a large dose. Check with your care team, especially if you have kidney disease."
          }
        },
        {
          "@type": "Question",
          "name": "Is Glucerna better than protein powder for diabetics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do different jobs. Glucerna Original is a meal-style shake with about 10 g of protein, 16 g of carbohydrate and 4 g of fiber per bottle, per retailer labels. A protein powder provides 25 g or more of protein with almost no carbohydrate. Glucerna suits a small meal replacement; a protein powder suits adding protein to a meal or snack."
          }
        },
        {
          "@type": "Question",
          "name": "Which sweeteners are best for diabetics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sucralose, stevia and monk fruit do not raise blood glucose directly in most studies, and the ADA says non-nutritive sweeteners can replace sugar in moderation. Erythritol has been linked to cardiovascular events in an observational 2023 study, though cause was not shown. Maltitol raises glucose more than other sugar alcohols. Unflavored powders let you avoid sweeteners entirely."
          }
        },
        {
          "@type": "Question",
          "name": "Can diabetics replace meals with protein shakes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with care. Structured meal-replacement programs have strong evidence, including the DiRECT trial, where nearly half of participants achieved type 2 remission at 12 months under medical supervision. But replacing meals with low-carb shakes can cause hypoglycemia on insulin or sulfonylureas, so talk to your care team first and use a balanced formula rather than protein and water alone."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein should a diabetic have per day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no special protein target for diabetes alone; the ADA favors individualized plans, and many people do well around the general recommendations. For people with diabetes and chronic kidney disease not on dialysis, the ADA recommends about 0.8 g per kilogram per day. Your doctor or a registered dietitian can set a number based on your kidney function and goals."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

