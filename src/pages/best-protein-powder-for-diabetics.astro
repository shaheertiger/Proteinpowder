const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-01", modified: "2026-11-01" });
const title = "Best Protein Powder for Diabetics: Low-Sugar Picks and What to Check";
const description =
