                    <td class="px-4 py-4 text-gray-700">About 110-120</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">Banned-substance tested, per brand</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Premier Protein Powder Plus Fiber</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">Check label</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Quest Protein Powder (Vanilla Milkshake)</td>
                    <td class="px-4 py-4 text-gray-700">About 24 g</td>
                    <td class="px-4 py-4 text-gray-700">About 110</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fairlife Nutrition Plan (shake)</td>
                    <td class="px-4 py-4 text-gray-700">About 30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 150</td>
                    <td class="px-4 py-4 text-gray-700">About 2 g</td>
