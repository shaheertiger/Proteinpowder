---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Protein Supplements",
    "url": "/best-protein-supplements/"
  },
  {
    "title": "Best Protein Drink",
    "url": "/best-protein-drink/"
  },
  {
    "title": "Best Cheap Protein Powder",
    "url": "/best-cheap-protein-powder/"
  },
  {
    "title": "Best Costco Protein Powder",
    "url": "/best-costco-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best Protein Bars: Ranked by Protein, Sugar Alcohols and Cost per Gram";
const description =
  "The best protein bars ranked on protein per calorie, maltitol vs erythritol, fiber, whey vs collagen protein and cost per 25 g compared with protein powder.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "quest-protein-bar-chocolate-chip-cookie-dough",
    "name": "Quest Protein Bar, Chocolate Chip Cookie Dough",
    "brand": "Quest",
    "badge": "Best Overall",
    "category": "Milk protein bar (erythritol)",
    "description": "Quest's flagship flavor lists 21 g of protein in a 60 g bar for 190 calories, with 1 g of sugar, 12 g of fiber and 6 g of sugar alcohols, per the brand's label at the time of writing. The protein blend is milk protein isolate and whey protein isolate, listed first, and the sugar alcohol is erythritol, which most people tolerate better than maltitol. The fiber is polydextrose, so the bar is filling but can cause gas in larger amounts. Its weakness is price: at $35.49 for 12 on Quest's own site it costs about $3.50 per 25 g of protein, though grocery and club-store prices are often lower.",
    "pros": [
      "21 g of complete dairy protein for 190 calories, per the label",
      "Erythritol instead of maltitol, and only 1 g of sugar",
      "12 g of fiber makes it genuinely filling",
      "Sold almost everywhere, in many flavors"
    ],
    "cons": [
      "About $3.50 per 25 g at the brand-site price",
      "Polydextrose fiber can cause gas if you eat two",
      "Dense, chewy texture that some buyers dislike"
    ],
    "bottomLine": "The best all-round label on the shelf; buy it on sale or in a multipack rather than at full brand-site price.",
    "specs": {
      "Protein per bar": "21 g (label)",
      "Calories": "190",
      "Sugar / sugar alcohols": "1 g / 6 g (erythritol)",
      "Best for": "Most people, low-sugar snacking"
    }
  },
  {
    "id": "kirkland-signature-protein-bar",
    "name": "Kirkland Signature Protein Bars (Chocolate Peanut Butter Chunk)",
    "brand": "Kirkland Signature",
    "badge": "Best Value",
    "category": "Milk protein bar (Costco)",
    "description": "Costco's own-brand bar lists 21 g of protein in a 60 g bar, with listings putting calories at about 180 to 190 depending on flavor, and a protein blend of milk protein isolate and whey protein isolate. A 20-count box has been tracked at roughly $22 to $24 in warehouses in 2026, which works out to about $1.30 to $1.45 per 25 g of protein, level with a mainstream tub of whey. Costco flags a newer formulation, and ingredient lists we found differ on the sweetener, so read the box: the fiber includes isomalto-oligosaccharides, which are partly digestible.",
    "pros": [
      "About $1.30-1.45 per 25 g, as cheap as whey powder",
      "21 g of dairy protein per bar, per the label",
      "Quest-like macros at a fraction of the price"
    ],
    "cons": [
      "Costco membership required for the best price",
      "Formulation has changed; sweetener lists vary by source",
      "Only a few flavors, and stock varies by warehouse"
    ],
    "bottomLine": "If you have a Costco card and eat a bar most days, this is the one to buy.",
    "specs": {
      "Protein per bar": "21 g (label)",
      "Calories": "About 180-190, by flavor",
      "Sugar / sugar alcohols": "Low sugar; check box for sweetener",
      "Best for": "Costco members, daily bar eaters"
    }
  },
  {
    "id": "barebells-protein-bar-salty-peanut",
    "name": "Barebells Protein Bar, Salty Peanut",
    "brand": "Barebells",
    "badge": "Best Tasting (Per Buyers)",
    "category": "Milk protein bar (maltitol)",
    "description": "Barebells is the bar buyers most often describe as tasting like a candy bar rather than a supplement. Salty Peanut lists 20 g of protein for about 200 calories in a 55 g bar, with 1 g of sugar, per retailer labels at the time of writing. The trade-off is the sweetener: a published label for this flavor shows 13 g of sugar alcohols, mainly maltitol, and only about 4 g of fiber. At $27.99 for 12 at Target it costs about $2.90 per 25 g. Eat one, not two, if maltitol bothers you.",
    "pros": [
      "Buyers consistently rate the taste and texture highly",
      "20 g of milk protein per bar",
      "Soft, candy-bar texture rather than a dense chew"
    ],
    "cons": [
      "About 13 g of sugar alcohols, mostly maltitol",
      "Maltitol is the sugar alcohol most likely to cause bloating",
      "About $2.90 per 25 g, more than Kirkland or Pure Protein"
    ],
    "bottomLine": "The bar to buy if taste decides whether you eat it at all, as long as maltitol agrees with you.",
    "specs": {
      "Protein per bar": "20 g (label)",
      "Calories": "About 200",
      "Sugar / sugar alcohols": "1 g / about 13 g (maltitol)",
      "Best for": "Taste first, one bar a day"
    }
  },
  {
    "id": "pure-protein-bar",
    "name": "Pure Protein Bars",
    "brand": "Pure Protein",
    "badge": "Best Supermarket Budget Bar",
    "category": "Protein bar (blend incl. gelatin)",
    "description": "Pure Protein is the cheap bar you can find in nearly every supermarket and drugstore. The Chocolate Peanut Butter bar lists 20 g of protein, 2 g of sugar and about 200 calories in a 50 g bar, per retailer labels at the time of writing, with maltitol and sucralose as sweeteners. At around $15 to $17 for a 12-count box it costs about $1.55 to $1.80 per 25 g. The catch is the protein: ingredient lists we checked include gelatin alongside milk and whey protein, so part of the 20 g is incomplete protein.",
    "pros": [
      "About $1.55-1.80 per 25 g, cheap for a branded bar",
      "Available in most supermarkets and drugstores",
      "20 g protein with low sugar, per the label"
    ],
    "cons": [
      "Part of the protein comes from gelatin",
      "Maltitol can cause bloating, especially beyond one bar",
      "Smaller 50 g bar, so less filling than Quest or Kirkland"
    ],
    "bottomLine": "A good desk-drawer bar on a budget; just do not count every gram as if it were whey.",
    "specs": {
      "Protein per bar": "20 g (label)",
      "Calories": "About 200, by flavor",
      "Sugar / sugar alcohols": "About 2 g / about 6 g (maltitol)",
      "Best for": "Budget buyers without Costco"
    }
  },
  {
    "id": "one-protein-bar-birthday-cake",
    "name": "ONE Protein Bar, Birthday Cake",
    "brand": "ONE",
    "badge": "Best Dessert-Style Flavors",
    "category": "Whey and milk protein bar (maltitol)",
    "description": "ONE built its following on dessert flavors such as Birthday Cake, which lists 20 g of protein and 1 g of sugar in a 60 g bar, at about 210 to 220 calories depending on the listing, per retailer labels at the time of writing. The protein blend in current flavors is whey protein isolate and milk protein isolate. Sweetening comes from isomalto-oligosaccharides, maltitol and sucralose, so it shares Barebells' digestive caveat and carries slightly more calories per gram of protein than Quest or Kirkland. Prices vary widely by store, so compare per bar.",
    "pros": [
      "20 g of whey and milk protein with 1 g of sugar",
      "Wide range of dessert flavors buyers like",
      "Gluten-free labelling on many flavors"
    ],
    "cons": [
      "Uses maltitol, which can cause bloating",
      "About 210-220 calories, lower protein per calorie than Quest",
      "Price varies a lot between retailers"
    ],
    "bottomLine": "A good pick if you want dessert flavors and dairy protein, but Quest does the same job with a gentler sweetener.",
    "specs": {
      "Protein per bar": "20 g (label)",
      "Calories": "About 210-220",
      "Sugar / sugar alcohols": "1 g / maltitol plus IMO",
      "Best for": "Dessert-flavor fans"
    }
  },
  {
    "id": "rxbar-chocolate-sea-salt",
    "name": "RXBAR, Chocolate Sea Salt",
    "brand": "RXBAR",
    "badge": "Best Whole-Food Bar",
    "category": "Egg white and date bar",
    "description": "RXBAR is the opposite approach: a short ingredient list of dates, egg whites, cashews, almonds, chocolate, cocoa and sea salt, with no sugar alcohols or sucralose. Chocolate Sea Salt lists 12 g of protein in a 52 g bar for about 200 to 210 calories, per the labels at the time of writing, and its sugar comes from dates rather than added sugar. That makes it the weakest bar here on protein per calorie, at under 6 g per 100 calories. A 12-count box lists near $21 on Amazon and often drops to about $13 with Subscribe and Save, roughly $2.30 to $3.60 per 25 g.",
    "pros": [
      "Short, recognisable ingredient list",
      "No sugar alcohols or artificial sweeteners",
      "Egg white protein is complete"
    ],
    "cons": [
      "Only 12 g of protein for about 200-210 calories",
      "Natural sugar from dates is high for a protein bar",
      "Sticky, firm texture that buyers either like or do not"
    ],
    "bottomLine": "A good real-food snack, but a poor way to buy protein; choose it for the ingredients, not the macros.",
    "specs": {
      "Protein per bar": "12 g (label)",
      "Calories": "About 200-210",
      "Sugar / sugar alcohols": "Sugar from dates / none",
      "Best for": "Avoiding sweeteners and sugar alcohols"
    }
  },
  {
    "id": "built-puff-protein-bar",
    "name": "BUILT Puff Protein Bar",
    "brand": "BUILT",
    "badge": "Lowest Calorie (With a Caveat)",
    "category": "Whey and collagen bar",
    "description": "BUILT Puff bars are light, marshmallow-style bars that list about 17 g of protein for around 140 calories in most flavors, per retailer labels at the time of writing, with about 6 g of sugar in the listing we checked. On paper that is the best protein per calorie in this guide. The caveat is the source: BUILT describes the protein as a blend of partially hydrolyzed whey protein isolate and collagen, and collagen is incomplete protein with little leucine. Treat it as a lower-calorie treat rather than a bar that does the work of a whey shake.",
    "pros": [
      "About 140 calories, the lightest bar here",
      "Airy texture that buyers describe as more like a candy",
      "Gluten-free labelling"
    ],
    "cons": [
      "Part of the protein is collagen, which is incomplete",
      "More sugar than Quest, Barebells or ONE",
      "Flavors vary from about 15 to 17 g of protein"
    ],
    "bottomLine": "Fine as a lower-calorie sweet snack; do not count it gram for gram against a whey bar.",
    "specs": {
      "Protein per bar": "About 15-17 g (label, by flavor)",
      "Calories": "About 140-160",
      "Sugar / sugar alcohols": "About 6 g sugar (flavor checked)",
      "Best for": "Calorie-conscious snacking"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Bars",
          item: `${SITE_URL}/best-protein-bars/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the healthiest protein bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no single healthiest bar, but the best labels combine about 20 g of milk or whey protein, under 200 calories, low sugar and a gentle sweetener such as erythritol or allulose. Quest fits that well. If you want to avoid sweeteners and sugar alcohols entirely, RXBAR's short ingredient list is cleaner, though it delivers far less protein per calorie than dairy bars."
          }
        },
        {
          "@type": "Question",
          "name": "Are protein bars good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can help if a bar replaces a higher-calorie snack, because protein and fiber are filling. But most bars carry 180 to 220 calories, so they are not free. For the most protein per calorie, a ready-to-drink shake or whey mixed with water is leaner. If you use bars while dieting, count them like food and stick to one a day."
          }
        },
        {
          "@type": "Question",
          "name": "Why do protein bars make me bloated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The usual causes are sugar alcohols, especially maltitol, and large doses of added fiber such as inulin, chicory root or polydextrose. Both ferment in the colon and produce gas. Try a bar sweetened with erythritol or allulose, eat one at a time with water, or choose a bar without sugar alcohols. If symptoms persist, speak to a doctor rather than assuming it is the protein."
          }
        },
        {
          "@type": "Question",
          "name": "Is it OK to eat a protein bar every day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most healthy adults, one bar a day is fine as a snack or travel option. The concerns are cumulative: calories, sugar alcohols and added fiber add up if you eat several. A bar should not replace whole meals regularly. People with kidney disease, diabetes, food allergies or who are pregnant should check with a doctor or registered dietitian first."
          }
        },
        {
          "@type": "Question",
          "name": "Are protein bars cheaper than protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Mainstream whey costs about $1.40 to $1.50 per 25 g of protein, while branded bars often run $2.50 to $3.50 per 25 g at full price. The exception is bulk buying: Kirkland bars at Costco work out around $1.30 to $1.45 per 25 g, and Pure Protein boxes about $1.55 to $1.80, close to powder."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between maltitol and erythritol?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both are sugar alcohols, but they behave differently. Much of the maltitol you eat reaches the colon, where it ferments and can cause gas and loose stools, and it raises blood sugar noticeably. Erythritol is mostly absorbed and excreted in urine, so it causes fewer digestive symptoms and has almost no blood-sugar effect. Most people tolerate erythritol bars better than maltitol bars."
          }
        },
        {
          "@type": "Question",
          "name": "Do collagen protein bars build muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not as well as dairy bars. Collagen is incomplete, with no tryptophan and little leucine, so it contributes far less to muscle protein synthesis than whey or milk protein. A bar that mixes collagen with whey still offers some useful protein, but less than its label total implies. For muscle, choose bars with milk or whey protein isolate listed first."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Protein Powder Rankings",
    tags: [
      "best protein bars",
      "protein bars",
      "high protein bars",
      "low sugar protein bars"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Buyer's Guide"} badge={"Label-by-Label Ranking"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Best Protein Bars</Fragment>
      Most protein bars hit the same 20 g headline. What separates them is what comes with it: how many calories, which sugar alcohol, how much fiber, whether part of the protein is collagen, and what you pay per 25 g compared with a scoop of powder.
    </ArticleHeader>

    <TableOfContents>
      <a href="#what-makes-a-good-bar">What Makes a Good Bar</a>
      <a href="#how-we-ranked">How We Ranked Them</a>
      <a href="#top-picks">Our Top Picks</a>
      <a href="#side-by-side">The Numbers Side by Side</a>
      <a href="#protein-per-calorie">Protein per Calorie</a>
      <a href="#sugar-alcohols">Maltitol vs Erythritol vs Allulose</a>
      <a href="#fiber">Fiber and Digestion</a>
      <a href="#protein-source">Whey vs Collagen Padding</a>
      <a href="#cost">Cost per 25 g vs Powder</a>
      <a href="#when-to-use">When a Bar Makes Sense</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          A protein bar is a snack that happens to be high in protein, and the best ones are honest about that. The worst are candy bars with a protein number on the front, padded with gelatin, sweetened with enough maltitol to upset your stomach, and priced at three times the cost of the same protein from a tub. This guide ranks widely sold bars on the five things the wrapper does not explain: protein per calorie, the sweetener system, fiber load, the protein source and cost per 25 g. Label figures are per the label at the time of writing and vary by flavor, so check the box you actually buy.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="what-makes-a-good-bar" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. What Separates a Good Protein Bar From a Candy Bar
          </h2>

          <p>
            Every bar in the protein aisle advertises the same thing: a large number followed by a g. That number is the least useful thing on the wrapper, because most mainstream bars land between 15 and 21 g and the differences that matter sit on the back of the box. A good bar delivers its protein without dragging along too many calories, without a sweetener that leaves you bloated, and without padding the total with cheap protein your muscles cannot use well.
          </p>

          <p>
            Start with what a bar is for. It is portable, needs no liquid, survives a gym bag or a glove box, and can be eaten in a meeting. That makes it a useful backup when the alternative is no protein at all, or a vending machine. It does not make a bar a sensible main protein source, because even the leanest bars carry 140 to 220 calories, some fat and usually a sugar alcohol. Our <a href="/best-protein-supplements/">guide to protein supplements by format</a> explains where bars sit against powders, shakes and clear whey.
          </p>

          <p>
            The second point is that low sugar does not mean low carbohydrate or easy digestion. Most modern bars replace sugar with a mix of sugar alcohols, added fiber and a high-intensity sweetener such as sucralose or stevia. Those swaps keep the Sugars line near zero, but they move the cost somewhere else: maltitol can raise blood sugar more than people expect and causes gas in many stomachs, and large doses of added fiber do the same. Reading the Total Carbohydrate, Dietary Fiber and Sugar Alcohol lines together tells you far more than the sugar figure alone.
          </p>

          <p>
            Third, the protein itself varies more than the headline suggests. A bar whose first ingredient is a protein blend of milk protein isolate and whey protein isolate is delivering complete dairy protein with plenty of leucine. A bar that lists gelatin, collagen or hydrolyzed collagen in its blend is reaching the same number partly with an incomplete protein. Both are legal and both are labelled accurately, but they are not equivalent if your goal is muscle or satiety.
          </p>

          <p>
            Finally, there is price. Bars feel cheap because you buy them one at a time, but converted to cost per 25 g of protein, a branded bar at full price can cost two or three times as much as a tub of whey. A few bars, bought in bulk, close that gap almost completely. Knowing which ones is the easiest money you will save in this aisle.
          </p>
        </div>

        <div id="how-we-ranked" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. How We Ranked the Bars
          </h2>

          <p>
            We did not taste-test these bars and do not claim to. The ranking is built on label analysis, ingredient lists and prices we could check in 2026, with taste and texture comments reported as what buyers say. Label figures come from brand pages and retailer listings at the time of writing, and they vary by flavor, so where a range exists we give it. If a figure could not be confirmed from a label, we left it out.
          </p>

          <p>
            The first filter was protein per bar and per calorie. We calculated grams of protein per 100 calories for each bar, because that single figure captures whether the protein comes with a reasonable calorie load. A whey powder mixed with water typically delivers around 20 g per 100 calories; good bars land around 10 to 12 g; anything below 8 g is closer to a snack bar with added protein than to a protein bar.
          </p>

          <p>
            The second filter was the sweetener system. We separated bars sweetened mainly with erythritol or allulose, which most people tolerate well, from bars sweetened mainly with maltitol, which is more likely to cause digestive symptoms and has a stronger effect on blood sugar. We also noted bars with no sugar alcohols at all, and bars whose sugar comes from fruit, because some readers want to avoid sweeteners entirely.
          </p>

          <p>
            The third and fourth filters were fiber and protein source. We noted how much added fiber each bar uses, since 12 g or more in one sitting is a lot for some stomachs, and we checked whether the protein blend leans on gelatin or collagen. Bars with dairy or egg protein first ranked ahead of bars padded with collagen at similar calorie counts.
          </p>

          <p>
            The last filter was cost per 25 g of protein, calculated from a dated, checkable price where we found one. That is the same unit we use across the site, which lets you compare a box of bars directly with a powder from our <a href="/best-cheap-protein-powder/">cheap protein powder</a> ranking. Where prices varied too much to state one confidently, we said so instead of picking a flattering number.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Best Protein Bars, Ranked
          </h2>

          <p>
            Each pick below was chosen on its label rather than on taste testing: protein per bar and per 100 calories, the sugar alcohol it relies on, its fiber, where its protein comes from, and its cost per 25 g of protein at prices we saw in 2026. Nutrition figures are per the label at the time of writing and vary by flavor; prices move constantly, so check the live listing. Taste comments reflect what buyers report, not hands-on testing.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="side-by-side" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. The Numbers Side by Side
          </h2>

          <p>
            The table below puts the label figures next to each other, per the labels at the time of writing; all of them vary somewhat by flavor. Protein per 100 calories is our calculation from the listed protein and calories. Cost per 25 g is calculated from the price shown in each product card and will move with sales, coupons and pack size.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Bar</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">g protein / 100 kcal</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Main sweetener</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Quest (Choc Chip Cookie Dough)</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">190</td>
                    <td class="px-4 py-4 text-gray-700">11.1</td>
                    <td class="px-4 py-4 text-gray-700">Erythritol</td>
                    <td class="px-4 py-4 text-gray-700">About $3.50 (brand site)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Kirkland Signature</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">180-190</td>
