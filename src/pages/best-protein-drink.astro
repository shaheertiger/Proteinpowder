const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Drink",
          item: `${SITE_URL}/best-protein-drink/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein drink overall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Fairlife Core Power is our top pick: about 26 g of complete milk protein per bottle from ultra-filtered milk, lactose-free, with single-digit sugar per the label at the time of writing. Premier Protein offers similar numbers for less money per bottle, and OWYN is the strongest widely available plant-based option if you avoid dairy. The right choice depends on budget and diet."
          }
        },
        {
          "@type": "Question",
          "name": "Are ready-to-drink protein shakes as good as powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nutritionally, yes, when the protein source and dose match. A 30 g milk protein shake and a 30 g serving of whey support muscle protein synthesis in much the same way. The differences are cost, where powder is usually far cheaper per 25 g of protein, and ingredients, where bottles add stabilizers and gums to stay shelf-stable. Convenience is what the bottle buys."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein should a protein drink have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aim for at least 20 g, and ideally 25-30 g, of complete protein per bottle. That range covers the roughly 0.4 g per kg of body weight per meal that research associates with a strong muscle-building response in most adults, and for dairy protein it clears the 2-3 g leucine threshold. Larger athletes and older adults may benefit from the higher end."
          }
        },
        {
          "@type": "Question",
          "name": "Are protein drinks bad for your kidneys?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In healthy people, research has not shown that protein intakes within common sports-nutrition ranges damage the kidneys. People with chronic kidney disease are a different case, because protein intake often needs managing and some fortified shakes are also high in potassium or phosphorus. If you have reduced kidney function, ask your doctor or a registered dietitian before using protein drinks regularly."
          }
        },
        {
          "@type": "Question",
          "name": "Can I drink a protein shake as a meal replacement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 150-calorie protein shake is too small to replace a meal on its own for most adults. It works better as a snack or alongside food such as fruit, oats or a sandwich. Dedicated meal-replacement drinks add carbohydrate, fat, fiber and vitamins to get closer to a real meal, so read the label for calories and fiber if that is the job you need done."
          }
        },
        {
          "@type": "Question",
          "name": "Is carrageenan in protein shakes safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Carrageenan is an approved food additive, and the evidence that it harms healthy people at normal intakes is limited. Much of the concern comes from animal and cell studies, some using degraded carrageenan, which is not permitted in food. Some people with inflammatory bowel conditions report symptoms. If a shake upsets your stomach, try a formula without it and see whether that helps."
          }
        },
        {
          "@type": "Question",
          "name": "Do protein shakes need to be refrigerated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unopened, most UHT-processed shakes are shelf-stable and can sit in a pantry until the best-by date, though most taste better cold. Once opened, every shake needs refrigerating and should be finished within the window printed on the label, often 24-48 hours. A few fresh, non-UHT protein drinks must be refrigerated even before opening, so always check the label."
          }
