  },
  {
    "id": "best-chocolate-whey-protein-powder-muscletech-nitro-tech-milk-chocolate",
    "name": "MuscleTech Nitro-Tech Whey Protein, Milk Chocolate (4 lb)",
    "brand": "MuscleTech",
    "badge": "Best Value per 25 g",
