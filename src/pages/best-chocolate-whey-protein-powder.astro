---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Vanilla Protein Powder",
    "url": "/best-vanilla-protein-powder/"
  },
  {
    "title": "Best Cookies and Cream Protein Powder",
    "url": "/best-cookies-and-cream-protein-powder/"
  },
  {
    "title": "Best Protein Hot Chocolate",
    "url": "/best-protein-hot-chocolate/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-19", modified: "2026-11-19" });
const title = "Chocolate Whey Protein Powder: 6 Best Picks, Ranked by Label";
const description =
  "ON Gold Standard Double Rich Chocolate is the best chocolate whey for most, at about $1.49 per 25 g. Plus the best isolate, cheapest and cleanest picks.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "best-chocolate-whey-protein-powder-on-gold-standard-double-rich-chocolate",
    "name": "Optimum Nutrition Gold Standard 100% Whey, Double Rich Chocolate (5 lb)",
