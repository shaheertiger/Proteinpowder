  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "PEScience Protein Powder Review",
          item: `${SITE_URL}/pescience-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is PEScience protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for most people who want dessert flavors. Select Protein lists 23 to 24 g of protein per scoop from a milk protein isolate and whey blend, in about 120 calories, and buyers rate its flavors highly. It is not certified for tested sport and uses sucralose, so drug-tested athletes and people avoiding artificial sweeteners should look elsewhere."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in PEScience Select Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gourmet Vanilla and Cake Pop list 24 g of protein per 31 g scoop in about 120 calories, per retailer labels at the time of writing. Chocolate Truffle and Chocolate Peanut Butter Cup list 23 g in slightly larger scoops. Figures vary by flavor and label version, so check the panel on the tub you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Is PEScience Select whey or casein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both. The main ingredient is milk protein isolate, which contains casein and whey in roughly the ratio found in milk, followed by whey protein concentrate and leucine peptides. That makes Select thicker and slower to digest than a pure whey isolate, which helps with fullness and makes it work well in recipes."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best PEScience flavor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gourmet Vanilla is the most versatile and the safest first tub, because it works in shakes, oats and baking. Cake Pop is the sweeter dessert-style pick, and Chocolate Truffle is the richer chocolate option. Taste is personal and we did not taste-test, so the sample kit is a cheap way to decide."
          }
        },
        {
          "@type": "Question",
          "name": "Is PEScience third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PEScience says its protein products are third-party tested for purity and potency. It does not advertise NSF Certified for Sport, Informed Choice or Informed Sport status for Select Protein at the time of writing. That is fine for most buyers, but athletes in tested sport should choose a product listed in a certification database."
          }
        },
        {
          "@type": "Question",
          "name": "Is PEScience Select Vegan good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a reasonable flavored plant protein: about 20 g of protein per scoop from pea and brown rice, sweetened only with stevia, and free of dairy, soy and gluten. Buyer reviews are more mixed than for the dairy Select, with some noting chalkiness and a stevia aftertaste. Sodium is relatively high at around 290 to 330 mg."
          }
        },
        {
          "@type": "Question",
          "name": "Where should I buy PEScience?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy from PEScience's own site, Amazon listings sold by PEScience or Amazon, or established retailers such as Vitamin Shoppe and Vitacost. We found lookalike websites using the brand's name on unusual domains, so avoid unfamiliar sites with steep discounts. The 55-serving tub on sale is usually the cheapest way to buy Select."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
