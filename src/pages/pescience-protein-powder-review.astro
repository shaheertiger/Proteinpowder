---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Devotion Protein Powder Review",
    "url": "/devotion-protein-powder-review/"
  },
  {
    "title": "Ghost Protein Powder Review",
    "url": "/ghost-protein-powder-review/"
  },
  {
    "title": "Best Vanilla Protein Powder",
    "url": "/best-vanilla-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "PEScience Protein Powder Review: Select Protein Flavors, Formula and Value";
const description =
  "PEScience Select Protein and Select Vegan checked by label: 24 g per scoop, the casein-whey formula, which flavor to start with and cost per 25 g of protein.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
