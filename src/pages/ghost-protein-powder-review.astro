const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ghost Protein Powder Review",
          item: `${SITE_URL}/ghost-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How much protein is in Ghost Whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ghost Whey lists 25 g of protein per rounded scoop, per the label at the time of writing, with about 130 to 150 calories depending on flavor. On the Cinnabon label, 12.5 g of that protein comes from whey isolate, 10 g from concentrate and 2.5 g from hydrolyzed isolate. Flavors with cookie pieces or more cocoa run slightly higher in calories."
          }
        },
