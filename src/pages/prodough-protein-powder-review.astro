---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Tasting Protein Powder",
    "url": "/best-tasting-protein-powder/"
  },
  {
    "title": "Best Whey Protein Isolate",
    "url": "/best-whey-protein-isolate/"
  },
  {
    "title": "Best Protein Powder for Smoothies",
    "url": "/best-protein-powder-for-smoothies/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "ProDough Protein Powder Review: Dessert Flavors, 25 g Scoops, Steep Price";
const description =
  "ProDough protein reviewed on the label: the 25 g whey isolate, the beef and plant powders, the baking mixes, what is not disclosed and the real cost per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "prodough-whey-protein-isolate",
    "name": "ProDough Whey Protein Isolate",
    "brand": "ProDough",
    "badge": "Best Overall ProDough",
