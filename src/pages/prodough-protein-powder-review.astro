    "specs": {
      "Protein / serving": "25 g (brand)",
      "Calories": "About 110",
      "Third-party testing": "None named",
      "Best for": "Flavor variety in shakes and oats"
    }
  },
  {
    "id": "prodough-grass-fed-beef-protein",
    "name": "ProDough Grass-Fed Beef Protein",
    "brand": "ProDough",
    "badge": "Best Dairy-Free ProDough",
    "category": "Beef protein with collagen peptides, stick packs",
