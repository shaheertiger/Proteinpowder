---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Garden of Life Protein Powder Review",
    "url": "/garden-of-life-protein-powder-review/"
  },
  {
    "title": "Best Pea Protein Powder",
    "url": "/best-pea-protein-powder/"
  },
  {
    "title": "Best Protein Drink",
    "url": "/best-protein-drink/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "OWYN Protein Powder Review: Pro Elite vs Original, Powder vs Shake";
const description =
  "OWYN Pro Elite and original plant protein powders and shakes checked on protein, sugar, allergen claims and cost per 25 g of protein, with who should buy which.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "owyn-pro-elite-protein-powder",
    "name": "OWYN Pro Elite Protein Powder",
    "brand": "OWYN",
    "badge": "Best Overall",
    "category": "Pea and pumpkin plant protein",
    "description": "OWYN's best powder lists 30 g of protein from pea and pumpkin protein in 180 calories per two-scoop serving, with 0 g of sugar and monk fruit sweetening, per the chocolate panel at the time of writing. It adds a probiotic, a greens blend and vitamins and minerals, and carries FARE and Non-GMO badges. At $49.99 for 27 servings on OWYN's site, it costs roughly $1.55 per 25 g of protein.",
    "pros": [
      "30 g of plant protein per serving, a full dose",
      "Zero sugar, sweetened with monk fruit",
      "About $1.55 per 25 g of protein at list price"
    ],
    "cons": [
      "No NSF Certified for Sport or Informed Sport status",
      "Two-scoop serving means 27 servings per tub"
    ],
    "bottomLine": "The OWYN product to buy: a full-dose, zero-sugar plant powder at a budget-tier cost per gram.",
    "specs": {
      "Protein per serving": "30 g (2 scoops, label)",
      "Calories": "180",
      "Third-party testing": "FARE, Non-GMO; no sport seal",
      "Best for": "Allergy-friendly vegan value"
    }
  },
  {
    "id": "owyn-pro-elite-protein-shake",
    "name": "OWYN Pro Elite Protein Shake",
    "brand": "OWYN",
    "badge": "Best Shake",
    "category": "Ready-to-drink plant protein shake",
    "description": "The higher-protein OWYN bottle lists 32 g of protein from pea protein and organic pumpkin seed protein with flaxseed oil, in 200 calories with 0 g of sugar and 3 g of carbohydrate that is all fiber, per the label at the time of writing. It is sweetened with monk fruit and stevia. A 12-pack costs $49.99 on OWYN's site, about $3.25 per 25 g of protein.",
    "pros": [
      "32 g of protein per bottle",
      "Zero sugar and zero net carbs",
      "Free from the top nine allergens, per OWYN"
    ],
    "cons": [
      "About $3.25 per 25 g of protein",
      "No sport certification"
    ],
    "bottomLine": "The OWYN bottle to buy after training; far stronger than the original shake.",
    "specs": {
      "Protein per serving": "32 g per bottle (label)",
      "Calories": "200",
      "Third-party testing": "FARE, Non-GMO, kosher; no sport seal",
      "Best for": "Post-workout on the go"
    }
  },
  {
    "id": "owyn-plant-protein-shake",
    "name": "OWYN Plant Protein Shake",
    "brand": "OWYN",
    "badge": "Most Widely Available",
    "category": "Ready-to-drink plant protein shake",
    "description": "The shake OWYN is known for lists 20 g of protein from pea protein, organic pumpkin seed protein and organic flax oil in 180 calories per 355 mL bottle, with 3 g of prebiotic fiber and 4 g of added cane sugar, per the label at the time of writing. It is stocked in many large grocery chains. At $38.99 for 12 on OWYN's site, it costs roughly $4 per 25 g of protein.",
    "pros": [
      "Allergy-friendly and easy to find in stores",
      "20 g of plant protein with 3 g of fiber",
      "Many flavors, including coffee and dessert options"
    ],
    "cons": [
      "About $4 per 25 g of protein",
      "4 g of added sugar",
      "20 g is a snack-sized dose"
    ],
    "bottomLine": "A convenient allergy-friendly bottle; the Pro Elite shake is the better buy for the protein.",
    "specs": {
      "Protein per serving": "20 g per bottle (label)",
      "Calories": "180",
      "Third-party testing": "FARE, Non-GMO; no sport seal",
      "Best for": "Snacks and grab-and-go"
    }
  },
  {
    "id": "owyn-plant-protein-powder",
    "name": "OWYN Plant Protein Powder",
    "brand": "OWYN",
    "badge": "Lower Calorie",
    "category": "Pea, pumpkin and chia plant protein",
    "description": "The original OWYN powder lists 20 g of protein from pea protein concentrate, pumpkin protein and chia, plus flaxseed, in 140 calories per two-scoop serving, with 4 g of added cane sugar and monk fruit, per the chocolate panel at the time of writing. At $44.99 for 28 servings on OWYN's site it costs about $2 per 25 g of protein, more than Pro Elite for less protein.",
    "pros": [
      "Lower calories per serving than Pro Elite",
      "Allergy-friendly pea, pumpkin and chia blend",
      "Includes a greens blend and probiotic"
    ],
    "cons": [
      "Only 20 g of protein per serving",
      "4 g of added sugar",
      "Worse value than Pro Elite"
    ],
    "bottomLine": "Only worth choosing over Pro Elite if you prefer its taste or want a lighter shake.",
    "specs": {
      "Protein per serving": "20 g (2 scoops, label)",
      "Calories": "140",
      "Third-party testing": "FARE, Non-GMO; no sport seal",
      "Best for": "Light snacks"
    }
  },
  {
    "id": "garden-of-life-sport-organic-plant-protein",
    "name": "Garden of Life Sport Organic Plant-Based Protein",
    "brand": "Garden of Life",
    "badge": "Alternative: Certified",
    "category": "Organic pea-led plant protein blend",
    "description": "The pick if you need what OWYN lacks. Garden of Life Sport combines USDA Organic certification with NSF Certified for Sport status, per the brand and NSF at the time of writing, and delivers about 30 g of protein per serving from an organic pea-led blend. It costs more per 25 g of protein than OWYN Pro Elite, but it is the safer choice for drug-tested vegan athletes.",
    "pros": [
      "NSF Certified for Sport and USDA Organic",
      "About 30 g of protein per serving",
      "Widely available, including on Amazon"
    ],
    "cons": [
      "Higher cost per 25 g of protein than OWYN Pro Elite",
      "Not built around top-nine allergen avoidance the way OWYN is"
    ],
    "bottomLine": "Choose it over OWYN if you compete in a tested sport or want organic certification.",
    "specs": {
      "Protein per serving": "About 30 g (label, varies by flavor)",
      "Calories": "Varies by flavor; see label",
      "Third-party testing": "NSF Certified for Sport (verify flavor)",
      "Best for": "Tested vegan athletes"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "OWYN Protein Powder Review",
          item: `${SITE_URL}/owyn-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is OWYN protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OWYN Pro Elite Protein Powder is a strong plant protein: 30 g of pea and pumpkin protein, zero sugar and 180 calories per serving, at about $1.55 per 25 g of protein at list price. The original OWYN powder is weaker, with 20 g of protein and 4 g of added sugar. Neither carries a sport certification."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in OWYN protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OWYN Pro Elite Protein Powder lists 30 g of protein per two-scoop serving, and the original OWYN Protein Powder lists 20 g per two-scoop serving, per the chocolate nutrition panels at the time of writing. Check the panel on your tub, since figures vary slightly by flavor."
          }
        },
        {
          "@type": "Question",
          "name": "Is OWYN protein dairy-free and vegan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. OWYN products are plant-based and dairy-free, built on pea protein with pumpkin, chia or flax depending on the product. OWYN says its products are free from the top nine allergens and carries FARE certification. People with severe allergies should still read each label and consult their allergist."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener does OWYN use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pro Elite powder uses monk fruit extract and has no sugar. The original powder and original shakes use organic cane sugar plus monk fruit, at about 4 g of added sugar per serving. The Pro Elite shake uses monk fruit and stevia. None of the products reviewed here use sucralose."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns OWYN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OWYN is owned by The Simply Good Foods Company, which also owns the Quest and Atkins brands, per its corporate website. OWYN stands for Only What You Need. Its products are sold through large grocery chains, Amazon and OWYN's own website, so prices vary by channel."
          }
        },
        {
          "@type": "Question",
          "name": "Is the OWYN shake or powder better value?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The powder, by a wide margin. Pro Elite powder costs about $1.55 per 25 g of protein at list price, while OWYN shakes cost roughly $3.25 to $4 per 25 g. Shakes are worth it for convenience, but if you drink one daily at home, the tub saves a lot of money."
          }
        },
        {
          "@type": "Question",
          "name": "Is OWYN third-party tested for sport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OWYN's product pages show FARE, Non-GMO and, for some shakes, kosher badges, but not NSF Certified for Sport or Informed Sport certification at the time of writing. Drug-tested athletes should choose a plant protein listed in those databases, such as Garden of Life Sport Organic Plant-Based Protein."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "owyn protein powder",
      "owyn plant protein",
      "owyn review",
      "owyn protein shake"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Plant Protein Picks",
    link: "/best-plant-based-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Review
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Label-Checked
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          OWYN Protein Powder: <span class="text-[#38BDF8]">Buy the Pro Elite</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          OWYN is best known for allergy-friendly plant shakes in the grocery fridge, but its tubs are where the value is. Here is what each OWYN powder and shake delivers, why the Pro Elite tub beats the original, and who should buy something else.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#owyn-pro-elite-protein-powder"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#pro-elite"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Read the Label Breakdown
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#who-makes-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Who Makes OWYN</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our Top Picks</a>
          <a href="#pro-elite" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The Pro Elite Label</a>
          <a href="#original" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. The Original Powder</a>
          <a href="#shakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. OWYN Shakes vs Powder</a>
          <a href="#allergy" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Allergen-Friendly, Explained</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Cost per 25 g of Protein</a>
          <a href="#vs" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. OWYN vs the Alternatives</a>
          <a href="#skip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Who Should Skip It</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          OWYN Pro Elite Protein Powder is one of the better-value plant powders you can buy: 30 g of pea and pumpkin protein, zero sugar and about 180 calories per serving, at roughly $1.55 per 25 g of protein at list price. The original OWYN powder gives you less protein and more sugar for nearly the same money, and the ready-to-drink shakes cost two to three times as much per gram. Buy the Pro Elite tub, keep the shakes for convenience, and skip OWYN if you need a sport certification.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            Buy <strong>OWYN Pro Elite Protein Powder</strong> if you want a dairy-free, allergy-friendly plant protein with a full dose and no sugar. The chocolate tub lists 30 g of protein from pea and pumpkin protein, 180 calories, 0 g of sugar and 5 g of carbohydrate per two-scoop serving, per its nutrition panel at the time of writing, plus a probiotic, a greens blend and added vitamins and minerals. At $49.99 for 27 servings on OWYN's site, that works out to roughly $1.85 per serving and about $1.55 per 25 g of protein.
          </p>

          <p>
            That price is the headline. Most premium plant powders land between $2 and $3 per 25 g of protein, so Pro Elite gives you more protein per scoop for less money than many better-known names on our <a href="/best-plant-based-protein-powder/">best plant-based protein powder</a> list. The two-scoop serving is large, so a tub lasts 27 shakes rather than 30-plus, but each of those shakes is a full dose.
          </p>

          <p>
            The <strong>original OWYN Protein Powder</strong> is the weaker buy. It delivers 20 g of protein in 140 calories with 4 g of added cane sugar, for $44.99 per 28-serving tub, which works out to about $2 per 25 g of protein. You pay a little less per tub and get a third less protein per shake.
          </p>

          <p>
            The <strong>ready-to-drink shakes</strong>, which most people know OWYN for, are convenient and widely stocked but expensive per gram: roughly $4 per 25 g of protein for the original 20 g shake and about $3.25 for the 32 g Pro Elite shake at list price. And none of the range carries NSF Certified for Sport or Informed Sport certification, so drug-tested athletes should shop elsewhere.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">OWYN Pro Elite Powder at a Glance</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">30 g</p>
                <p class="text-gray-400 text-xs mt-1">Protein per serving (label)</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">0 g</p>
                <p class="text-gray-400 text-xs mt-1">Sugar</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">180</p>
                <p class="text-gray-400 text-xs mt-1">Calories per serving</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">~$1.55</p>
                <p class="text-gray-400 text-xs mt-1">Per 25 g protein, approx.</p>
              </div>
            </div>
          </div>
        </div>

        <div id="who-makes-it" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Who Makes OWYN
          </h2>

          <p>
            OWYN, short for Only What You Need, is a plant-based nutrition brand owned by The Simply Good Foods Company, which also owns Quest and Atkins. The brand built its name on dairy-free protein shakes designed for people with food allergies, and its products are now stocked in many large US grocery chains and by online retailers including Amazon.
          </p>

          <p>
            Being part of Simply Good Foods matters in two ways. First, distribution: OWYN shakes are easy to find in stores and online, so you can usually compare several prices before buying. Second, it places OWYN alongside Quest, whose dairy-based protein powders and shakes target a similar low-sugar buyer. If you can tolerate dairy, our <a href="/quest-protein-powder-review/">Quest protein review</a> covers its sister brand.
          </p>

          <p>
            OWYN's product line has grown well beyond the original shake. Alongside the two powders, it sells the standard 20 g protein shake, a 32 g Pro Elite shake, a high-protein shake, Doubleshot protein coffee shakes, balanced-nutrition shakes and plant-based kids' nutrition shakes. This review focuses on the powders and the two core shakes, since those are what most protein buyers compare.
          </p>

          <p>
            The brand's consistent theme is allergen avoidance. OWYN says its products are free from the top nine allergens, and its product pages show FARE certification and Non-GMO badges. That makes OWYN a natural shortlist for households managing milk, soy, peanut or tree nut allergies, which we cover in detail below.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The OWYN Protein Range, Ranked
          </h2>

          <p>
            OWYN sells two protein powders and a long list of ready-to-drink shakes, including high-protein, coffee, balanced-nutrition and kids' lines. The four products below are the ones most protein buyers choose between, ranked for the job of hitting a daily protein target, followed by one certified alternative from another brand. Figures come from OWYN's product pages and nutrition panels at the time of writing and vary slightly by flavor. The ranking is built on label analysis, certification status and approximate cost per 25 g of protein, not on our own lab or taste tests.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <p class="text-white font-black text-lg">{product.name}</p>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      {[...Array(5)].map((_, i) => (
                        <svg
                          class={`w-4 h-4 ${i < Math.floor(product.rating) ? "fill-current" : "text-gray-200"}`}
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
