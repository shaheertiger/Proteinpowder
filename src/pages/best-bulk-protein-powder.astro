---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Amazon Protein Powder",
    "url": "/amazon-protein-powder/"
  },
  {
    "title": "Best Whey Protein Powder",
    "url": "/best-whey-protein-powder/"
  },
  {
    "title": "Best Whey Protein Concentrate",
    "url": "/best-whey-protein-concentrate/"
  },
  {
    "title": "Best Unflavored Protein Powder",
    "url": "/best-unflavored-protein-powder/"
  },
  {
    "title": "Best Protein Pancake Mix",
    "url": "/best-protein-pancake-mix/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best Bulk Protein Powder: Big Bags That Really Save";
const description =
  "The best bulk protein powder on Amazon: 5 to 10 lb bags and tubs ranked on cost per 25 g at scale, testing and shelf life, plus how to store a big bag.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "optimum-nutrition-gold-standard-100-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey",
    "brand": "Optimum Nutrition",
    "badge": "Best Overall Bulk Powder",
    "category": "Whey isolate, concentrate and peptide blend",
    "description": "Gold Standard is the default bulk whey for good reason. The 10 lb tub holds about 149 servings per retailer listings, and per the label at the time of writing each roughly 30 g scoop gives about 24 g of protein in around 120 calories. Optimum Nutrition promotes it as Informed Choice certified. At 10 lb the cost per 25 g falls well below the 2 lb tub, and on sale it competes with budget brands. It comes in more flavors in the big size than almost anyone else.",
    "pros": [
      "About 149 servings in the 10 lb size, per retailer listings",
      "Promoted as Informed Choice certified by the brand",
      "Wide flavor choice even in the largest tub"
    ],
    "cons": [
