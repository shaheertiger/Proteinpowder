      "Protein / serving": "25 g (listing)",
      "Largest size": "5 lb",
      "Cost per 25 g tier": "Budget",
      "Best for": "Lowest cost per shake"
    }
  },
  {
    "id": "myprotein-impact-whey-protein",
    "name": "Myprotein Impact Whey Protein",
    "brand": "Myprotein",
    "badge": "Best for Sale Shoppers",
    "category": "Whey protein concentrate",
    "description": "Myprotein's US listing gives about 19 to 22 g of protein per 25 g scoop depending on flavor, at around 100 calories, with a 5.5 lb size of about 130 servings. Its list price is not cheap, but the brand runs frequent sales of up to half off, and at those prices the cost per 25 g drops into the budget tier. The brand promotes Informed Choice and Informed Protein certification. It comes in a very long flavor list.",
    "pros": [
      "About 130 servings in the 5.5 lb size",
      "Frequent deep sales bring cost per 25 g into the budget tier",
      "Promoted as Informed Choice and Informed Protein certified"
    ],
    "cons": [
      "Smaller scoop means fewer grams of protein per serving",
      "Protein per scoop varies noticeably by flavor",
      "Poor value at full list price"
    ],
    "bottomLine": "Excellent bulk value if you wait for a sale, and only average if you do not.",
    "specs": {
      "Protein / serving": "About 19-22 g by flavor (listing)",
      "Largest size": "5.5 lb, about 130 servings",
