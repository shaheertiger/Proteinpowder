                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">About 22.5 g</td>
                    <td class="px-4 py-4 text-gray-700">Best plant-based</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Infusions</td>
