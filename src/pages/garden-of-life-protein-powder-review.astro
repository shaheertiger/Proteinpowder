---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Orgain Protein Powder Review",
    "url": "/orgain-protein-powder-review/"
  },
  {
    "title": "Best Pea Protein Powder",
    "url": "/best-pea-protein-powder/"
  },
  {
    "title": "Whey vs Plant Protein",
    "url": "/whey-vs-plant-protein/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Garden of Life Protein Powder Review: Sport vs Raw Organic, and Which NSF Badge Counts";
const description =
  "Garden of Life protein powder review: Sport and Raw Organic label-checked, which NSF badge means sport testing, and cost per 25 g against Vega and Naked Pea.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "garden-of-life-sport-organic-plant-based-protein",
    "name": "Garden of Life Sport Organic Plant-Based Protein",
    "brand": "Garden of Life",
    "badge": "Best Garden of Life Protein",
    "category": "Organic pea-based legume blend",
    "description": "Sport is Garden of Life's certified protein. Its listing states 30 g of organic protein per two-scoop serving from pea, navy bean, lentil and garbanzo bean, at about 160 calories, with over 5 g of BCAAs, 5 g of glutamine, a fruit and turmeric recovery blend and a probiotic. It is USDA Organic and NSF Certified for Sport, per the listing, with no artificial sweeteners.",
    "pros": [
      "30 g of protein per serving, a full plant dose",
      "NSF Certified for Sport and USDA Organic, per the listing",
      "Best cost per 25 g in the Garden of Life range",
      "Sold by Amazon at the time of writing"
    ],
    "cons": [
      "Thick, earthy texture in water, per buyer reports",
      "Some buyers report a price rise and a taste change"
    ],
    "bottomLine": "The organic plant protein to buy if you want a full dose and sport certification in one tub.",
    "specs": {
      "Protein per serving": "30 g per 2 scoops (label)",
      "Calories": "About 160",
      "Third-party testing": "NSF Certified for Sport (verify flavor)",
      "Best for": "Tested athletes, vegans"
    },
    "amazonUrl": "https://www.amazon.com/dp/B01N7DTD98"
  },
  {
    "id": "garden-of-life-raw-organic-protein",
    "name": "Garden of Life Raw Organic Protein",
    "brand": "Garden of Life",
    "badge": "Best Everyday Organic",
    "category": "Organic sprouted plant protein blend",
    "description": "Raw Organic Protein lists 22 g of protein, 4 g of BCAAs and 5 g of fiber in 130 calories per scoop, with 0 g of sugar, per the listing. The protein comes mainly from organic pea and sprouted brown rice protein, with a long list of sprouted grains and seeds. The vanilla is sweetened with organic erythritol and stevia and adds digestive enzymes and a probiotic.",
    "pros": [
      "22 g of protein in 130 calories, per the label",
      "USDA Organic, Non-GMO and NSF Contents Certified",
      "5 g of fiber and 0 g of sugar"
    ],
    "cons": [
      "No NSF Certified for Sport",
      "Contains erythritol; highest cost per 25 g in the range"
    ],
    "bottomLine": "A pleasant organic everyday protein, but not the one to buy for training or testing.",
    "specs": {
      "Protein per serving": "22 g (label)",
      "Calories": "About 130",
      "Third-party testing": "NSF Gluten-Free and Contents Certified",
      "Best for": "Smoothies, light everyday use"
    },
    "amazonUrl": "https://www.amazon.com/dp/B007SYT7LO"
  },
  {
    "id": "garden-of-life-raw-organic-meal",
    "name": "Garden of Life Raw Organic Meal",
    "brand": "Garden of Life",
    "badge": "Best Meal-Style Shake",
    "category": "Organic plant meal replacement powder",
    "description": "Raw Organic Meal is a light meal shake. Its nutrition panel lists a 37.5 g scoop with 150 calories, 20 g of protein, 13 g of carbohydrate, 7 g of fiber and 0 g of sugar. It uses a sprouted pea and brown rice protein blend with fiber, fruits and vegetables, sweetened with organic erythritol and stevia. It is one of the brand's best-rated listings on Amazon.",
    "pros": [
      "7 g of fiber per serving for fullness",
      "20 g of protein in 150 calories, per the label",
      "Available in a 28-serving tub that lowers the cost"
    ],
    "cons": [
      "Light for a true meal at 150 calories",
      "Contains erythritol; no sport certification"
    ],
    "bottomLine": "A good high-fiber shake for light breakfasts, not a full meal or a training protein.",
    "specs": {
      "Protein per serving": "20 g per 37.5 g scoop (label)",
      "Calories": "About 150",
      "Third-party testing": "NSF Gluten-Free and Contents Certified",
      "Best for": "Light breakfasts, fiber"
    },
    "amazonUrl": "https://www.amazon.com/dp/B007S6Y74O"
  },
  {
    "id": "garden-of-life-raw-organic-protein-and-greens",
    "name": "Garden of Life Raw Organic Protein & Greens",
    "brand": "Garden of Life",
    "badge": "Protein Plus Greens",
    "category": "Organic plant protein and greens blend",
    "description": "Protein and Greens adds organic spinach, kale, broccoli, alfalfa grass, carrots and beets to a 20 g plant protein base from organic pea and sprouted grains and legumes, with probiotics and enzymes, per the listing. The brand's chart puts it at about 110 calories per serving. It is sweetened with organic stevia and carries USDA Organic, Non-GMO and NSF Gluten-Free certification.",
    "pros": [
      "20 g of protein plus organic greens, per the label",
      "Lowest-calorie tub in the range, at about 110",
      "No erythritol listed in the vanilla"
    ],
    "cons": [
      "20 g serving is short of ideal after training",
      "No NSF Certified for Sport"
    ],
    "bottomLine": "Worth it only if you want greens in your protein shake every day.",
    "specs": {
      "Protein per serving": "20 g (label)",
      "Calories": "About 110",
      "Third-party testing": "NSF Gluten-Free Certified",
      "Best for": "Protein-and-greens mornings"
    },
    "amazonUrl": "https://www.amazon.com/dp/B01A9IFE8K"
  },
  {
    "id": "vega-sport-premium-protein",
    "name": "Vega Protein + Recovery (formerly Vega Sport Premium Protein)",
    "brand": "Vega",
    "badge": "Alternative: Certified Rival",
    "category": "Pea, pumpkin seed and sunflower seed protein blend",
    "description": "Vega Protein + Recovery, still widely searched as Vega Sport, is the closest rival to Garden of Life Sport. Its listing states 30 g of plant protein per serving, 2 billion CFU of probiotics and NSF Certified for Sport status, in a 20-serving tub at the time of writing. It is not organic, but it lands at a similar cost per 25 g and many buyers prefer its texture.",
    "pros": [
      "30 g of plant protein per serving, per the label",
      "NSF Certified for Sport, per the listing",
      "Similar cost per 25 g to Garden of Life Sport"
    ],
    "cons": [
      "Not USDA Organic",
      "Stevia aftertaste is a common buyer complaint"
    ],
    "bottomLine": "Pick Vega over Garden of Life Sport if you prefer its flavors and do not need organic.",
    "specs": {
      "Protein per serving": "30 g (label)",
      "Calories": "Check label by flavor",
      "Third-party testing": "NSF Certified for Sport",
      "Best for": "Athletes, post-workout"
    },
    "amazonUrl": "https://www.amazon.com/dp/B016D9IGRA"
  },
  {
    "id": "naked-nutrition-naked-pea",
    "name": "Naked Pea Protein",
    "brand": "Naked Nutrition",
    "badge": "Alternative: Budget, One Ingredient",
    "category": "Single-source yellow pea protein isolate",
    "description": "Naked Pea is the budget alternative to the whole Garden of Life range. It has one ingredient, yellow pea protein, and delivers about 27 g of protein in roughly 120 calories per serving, per the label at the time of writing, with no sweeteners, gums or flavorings. It is not organic and has no sport certification we could confirm, but its cost per 25 g is far lower.",
    "pros": [
      "About 27 g of protein per serving, per the label",
      "One ingredient, no erythritol or stevia",
      "Budget-tier cost per 25 g of protein"
    ],
    "cons": [
      "Earthy taste on its own, per buyer reports",
      "Not organic; no sport certification confirmed"
    ],
    "bottomLine": "The cheapest honest plant protein, if you blend it and do not need certification.",
    "specs": {
      "Protein per serving": "About 27 g (label)",
      "Calories": "About 120",
      "Third-party testing": "No sport certification confirmed",
      "Best for": "Smoothies, baking, budgets"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Garden of Life Protein Powder Review",
          item: `${SITE_URL}/garden-of-life-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Garden of Life protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Sport tub is one of the best plant proteins available, with 30 g of organic protein per serving and NSF Certified for Sport status, per its listing. The Raw Organic line is a reasonable lighter protein, with 20-22 g per serving and erythritol in the vanilla flavors, but no sport certification. For most buyers, Sport is the Garden of Life tub to choose."
          }
        },
        {
          "@type": "Question",
          "name": "Which Garden of Life protein is NSF Certified for Sport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Of the plant proteins we checked, only Garden of Life Sport Organic Plant-Based Protein claims NSF Certified for Sport on its listing. The Raw Organic tubs carry NSF Certified Gluten-Free and NSF Contents Certified, which are different programs that do not screen for banned substances. Always confirm the exact product and flavor on NSF's database."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Garden of Life Raw Organic Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Raw Organic Protein listing states 22 g of protein, 4 g of BCAAs and 5 g of fiber in 130 calories per scoop, with 0 g of sugar and about 1 g of net carbohydrate. Raw Organic Meal and Raw Organic Protein and Greens list 20 g each. Figures can vary slightly by flavor, so check your tub's label."
          }
        },
        {
          "@type": "Question",
          "name": "What does raw mean on Garden of Life protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Garden of Life uses raw to describe protein it says is made at low temperatures, with sprouted ingredients and added enzymes. There is no good evidence that low-temperature processing improves the protein your body absorbs, since digestion breaks proteins down anyway. It is a reasonable preference for minimally processed food, not a performance advantage."
          }
        },
        {
          "@type": "Question",
          "name": "Does Garden of Life protein contain stevia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most flavored Garden of Life proteins do. The Raw Organic Protein and Raw Organic Meal vanilla flavors list organic erythritol and organic stevia, and Protein and Greens lists organic stevia. The Sport listing says it has no artificial sweeteners, and buyers attribute its sweetness to stevia. Check the ingredient panel on your flavor if you avoid it."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns Garden of Life?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Garden of Life is owned by Nestlé Health Science, which also holds a majority stake in Orgain. That makes the two brands sister companies. The ownership has no effect on the labels or certifications described in this review, but it is useful context if you prefer buying from independent supplement brands."
          }
        },
        {
          "@type": "Question",
          "name": "Is Garden of Life Sport or Vega better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are close. Both list 30 g of plant protein per serving with NSF Certified for Sport status and land at a similar cost per 25 g at typical prices. Garden of Life Sport is USDA Organic; Vega Protein + Recovery is not. Choose Garden of Life if organic matters to you, and Vega if you prefer its flavors or texture."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "garden of life protein powder",
      "garden of life sport protein",
      "garden of life raw organic protein",
      "raw protein powder"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Plant Protein Picks",
    link: "/best-plant-based-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Review
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Label-Checked
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Garden of Life Protein Powder <span class="text-[#38BDF8]">Review</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Garden of Life sells several organic plant proteins that look alike on the shelf but differ in dose, sweeteners and testing. We checked the labels and certifications so you can tell the 30 g, NSF Certified for Sport tub from the rest.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#garden-of-life-sport-organic-plant-based-protein"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#sport"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare Sport and Raw Organic
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#range" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Garden of Life Protein Range</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our Top Picks</a>
          <a href="#sport" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Sport Organic Plant-Based, Label-Checked</a>
          <a href="#raw" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Raw Organic Protein, and What Raw Means</a>
          <a href="#meals" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Raw Organic Meal and Protein and Greens</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Cost per 25 g of Protein</a>
          <a href="#certifications" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Organic, NSF and the Badge That Matters</a>
          <a href="#digestion" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Sweeteners, Probiotics and Digestion</a>
          <a href="#who" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Who Should Buy It, and the Alternatives</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Garden of Life Sport Organic Plant-Based Protein is the one to buy: 30 g of organic plant protein per serving with NSF Certified for Sport status, at a mid-tier cost per 25 g. The Raw Organic line is a gentler, lower-protein everyday option with sugar alcohol in the mix. Read which NSF badge is on the tub before you assume it is sport tested.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            Garden of Life is one of the few brands that can put USDA Organic and NSF Certified for Sport on the same plant protein tub. Its Sport Organic Plant-Based Protein lists 30 g of protein per two-scoop serving, from organic pea, navy bean, lentil and garbanzo bean protein, per the Amazon listing at the time of writing. That full 30 g dose closes most of the leucine gap that smaller plant servings leave against whey.
          </p>

          <p>
            The rest of the range is weaker as a protein source. Raw Organic Protein, the brand's long-running everyday tub, gives 22 g of protein in 130 calories and is sweetened with organic erythritol and stevia. Raw Organic Meal and Raw Organic Protein and Greens give 20 g each. None of those three carries the sport certification; their NSF badges are for gluten-free status and contents, which are different programs.
          </p>

          <p>
            So is Garden of Life any good? Sport is one of the best plant proteins you can buy, which is why it leads our <a href="/best-plant-based-protein-powder/">best plant-based protein powder</a> ranking. Raw Organic is a reasonable organic protein for smoothies and light use, but it is not the better buy for anyone who trains hard or competes. The cost per 25 g is broadly similar across the range, so the Sport tub is usually the best value too.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Buy Sport. Treat Raw Organic as a lighter, everyday option.</p>
            <p class="text-gray-300 leading-relaxed m-0">Sport gives 30 g of protein with NSF Certified for Sport status at a mid-tier price. The Raw Organic tubs give 20-22 g, contain erythritol and lack the sport certification.</p>
          </div>

          <p>
            Garden of Life is owned by Nestlé Health Science, which also holds a majority stake in Orgain. That makes Garden of Life part of a large supplement group rather than an independent label, which is worth knowing if brand independence matters to you, though it has no effect on what is in the tub.
          </p>
        </div>

        <div id="range" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Garden of Life Protein Range
          </h2>

          <p>
            Garden of Life's plant protein range on Amazon at the time of writing included five tubs: Sport Organic Plant-Based Protein, Raw Organic Protein, Raw Organic Protein and Greens, Raw Organic Meal and a newer Creamy Protein with Oatmilk. The brand also sells collagen and a large catalog of vitamins and probiotics, but those are outside this review. Our <a href="/best-collagen-protein-powder/">best collagen protein powder</a> guide covers its collagen.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Fiber</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sport Organic Plant-Based (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                    <td class="px-4 py-4 text-gray-700">160</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Raw Organic Protein</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                    <td class="px-4 py-4 text-gray-700">130</td>
                    <td class="px-4 py-4 text-gray-700">5 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Raw Organic Protein and Greens</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">110</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Raw Organic Meal</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">150</td>
