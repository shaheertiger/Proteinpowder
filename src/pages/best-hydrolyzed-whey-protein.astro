const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Hydrolyzed Whey Protein",
          item: `${SITE_URL}/best-hydrolyzed-whey-protein/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best hydrolyzed whey protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Dymatize ISO100. It pairs hydrolyzed whey isolate with regular isolate for 25 g of protein in about 110 to 120 calories per the label, and it costs about what a standard isolate does. Optimum Nutrition Platinum Hydrowhey is the pick if you want hydrolysate as the main protein, and Rule 1 R1 is the value option."
          }
        },
        {
          "@type": "Question",
          "name": "Is hydrolyzed whey better than whey isolate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for most goals. Hydrolyzed whey digests slightly faster, but an eight-week trial by Lockwood and colleagues found no meaningful advantage in body composition or strength over isolate or concentrate. It is worth trying if isolate still bothers your stomach or you train twice a day; otherwise isolate gives the same protein for less money."
          }
        },
        {
          "@type": "Question",
          "name": "Is hydrolyzed whey easier to digest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be for some people, because the protein arrives partly broken down. But much of the comfort people notice comes from the low lactose of the isolate base rather than the hydrolysis. If ordinary whey causes bloating, try a plain isolate first, and check for sugar alcohols or gums that may be the real cause."
          }
        },
        {
          "@type": "Question",
          "name": "Does hydrolyzed whey absorb faster?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally, yes. Hydrolysates tend to raise blood amino acids a little faster than intact proteins. Whey is already fast, so the difference versus whey isolate is modest, and the research has not shown that it leads to more muscle over time. Hitting your daily protein total matters much more than absorption speed."
          }
        },
        {
          "@type": "Question",
          "name": "Can people with a milk allergy use hydrolyzed whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Sports hydrolyzed whey is only partly broken down and still contains milk proteins that can trigger an allergic reaction. Extensively hydrolyzed formulas used for infants with cow's milk protein allergy are a different, medically supervised product. Anyone with a milk allergy should avoid whey and speak to a doctor or allergist."
          }
        },
        {
          "@type": "Question",
          "name": "Why does hydrolyzed whey taste bitter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Breaking whey into smaller peptides exposes hydrophobic amino acids, and many of those short peptides taste bitter. The more extensive the hydrolysis, the stronger the effect. Flavored powders mask it well, chocolate and coffee best of all, while unflavored hydrolysates are noticeably harsher than unflavored isolates."
          }
        },
        {
          "@type": "Question",
          "name": "Is hydrolyzed whey worth the money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only for a narrow group: people whose stomachs still react to isolate, athletes training twice a day, or anyone who finds a hydrolyzed blend priced like an isolate. For general muscle gain, weight loss or a first protein powder, a good isolate or even a concentrate gives the same results for less."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
