---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Clean Protein Powder",
    "url": "/best-clean-protein-powder/"
  },
  {
    "title": "Is Protein Powder Safe?",
    "url": "/is-protein-powder-safe/"
  },
  {
    "title": "Best Unflavored Protein Powder",
    "url": "/best-unflavored-protein-powder/"
  },
  {
    "title": "Best Protein Powder for Sensitive Stomach",
    "url": "/best-protein-powder-for-sensitive-stomach/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-17", modified: "2026-10-17" });
const title = "What Is in Protein Powder? How to Read the Label, Line by Line";
const description =
  "What is in protein powder? A line-by-line walk through a real label: protein sources, blends, amino spiking, sweeteners, gums, flavors and real red flags.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "What Is in Protein Powder",
          item: `${SITE_URL}/what-is-in-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is protein powder actually made of?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most protein powder is made from a concentrated protein source, typically whey, casein, milk protein, egg, soy or pea, which makes up the bulk of each scoop. Flavored versions add a sweetener such as sucralose or stevia, a thickener such as xanthan gum, an emulsifier such as sunflower lecithin, flavoring and salt. Some add enzymes, probiotics, vitamins or fiber."
          }
        },
        {
          "@type": "Question",
          "name": "Why do some protein powders have Supplement Facts and others Nutrition Facts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Protein powder can be sold either as a dietary supplement or as a conventional food, and the company's intended use decides which. Supplements use a Supplement Facts panel, which can include proprietary blends and lists non-dietary ingredients under Other ingredients. Foods, including many meal replacements, use a Nutrition Facts panel with a single ingredient list."
          }
        },
        {
          "@type": "Question",
          "name": "What is a proprietary blend on a protein powder label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a group of ingredients listed under one name with only the total weight disclosed. FDA rules require the ingredients inside to be listed in descending order by weight, but not their individual amounts. That protects a brand's formula but also makes it impossible to tell how much of each protein source you are getting."
          }
        },
        {
          "@type": "Question",
          "name": "What is amino spiking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Amino spiking is adding cheap nitrogen-rich compounds such as glycine, taurine or creatine to a protein powder. Because protein is usually measured by nitrogen content, these inflate the protein figure without adding complete protein. Look for free amino acids listed inside the protein blend, and favor products with published amino acid profiles or independent label claim testing."
          }
        },
        {
          "@type": "Question",
          "name": "Is sucralose in protein powder bad for you?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At the small amounts used in protein powder, regulators in the US and Europe consider sucralose safe. A 2023 laboratory study raised questions about an impurity called sucralose-6-acetate, but it was done on cells, not people. If you would rather avoid it, choose a stevia or monk fruit sweetened powder, or an unflavored one."
          }
        },
        {
          "@type": "Question",
          "name": "Which protein powder ingredients cause bloating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common causes are sugar alcohols such as xylitol, sorbitol and maltitol, added fibers such as inulin, stacks of several gums, and lactose in whey concentrate. Erythritol and a single gum are usually well tolerated. Switching to a whey isolate or an unflavored powder with a short label often resolves the problem."
          }
        },
        {
          "@type": "Question",
          "name": "Can the ingredient list tell me if a protein powder has heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Lead, cadmium and arsenic come from soil and raw materials, so they never appear in the ingredient list. Plant-based and chocolate powders tend to test higher. The only way to judge contamination is independent testing, such as certification programs that screen for heavy metals or published third-party lab results."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
  ],
};
