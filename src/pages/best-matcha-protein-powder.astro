const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Matcha Protein Powder",
          item: `${SITE_URL}/best-matcha-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best matcha protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, NOW Sports Whey Protein with Matcha, because it uses real organic matcha and delivers about 26 g of protein per scoop with roughly 32 mg of caffeine per listings. Truvani's matcha plant protein is the better pick if you are dairy-free or avoid stevia. If you already have a matcha you like, a vanilla whey isolate plus your own matcha is often the best value."
          }
        },
        {
          "@type": "Question",
          "name": "Does matcha protein powder have caffeine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it contains real matcha. Ready-made blends we looked at range from roughly 20 to 50 mg per scoop per brand and listing figures, compared with about 95 mg in an 8 oz cup of coffee. Adding a level teaspoon of matcha to your own protein typically adds about 40 to 90 mg. A matcha protein with no stated caffeine probably contains very little matcha."
          }
        },
        {
          "@type": "Question",
          "name": "Can I add matcha to my protein shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is often the better option. Add cold milk to a shaker, then the protein, then half to one teaspoon of matcha, and shake hard for 20 seconds. Vanilla whey softens matcha's bitterness, unflavored isolate keeps the taste pure, and pea protein works well blended because matcha masks its earthiness."
          }
        },
        {
          "@type": "Question",
          "name": "Is matcha protein powder good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only in the sense that any protein shake can help you stay full within a calorie target. Matcha's caffeine and catechins have small, inconsistent effects on metabolism in studies and should not be counted on. Pick a matcha protein with enough protein per calorie, and work out your daily target before choosing a serving size."
          }
        },
        {
          "@type": "Question",
          "name": "Can I drink matcha protein while pregnant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Possibly, but count the caffeine. ACOG advises staying under 200 mg a day in pregnancy, and a matcha shake can contribute 20 to 90 mg depending on the product. Check the protein powder's other ingredients too, and talk to your doctor or a registered dietitian before adding a caffeinated supplement during pregnancy or breastfeeding."
          }
        },
        {
          "@type": "Question",
          "name": "Is ceremonial grade matcha worth it in a protein shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Ceremonial grade is prized for drinking straight with water, where its sweetness and low bitterness stand out. With milk, protein and sweetener, a good culinary grade tastes almost as good for far less money. Spend on freshness instead: a bright green culinary matcha beats a stale, yellowing ceremonial one."
          }
        },
        {
          "@type": "Question",
          "name": "Does matcha protein powder contain lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can contain small amounts, because tea plants absorb lead and matcha means eating the whole leaf rather than steeping it. Amounts vary by brand and origin. Prefer brands that publish heavy-metal testing, and see our heavy metals guide, linked above, for the published data on protein powders."
          }
        }
      ],
