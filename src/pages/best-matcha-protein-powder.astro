                    <td class="px-4 py-4 text-gray-700">About 26 g</td>
                    <td class="px-4 py-4 text-gray-700">About 32 mg</td>
                    <td class="px-4 py-4 text-gray-700">Organic matcha in blend</td>
                    <td class="px-4 py-4 text-gray-700">One-scoop whey matcha</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Truvani Matcha Plant Protein</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">About 20-27 mg</td>
                    <td class="px-4 py-4 text-gray-700">Organic matcha in blend</td>
                    <td class="px-4 py-4 text-gray-700">Vegan, stevia-free</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dymatize ISO100 Gourmet Vanilla</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">Whatever you add</td>
                    <td class="px-4 py-4 text-gray-700">Your own</td>
                    <td class="px-4 py-4 text-gray-700">Matcha lattes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Zero Carb Unflavored</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">Whatever you add</td>
                    <td class="px-4 py-4 text-gray-700">Your own</td>
                    <td class="px-4 py-4 text-gray-700">Unsweetened matcha</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vital Proteins Matcha Collagen</td>
                    <td class="px-4 py-4 text-gray-700">About 10 g collagen</td>
                    <td class="px-4 py-4 text-gray-700">About 50 mg</td>
                    <td class="px-4 py-4 text-gray-700">Matcha in blend</td>
                    <td class="px-4 py-4 text-gray-700">Hot matcha top-up</td>
                  </tr>
