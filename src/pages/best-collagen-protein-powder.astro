                    <td class="px-4 py-4 text-gray-700">No, contains no tryptophan</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">PDCAAS protein quality</td>
                    <td class="px-4 py-4 text-gray-700">0</td>
                    <td class="px-4 py-4 text-gray-700">1.0, the maximum</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
