---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Protein Powder with Creatine",
    "url": "/best-protein-powder-with-creatine/"
  },
  {
    "title": "Best Protein Powder for Muscle Gain",
    "url": "/best-protein-powder-for-muscle-gain/"
  },
  {
    "title": "Best Protein Powder for Weight Gain",
    "url": "/best-protein-powder-for-weight-gain/"
  },
  {
    "title": "Best Protein Powder for Recovery",
    "url": "/best-protein-powder-for-recovery/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best Creatine Monohydrate: Certified Powders Ranked by Cost per 5 g";
const description =
  "The best creatine monohydrate powders on Amazon, ranked on NSF certification, Creapure sourcing and cost per 5 g serving, with ISSN dosing, safety and the problem with gummies.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "thorne-creatine-micronized-powder",
    "name": "THORNE Creatine, Micronized Creatine Monohydrate Powder, 90 Servings",
    "brand": "Thorne",
    "badge": "Best Overall",
