    }
  },
  {
    "id": "klean-athlete-klean-creatine",
    "name": "Klean Athlete Klean Creatine, Unflavored, 11.1 Ounces",
    "brand": "Klean Athlete",
    "badge": "Best Creapure + NSF",
    "category": "Creapure creatine monohydrate, NSF Certified for Sport",
    "description": "Klean Creatine combines the two quality signals buyers ask about most: it is made with Creapure creatine monohydrate, per the brand's retail listings, and it is NSF Certified for Sport. Each scoop gives 5 g, and the 11.1 oz tub holds about 60 servings, per the label at the time of writing. It was about $34.50 on Amazon when we checked (November 2026); prices move.",
    "pros": [
      "Creapure raw material plus NSF Certified for Sport",
      "5 g of creatine monohydrate and nothing else",
      "Free of artificial colors, flavors and sweeteners, per the label"
    ],
    "cons": [
      "Most expensive here at about $0.58 per serving",
      "Smaller 60-serving tub",
      "Some Amazon buyers reported broken seals; buy from the brand storefront"
    ],
    "bottomLine": "The pick for tested athletes who also want Creapure. You pay a premium for both boxes ticked.",
    "specs": {
      "Creatine / serving": "5 g Creapure monohydrate",
      "Testing": "NSF Certified for Sport",
      "Approx. cost / 5 g": "About $0.58",
      "Best for": "Tested athletes wanting Creapure"
    }
  },
  {
    "id": "optimum-nutrition-micronized-creatine-powder",
