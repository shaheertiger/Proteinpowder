              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">46 g</p>
                <p class="text-gray-400 text-xs mt-1">Daily RDA, girls 14-18</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">52 g</p>
                <p class="text-gray-400 text-xs mt-1">Daily RDA, boys 14-18</p>
              </div>
