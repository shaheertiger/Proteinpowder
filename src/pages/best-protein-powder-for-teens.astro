                    <td class="px-4 py-4 font-black text-gray-900">Momentous Essential Grass-Fed Whey</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">About 90</td>
                    <td class="px-4 py-4 text-gray-700">Low; varies by flavor</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (verify)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Garden of Life Sport Organic Plant-Based</td>
                    <td class="px-4 py-4 text-gray-700">About 30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 170</td>
                    <td class="px-4 py-4 text-gray-700">Low; varies by flavor</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (verify)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Optimum Nutrition Gold Standard 100% Whey</td>
