const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Teens",
          item: `${SITE_URL}/best-protein-powder-for-teens/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for teens?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most teen athletes, a third-party certified whey isolate such as Thorne Whey Protein Isolate or Klean Athlete Klean Isolate, both NSF Certified for Sport per their brands. Dairy-free teens can use Garden of Life Sport Organic Plant-Based. Whatever you choose, it should be protein only, with no stimulants, creatine or gainer-style carbohydrate load, and the certification should be confirmed in the certifier's database."
          }
        },
        {
          "@type": "Question",
          "name": "Can kids have protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A healthy child can safely have a small amount of a plain whey or pea protein, but most do not need it. Children aged 9 to 13 need about 34 g of protein a day at reference body weights, which normal meals easily cover. Adult powders may carry sweeteners, adult-dose vitamins or stimulants, so check with your pediatrician first and favor milk, eggs and yogurt."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein does a teenager need per day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The RDA is 0.85 g per kilogram of body weight for ages 14 to 18, which is about 46 g a day for girls and about 52 g for boys at reference body sizes. Teen athletes in heavy training often need more, frequently in the region of 1.2 to 1.8 g per kilogram, and a pediatrician or sports dietitian can set an individual target."
          }
        },
        {
          "@type": "Question",
          "name": "At what age can you start taking protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no official minimum age, because protein powder is a food product rather than a drug. In practice, most pediatric guidance favors food for younger children and reserves supplements for teens with a real gap or a medical reason. Many families wait until mid-teens and organized training, and talk to the pediatrician before starting a regular routine."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey protein safe for a 14-year-old?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plain whey protein is a milk protein and is generally safe for a healthy 14-year-old in normal amounts, such as one scoop a day. The concerns are the extras, like stimulants and creatine, and contamination with banned substances. Choose a protein-only, third-party certified product, keep to one serving, and avoid it if your teen has a milk allergy or kidney disease."
          }
        },
        {
          "@type": "Question",
          "name": "Should teen athletes take creatine with their protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not without a doctor's input. The American Academy of Pediatrics' 2016 clinical report on performance-enhancing substances discourages their use by adolescents, and creatine is among the substances it covers. The research base in teens is limited compared with adults. Avoid protein powders that include creatine, HMB or performance blends, and let a pediatrician or sports medicine physician weigh in."
          }
        },
        {
          "@type": "Question",
          "name": "Can protein powder stunt a teenager's growth?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no good evidence that a sensible amount of plain protein powder stunts growth. Growth problems are more likely when shakes replace meals and a teen ends up short on total calories, calcium or other nutrients, or when supplements contain hormonally active ingredients. Keep shakes alongside regular meals, choose a certified protein-only formula, and raise any growth concerns with your pediatrician."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
