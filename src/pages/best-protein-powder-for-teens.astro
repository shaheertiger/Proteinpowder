                    <td class="px-4 py-4 text-gray-700">About 170</td>
                    <td class="px-4 py-4 text-gray-700">Single digits</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
