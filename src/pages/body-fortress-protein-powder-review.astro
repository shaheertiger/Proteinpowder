const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Body Fortress Protein Powder Review",
          item: `${SITE_URL}/body-fortress-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Body Fortress a good protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for the price, if you buy it at a big-box store. Super Advanced Whey gives 30 g of protein and about 3.1 g of leucine per scoop, per the label, and it is listed in NSF's dietary supplement registry. The trade-offs are a concentrate-led blend, maltodextrin, artificial sweeteners and no sport-level certification we could find. On Amazon, at the prices we saw, other powders were better value."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Body Fortress Super Advanced Whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One scoop gives 30 g of protein, per the label at the time of writing: 45 g of powder for chocolate and 44 g for vanilla, both at 180 calories. The 60 g figure on the front of the tub is for a two-scoop serving of about 90 g of powder and 360 calories. Most people only need one scoop at a time."
          }
        },
        {
          "@type": "Question",
          "name": "Is Body Fortress whey isolate or concentrate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Super Advanced Whey is a blend of whey protein concentrate and whey protein isolate, with concentrate listed first, so it is mostly concentrate by weight. The separate Super Advanced Isolate uses hydrolyzed whey isolate, milk protein isolate and whey isolate. If lactose is a concern, the isolate is the better choice, though neither is lactose-free."
          }
        },
        {
          "@type": "Question",
          "name": "Is Body Fortress third-party tested?",
