                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein per serving</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein source</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vega Sport Premium Protein</td>
                    <td class="px-4 py-4 text-gray-700">About 30 g</td>
                    <td class="px-4 py-4 text-gray-700">Pea, pumpkin, sunflower, alfalfa</td>
                    <td class="px-4 py-4 text-gray-700">Training, all-round</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Orgain Organic Plant-Based</td>
                    <td class="px-4 py-4 text-gray-700">21 g (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">Pea, brown rice, chia</td>
                    <td class="px-4 py-4 text-gray-700">Budget everyday shakes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">OWYN Pro Elite</td>
                    <td class="px-4 py-4 text-gray-700">30 g (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">Pea, pumpkin seed</td>
                    <td class="px-4 py-4 text-gray-700">Multiple allergies</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Pea</td>
                    <td class="px-4 py-4 text-gray-700">About 27 g</td>
                    <td class="px-4 py-4 text-gray-700">Yellow pea only</td>
                    <td class="px-4 py-4 text-gray-700">Smoothies, baking</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Momentous Essential Plant</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">Pea, brown rice</td>
                    <td class="px-4 py-4 text-gray-700">Drug-tested athletes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Transparent Labs Organic Vegan</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                    <td class="px-4 py-4 text-gray-700">Organic rice, pea</td>
                    <td class="px-4 py-4 text-gray-700">Organic single scoop</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Egg White</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">Egg white</td>
                    <td class="px-4 py-4 text-gray-700">Dairy-free animal protein</td>
