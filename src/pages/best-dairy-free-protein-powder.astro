const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Dairy-Free Protein Powder",
          item: `${SITE_URL}/best-dairy-free-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best dairy-free protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people who train, Vega Sport Premium Protein, which gives about 30 g of plant protein per serving and which the brand states is NSF Certified for Sport. Orgain Organic Plant-Based is the budget pick for everyday shakes, OWYN suits people avoiding several allergens, and Naked Egg White is the best dairy-free animal protein. Check the label for your exact flavor."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey protein dairy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Whey is one of the two main proteins in milk, alongside casein, so every whey powder is dairy, including isolates labeled lactose-free. Whey isolate can work for many people with lactose intolerance, because most of the lactose is filtered out, but it is unsuitable for anyone with a milk allergy or following a vegan or dairy-free diet."
          }
        },
        {
          "@type": "Question",
          "name": "Is lactose-free protein powder the same as dairy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Lactose-free means the milk sugar has been removed or broken down, while dairy-free means no milk-derived ingredient at all. A lactose-free whey isolate or a lactase-treated milk protein is still dairy. People with a milk allergy need dairy-free; people with lactose intolerance can often use lactose-free whey isolate instead."
          }
        },
        {
          "@type": "Question",
          "name": "What protein powder is safe for a milk allergy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look for a powder with no milk in the ingredients and no milk in the Contains statement, such as a pea, pea and rice, or egg white powder. Then check for shared-equipment risk by asking the brand, because may contain statements are voluntary. Agree on a specific product with your allergist, especially for children or severe reactions."
          }
        },
        {
          "@type": "Question",
          "name": "Is dairy-free protein powder as good as whey for muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be close if you take enough. Plant proteins are lower in leucine than whey, so studies that match plant and whey usually use slightly larger plant doses. A 25 to 30 g serving of a pea and rice blend, or egg white, supports muscle gain well alongside resistance training and adequate total daily protein."
          }
        },
        {
          "@type": "Question",
          "name": "Is egg white protein dairy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Egg white is not a dairy product, so an unflavored egg white powder such as Naked Egg contains no milk. Flavored egg powders can add milk-based ingredients, so read the label for each flavor. Egg white is a complete, highly digestible protein, but it is unsuitable for vegans and anyone with an egg allergy."
          }
        },
        {
          "@type": "Question",
          "name": "Do dairy-free protein powders have more heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On average, plant-based powders have tested higher for lead than whey in Consumer Reports and Clean Label Project testing, because plants absorb metals from soil. Results vary by brand and batch. Choosing vanilla or unflavored over chocolate, rotating brands and asking for batch results all reduce exposure. Egg white largely avoids the issue."
          }
        }
      ],
    },
