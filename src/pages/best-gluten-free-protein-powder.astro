  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
