const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Gluten-Free Protein Powder",
          item: `${SITE_URL}/best-gluten-free-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best gluten-free protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For celiac disease, a third-party certified powder is the safest choice. Garden of Life Sport Organic Plant-Based Protein is listed as NSF certified gluten-free, and Ascent 100% Whey carries a certified gluten-free claim with the GFCO mark on several listings. For general gluten avoidance, labeled gluten-free isolates such as Isopure Zero Carb or Dymatize ISO100 are good options."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey protein gluten-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey itself is gluten-free because it comes from milk. Most plain whey isolates and concentrates contain no gluten ingredients. The risks come from added flavor ingredients such as cookie pieces or malt, and from cross-contact in shared facilities. Choose a whey that is labeled or certified gluten-free and check the specific flavor's ingredient list."
          }
        },
        {
          "@type": "Question",
          "name": "What does certified gluten-free mean on protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It means an independent organization has tested the product and reviewed how it is made. GFCO, one of the best-known programs, requires products to test at 10 ppm of gluten or less, half the FDA labeling limit. Certified products carry the certifier's mark, and you can usually confirm the certification in the program's online directory."
          }
        },
        {
          "@type": "Question",
          "name": "Is a gluten-free label safe for celiac disease?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people with celiac disease, yes. The FDA gluten-free label means less than 20 ppm of gluten, which works out to well under a milligram per scoop, and research suggests most people with celiac disease tolerate under 10 mg a day. Certification adds independent verification, which is worth it for products you use daily."
          }
        },
        {
          "@type": "Question",
          "name": "Which protein powder ingredients contain gluten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Watch for wheat flour in cookie or brownie pieces, wheat protein, barley malt, malt extract, malt flavoring and regular oats. Maltodextrin is usually corn-based in the US and gluten-free. Wheatgrass and barley grass are a contamination risk. Because barley, rye and oats are not major allergens, always read the full ingredient list, not just the allergen statement."
          }
        },
        {
          "@type": "Question",
          "name": "Are plant protein powders gluten-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pea, rice, soy, pumpkin and hemp proteins are naturally gluten-free, but plant crops can pick up gluten from fields and equipment shared with wheat and barley. That makes certification more valuable for plant powders. Avoid plant blends with oat protein or grain ingredients unless the product is certified gluten-free."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use protein powder for baking on a gluten-free diet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as long as the powder is gluten-free and every other ingredient in the recipe is too. Unflavored whey isolate, egg white and pea protein work well in gluten-free baking. Pair them with certified gluten-free flours and oats, and check baking powder, chocolate chips and mix-ins, which occasionally contain gluten."
