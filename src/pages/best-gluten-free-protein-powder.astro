                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dymatize ISO100</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 110-120</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">Gluten-free claim</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">OWYN Pro Elite (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 180</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">Under 10 ppm brand standard</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Garden of Life Raw Organic Protein</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                    <td class="px-4 py-4 text-gray-700">About 130</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">NSF Gluten-Free (per brand)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Transparent Labs Grass-Fed Isolate</td>
                    <td class="px-4 py-4 text-gray-700">28 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120-150</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">Gluten-free claim, Informed Choice</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Thorne Whey Isolate</td>
                    <td class="px-4 py-4 text-gray-700">About 21 g</td>
                    <td class="px-4 py-4 text-gray-700">Check flavor</td>
                    <td class="px-4 py-4 text-gray-700">No added sugar</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">Gluten-free claim, NSF Sport</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Pea Unflavored</td>
