const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-08", modified: "2026-11-08" });
const title = "Best Gluten-Free Protein Powder: Certified Picks and How to Check the Label for Celiac Safety";
const description =
  "The best gluten-free protein powders, comparing certified and claim-only picks, the FDA 20 ppm rule, GFCO seals and hidden gluten sources such as barley malt.";

