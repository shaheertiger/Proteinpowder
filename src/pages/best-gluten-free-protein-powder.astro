      "certified gluten free protein powder",
      "celiac protein powder",
      "is protein powder gluten free",
      "gluten free whey protein"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
