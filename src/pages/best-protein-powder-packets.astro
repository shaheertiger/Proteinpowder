    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder Packets",
          item: `${SITE_URL}/best-protein-powder-packets/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What are the best protein powder packets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean Simple Eats Whey Isolate Stick Packs are our top pick for most people, with about 20 g of grass-fed whey isolate per stick. Ascent's native whey packets offer 25 g and Informed Sport certification on some versions, Orgain's travel packs are the budget dairy-free option, and SEEQ and Oath make the best clear whey packets."
          }
        },
        {
          "@type": "Question",
          "name": "Can you bring protein powder on a plane?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. TSA allows protein powder in carry-on and checked bags. Powders over 12 oz, or 350 mL, must go in a separate bin for X-ray, may get extra screening and may be opened, and TSA suggests checking non-essential powders over that size. A few single-serve packets stay well under the threshold. Check tsa.gov before you fly."
          }
        },
        {
          "@type": "Question",
          "name": "Are protein powder packets worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For travel, the gym bag, the office or trying flavors, yes. As your daily protein, usually not, because packets cost noticeably more per serving than the same powder in a tub. A good approach is a tub at home and a box of packets for the times when convenience matters."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in a protein packet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most single-serve protein packets contain about 20 to 30 g of protein. On our list, Clean Simple Eats and Oath are around 20 g, SEEQ 22 g, Orgain 21 g, Ascent 25 g and Happy Viking 30 g, per labels and listings. Check the panel, since figures vary by flavor."
          }
        },
        {
          "@type": "Question",
          "name": "Do protein packets expire?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Like tubs, packets carry a best-by date, often a year or more from manufacture. Sealed foil packets protect the powder from moisture and air well, but heat can degrade flavor, so avoid leaving them in a hot car for long periods. Check the date on the box before stocking up."
          }
        },
        {
          "@type": "Question",
          "name": "Can I mix protein packets with just water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Clear whey packets such as SEEQ and Oath are designed for cold water. Creamy whey packets also mix in water but taste richer with milk. Plant packets are thicker and mix best in a shaker with a mixing ball. Use about 10 to 12 oz of liquid per packet as a starting point."
          }
        },
        {
          "@type": "Question",
          "name": "Are single-serve protein packets bad for the environment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They create more packaging waste per serving than a tub, and most foil packets are not curbside recyclable. If that matters to you, use packets only for travel and buy tubs or large bags for home, or portion your own powder into a reusable container for trips."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

