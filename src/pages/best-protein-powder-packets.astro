  {
    "title": "Best Protein Drink",
    "url": "/best-protein-drink/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-08", modified: "2026-11-08" });
const title = "Best Protein Powder Packets: Single-Serve Stick Packs for Travel and Gym Bags";
const description =
  "The best single-serve protein powder packets for travel and gym bags, what they cost per serving versus a tub, and what TSA actually says about powders.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
