                    <td class="px-4 py-4 text-gray-700">About 110</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Ascent Native Whey Packets</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120-130</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">Informed Sport on some versions</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Orgain Organic Protein Travel Packs</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">About 150</td>
                    <td class="px-4 py-4 text-gray-700">0-1 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">USDA Organic</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">SEEQ Clear Protein Packets</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                    <td class="px-4 py-4 text-gray-700">About 100</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Oath Clear Protein Variety Pack</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">About 100-110</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">FlavCity Protein Smoothie Packets</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g (incl. collagen)</td>
                    <td class="px-4 py-4 text-gray-700">See packet</td>
                    <td class="px-4 py-4 text-gray-700">See packet</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">None claimed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Happy Viking Core Sampler</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                    <td class="px-4 py-4 text-gray-700">See listing</td>
                    <td class="px-4 py-4 text-gray-700">See listing</td>
