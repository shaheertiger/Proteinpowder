                    <td class="px-4 py-4 font-black text-gray-900">Used on US labels?</td>
                    <td class="px-4 py-4 text-gray-700">Yes, for percent Daily Value</td>
                    <td class="px-4 py-4 text-gray-700">Not required</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Main weakness</td>
                    <td class="px-4 py-4 text-gray-700">Hides differences among top proteins</td>
                    <td class="px-4 py-4 text-gray-700">Less data, results vary by study</td>
                  </tr>
                </tbody>
