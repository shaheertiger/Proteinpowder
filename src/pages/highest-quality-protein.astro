                    <td class="px-4 py-4 text-gray-700">Early 1990s (FAO/WHO)</td>
                    <td class="px-4 py-4 text-gray-700">2013 (FAO recommendation)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Digestibility measured</td>
                    <td class="px-4 py-4 text-gray-700">Whole protein, fecal, usually rats</td>
                    <td class="px-4 py-4 text-gray-700">Each amino acid, ileal, usually pigs</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Score capped?</td>
                    <td class="px-4 py-4 text-gray-700">Yes, at 1.0</td>
                    <td class="px-4 py-4 text-gray-700">No, can exceed 100</td>
                  </tr>
