    "title": "Best Organic Protein Powder",
    "url": "/best-organic-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Ritual Protein Powder Review: Is a 20 g Pea Shake Worth the Premium?";
const description =
  "Ritual protein powder reviewed on the label: the 20 g pea Daily Shake, the pregnancy version, its sweeteners, its testing claims and the real cost per 25 g.";

const PRODUCTS: {
