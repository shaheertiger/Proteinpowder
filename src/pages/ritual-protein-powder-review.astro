      "Third-party testing": "No sport certification confirmed",
      "Best for": "Budget, smoothies, baking"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ritual Protein Review",
          item: `${SITE_URL}/ritual-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Ritual protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a good product with a narrow audience. The Daily Shake delivers 20 g of organic pea protein with 0 g sugar, a short ingredient list and Clean Label Project and NSF Contents marks on Ritual's pages. The catch is a premium price, roughly 3 to 4 dollars per 25 g of protein, so it suits buyers who value documentation over value."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Ritual Essential Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Each serving of the Daily Shake and the Pregnancy and Postpartum version contains 20 g of pea protein, per the labels at the time of writing. A serving is 5 tablespoons, about 30 to 31 g of powder, and each bag holds 15 servings. Calories run about 120 for vanilla and about 130 for chocolate."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ritual protein Informed Sport certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ritual announced Informed Sport certification for its Essential Protein line, and the Informed Sport registry has listed the 18+, 50+ and pregnancy products since 2021. The current product pages we checked show Clean Label Project and NSF Contents marks instead. Drug-tested athletes should confirm their specific lot number on the Informed Sport website before relying on it."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener does Ritual protein use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The vanilla Daily Shake and the pregnancy shake use rebaudioside M, a stevia-derived sweetener, plus monk fruit extract. The chocolate Daily Shake lists monk fruit extract alone and states it contains no stevia. None of them use sucralose, sugar alcohols or added sugar, per the labels at the time of writing."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ritual protein safe during pregnancy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ritual makes a dedicated Pregnancy and Postpartum shake with 250 mg of choline and the same contaminant testing claims as its main shake. That is reassuring, but it is not medical advice. Anyone pregnant or breastfeeding should check with their doctor or a registered dietitian before adding a protein powder, especially alongside a prenatal vitamin."
          }
        },
        {
          "@type": "Question",
          "name": "Can you buy Ritual protein on Amazon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the vanilla Daily Shake is listed on Amazon at the time of writing, usually at or near full price. The chocolate flavor and the pregnancy version were easier to find on Ritual's own site. Ritual's subscriber price is typically the cheapest way to buy it, so compare before ordering a one-off bag anywhere."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ritual protein good for building muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can contribute, but it is not an efficient choice. Each serving gives 20 g of protein and about 1.8 g of leucine, which is a modest dose, and the price per gram is high. Lifters chasing a large daily target will get more protein per scoop and per dollar from a whey isolate or a larger-dose plant protein."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
