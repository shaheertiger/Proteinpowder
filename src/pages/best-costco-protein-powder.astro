---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Cheap Protein Powder",
    "url": "/best-cheap-protein-powder/"
  },
  {
    "title": "Best Protein Powder on Amazon",
    "url": "/amazon-protein-powder/"
  },
  {
    "title": "Protein Powder Brands",
    "url": "/protein-powder-brands/"
  },
  {
    "title": "Best Protein Powder",
    "url": "/best-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-01", modified: "2026-11-01" });
const title = "Best Costco Protein Powder: Ranked by Protein per Dollar";
const description =
  "The best Costco protein powder ranked by cost per 25 g of protein, from Kirkland Signature Whey to Ascent and Orgain, plus what Costco actually stocks.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "kirkland-signature-whey-protein",
    "name": "Kirkland Signature Whey Protein Powder (Creamy Chocolate)",
    "brand": "Kirkland Signature",
    "badge": "Best Value at Costco",
    "category": "Whey isolate and concentrate blend",
    "description": "Costco's own whey arrived in 2024 as a 5.4 lb bag of roughly 70 servings, and on protein per dollar it is the cheapest whey in the warehouse at typical member prices. Per the label at the time of writing, a scoop gives about 25 g of protein, roughly 130 calories, about 4 g of carbohydrate and 1 g of sugar, from a blend led by whey protein isolate with whey concentrate. Chocolate was the launch flavor; check your warehouse for others.",
    "pros": [
      "Budget-tier cost per 25 g of protein, the lowest of any whey at Costco at typical prices",
      "About 25 g of protein per scoop with about 1 g of sugar, per the label",
      "Roughly 70 servings per bag, so one purchase lasts most people two months or more"
