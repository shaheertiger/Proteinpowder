    "cons": [
      "Costco does not name the contract manufacturer on the bag",
      "No NSF Certified for Sport or Informed Sport listing we could confirm",
      "One or two flavors only, so a bag you dislike is a lot of powder to finish"
    ],
    "bottomLine": "The default Costco buy if you tolerate dairy, do not need a sport certification and just want cheap, decent whey.",
    "specs": {
      "Protein / serving": "About 25 g (label)",
      "Calories": "About 130",
      "Third-party tested": "No sport certification confirmed",
      "Best for": "Lowest cost per gram"
    }
  },
  {
    "id": "optimum-nutrition-gold-standard-100-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey",
    "brand": "Optimum Nutrition",
    "badge": "Best Name-Brand Value",
    "category": "Whey blend (isolate listed first)",
    "description": "Gold Standard is the name-brand whey Costco carries most consistently, usually in a tub of around 5 lb or more and a narrow choice of flavors. Per the label at the time of writing, a scoop gives about 24 g of protein for roughly 120 to 130 calories, with whey isolate listed as the first ingredient. Optimum Nutrition promotes Informed Choice on many flavors, so it is the cheapest Costco whey with a credible testing claim attached.",
    "pros": [
      "Budget-tier cost per 25 g in the big Costco tub at typical member prices",
      "Informed Choice promoted on many flavors (confirm your flavor in the database)",
      "Long track record and widely reported to mix easily with a spoon"
    ],
    "cons": [
      "Costco usually stocks only two or so of the brand's many flavors",
      "Contains whey concentrate, so a little more lactose than a pure isolate",
      "Most flavors use sucralose"
    ],
    "bottomLine": "Barely more per gram than Kirkland, with a testing claim and a known manufacturer. The safest everyday Costco pick.",
    "specs": {
      "Protein / serving": "About 24 g (label, varies by flavor)",
      "Calories": "About 120-130",
      "Third-party tested": "Informed Choice (confirm flavor)",
      "Best for": "Everyday whey on a budget"
    }
  },
  {
    "id": "ascent-whey-protein",
