const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Clean Protein Powder",
          item: `${SITE_URL}/best-clean-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the cleanest protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no official cleanest powder, because clean has no legal definition. The closest practical answer is a whey isolate or single-source protein with a short ingredient list, no added sugar, NSF Certified for Sport or Informed Sport status you can confirm, and published heavy-metal results. Thorne Whey Protein Isolate and Klean Isolate meet most of those criteria."
          }
        },
        {
          "@type": "Question",
          "name": "Is organic protein powder better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Organic is better for some values, such as pesticide use and farming practices, and it is a regulated, enforceable label. It is not a contaminant standard. Organic protein powder is not automatically lower in heavy metals and does not screen for banned substances, so pair organic with a sport certification or published testing if safety is your main concern."
          }
        },
        {
          "@type": "Question",
          "name": "Which protein powder has the least heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Independent surveys have found that whey and other dairy proteins tend to test lower than plant proteins, and vanilla or unflavored tends to test lower than chocolate. Individual products vary, so the most reliable choice is one with batch results published by an independent lab. A brand claiming zero heavy metals is overstating what any test can show."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey or plant protein cleaner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On heavy metals, whey usually has the edge, because cows filter much of what they eat before it reaches the milk, while plants absorb metals directly from soil. On ingredient lists and allergens, a single-source pea protein can be just as simple as an unflavored whey. Pick based on your diet, then apply the same documentation checks to either."
          }
        },
        {
          "@type": "Question",
          "name": "What does NSF Certified for Sport actually test?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "NSF Certified for Sport verifies that the label matches the contents, screens for a long list of substances banned in sport, screens for certain contaminants and audits the manufacturing facility. Certification applies to specific products and flavors, so search NSF's database for the exact item. Informed Sport, a separate program, tests every batch for banned substances before release."
          }
        },
        {
          "@type": "Question",
          "name": "What makes a protein powder high quality?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A high quality powder delivers 20 to 30 g of protein per serving, enough leucine to reach roughly 2 to 3 g per meal, and a protein figure that is not inflated by free amino acids such as glycine or taurine. Whey, casein, egg and soy score highest on protein quality scales; plant proteins work well at slightly larger servings."
          }
        },
        {
          "@type": "Question",
          "name": "Is clean protein powder safe during pregnancy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many people use protein powder during pregnancy, but it is worth extra caution. Choose a product with published heavy-metal results or strong certification, lean toward whey or a well-tested blend, avoid chocolate for daily use and skip herbal or stimulant extras. Most importantly, take the specific product to your obstetric provider or a registered dietitian before you start."
          }
        }
