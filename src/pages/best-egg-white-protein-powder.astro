const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Egg White Protein Powder",
          item: `${SITE_URL}/best-egg-white-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best egg white protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Naked Egg is the best egg white protein powder, because it is a single ingredient and delivers about 25 g of protein in about 110 calories per two-scoop serving. NOW Sports is the budget pick with a smaller scoop, and Jay Robb is the best-known flavored option, sweetened with stevia. Check the label of the exact flavor you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Is egg white protein better than whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for most people. Whey is cheaper and a little higher in leucine, the amino acid most tied to muscle building. Egg white is a high-quality complete protein and the better choice if you avoid dairy or react to lactose. A slightly larger serving of egg white, around 30 g of protein, closes most of the leucine gap."
          }
        },
        {
          "@type": "Question",
          "name": "Does egg white protein powder affect biotin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Raw egg white contains avidin, which binds biotin. Heat reduces this effect, and commercial egg white powder is pasteurized and usually heat-treated. A scoop or two a day in a normal diet is very unlikely to cause biotin deficiency, which has mostly been documented in people eating large amounts of raw egg white for long periods. Ask a dietitian if you use it heavily."
          }
        },
        {
          "@type": "Question",
          "name": "Is egg white protein dairy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pure egg white protein contains no milk and no lactose, so it is dairy-free by ingredients. Some products blend egg with whey or casein, and some are made in facilities that also process milk. If you have a milk allergy, read the ingredient list and the facility statement, and talk to your allergist if your allergy is severe."
          }
        },
        {
          "@type": "Question",
          "name": "Can you drink egg white protein powder raw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. In the US, egg products sold as ingredients must be pasteurized, and dried egg whites are typically heat-treated as well, so egg white protein powder is safe to mix into a shake without cooking. That is different from raw liquid egg whites from the shell, which can carry Salmonella and should be cooked or bought pasteurized."
