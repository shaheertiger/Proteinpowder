      "Sodium of roughly 230-260 mg per small scoop, depending on listing"
    ],
    "bottomLine": "The pick for drug-tested athletes and anyone who wants third-party testing; confirm the current lot in the certifier's database.",
    "specs": {
      "Protein / serving": "About 15-16 g per 20 g scoop",
      "Calories": "About 70-80",
      "Third-party tested": "Informed Choice / Informed Sport (confirm)",
      "Best for": "Tested athletes"
    }
  },
  {
    "id": "jay-robb-egg-white-protein",
    "name": "Jay Robb Egg White Protein (Vanilla)",
    "brand": "Jay Robb",
    "badge": "Best Flavored",
    "category": "Egg white protein (stevia-sweetened)",
