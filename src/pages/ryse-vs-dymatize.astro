---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Ryse vs Ghost Protein",
    "url": "/ryse-vs-ghost-protein/"
  },
  {
    "title": "Dymatize vs Premier Protein",
    "url": "/dymatize-vs-premier-protein/"
  },
  {
    "title": "Ghost vs Optimum Nutrition",
    "url": "/ghost-vs-optimum-nutrition/"
  },
  {
    "title": "Isopure vs Optimum Nutrition",
    "url": "/isopure-vs-optimum-nutrition/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Ryse vs Dymatize: Cheaper Blend or Certified Isolate?";
const description =
  "Ryse Loaded is cheaper at about $1.67 vs $2.14 per 25 g of protein on Amazon; Dymatize ISO100 is the leaner isolate with an Informed Choice logo.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "ryse-vs-dymatize-ryse-loaded",
    "name": "RYSE Loaded Protein, Jet-Puffed Marshmallow (2 lb)",
    "brand": "RYSE",
    "badge": "Best Value for Flavor",
    "category": "Whey isolate and concentrate blend with MCT powder",
    "description": "Per the label at the time of writing, a 33.9 g scoop of Jet-Puffed Marshmallow gives 25 g of protein, 130 calories, 3 g of carbohydrate, 1 g of sugar, 2.5 g of fat and 240 mg of sodium, sweetened with sucralose and acesulfame potassium. It adds MCT powder, organic agave inulin and a gum blend. At $44.99 for 27 servings on Amazon (20 November 2026) it costs about $1.67 per 25 g; at Vitacost's $49.99 (1 November) about $1.85.",
    "pros": [
      "About $1.67 per 25 g at the Amazon price we saw, the lowest here",
      "Licensed flavors such as Jet-Puffed, Skippy and Little Debbie",
      "Full 25 g of protein per scoop",
      "Thicker, creamier body from MCT powder and inulin, per buyers"
    ],
    "cons": [
      "Contains whey concentrate, so more lactose than an isolate",
      "No sport certification found",
      "Unnamed gum blend, two artificial sweeteners and 240 mg sodium; Label Score 56 / 100"
    ],
    "bottomLine": "The better buy for an untested lifter who tolerates dairy and wants a fun daily shake for less money. Skip it if you are drug tested or whey concentrate upsets your stomach.",
    "specs": {
      "Protein / serving": "25 g in 33.9 g (label)",
      "Calories": "130",
      "Third-party testing": "No certification found",
      "Cost per 25 g": "About $1.67 ($44.99, 27 servings, Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0BDTMHBC8"
  },
  {
    "id": "ryse-vs-dymatize-dymatize-iso100",
    "name": "Dymatize ISO100 Hydrolyzed Whey Isolate, Gourmet Chocolate",
    "brand": "Dymatize",
    "badge": "Best for Tested Athletes and Lactose",
    "category": "Hydrolyzed whey isolate and whey isolate",
    "description": "Per the Vitacost label at the time of writing, a 32 g scoop of Gourmet Chocolate gives 25 g of protein, 120 calories, 2 g of carbohydrate, 1 g of sugar, 1 g of fat and 180 mg of sodium, with 2.6 g of leucine, sweetened with sucralose and stevia. Retailer listings show the Informed Choice logo. A 3 lb Fruity Pebbles tub was $96.20 for 45 servings on Amazon (20 November 2026), about $2.14 per 25 g; the 5 lb tub at Vitacost worked out to about $2.77.",
    "pros": [
      "Isolate only: 1 g fat and low lactose",
      "About 78% protein by weight, the densest scoop here",
      "Informed Choice logo on retailer listings",
      "Pebbles and Dunkin' licensed flavors; Label Score 64 / 100"
    ],
    "cons": [
      "About $2.14 per 25 g on Amazon, roughly 28% more than Ryse",
      "Certification not confirmable in the registry when we checked",
      "Still uses sucralose and lists soy"
    ],
    "bottomLine": "The better-built powder, and the one to buy if you are tested, lactose sensitive or counting every calorie. Skip it if you just want the cheapest flavored shake that hits 25 g.",
    "specs": {
      "Protein / serving": "25 g in 32 g (label)",
      "Calories": "120",
      "Third-party testing": "Informed Choice (retailer listing; confirm flavor)",
      "Cost per 25 g": "About $2.14 (3 lb, Amazon) / $2.77 (5 lb, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B099J2SWXV"
  },
  {
    "id": "ryse-vs-dymatize-dymatize-elite-100-whey",
    "name": "Dymatize Elite 100% Whey, Rich Chocolate (5 lb)",
    "brand": "Dymatize",
    "badge": "Dymatize's Blend Alternative",
    "category": "Whey concentrate, isolate and hydrolyzed concentrate blend",
    "description": "Per the Vitacost label at the time of writing, a 36 g scoop of Rich Chocolate gives 25 g of protein, 140 calories, 3 g of carbohydrate, 2 g of sugar, 3 g of fat and 160 mg of sodium, with 2.7 g of leucine, sweetened with sucralose and acesulfame potassium and thickened with cellulose gum, xanthan gum and carrageenan. Retailer listings show the Informed Choice logo. At $166.95 for about 63 servings (Vitacost, 1 November 2026) it costs about $2.65 per 25 g.",
    "pros": [
      "Informed Choice logo on retailer listings",
      "Big 5 lb tub with about 63 servings",
      "2.7 g of leucine per scoop, per Dymatize"
    ],
    "cons": [
      "About $2.65 per 25 g at Vitacost, more than Ryse",
      "Least dense scoop here at about 69% protein; 140 calories",
      "Carrageenan and two other gums; Label Score 48 / 100"
    ],
    "bottomLine": "Worth it for a tested athlete who wants a Dymatize blend and finds it on sale. Skip it if you are not tested and expect it to beat Ryse on price.",
    "specs": {
      "Protein / serving": "25 g in 36 g (label)",
      "Calories": "140",
      "Third-party testing": "Informed Choice (retailer listing; confirm flavor)",
      "Cost per 25 g": "About $2.65 ($166.95, ~63 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B00CUDYY2U"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ryse vs Dymatize",
          item: `${SITE_URL}/ryse-vs-dymatize/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Ryse or Dymatize better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on what you need. Dymatize ISO100 is the better-built powder: 25 g of protein in a 32 g scoop, 1 g of fat, isolate only and an Informed Choice logo on retailer listings. Ryse Loaded is cheaper at about $1.67 per 25 g against about $2.14 on Amazon and offers more dessert-style flavors. Tested or lactose-sensitive buyers should pick ISO100; everyone else can save with Ryse."
          }
        },
        {
          "@type": "Question",
          "name": "Is Dymatize ISO100 vs Ryse Loaded Protein a fair comparison?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, because they are each brand's flagship and both give 25 g of protein per scoop. The difference is type: ISO100 is hydrolyzed whey isolate, while Ryse Loaded blends whey isolate, whey concentrate and MCT powder. That explains why ISO100 has less fat and lactose and Ryse a creamier body, and why ISO100 costs more per gram of protein."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ryse protein third-party tested like Dymatize?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not that we could verify. We found no Ryse protein in the NSF Certified for Sport registry or on Informed Choice and Informed Sport brand lists. Dymatize ISO100 and Elite 100% Whey show the Informed Choice logo on retailer listings, though the registry returned an error when we checked, so confirm your exact flavor before a drug-tested event."
          }
        },
        {
          "@type": "Question",
          "name": "Which has fewer calories, Ryse or Dymatize?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dymatize ISO100 has fewer: 120 calories per 32 g scoop against 130 for Ryse Loaded's 33.9 g scoop, per the labels we read, both with 25 g of protein. Fat is the main reason, at 1 g for ISO100 and 2.5 g for Ryse. Dymatize Elite 100% Whey is the highest of the three, at 140 calories and 3 g of fat."
          }
        },
        {
          "@type": "Question",
          "name": "Does Ryse Loaded Protein contain casein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, a small amount. The MCT powder in Ryse Loaded is listed with sodium caseinate, a milk protein, alongside the whey isolate and concentrate. Ryse does not say how much. It matters mainly if you avoid casein specifically or assumed Ryse was whey only. Dymatize ISO100's label lists whey isolate and hydrolyzed whey isolate with no casein."
          }
        },
        {
          "@type": "Question",
          "name": "Is Dymatize ISO100 worth the extra money over Ryse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is if you are drug tested, sensitive to lactose or tracking macros tightly. At the Amazon prices we recorded it costs about 28% more per gram than Ryse, roughly $14 a month at one shake a day. For an untested lifter who digests whey concentrate comfortably, that premium buys a leaner label rather than better results."
          }
        },
        {
          "@type": "Question",
          "name": "Which mixes better, Ryse or Dymatize ISO100?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyers commonly report both mixing easily in a shaker bottle. ISO100 is an isolate with lecithin and no gums, so it tends to come out thin and smooth in water. Ryse's MCT powder, inulin and gum blend make it thicker and creamier, which buyers like in milk. We have not mixed either ourselves; these are buyer reports."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "ryse vs dymatize",
      "dymatize vs ryse",
      "dymatize iso100 vs ryse loaded protein",
      "ryse loaded protein vs iso100",
      "ryse protein vs dymatize",
      "dymatize elite whey vs ryse"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Whey Protein Picks",
    link: "/best-whey-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Ryse vs Dymatize</Fragment>
      Ryse Loaded Protein and Dymatize ISO100 both sell licensed cereal and snack flavors, but one is a whey blend with MCT powder and the other is a hydrolyzed whey isolate. Here is how they compare on price per gram, label, testing and stomach comfort, with Dymatize Elite 100% Whey as the third option.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Three Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Isolate vs Blend</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#stomach">Lactose and Digestion</a>
      <a href="#elite">Dymatize Elite Whey</a>
      <a href="#ryse-pros-cons">Ryse Strengths and Gaps</a>
      <a href="#iso-pros-cons">ISO100 Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Ryse Loaded Protein is the cheaper of the two at about $1.67 per 25 g of protein against about $2.14 for Dymatize ISO100, at the Amazon prices we recorded on 20 November 2026. ISO100 is the better-built powder: an isolate with less fat and lactose, a higher Label Score and the Informed Choice logo on retailer listings. Below: label math, testing, buyer-reported taste and who should buy which.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Ryse vs Dymatize: The Short Answer
          </h2>

          <p>
            Ryse Loaded Protein wins on price and flavor fun, while Dymatize ISO100 wins on almost everything printed on the label. Both give 25 g of protein per scoop. ISO100 does it in a smaller 32 g scoop with 120 calories and 1 g of fat; Ryse uses a 33.9 g scoop with 130 calories and 2.5 g of fat. At matching Amazon prices, Ryse costs roughly 22% less per gram of protein.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Ryse Loaded Protein</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Dymatize ISO100</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 33.9 g (74%)</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 32 g (78%)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g (Amazon, 20 Nov)</td>
                    <td class="px-4 py-4 text-gray-700">About $1.67</td>
                    <td class="px-4 py-4 text-gray-700">About $2.14</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein source</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate + concentrate, MCT powder</td>
                    <td class="px-4 py-4 text-gray-700">Hydrolyzed whey isolate + isolate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sport certification</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                    <td class="px-4 py-4 text-gray-700">Informed Choice logo on retailer listings</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweeteners</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose, acesulfame K</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose, stevia</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">56 / 100</td>
                    <td class="px-4 py-4 text-gray-700">64 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Ryse to save money on a fun daily shake; pick ISO100 for a leaner, tested isolate.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Ryse Loaded if</strong> you tolerate dairy well, want Jet-Puffed, Skippy or Little Debbie flavors, and care most about cost per gram. <strong>Pick Dymatize ISO100 if</strong> you are drug tested, lactose sensitive, cutting on tight macros, or want an isolate with Pebbles or Dunkin' flavors. <strong>Pick Dymatize Elite 100% Whey only if</strong> you find it on sale: at the Vitacost price we recorded it was not cheaper per gram than Ryse.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Ryse and Dymatize at a Glance
          </h2>

          <p>
            If you only read one table, read this one. It sets each tub against the shopper it fits and the shopper who should walk past it, beside the two numbers we calculate for every powder we track: the <a href='/methodology/'>Label Score</a> out of 100 and cost per 25 g of protein. Cost is shown at both the Amazon price we recorded and the Vitacost price in our database, because the two disagree.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/ryse-loaded-protein/'>Ryse Loaded Protein</a></td>
                    <td class="px-4 py-4 text-gray-700">Flavor-driven daily shakes, lowest cost of the three</td>
                    <td class="px-4 py-4 text-gray-700">You are drug tested or react to lactose</td>
                    <td class="px-4 py-4 text-gray-700">56</td>
                    <td class="px-4 py-4 text-gray-700">About $1.67 (Amazon) / $1.85 (Vitacost)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/dymatize-iso100/'>Dymatize ISO100</a></td>
                    <td class="px-4 py-4 text-gray-700">Tested athletes, lactose-sensitive stomachs, cutting</td>
                    <td class="px-4 py-4 text-gray-700">You want the cheapest shake that does the job</td>
                    <td class="px-4 py-4 text-gray-700">64</td>
                    <td class="px-4 py-4 text-gray-700">About $2.14 (Amazon, 3 lb) / $2.77 (Vitacost, 5 lb)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/dymatize-elite-100-whey/'>Dymatize Elite 100% Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Dymatize fans who want a big 5 lb tub</td>
                    <td class="px-4 py-4 text-gray-700">You expect it to undercut Ryse at list price</td>
                    <td class="px-4 py-4 text-gray-700">48</td>
                    <td class="px-4 py-4 text-gray-700">About $2.65 (Vitacost, 5 lb)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            ISO100's eight-point lead over Ryse comes from a denser scoop, less fat, a certification claim and a shorter list of additives. Ryse claws some of that back on price, since cost per 25 g is part of our score. Elite lands lowest of the three because its scoop is the least dense at about 69% protein and its gum blend includes carrageenan, which our <a href='/methodology/'>scoring method</a> counts against a label. A lower score is a statement about the label, not a safety warning.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Ryse and Dymatize Powders Are We Comparing?
          </h2>

          <p>
            Ryse's flagship is Loaded Protein and Dymatize's is ISO100, so those two get the main cards, with Dymatize Elite 100% Whey added because it is the Dymatize tub most often weighed against Ryse on price. Label figures are for Ryse Jet-Puffed Marshmallow, ISO100 Gourmet Chocolate and Elite Rich Chocolate. Prices come from our database (Vitacost, 1 November 2026) and from the Amazon prices we recorded on 20 November 2026; all of them will move. Each card links to its full label page in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            These are the full label figures in our database, read from Vitacost's listings when they were checked on 1 November 2026. Ryse publishes its panel only as an image on its own site, and the Dymatize figures come from Vitacost because we could not find a matching page on Dymatize's site. Panels shift by flavor for all three, so treat these as one flavor's numbers, not the whole range.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Ryse Loaded (Jet-Puffed Marshmallow)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">ISO100 (Gourmet Chocolate)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Elite 100% Whey (Rich Chocolate)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
