                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whey protein, 1 scoop</td>
                    <td class="px-4 py-4 text-gray-700">About 24 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">High leucine, fast, cheap per gram</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">3 large eggs</td>
                    <td class="px-4 py-4 text-gray-700">About 18-19 g</td>
                    <td class="px-4 py-4 text-gray-700">About 210</td>
                    <td class="px-4 py-4 text-gray-700">Whole-food nutrients, filling</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Nonfat Greek yogurt, 200 g</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">Casein-rich, slow digesting</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Chicken breast, cooked, 100 g</td>
                    <td class="px-4 py-4 text-gray-700">About 31 g</td>
                    <td class="px-4 py-4 text-gray-700">About 165</td>
                    <td class="px-4 py-4 text-gray-700">Lean, needs cooking</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Firm tofu, 150 g</td>
                    <td class="px-4 py-4 text-gray-700">About 15-20 g (varies by brand)</td>
                    <td class="px-4 py-4 text-gray-700">About 150-200</td>
                    <td class="px-4 py-4 text-gray-700">Complete plant protein</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lentils, cooked, 1 cup</td>
