---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Naked Nutrition Protein Powder Review",
    "url": "/naked-nutrition-protein-powder-review/"
  },
  {
    "title": "Whey vs Whey Isolate",
    "url": "/whey-vs-whey-isolate/"
  },
  {
    "title": "Best Clear Protein Powder",
    "url": "/best-clear-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Ascent Protein Powder Review: Native Whey, Casein and What to Buy";
const description =
  "Ascent protein reviewed by label: what native whey means on today's tub, why the casein is the standout, Informed Sport status and the real cost per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "ascent-whey-protein",
    "name": "Ascent Whey Protein",
    "brand": "Ascent",
    "badge": "Best Overall Ascent",
    "category": "Whey isolate blend (incl. native whey isolate) with whey concentrate",
    "description": "Ascent's flagship gives 25 g of protein and 120 calories per scoop, per the label at the time of writing (33 g scoop for chocolate, 31 g for vanilla). The protein is a whey isolate blend of native whey isolate and regular whey isolate, plus some whey concentrate. It is sweetened with stevia and uses no artificial flavors. Ascent lists 5.5 g of BCAAs and 2.6 g of leucine per scoop, and it is Informed Sport certified.",
    "pros": [
      "Informed Sport certified and certified gluten-free, per Ascent",
      "Stevia only, with no artificial flavors or sweeteners",
      "2.6 g of leucine per scoop, per the brand",
      "4 lb bag is competitively priced per 25 g"
    ],
    "cons": [
      "Contains whey concentrate, so not a pure isolate",
      "Soy lecithin, so the label says it contains soy"
    ],
    "bottomLine": "A cleanly sweetened, certified whey at a fair price. Lactose-sensitive buyers may still prefer a pure isolate.",
    "specs": {
      "Protein / serving": "25 g (label)",
      "Calories": "About 120",
      "Third-party testing": "Informed Sport",
      "Best for": "Tested athletes, daily shakes"
    }
  },
  {
    "id": "ascent-micellar-casein",
    "name": "Ascent Micellar Casein",
    "brand": "Ascent",
    "badge": "Best Ascent for Night",
    "category": "Micellar casein isolate",
    "description": "Ascent's casein gives 25 g of protein and 120 calories in a 36 g scoop of chocolate, per the label at the time of writing. That scoop also has about 661 mg of calcium, roughly half the daily value. The protein is micellar casein isolate, thickened with a guar, acacia and xanthan gum blend and sweetened with stevia. It is soy-free and Informed Sport certified, per Ascent. It is the most interesting product in the range, and the best value per gram.",
    "pros": [
      "25 g of slow-digesting protein in 120 calories",
      "Informed Sport certified and soy-free, per Ascent",
      "Lowest cost per 25 g in the Ascent range at list price"
    ],
    "cons": [
      "Only three flavors",
      "Gum blend makes it thick, which some buyers dislike in a shaker"
    ],
    "bottomLine": "One of the better-value certified caseins, and the Ascent product we would buy first if you want casein.",
    "specs": {
      "Protein / serving": "25 g (label, chocolate)",
      "Calories": "About 120",
      "Third-party testing": "Informed Sport",
      "Best for": "Before bed, puddings"
    }
  },
  {
    "id": "ascent-clear-whey-protein-isolate",
    "name": "Ascent Clear Whey Protein Isolate",
    "brand": "Ascent",
    "badge": "Best Light Option",
    "category": "Clear whey protein isolate",
    "description": "Clear whey is mixed with water into a juice-style drink rather than a milkshake. Ascent's version gives 20 g of protein and 100 calories in a 26 g scoop, per the label at the time of writing. It is pure whey isolate with organic cane sugar, natural flavors, vegetable juice for color, sea salt and stevia, which adds up to about 1 g of added sugar. It is Informed Sport certified and comes in Orange Mango and Pineapple Coconut.",
    "pros": [
      "Light, juice-style drink for hot days or after cardio",
      "Pure whey isolate, Informed Sport certified, per Ascent",
      "No sucralose, unlike many clear wheys"
    ],
    "cons": [
      "Only 20 g of protein per scoop",
      "Highest cost per 25 g in the range"
    ],
    "bottomLine": "Buy it for the format, not for value. A standard whey is cheaper per gram.",
    "specs": {
      "Protein / serving": "20 g (label)",
      "Calories": "About 100",
      "Third-party testing": "Informed Sport",
      "Best for": "Summer, post-cardio"
    }
  },
  {
    "id": "transparent-labs-grass-fed-whey-protein-isolate",
    "name": "Transparent Labs 100% Grass-Fed Whey Protein Isolate",
    "brand": "Transparent Labs",
    "badge": "Alternative: Pure Isolate",
    "category": "Grass-fed whey protein isolate",
    "description": "If you want what Ascent offers, certification and no artificial sweeteners, but in a pure isolate, Transparent Labs is the upgrade. Per the brand at the time of writing, a scoop of about 32 g gives 28 g of protein from grass-fed whey isolate, with roughly 120-150 calories depending on flavor. It is Informed Choice and Informed Protein certified. It costs a little more per gram than Ascent's 4 lb bag at list price, but has no whey concentrate.",
    "pros": [
      "Pure isolate, described as virtually lactose-free",
      "28 g of protein per scoop, per the brand",
      "Informed Choice and Informed Protein certified, per the brand"
    ],
    "cons": [
      "Slightly higher cost per 25 g than Ascent's 4 lb bag",
      "Some flavors contain peanuts"
    ],
    "bottomLine": "The pick for lactose-sensitive buyers who like Ascent's clean label.",
    "specs": {
      "Protein / serving": "28 g (brand)",
      "Calories": "About 120-150",
      "Third-party testing": "Informed Choice + Informed Protein",
      "Best for": "Lactose-sensitive lifters"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0CQ32D39X"
  },
  {
    "id": "naked-nutrition-naked-casein",
    "name": "Naked Casein",
    "brand": "Naked Nutrition",
    "badge": "Alternative: Cheaper Casein",
    "category": "Single-ingredient micellar casein",
    "description": "Naked Casein is one ingredient, micellar casein sourced from US farms. Per the brand, it gives 26 g of protein per two-scoop serving, and it comes unflavored, chocolate or vanilla. In the 5 lb bag it works out cheaper per 25 g than Ascent's casein at list price. Naked says it is NSF Contents Certified, which checks contents and contaminants but is not the same as a sport certification.",
    "pros": [
      "Unflavored version is a single ingredient",
      "Cheaper per 25 g than Ascent casein in the 5 lb bag",
      "26 g of protein per serving, per the brand"
    ],
    "cons": [
      "No Informed Sport or NSF Certified for Sport",
      "Unflavored casein is bland and thick on its own"
    ],
    "bottomLine": "The better buy if you blend casein into recipes and do not need sport certification.",
    "specs": {
      "Protein / serving": "26 g (brand)",
      "Calories": "Check label",
      "Third-party testing": "NSF Contents Certified (brand)",
      "Best for": "Baking, budget casein"
    },
    "amazonUrl": "https://www.amazon.com/dp/B00NBILDQ8"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ascent Protein Powder Review",
          item: `${SITE_URL}/ascent-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Ascent protein a whey isolate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Partly. Ascent's flagship whey lists a whey isolate blend of native whey isolate and regular whey isolate, followed by whey concentrate. So it is mostly isolate, with some concentrate. The Clear Whey Isolate is a pure isolate. If you need a pure isolate for lactose sensitivity, read the ingredient list on the specific product before you buy."
          }
        },
        {
          "@type": "Question",
          "name": "What is Ascent native whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Native whey is filtered directly from milk rather than collected as a by-product of cheesemaking, so it skips the cheese process. Ascent has long marketed native whey, and its current whey label includes native whey protein isolate within an isolate blend. The research showing native whey beats good conventional whey for results is limited."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ascent protein third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Ascent says its whey, casein and clear whey are Informed Sport certified, a program that screens for substances banned in sport. They are also certified gluten-free. Certification applies to tested batches, so if you are a tested athlete, check the product and flavor in the Informed Sport database and keep your batch number."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Ascent casein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The chocolate Micellar Casein label lists 25 g of protein and 120 calories in a 36 g scoop at the time of writing, plus about 661 mg of calcium. Ascent also lists 2.2 g of leucine and 10.7 g of essential amino acids per scoop. Other flavors are similar but vary slightly, so check the panel."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener does Ascent use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ascent uses stevia leaf extract and no artificial sweeteners or flavors in its whey, casein and clear whey, per the labels at the time of writing. The Clear Whey Isolate also contains organic cane sugar, about 1 g of added sugar per scoop. The unflavored whey has no sweetener, for anyone who wants to avoid stevia."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ascent good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can help, as any protein can, because a 120-calorie, 25 g scoop is filling and easy to fit into a calorie budget. The casein's slow digestion and thick texture may help some people feel full for longer. Weight loss still depends on your overall diet. No powder causes fat loss by itself."
          }
        },
        {
          "@type": "Question",
          "name": "Who makes Ascent protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ascent describes itself as a family-owned business based in Denver, Colorado, with more than 30 years of experience making protein. It sells online and through retail stores, and its website has a store locator. Alongside protein, the brand also sells collagen, Creapure creatine and hydration products, according to its website at the time of writing."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "ascent protein powder",
      "ascent native whey",
      "ascent protein review",
      "ascent casein"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Isolate Picks",
    link: "/best-whey-protein-isolate/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Review
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Label-Checked
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Ascent Protein Powder <span class="text-[#38BDF8]">Review</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Stevia-only, Informed Sport certified and sold almost everywhere. Here is what is actually in the tub, which Ascent product is the real standout, and who should buy something else.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#ascent-whey-protein"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#label"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Range
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#lineup" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The Ascent Range</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our Top Picks</a>
          <a href="#label" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. What Is in the Whey</a>
          <a href="#casein" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Why the Casein Stands Out</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cost per 25 g</a>
          <a href="#taste" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Taste and Mixing</a>
          <a href="#compare" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Ascent vs Other Brands</a>
          <a href="#who" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Who Should Buy It</a>
          <a href="#use" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. How to Use It</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Ascent makes clean, certified protein at a fair price, and its casein is better value than its whey. The one thing to know before you buy is that the flagship whey is an isolate and concentrate blend, not a pure isolate.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict on Ascent
          </h2>

          <p>
            Ascent is one of the more honest-looking labels in the protein aisle. Its whey, casein and clear whey are all Informed Sport certified, according to the brand. All use stevia rather than sucralose or other artificial sweeteners, and all carry certified gluten-free status. For a brand sold in physical stores as well as online, that is a strong combination.
          </p>

          <p>
            Our ranking is simple. The <strong>Micellar Casein</strong> is the standout: 25 g of protein in 120 calories, Informed Sport certified, and the best value per gram in the range at list price. The flagship <strong>Whey Protein</strong> is a good, cleanly sweetened daily whey, and it is competitive in the 4 lb bag. The <strong>Clear Whey Isolate</strong> is a nice format and a poor value. Buy it for the format if that matters to you.
          </p>

          <p>
            One thing to understand before you buy is the native whey question. Many people search for Ascent native whey because the brand has long marketed native whey. The current label lists a whey isolate blend that includes native whey isolate, plus regular whey isolate and some whey concentrate. That is a perfectly good formula. It is just not a pure native isolate, and it is not a pure isolate of any kind.
          </p>

          <p>
            We rank Ascent on the label, certification status and cost per 25 g of protein. We have not tasted these products, so any comments on taste are summarized buyer feedback. For the broader isolate market, including the pure isolates Ascent competes with, see our <a href="/best-whey-protein-isolate/">best whey protein isolates</a> roundup.
          </p>
        </div>

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Ascent Range, Explained
          </h2>

          <p>
            Ascent's protein range is compact. There is the core <strong>Whey Protein</strong> in a long list of flavors, the <strong>Micellar Casein</strong> in three flavors, and the <strong>Clear Whey Isolate</strong> in two fruit flavors. Around them sit an Iced Coffee With Protein (20 g of protein and 100 mg of caffeine per serving, per Ascent), collagen peptides, a Creapure creatine and hydration mixes. Ascent describes itself as a family-owned business based in Denver with more than 30 years of experience making protein.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Scoop</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Certification</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whey Protein (chocolate)</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                    <td class="px-4 py-4 text-gray-700">33 g</td>
                    <td class="px-4 py-4 text-gray-700">Informed Sport</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whey Protein (vanilla bean)</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                    <td class="px-4 py-4 text-gray-700">31 g</td>
                    <td class="px-4 py-4 text-gray-700">Informed Sport</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Micellar Casein (chocolate)</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                    <td class="px-4 py-4 text-gray-700">36 g</td>
                    <td class="px-4 py-4 text-gray-700">Informed Sport</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clear Whey Isolate</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">100</td>
                    <td class="px-4 py-4 text-gray-700">26 g</td>
                    <td class="px-4 py-4 text-gray-700">Informed Sport</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Iced Coffee With Protein</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">Check label</td>
                    <td class="px-4 py-4 text-gray-700">Check label</td>
                    <td class="px-4 py-4 text-gray-700">Check label</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Figures come from the nutrition panels on Ascent's product pages at the time of writing and vary a little by flavor. The core whey's flavor list is long: chocolate, vanilla bean, chocolate peanut butter and unflavored are joined by cookies and cream, strawberry, lemon sorbet, brownie batter, fruity cereal, key lime pie, blueberry muffin, mint chocolate chip and seasonal flavors. The specialty flavors are mostly sold in a single 25-serving bag size.
          </p>

          <p>
            Unflavored is worth knowing about. Ascent lists 25 g of protein per serving, in 2 lb bags of 30 servings and 4 lb bags of 60. That makes it one of the cheaper ways into the range. With no sweetener or cocoa, it is the version to cook with. Our <a href="/best-unflavored-protein-powder/">unflavored protein guide</a> ranks it against other plain powders for baking and smoothies.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
