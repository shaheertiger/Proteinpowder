---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Protein Bars",
    "url": "/best-protein-bars/"
  },
  {
    "title": "Best Protein Powder for Baking",
    "url": "/best-protein-powder-for-baking/"
  },
  {
    "title": "Best Protein Pancake Mix",
    "url": "/best-protein-pancake-mix/"
  },
  {
    "title": "Best Protein Cereal",
    "url": "/best-protein-cereal/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best Protein Cookies: Protein per Calorie, Sugar and Real Cost Compared";
const description =
  "The best protein cookies on Amazon ranked on protein per whole cookie vs calories, milk vs wheat and pea protein, sugar and cost per 25 g, plus a DIY option.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
