          item: `${SITE_URL}/best-whey-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best whey protein powder for most people?",
          "acceptedAnswer": {
