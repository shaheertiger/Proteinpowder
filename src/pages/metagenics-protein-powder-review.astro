                    <td class="px-4 py-4 font-black text-gray-900">BioPure Protein</td>
                    <td class="px-4 py-4 text-gray-700">About 23 g</td>
                    <td class="px-4 py-4 text-gray-700">16 g</td>
                    <td class="px-4 py-4 text-gray-700">100</td>
                    <td class="px-4 py-4 text-gray-700">Not stated</td>
                    <td class="px-4 py-4 text-gray-700">None (unflavored)</td>
                  </tr>
