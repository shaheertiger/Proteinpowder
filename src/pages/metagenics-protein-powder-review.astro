                    <td class="px-4 py-4 text-gray-700">Monk fruit (vanilla listing)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Essential Nutrition Shake (UltraMeal Rice), vanilla</td>
                    <td class="px-4 py-4 text-gray-700">48 g</td>
