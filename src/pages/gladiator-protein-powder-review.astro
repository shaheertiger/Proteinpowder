                    <td class="px-4 py-4 text-gray-700">6 g / 2 g / 3 g</td>
                    <td class="px-4 py-4 text-gray-700">5 g / 1 g / 3 g</td>
                    <td class="px-4 py-4 text-gray-700">5 g / 0 g / 3 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cholesterol</td>
                    <td class="px-4 py-4 text-gray-700">35 mg</td>
