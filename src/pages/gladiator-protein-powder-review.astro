const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "gladiator-smoothie-king-gladiator-protein-2lb",
    "name": "Smoothie King Gladiator Protein, Chocolate, 2 lb",
    "brand": "Smoothie King",
    "badge": "The Product Reviewed",
    "category": "Whey isolate, hydrolysate, micellar casein and egg white blend",
    "description": "Gladiator is the protein Smoothie King blends into its Gladiator smoothies, sold in 2 lb tubs in chocolate, vanilla and strawberry. Per the label at the time of writing, two scoops (64 g of chocolate, 61 g of vanilla or strawberry) give 45 g of protein, 220 to 230 calories and 3 g of sugar, with 14 servings per tub and a long vitamin and mineral panel. It is sweetened with sucralose and listed by NSF as Certified for Sport. Prices are set per store; ordering pages we found ranged from about $44 to $80.",
