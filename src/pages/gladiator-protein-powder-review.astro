    "specs": {
      "Protein / serving": "45 g per 2 scoops (label)",
      "Calories": "220 to 230",
      "Third-party testing": "NSF Certified for Sport (registry)",
      "Cost per 25 g": "About $1.75 to $3.17 (store prices found)"
    }
  },
  {
    "id": "gladiator-alt-muscle-milk-pro-series-2lb",
