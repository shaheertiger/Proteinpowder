const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Blessed Protein Powder Review",
          item: `${SITE_URL}/blessed-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Blessed protein third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not by a certification program that we could find. EHPlabs says each batch of Blessed is HPLC, UPLC and LCMS tested for ingredient purity and contaminants, but it does not name the lab or publish results, and we found no NSF Certified for Sport or Informed Sport listing. If you are drug tested, choose a certified product such as NOW Sports Pea Protein, which NOW lists as Informed Sport certified."
          }
        },
        {
          "@type": "Question",
          "name": "Is Blessed protein healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Blessed has a fairly clean label for a flavored protein: pea protein isolate, stevia, natural flavors, vegetable gums and a sunflower oil creamer, with 0 g of sugar where printed. The weak points are sodium, at 600 to 650 mg per scoop in newer flavors, carrageenan in Cookies &amp; Cream, and no published heavy-metal results. It is reasonable for most healthy adults, used as one shake a day."
          }
        },
        {
          "@type": "Question",
          "name": "Does Blessed protein contain dairy, soy or gluten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. EHPlabs describes Blessed as dairy-free, lactose-free, soy-free, gluten-free and vegan, and says it is made on a dedicated vegan production line. The protein comes only from pea. Note that the Peanut Butter flavor, which has a panel on EHPlabs' site but was not listed in the US store when we checked, contains peanuts, so anyone with a peanut allergy should read the allergen statement on the specific tub they buy."
          }
        },
        {
          "@type": "Question",
          "name": "Which Blessed flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In buyer reviews we read, Salted Caramel, the chocolate flavors and Banana Bread were the most consistently praised. Vanilla Chai is more divisive, with some buyers loving it warm and others disliking it. Of the flavors the US store listed when we checked, Banana Bread gets the strongest feedback, while Cookies &amp; Cream suits people who want a chocolate-style shake. We have not tasted them ourselves."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common complaints about Blessed protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyers most often complain that some flavors are too sweet, that there is a stevia-style aftertaste, and that specific flavors such as Vanilla Chai or Strawberry Mylk did not suit them. Price comes up too, since it is not sold on Amazon. On the positive side, many reviewers say it is smooth, not gritty, and easy to digest compared with other plant proteins."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in a scoop of Blessed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every current Blessed panel lists 23 g of protein per scoop, per the labels at the time of writing, except Cookies &amp; Cream, which lists 24 g. Scoop sizes run from about 32 to 38 g depending on flavor, with 120 to 150 calories. The 30-serve tub holds about 690 g of protein in total, and the 45-serve bag about 1,035 g."
          }
        },
        {
          "@type": "Question",
          "name": "Can you take Blessed protein while pregnant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EHPlabs' FAQ says yes, describing Blessed as a natural pea protein food, and the 45-serve bag tells pregnant or breastfeeding buyers to speak with their healthcare practitioner first. We would follow that second instruction. Protein powders are lightly regulated, Blessed publishes no heavy-metal results, and pregnancy changes your needs, so check with your doctor or a registered dietitian before using it."
          }
