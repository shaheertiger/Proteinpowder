                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Complete protein?</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. leucine per 25 g protein</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Main use</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Egg white</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">About 2.1-2.3 g (labels)</td>
                    <td class="px-4 py-4 text-gray-700">Muscle, daily shakes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Beef isolate</td>
                    <td class="px-4 py-4 text-gray-700">Technically yes, collagen-heavy</td>
                    <td class="px-4 py-4 text-gray-700">Roughly 1 g (typical panels)</td>
                    <td class="px-4 py-4 text-gray-700">Dairy-free shakes, larger dose</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Bone broth</td>
                    <td class="px-4 py-4 text-gray-700">Collagen-heavy</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g (Paleovalley profile)</td>
                    <td class="px-4 py-4 text-gray-700">Cooking, coffee, top-up</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Collagen peptides</td>
