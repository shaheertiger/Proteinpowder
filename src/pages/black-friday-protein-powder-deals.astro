const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Black Friday Protein Powder Deals",
          item: `${SITE_URL}/black-friday-protein-powder-deals/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "When is Black Friday 2026 for protein powder deals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Black Friday is Friday, November 27, 2026, the day after Thanksgiving, and Cyber Monday is November 30. Many retailers and brand sites start discounts earlier in Thanksgiving week and some run them into early December. Set your target price per 25 g now and check each day from Monday, November 23, rather than waiting for one moment."
          }
        },
        {
          "@type": "Question",
          "name": "What is a good price per serving for protein powder on Black Friday?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a typical 24-25 g scoop, under about $1.30 a serving is a good Black Friday price for regular whey, under $1.65 for whey isolate and under $1.25 for plain pea protein. Per-serving prices only compare fairly when the servings hold similar protein, so the per-25 g thresholds on this page are the safer check."
          }
        },
        {
          "@type": "Question",
          "name": "Is Black Friday the cheapest time to buy protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is usually one of the cheapest, along with Cyber Monday, Amazon's July and October deal events, and January sales. A good sale takes 25 to 30 percent off the normal price. Some powders are cheap all year, such as Muscle Milk Pro Series at $1.25 per 25 g and plain pea at about $0.71 to $1.02, so a sale matters less for them."
          }
        },
        {
          "@type": "Question",
          "name": "Which protein powder brands have the best Black Friday deals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Direct-to-consumer brands such as Transparent Labs, Myprotein, Legion and Naked have typically run sitewide codes, and big brands such as Optimum Nutrition, Dymatize and Isopure are often discounted at large retailers. We cannot know this year's offers in advance, so compare final prices per 25 g rather than trusting a brand's reputation for sales."
          }
        },
        {
          "@type": "Question",
          "name": "How can I tell if a protein powder deal is real?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Work out the sale price per 25 g of protein: price divided by servings, divided by protein per serving, times 25. Compare that with the normal price for the type in our table, or with a price-history chart such as Keepa for Amazon. If the sale price is not at least 25 percent below normal, the deal is mostly marketing."
          }
        },
        {
          "@type": "Question",
          "name": "Should I buy protein powder in bulk on Black Friday?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if it is a powder and flavor you already use and you will finish it before the best-by date. Three to six months of supply is sensible for most people; at one shake a day, that is one or two 5 lb tubs. Store sealed tubs somewhere cool and dry, and check the best-by date when they arrive."
          }
        },
        {
          "@type": "Question",
          "name": "Are Cyber Monday protein powder deals better than Black Friday?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes, especially on brand websites, which often treat Cyber Monday as their biggest day. Large retailers usually keep similar prices from Black Friday through Cyber Monday. If a powder hits your target price on Friday, buy it; if it is close, waiting until Monday is a reasonable bet. Prices rarely drop further in early December."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
