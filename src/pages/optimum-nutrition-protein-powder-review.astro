---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Whey Protein Powder",
    "url": "/best-whey-protein-powder/"
  },
  {
    "title": "Premier Protein Powder Review",
    "url": "/premier-protein-powder-review/"
  },
  {
    "title": "Dymatize Protein Powder Review",
    "url": "/dymatize-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Optimum Nutrition Protein Powder Review: Which ON Tub to Buy";
const description =
  "ON protein powder reviewed tub by tub: Gold Standard Whey, Isolate, Platinum Hydrowhey, Casein and Plant, compared on label, testing and cost per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "optimum-nutrition-gold-standard-100-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey",
    "brand": "Optimum Nutrition",
    "badge": "Flagship Pick",
    "category": "Isolate-led whey blend",
    "description": "Gold Standard is the default whey for good reason. Per ON's site and label at the time of writing, one scoop gives 24 g of protein, 5.5 g of BCAAs and about 120 to 130 calories depending on flavor, with whey isolate listed as the first ingredient. ON describes it as banned-substance tested and has promoted Informed Choice on many flavors. It comes in more than 20 flavors and tubs up to about 10 lb, and buyers consistently report that it mixes easily with a spoon.",
    "pros": [
      "24 g of protein per scoop with isolate listed first",
      "More than 20 flavors and sizes up to about 10 lb",
      "Roughly $1.30 to $1.50 per 25 g in the 5 lb tub",
      "Banned-substance tested, per the brand"
    ],
    "cons": [
      "Most flavors use sucralose and acesulfame potassium",
      "Not a pure isolate, so some lactose remains"
    ],
    "bottomLine": "The one ON protein most people should buy, ideally in the 5 lb tub.",
    "specs": {
      "Protein per serving": "24 g (label)",
      "Calories": "About 120-130",
      "Third-party testing": "Banned-substance tested (brand)",
      "Best for": "Almost everyone"
    }
  },
  {
    "id": "optimum-nutrition-gold-standard-100-isolate",
    "name": "Optimum Nutrition Gold Standard 100% Isolate",
    "brand": "Optimum Nutrition",
    "badge": "Best for Lactose",
    "category": "Ultra-filtered whey protein isolate",
    "description": "Gold Standard Isolate is the leaner, lower-lactose version of the flagship. Per ON's site at the time of writing, a serving gives 25 g of protein, 5.5 g of BCAAs, about 1 g of carbohydrate and 0.5 g of fat, at roughly 100 to 110 calories depending on flavor. It is banned-substance tested per ON and comes in Chocolate Bliss and Rich Vanilla, at about $2.35 per 25 g of protein in a roughly 3 lb, 44-serving tub.",
    "pros": [
      "25 g of protein in roughly 100-110 calories",
      "Isolate-only, so very low in lactose",
      "Banned-substance tested, per the brand"
    ],
    "cons": [
      "Only two flavors",
      "About 60 to 80 percent more per gram than Gold Standard Whey"
    ],
    "bottomLine": "Worth the premium only if regular whey bloats you or you are cutting hard.",
    "specs": {
      "Protein per serving": "25 g (brand)",
      "Calories": "About 100-110",
      "Third-party testing": "Banned-substance tested (brand)",
      "Best for": "Lactose-sensitive, cutting"
    }
  },
  {
    "id": "optimum-nutrition-gold-standard-100-casein",
    "name": "Optimum Nutrition Gold Standard 100% Casein",
    "brand": "Optimum Nutrition",
    "badge": "Best Before Bed",
    "category": "Micellar casein",
    "description": "Gold Standard Casein gives 24 g of slow-digesting micellar casein per scoop, per ON, at about 120 calories per the label at the time of writing. Flavors include Chocolate Supreme, Creamy Vanilla, Cookies and Cream and Chocolate Peanut Butter. It mixes thick, so buyers often use it as a pudding with less liquid. ON lists it as banned-substance tested, and at about $1.90 per 25 g on ON's site it is cheaper per gram than the isolate.",
    "pros": [
      "Slow-digesting protein for pre-bed or long gaps",
      "Thickens into a pudding with less liquid",
      "Banned-substance tested, per the brand"
    ],
    "cons": [
      "Optional if you already hit your protein target",
      "Thick in a shaker bottle"
    ],
    "bottomLine": "A good second tub for evening shakes, not a replacement for whey.",
    "specs": {
      "Protein per serving": "24 g (brand)",
      "Calories": "About 120",
      "Third-party testing": "Banned-substance tested (brand)",
      "Best for": "Pre-bed shakes, protein pudding"
    }
  },
  {
    "id": "optimum-nutrition-platinum-hydrowhey",
    "name": "Optimum Nutrition Platinum Hydrowhey",
    "brand": "Optimum Nutrition",
    "badge": "Premium Pick",
    "category": "Hydrolyzed whey protein isolate",
    "description": "Platinum Hydrowhey is ON's top tier: 30 g of protein per serving from hydrolyzed whey protein isolate alone, with 8.8 g of BCAAs including added BCAAs, per ON's site at the time of writing. Hydrolyzed protein is partly pre-digested, which some people with sensitive stomachs find easier. It is banned-substance tested per ON, but at about $3.10 per 25 g it costs more than twice Gold Standard Whey.",
    "pros": [
      "30 g of protein per serving from hydrolyzed isolate",
      "May suit people who cannot tolerate other wheys",
      "Banned-substance tested, per the brand"
    ],
    "cons": [
      "About $3.10 per 25 g of protein",
      "Weak evidence of extra muscle benefit over regular whey"
    ],
    "bottomLine": "Only for sensitive stomachs or buyers who do not mind paying double.",
    "specs": {
      "Protein per serving": "30 g (brand)",
      "BCAAs": "8.8 g (incl. added)",
      "Third-party testing": "Banned-substance tested (brand)",
      "Best for": "Sensitive stomachs"
    }
  },
  {
    "id": "optimum-nutrition-gold-standard-100-plant",
    "name": "Optimum Nutrition Gold Standard 100% Plant",
    "brand": "Optimum Nutrition",
    "badge": "Best Vegan",
    "category": "Pea, rice and fava bean protein blend",
    "description": "Gold Standard Plant gives 24 g of protein per serving from pea, rice and fava bean proteins, per ON's site at the time of writing, with 0 g of sugar and no artificial colors, flavors or sweeteners. It comes in Creamy Vanilla and Rich Chocolate Fudge. The blend provides all nine essential amino acids, per ON, but at about $2.45 per 25 g in the 12-serving size it costs much more per gram than ON's whey.",
    "pros": [
      "24 g of plant protein from a pea, rice and fava blend",
      "No artificial sweeteners, colors or flavors, per ON",
      "Familiar brand for vegans switching from whey"
    ],
    "cons": [
      "About $2.45 per 25 g of protein",
      "Only two flavors and no sport certification we could find"
    ],
    "bottomLine": "A solid vegan option from ON, though certified plant proteins compete hard on value.",
    "specs": {
      "Protein per serving": "24 g (brand)",
      "Sugar": "0 g (brand)",
      "Third-party testing": "No sport certification found",
      "Best for": "Vegans, no artificial sweeteners"
    }
  },
  {
    "id": "premier-protein-100-whey-chocolate-milkshake",
    "name": "Premier Protein 100% Whey Protein Powder, Chocolate Milkshake",
    "brand": "Premier Protein",
    "badge": "Alternative: More Protein per Serving",
    "category": "Whey isolate and concentrate blend",
    "description": "If you want more protein per shake at a similar price, Premier is the alternative. Per the label at the time of writing, two scoops give 30 g of protein in about 150 calories, from an isolate-led blend of whey isolate and concentrate, at roughly $1.20 to $1.70 per 25 g at typical prices. It comes in only three classic flavors and has no sport certification we could find.",
    "pros": [
      "30 g of protein per serving",
      "Competitive cost per 25 g",
      "Easy to find in supermarkets and on Amazon"
    ],
    "cons": [
      "Only three flavors",
      "No NSF or Informed certification we could find"
    ],
    "bottomLine": "A good-value alternative for buyers who do not need ON's flavor range or testing claims.",
    "specs": {
      "Protein per serving": "30 g (label, 2 scoops)",
      "Calories": "About 150",
      "Third-party testing": "No sport certification found",
      "Best for": "Budget everyday whey"
    },
    "amazonUrl": "https://www.amazon.com/dp/B06Y5ZG66K"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Optimum Nutrition Review",
          item: `${SITE_URL}/optimum-nutrition-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What does ON stand for in protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ON stands for Optimum Nutrition, the brand behind Gold Standard 100% Whey. Optimum Nutrition is owned by Glanbia, an Irish nutrition group that also owns brands such as Isopure through its performance nutrition division. When people search for ON protein, they usually mean Gold Standard 100% Whey, the brand's best-selling product for decades."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in ON Gold Standard Whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One scoop of Gold Standard 100% Whey gives 24 g of protein and 5.5 g of naturally occurring BCAAs, with about 120 to 130 calories depending on flavor, per ON's site and label at the time of writing. The serving is about 30 to 32 g of powder. A double scoop gives 48 g of protein for about 240 to 260 calories."
          }
        },
        {
          "@type": "Question",
          "name": "Is Optimum Nutrition Gold Standard whey isolate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is an isolate-led blend. The label lists whey protein isolate first, followed by whey protein concentrate and whey peptides. That makes it leaner than a concentrate-led whey but not a pure isolate. If you want isolate only, Gold Standard 100% Isolate gives 25 g of protein with about 1 g of carbohydrate and 0.5 g of fat per serving."
          }
        },
        {
          "@type": "Question",
          "name": "Is ON protein third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ON describes Gold Standard Whey, Isolate, Hydrowhey and Casein as banned-substance tested on its US product pages, and it has promoted Informed Choice certification on many Gold Standard flavors. Certifications are flavor- and market-specific, so drug-tested athletes should check the exact product, flavor and lot number in the Informed Choice database before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Which ON protein is best for beginners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gold Standard 100% Whey. It gives 24 g of protein per scoop, comes in more than 20 flavors, mixes easily according to buyer feedback and is one of the cheapest major-brand wheys per gram in the 5 lb tub. Start with a smaller tub of a popular flavor such as Double Rich Chocolate, then move to a bigger tub."
          }
        },
        {
          "@type": "Question",
          "name": "Is ON Gold Standard good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can help. About 24 g of protein in roughly 120 to 130 calories is a strong ratio, and protein helps with fullness and preserving muscle while dieting. Gold Standard Isolate is slightly leaner still. Neither is a weight-loss product on its own, and anyone planning a large calorie deficit should speak with a doctor or registered dietitian."
          }
        },
        {
          "@type": "Question",
          "name": "Is Optimum Nutrition worth the price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gold Standard Whey in the 5 lb tub is good value at roughly $1.30 to $1.50 per 25 g of protein at typical prices. The rest of the range costs more: about $1.90 per 25 g for Casein, $2.35 for Isolate, $2.45 for Plant and $3.10 for Platinum Hydrowhey, based on ON's listed prices. Buy the others only for a specific need."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "on protein powder",
      "optimum nutrition protein powder",
      "on protein",
      "optimum protein powder",
      "gold standard whey review"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Protein Picks",
    link: "/best-whey-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Review
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Label-Checked
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Optimum Nutrition Protein: <span class="text-[#38BDF8]">Which ON Tub to Buy</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Gold Standard 100% Whey is the default protein powder in America. We read the labels across the ON range, priced each tub per 25 g of protein and set out who should buy which one, and who should skip ON altogether.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#optimum-nutrition-gold-standard-100-whey"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#gold-standard"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Read the Range Breakdown
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#range" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. The ON Protein Range</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Which One to Buy</a>
          <a href="#gold-standard" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Gold Standard Whey Label</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Cost per 25 g of Protein</a>
          <a href="#isolate-hydro" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Isolate vs Hydrowhey</a>
          <a href="#casein-plant" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Casein and Plant</a>
          <a href="#testing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Testing and Certification</a>
          <a href="#vs-rivals" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. ON vs Rivals</a>
          <a href="#who" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Who Should Skip ON</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          For most people, the only Optimum Nutrition product worth buying is the one they already know: Gold Standard 100% Whey in the 5 lb tub. It gives about 24 g of protein per scoop with isolate listed first, it is banned-substance tested per the brand, and in the big tub it is one of the cheapest major-brand wheys per gram. The rest of the range is good but costs more, and only suits specific needs.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            Optimum Nutrition Gold Standard 100% Whey is still the safest default protein powder you can buy. Per ON's site and label at the time of writing, one scoop of about 30 to 32 g gives 24 g of protein, 5.5 g of naturally occurring BCAAs and about 120 to 130 calories depending on flavor. Whey protein isolate is listed as the first ingredient, and ON describes the product as banned-substance tested.
          </p>

          <p>
            It is not the best at anything in particular. It is not the leanest, the cheapest, the cleanest label or the best-tasting. But it is good at everything, comes in more than 20 flavors, mixes with a spoon according to years of buyer feedback, and is sold almost everywhere. In the 5 lb tub it works out to roughly $1.30 to $1.50 per 25 g of protein at typical prices, which is hard to beat from a major brand.
          </p>

          <p>
            The rest of the range is worth knowing about but is a narrower buy. Gold Standard 100% Isolate gives 25 g of protein with about 1 g of carbohydrate and 0.5 g of fat for people who are lactose-sensitive or cutting hard. Platinum Hydrowhey gives 30 g of hydrolyzed isolate at a steep price. Gold Standard Casein is for pre-bed shakes, and Gold Standard Plant is a decent vegan option that costs more per gram than the whey.
          </p>

          <p>
            Our ranking is simple: Gold Standard Whey for almost everyone, Isolate if regular whey upsets your stomach, Casein as an optional second tub, and Hydrowhey or Plant only for specific needs. For the wider category, see our <a href="/best-whey-protein-powder/">best whey protein powder</a> rankings, where Gold Standard is our top pick.
          </p>
        </div>

        <div id="range" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The ON Protein Range
          </h2>

          <p>
            Optimum Nutrition, usually shortened to ON, is owned by Glanbia, the Irish nutrition group whose Glanbia Performance Nutrition division also owns brands including Isopure. Gold Standard 100% Whey has been one of the best-selling protein powders in the US for decades, and many people searching for ON protein are really searching for that one tub.
          </p>

          <p>
            ON's US site lists five protein powders at the time of writing: Gold Standard 100% Whey, Gold Standard 100% Isolate, Platinum Hydrowhey, Gold Standard 100% Plant and Gold Standard 100% Casein, alongside Gold Standard Pro Gainer and Serious Mass, which are weight gainers rather than protein powders. If you want a gainer, our <a href="/best-protein-powder-for-weight-gain/">best protein powder for weight gain</a> guide covers both.
          </p>

          <p>
            Sizes vary by product. Gold Standard Whey comes in tubs of roughly 10, 29, 74 and 149 servings, from about 0.7 lb up to about 10 lb, per ON's site. Gold Standard Isolate comes in a roughly 3 lb tub of about 44 servings, Platinum Hydrowhey in a 1.76 lb tub of about 20 servings, Casein in a roughly 4 lb tub of about 53 servings on ON's site, and Plant in 12-serving and 20-serving sizes.
          </p>

          <p>
            The whole range is sold on Amazon in the US, and Gold Standard Whey in particular is stocked by almost every supplement retailer, warehouse club and many supermarkets. That ubiquity is part of its value: you can compare prices easily, and big-tub discounts are frequent.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Optimum Nutrition Protein to Buy
          </h2>

          <p>
            Optimum Nutrition's current US protein powder range is Gold Standard 100% Whey, Gold Standard 100% Isolate, Platinum Hydrowhey, Gold Standard 100% Casein and Gold Standard 100% Plant, plus mass gainers we cover elsewhere. Here they are ranked by how many buyers they suit, with one clearly labelled alternative for readers who want more protein per serving for less. Nutrition figures are per the label or ON's site at the time of writing and vary by flavor.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <p class="text-white font-black text-lg">{product.name}</p>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
