---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Clean Simple Eats vs Just Ingredients",
    "url": "/clean-simple-eats-vs-just-ingredients/"
  },
  {
    "title": "FlavCity vs Clean Simple Eats",
    "url": "/flavcity-vs-clean-simple-eats/"
  },
  {
    "title": "Isopure vs Optimum Nutrition",
    "url": "/isopure-vs-optimum-nutrition/"
  },
  {
    "title": "Best Clear Protein Powder",
    "url": "/best-clear-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Clean Simple Eats vs Isopure: Cleaner Label or Better Value?";
const description =
  "Isopure Zero Carb is the better value: about $2.04 per 25 g of protein vs $2.71, with 0 g carbs. Clean Simple Eats wins on a stevia-only, grass-fed label.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "clean-simple-eats-vs-isopure-isopure-zero-carb",
    "name": "Isopure Zero Carb Whey Protein Isolate, Creamy Vanilla (3 lb)",
    "brand": "Isopure",
    "badge": "Best Value and Lowest Carb",
    "category": "Whey protein isolate",
    "description": "Per the label at the time of writing, a 31 g scoop of Creamy Vanilla gives 25 g of protein, 110 calories, 0 g of carbohydrate, 0 g of sugar, 0.5 g of fat and 190 mg of sodium, sweetened with sucralose and fortified with a vitamin and mineral blend. At $89.79 for about 44 servings on Vitacost (checked 1 November 2026) it costs about $2.04 per 25 g of protein. We found no NSF Certified for Sport or Informed Choice listing for it.",
    "pros": [
      "About $2.04 per 25 g, the cheaper of the two by about a quarter",
      "0 g carbs and 0 g sugar, per the label",
      "About 81% protein by weight; full 25 g in one scoop",
      "Label Score 63 / 100"
    ],
    "cons": [
      "Sucralose and artificial flavor",
      "Lists soy (lecithin) and adds xanthan gum",
      "No chocolate flavor in the Zero Carb line; no sport certification found"
    ],
    "bottomLine": "The better buy for keto, cutting and anyone who wants the most protein per dollar from these two brands. Skip it if you avoid sucralose or soy, or if you are drug tested.",
    "specs": {
      "Protein / serving": "25 g in 31 g (label)",
      "Carbs / calories": "0 g / 110",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $2.04 ($89.79, ~44 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000E95HP0"
  },
  {
    "id": "clean-simple-eats-vs-isopure-clean-simple-eats-whey",
    "name": "Clean Simple Eats Whey Protein Powder, Brownie Batter (30 servings)",
    "brand": "Clean Simple Eats",
    "badge": "Best Clean Label",
    "category": "Grass-fed whey protein isolate",
    "description": "Per the label at the time of writing, a 27 g scoop of Brownie Batter gives 20 g of protein, 100 calories, 2 g of carbohydrate, under 1 g of sugar, 0.5 g of fat and 130 mg of sodium, sweetened only with stevia leaf extract and with a 100 mg enzyme blend. It contains coconut milk powder. At $64.99 for 30 servings on the brand's store (checked 1 November 2026) it costs about $2.71 per 25 g. The brand says it is third-party tested but names no certifier.",
    "pros": [
      "Stevia is the only sweetener; no gums or soy",
      "Grass-fed whey isolate with an added enzyme blend, per the brand",
      "Twelve flavors, including Snickerdoodle and an Unflavored option",
      "100 calories per scoop"
    ],
    "cons": [
      "About $2.71 per 25 g, roughly a third more than Isopure Zero Carb",
      "20 g per scoop, about 74% protein by weight",
      "Contains coconut milk powder; Label Score 48 / 100"
    ],
    "bottomLine": "Worth the premium if a short, stevia-sweetened label matters more to you than price per gram. Skip it if you want 25 g in one scoop, avoid coconut or are drug tested.",
    "specs": {
      "Protein / serving": "20 g in 27 g (label)",
      "Carbs / calories": "2 g / 100",
      "Third-party testing": "Brand claim; no certifier named",
      "Cost per 25 g": "About $2.71 ($64.99, 30 servings, brand store)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0912XJ8H4"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Clean Simple Eats vs Isopure",
          item: `${SITE_URL}/clean-simple-eats-vs-isopure/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Clean Simple Eats better than Isopure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most buyers, no. Isopure Zero Carb gives 25 g of protein per scoop with 0 g of carbs, costs about $2.04 per 25 g against about $2.71 for Clean Simple Eats, and scores 63 to 48 on our Label Score. Clean Simple Eats is better if you want stevia instead of sucralose, no soy or gums, grass-fed whey and dessert flavors."
          }
        },
        {
          "@type": "Question",
          "name": "Isopure vs Clean Simple Eats: which has fewer calories?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per scoop, Clean Simple Eats has fewer: 100 calories against 110 for Isopure Zero Carb, per the labels. Per gram of protein, Isopure is leaner, because its scoop holds 25 g of protein against 20 g. Scaled to 25 g of protein, Clean Simple Eats comes to about 125 calories and Isopure stays at 110."
          }
        },
        {
          "@type": "Question",
          "name": "Is Clean Simple Eats protein third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The brand says it is, for pathogens, heavy metals and gluten, but it names no certifier and we found no published lot certificates. We could not find an NSF Certified for Sport or Informed Choice listing at the time of writing. Isopure is in the same position, so drug-tested athletes should choose a certified isolate from another brand."
          }
        },
        {
          "@type": "Question",
          "name": "Does Isopure use artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The flavored Zero Carb and Low Carb tubs do. Both list sucralose and natural and artificial flavor, per the Vitacost labels we read. Isopure's clear protein uses stevia instead and says it has no artificial sweeteners or flavors. Clean Simple Eats Whey uses only stevia leaf extract, so it is the pick if you avoid sucralose."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for keto, Clean Simple Eats or Isopure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb, because its label shows 0 g of carbohydrate and 0 g of sugar per 25 g scoop. Clean Simple Eats has 2 g of carbohydrate per 20 g scoop. That small amount fits most keto plans, but on a strict 20 g daily limit two Clean Simple Eats shakes use about a fifth of the budget."
          }
        },
        {
          "@type": "Question",
          "name": "Does Isopure or Clean Simple Eats contain soy or coconut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb and Low Carb list soy because they use soy lecithin. Clean Simple Eats Whey has no soy but contains coconut milk powder, though its allergen line declares only milk. Both contain milk. If you avoid soy, Clean Simple Eats fits; if you avoid coconut, Isopure fits. Always check the bag or tub you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Which clear protein is better, Clean Simple Eats Clear or Isopure Clear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Clear is the better value. It gives 20 g of protein for 90 calories and costs about $2.43 per 25 g in its 36-serving tub, against 100 calories and about $3.44 per 25 g for Clean Simple Eats Clear in the 20-serving bag. Both use stevia. Clean Simple Eats wins only if you prefer its candy-style flavors."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "clean simple eats vs isopure",
      "isopure vs clean simple eats",
      "clean simple eats whey protein vs isopure zero carb",
      "clean simple eats vs isopure low carb",
      "clean simple eats clear protein vs isopure clear",
      "clean simple eats protein powder",
      "isopure zero carb"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Isolate Picks",
    link: "/best-whey-protein-isolate/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Clean Simple Eats vs Isopure</Fragment>
      Both brands sell a flavored whey isolate, but they are built for different shoppers: Clean Simple Eats for people who read ingredient lists, Isopure for people who count carbs and dollars. Here is how the two compare on protein, cost per 25 g, sweeteners, testing and their clear wheys.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Two Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#keto">Keto and Sensitive Stomachs</a>
      <a href="#clear">Clear Whey Matchup</a>
      <a href="#taste">Taste and Flavors</a>
      <a href="#cse-pros-cons">Clean Simple Eats Strengths and Gaps</a>
      <a href="#isopure-pros-cons">Isopure Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Isopure Zero Carb is the better value for most people: it gives 25 g of protein per scoop with 0 g of carbs and costs about $2.04 per 25 g of protein, against about $2.71 for Clean Simple Eats Whey Protein, per the prices in our database. Clean Simple Eats wins if you want grass-fed whey sweetened only with stevia, with no sucralose, gums or soy. Below we compare the labels, the cost math, testing claims, the two brands' clear proteins and who should skip both.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Clean Simple Eats vs Isopure: The Short Answer
          </h2>

          <p>
            Isopure Zero Carb wins on protein per scoop, carbs and price, while Clean Simple Eats wins on ingredients. Per the labels at the time of writing, Isopure gives 25 g of protein in a 31 g scoop for 110 calories and 0 g of carbohydrate, and Clean Simple Eats gives 20 g in a 27 g scoop for 100 calories and 2 g of carbohydrate. Neither has an NSF Certified for Sport or Informed Choice listing that we could find.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Clean Simple Eats Whey</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Zero Carb</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">20 g in 27 g (74%)</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 31 g (81%)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.71</td>
                    <td class="px-4 py-4 text-gray-700">About $2.04</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweetener</td>
                    <td class="px-4 py-4 text-gray-700">Stevia leaf extract</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sport certification</td>
                    <td class="px-4 py-4 text-gray-700">None found (brand says third-party tested)</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">48 / 100</td>
                    <td class="px-4 py-4 text-gray-700">63 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Isopure for value and zero carbs; pick Clean Simple Eats for a stevia-sweetened, gum-free label.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Isopure Zero Carb if</strong> you are on keto or a hard cut, you want a full 25 g in one scoop, or you drink a shake every day and the roughly $20 a month difference matters. <strong>Pick Clean Simple Eats if</strong> you avoid sucralose, soy lecithin and gums, you want grass-fed whey, or you want dessert flavors such as Snickerdoodle and Cake Batter. <strong>Pick neither if</strong> you are a drug-tested athlete or cannot have dairy.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Clean Simple Eats and Isopure at a Glance
          </h2>

          <p>
            Start with the one thing you will not compromise on, then read across. The table sets the five powders that the two brands put up against each other next to the buyer each one suits, the buyer who should pass, and the two numbers we publish for every product: the <a href='/methodology/'>Label Score</a> out of 100 and the cost per 25 g of protein.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/isopure-zero-carb/'>Isopure Zero Carb</a></td>
                    <td class="px-4 py-4 text-gray-700">Keto, cutting, lowest cost per gram of the five</td>
                    <td class="px-4 py-4 text-gray-700">You avoid sucralose or soy, or want chocolate</td>
                    <td class="px-4 py-4 text-gray-700">63</td>
                    <td class="px-4 py-4 text-gray-700">About $2.04</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/isopure-low-carb/'>Isopure Low Carb</a></td>
                    <td class="px-4 py-4 text-gray-700">Chocolate and peanut butter flavors with 1 g carb</td>
                    <td class="px-4 py-4 text-gray-700">You want the cheapest Isopure tub</td>
                    <td class="px-4 py-4 text-gray-700">55</td>
                    <td class="px-4 py-4 text-gray-700">About $2.39</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/clean-simple-eats-whey-protein/'>Clean Simple Eats Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Stevia-only, gum-free, grass-fed isolate; dessert flavors</td>
                    <td class="px-4 py-4 text-gray-700">You want 25 g in a scoop or count every dollar</td>
                    <td class="px-4 py-4 text-gray-700">48</td>
                    <td class="px-4 py-4 text-gray-700">About $2.71</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/isopure-infusions/'>Isopure Clear Protein</a></td>
                    <td class="px-4 py-4 text-gray-700">A juice-style clear whey at a lower price</td>
                    <td class="px-4 py-4 text-gray-700">You want a creamy shake</td>
                    <td class="px-4 py-4 text-gray-700">61</td>
                    <td class="px-4 py-4 text-gray-700">About $2.43</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/clean-simple-eats-clear-protein/'>Clean Simple Eats Clear</a></td>
                    <td class="px-4 py-4 text-gray-700">Candy-style clear flavors such as Peachy Ring</td>
                    <td class="px-4 py-4 text-gray-700">Price per gram matters</td>
                    <td class="px-4 py-4 text-gray-700">42</td>
                    <td class="px-4 py-4 text-gray-700">About $3.44</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The 15-point gap between Isopure Zero Carb and Clean Simple Eats Whey comes from protein density and price, which carry the most weight in our scoring. Isopure is about 81% protein by weight and Clean Simple Eats about 74%, and Isopure costs about a quarter less per gram. Clean Simple Eats claws points back for its short ingredient list and natural sweetener, but not enough to close the gap. A lower score is not a safety verdict; it means the label delivers less protein per dollar and per gram of powder.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Clean Simple Eats and Isopure Powders Are We Comparing?
          </h2>

          <p>
            Each brand sells more than one powder, so the cards below cover the tub most shoppers are choosing between: Clean Simple Eats Whey Protein (Brownie Batter label) and Isopure Zero Carb (Creamy Vanilla label). Isopure Low Carb and both brands' clear proteins are covered in the tables and sections further down. Prices are the ones recorded in our database on 1 November 2026, from the Clean Simple Eats store and Vitacost, and they will move. Full label pages for every product are in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            These are the full label figures for the two flagship powders, per the labels at the time of writing. The Clean Simple Eats column comes from the new-formula Supplement Facts image on the brand's Brownie Batter page. The Isopure column comes from Vitacost's listing for the 3 lb Creamy Vanilla tub, because Isopure's own store did not have a Zero Carb page when our database was checked. Both brands vary slightly by flavor.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Clean Simple Eats Whey (Brownie Batter)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Zero Carb (Creamy Vanilla)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Scoop size</td>
                    <td class="px-4 py-4 text-gray-700">27 g</td>
                    <td class="px-4 py-4 text-gray-700">31 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">74%</td>
                    <td class="px-4 py-4 text-gray-700">81%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">100</td>
                    <td class="px-4 py-4 text-gray-700">110</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                  </tr>
