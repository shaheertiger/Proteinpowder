    ],
    "bottomLine": "A clean, well-liked daily whey at a fair mid-tier price, if you do not need certification.",
    "specs": {
      "Protein per serving": "24 g (label)",
      "Calories": "About 130 (databases)",
      "Third-party testing": "No certification found",
      "Best for": "Sucralose-free daily shakes"
