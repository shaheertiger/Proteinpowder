                    <td class="px-4 py-4 text-gray-700">About 40</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">Brand testing</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Premier Protein Cafe Latte</td>
                    <td class="px-4 py-4 text-gray-700">30 g (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">About 150</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget-mid</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Zero Carb Unflavored</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 100</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">ON Gold Standard Mocha Cappuccino</td>
                    <td class="px-4 py-4 text-gray-700">About 24 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120-130</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
