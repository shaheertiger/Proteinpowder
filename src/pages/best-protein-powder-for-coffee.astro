  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-01", modified: "2026-11-01" });
const title = "Best Protein Powder for Coffee: Picks That Won't Clump";
const description =
  "The best protein powder for coffee, hot or iced: collagen vs whey isolate vs coffee-flavored powders, why whey clumps in hot coffee and how to mix it smoothly.";

const PRODUCTS: {
