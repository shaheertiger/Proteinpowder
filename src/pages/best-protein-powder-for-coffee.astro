const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Coffee",
          item: `${SITE_URL}/best-protein-powder-for-coffee/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Can you put protein powder in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. It is safe and the protein still counts. The main issue is texture: whey can clump in very hot coffee. Collagen peptides dissolve easily in hot coffee, while whey isolate mixes smoothly if you temper it in a little cool milk first or let the coffee cool for a few minutes before stirring it in."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best protein powder for coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For hot coffee, unflavored collagen peptides such as Vital Proteins dissolve most easily. For complete protein, an unflavored whey isolate such as Isopure Unflavored is the better choice if you mix it properly. For iced coffee, a coffee-flavored whey such as Premier Protein Cafe Latte is the least effort and tastes most like a coffee-shop drink."
          }
        },
        {
          "@type": "Question",
          "name": "Does hot coffee destroy protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Heat changes protein's shape, which is called denaturation, and that causes clumping, but it does not remove amino acids. Your stomach denatures protein during digestion anyway. Sustained high heat with sugar, as in baking, can slightly reduce lysine availability, but a few minutes in hot coffee does not meaningfully change the nutrition."
          }
        },
        {
          "@type": "Question",
          "name": "Why does my protein powder curdle in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey proteins begin to set around 70 to 75 degrees Celsius, and fresh coffee is hotter than that. Dry powder also forms a gel shell around a dry core when it hits hot liquid. Mix the powder into a few tablespoons of cool milk first, use a milk frother, or let the coffee cool slightly before adding it."
          }
        },
        {
          "@type": "Question",
          "name": "Is collagen or whey better in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Collagen is better for mixing and whey is better for nutrition. Collagen dissolves in hot coffee without flavor, but it is an incomplete protein and low in leucine. Whey isolate provides complete protein with plenty of leucine for muscle, but it needs tempering or frothing to stay smooth in hot coffee. Many people use collagen daily and whey after training."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein powder should I put in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most people use one serving, which is about 20 to 30 g of protein for whey or 10 to 20 g for collagen. Start with half a scoop to check the texture and sweetness, then build up. If coffee is your main protein source at breakfast, a full serving of whey isolate gets you closer to the 25 to 30 g per meal many guidelines suggest."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use plant protein powder in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can, but it works best in blended iced coffee rather than a hot mug. Pea, rice and other plant proteins tend to stay gritty in hot liquid and can taste earthy against black coffee. A blender with ice and milk hides the texture well. If you want dairy-free protein in hot coffee, a blended frothed latte is the most reliable approach."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
