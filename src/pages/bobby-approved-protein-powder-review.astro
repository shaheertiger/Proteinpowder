const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Bobby Approved Protein Powder",
          item: `${SITE_URL}/bobby-approved-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Bobby Approved protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not that FlavCity states. The Bobby Approved smoothie names no NSF Certified for Sport, Informed Choice, Informed Sport or Clean Label Project certification, and our label-database check found no FlavCity listing in the NSF for Sport registry. The Bobby Approved stamp is Bobby Parrish's own ingredient seal on his own company's product, so it is not an independent test. The bag also carries a Prop 65 warning for lead and cadmium."
          }
        },
