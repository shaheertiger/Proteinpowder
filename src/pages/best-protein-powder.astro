---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "How Much Protein Do I Need?",
    "url": "/how-much-protein-do-i-need/"
  },
  {
    "title": "When to Take Protein Powder",
    "url": "/when-to-take-protein-powder/"
  },
  {
    "title": "Protein Calculator",
    "url": "/protein-calculator/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-16", modified: "2026-10-16" });
const title = "Best Protein Powder: Our Picks by Goal and Budget";
const description =
  "Seven proven protein powders ranked from the label up: protein per scoop, cost per 25 g of protein, third-party certification and ingredients, by goal.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "optimum-nutrition-gold-standard-100-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey",
    "brand": "Optimum Nutrition",
    "badge": "Best Overall",
    "category": "Whey blend (isolate + concentrate)",
    "description": "Gold Standard is the default recommendation because it does everything adequately and nothing badly: about 24 g of protein in a scoop of roughly 30 g, a short and conventional ingredient list, a huge flavor range, and pricing that usually lands at the cheap end of the mid tier. Optimum Nutrition states that it is Informed Choice certified, which matters for anyone who gets drug tested. It is the pick for anyone who wants one tub and no homework.",
    "pros": [
      "About 24 g of protein per scoop of roughly 30 g, close to 80% protein by weight",
      "Informed Choice banned-substance certification claimed by the brand",
      "Widely reported to mix with a spoon or shaker without clumping",
      "Often among the cheapest per 25 g of protein for a major-brand whey"
    ],
    "cons": [
      "Contains concentrate, so a few grams of lactose per scoop may bother sensitive users",
      "Sweetened with sucralose and acesulfame potassium, which some people prefer to avoid"
    ],
    "bottomLine": "The safest single purchase in the category: solid protein density, credible certification and a price most people can sustain.",
    "specs": {
      "Protein / serving": "About 24 g",
      "Protein type": "Whey isolate + concentrate",
      "Third-party tested": "Informed Choice (confirm flavor)",
      "Best for": "Most people"
    }
  },
  {
    "id": "myprotein-impact-whey-protein",
    "name": "Myprotein Impact Whey Protein",
    "brand": "Myprotein",
    "badge": "Best Budget",
    "category": "Whey protein concentrate",
    "description": "Impact Whey is a straightforward whey concentrate that becomes one of the cheapest major-brand proteins per gram when bought on one of Myprotein's frequent sales. The label gives roughly 20 to 21 g of protein in a scoop of about 25 g, depending on flavor and region. It is the pick for people buying protein by the kilogram who care most about cost per serving.",
    "pros": [
      "Frequently discounted, putting it in the budget tier per 25 g of protein",
      "High protein density for a concentrate, around 80% by weight in many flavors",
      "Very large flavor range, including unflavored"
    ],
    "cons": [
      "Smaller scoop means about 20 g per serving unless you use more powder",
      "Full list price is not a bargain; only buy it on sale",
      "Drug-tested athletes should confirm certification for the specific product before use"
    ],
    "bottomLine": "The best value whey if you only ever buy it discounted, which is most of the time.",
    "specs": {
      "Protein / serving": "About 20-21 g",
      "Protein type": "Whey concentrate",
      "Third-party tested": "Check certifier database",
      "Best for": "Tight budgets"
    }
  },
  {
    "id": "dymatize-iso100-hydrolyzed",
    "name": "Dymatize ISO100 Hydrolyzed Whey Isolate",
    "brand": "Dymatize",
    "badge": "Best Isolate",
    "category": "Hydrolyzed whey isolate + whey isolate",
    "description": "ISO100 is the isolate to buy if lactose bothers you or you are counting calories closely. The label gives about 25 g of protein per scoop with only a gram or two of carbohydrate and very little fat, and Dymatize states it carries Informed Choice certification. The hydrolyzed fraction does not build more muscle, but the product earns its spot on purity, certification and the flavor range buyers consistently praise.",
    "pros": [
      "About 25 g of protein per scoop with very little lactose, carbohydrate or fat",
      "Informed Choice certification claimed by the brand",
      "Mixes thin and clear, widely reported to dissolve easily in water"
    ],
    "cons": [
      "Mid-to-upper price tier per 25 g of protein",
      "Paying for hydrolysis buys faster digestion, not more muscle"
    ],
    "bottomLine": "The isolate with the best mix of protein density, certification and taste reports, worth the premium only if you need an isolate.",
    "specs": {
      "Protein / serving": "About 25 g",
      "Protein type": "Hydrolyzed + whey isolate",
      "Third-party tested": "Informed Choice (confirm flavor)",
      "Best for": "Lactose-sensitive, cutting"
    }
  },
  {
    "id": "garden-of-life-sport-organic-plant-based-protein",
    "name": "Garden of Life Sport Organic Plant-Based Protein",
    "brand": "Garden of Life",
    "badge": "Best Plant-Based",
    "category": "Organic pea-based legume blend",
    "description": "Garden of Life Sport delivers about 30 g of protein per two-scoop serving from a pea-based organic legume blend, which is enough to offset the slightly lower leucine content of plant protein. It is certified USDA Organic and Garden of Life states it is NSF Certified for Sport, a combination few vegan powders offer. It suits vegans, people with dairy allergies and plant-based athletes who need banned-substance screening.",
    "pros": [
      "About 30 g of protein per serving, a large dose that closes the leucine gap with whey",
      "NSF Certified for Sport per the brand, rare among plant proteins",
      "Dairy-free, soy-free and certified organic"
    ],
    "cons": [
      "Premium tier per 25 g of protein",
      "Lower protein density than whey, roughly 65-75% of the scoop weight",
      "Buyers commonly describe an earthy taste and thicker, grittier texture"
    ],
    "bottomLine": "The plant protein to buy if certification matters, as long as you accept a premium price and a plant-protein texture.",
    "specs": {
      "Protein / serving": "About 30 g (2 scoops)",
      "Protein type": "Pea-based legume blend",
      "Third-party tested": "NSF Certified for Sport",
      "Best for": "Vegan, dairy-free athletes"
    }
  },
  {
    "id": "thorne-whey-protein-isolate",
    "name": "Thorne Whey Protein Isolate",
    "brand": "Thorne",
    "badge": "Best for Tested Athletes",
    "category": "Whey protein isolate",
    "description": "Thorne built much of its reputation on NSF Certified for Sport products, and its Whey Protein Isolate is one of them, which makes it the pick for athletes in drug-tested sports who cannot afford a contamination mistake. The label gives about 21 g of protein per scoop from whey isolate. You pay a premium for that assurance, and the serving is smaller than most rivals.",
    "pros": [
      "NSF Certified for Sport, the certification most US sports organizations recognize",
      "Isolate base keeps lactose low",
      "Short ingredient list from a brand with a long track record in tested sport"
    ],
    "cons": [
      "One of the most expensive options per 25 g of protein",
      "About 21 g per scoop, below the 25 g most competitors offer",
      "Small flavor range"
    ],
    "bottomLine": "Overkill for recreational lifters, but the right call when a failed drug test would cost you a season.",
    "specs": {
      "Protein / serving": "About 21 g",
      "Protein type": "Whey isolate",
      "Third-party tested": "NSF Certified for Sport",
      "Best for": "Drug-tested athletes"
    }
  },
  {
    "id": "naked-nutrition-naked-whey",
    "name": "Naked Nutrition Naked Whey (Unflavored)",
    "brand": "Naked Nutrition",
    "badge": "Best Clean Ingredients",
    "category": "Grass-fed whey protein concentrate",
    "description": "The unflavored Naked Whey lists a single ingredient, grass-fed whey protein concentrate, on its label at the time of writing. That gives about 25 g of protein per 30 g serving with no sweeteners, flavors, gums or added fibers, which also makes it the easiest powder to blend into oats, smoothies or baking. It is the pick for people who react to sweeteners or simply want to know exactly what they are eating.",
    "pros": [
      "Single-ingredient label: no sweeteners, flavors, gums or thickeners",
      "About 25 g of protein per 30 g serving, high density for a concentrate",
      "Neutral enough to add to food as well as shakes"
    ],
    "cons": [
      "Tastes like plain milk powder on its own; you supply the flavor",
      "Concentrate carries some lactose",
      "Serving is two scoops, and buyers report it can need a blender to mix smoothly"
    ],
    "bottomLine": "The cleanest label here and a fair price per gram, provided you are happy to flavor it yourself.",
    "specs": {
      "Protein / serving": "About 25 g (2 scoops)",
      "Protein type": "Grass-fed whey concentrate",
      "Third-party tested": "Verify current status",
      "Best for": "Minimal ingredients"
    }
  },
  {
    "id": "optimum-nutrition-gold-standard-100-casein",
    "name": "Optimum Nutrition Gold Standard 100% Casein",
    "brand": "Optimum Nutrition",
    "badge": "Best Casein (Nighttime)",
    "category": "Micellar casein",
    "description": "Gold Standard Casein provides about 24 g of slow-digesting micellar casein per scoop, which forms a gel in the stomach and releases amino acids over several hours. That makes it the logical pick for a pre-sleep shake or a filling snack between long gaps in meals. It is optional: nobody needs casein if their daily protein target is already met.",
    "pros": [
      "About 24 g of slow-digesting protein per scoop",
      "Thick texture makes a pudding-style snack when mixed with less liquid",
      "Same widely distributed brand as our top pick"
    ],
    "cons": [
      "Thicker and chalkier than whey, as many buyers note",
      "Lower protein density than an isolate",
      "Not a necessity; whey or food does the same job if your daily total is covered"
    ],
    "bottomLine": "The casein to buy if a bedtime shake is how you hit your daily target; skip it if it is not.",
    "specs": {
      "Protein / serving": "About 24 g",
      "Protein type": "Micellar casein",
      "Third-party tested": "Check certifier database",
      "Best for": "Pre-sleep, snacks"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder",
          item: `${SITE_URL}/best-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder overall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Optimum Nutrition Gold Standard 100% Whey. It gives about 24 g of protein per scoop at close to 80% protein by weight, usually lands at the cheap end of the mid-price tier, and the brand states it holds Informed Choice certification. Choose an isolate, plant protein or NSF-certified product only if you have a specific reason to."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey or plant protein better for building muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey has more leucine per gram and digests quickly, so it has a slight edge gram for gram. In practice, a well-formulated plant blend at a slightly larger dose produces similar results, and trials comparing pea and whey over a training program have found comparable muscle gains. Choose plant protein if you avoid dairy; otherwise whey is usually cheaper."
          }
        },
        {
          "@type": "Question",
          "name": "How many scoops of protein powder should I have a day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As many as it takes to close the gap between your daily target and what your food provides, which for most people is one or two. Each scoop gives roughly 20 to 30 g. Work out your target with a protein calculator, track a few days of food, and divide the shortfall by about 25 g. More than two a day usually signals a diet problem."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to take protein powder every day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For healthy adults, one or two servings a day of a reputable, certified product is considered safe. Heavy metal exposure is the main long-term concern, so favor certified products, rotate brands, and choose vanilla or unflavored over chocolate. People with kidney disease, pregnant women, children and anyone on medication should check with a doctor or registered dietitian first."
          }
        },
        {
          "@type": "Question",
          "name": "Can protein powder help with weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Indirectly. Protein is filling and helps preserve muscle in a calorie deficit, and a shake is an easy, low-calorie way to raise intake. But powder does not burn fat by itself, and calories from shakes still count. The best approach is to use it to replace a low-protein snack or breakfast, not to add it on top of your current diet."
          }
        },
        {
          "@type": "Question",
          "name": "Is grass-fed whey worth paying more for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for muscle gain. Grass-fed describes how the cows were raised, and there is no good evidence that it changes the protein you absorb or the results you get. Some people choose it for ethical, environmental or taste reasons, which is a fair choice. Just compare it on cost per 25 g of protein and certification like any other product."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to drink a protein shake right after a workout?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Research on protein timing suggests total daily intake matters far more than the exact minute you drink a shake. A post-workout shake is convenient and sensible if you trained fasted or many hours after eating, but having protein at a meal within a few hours of training works just as well for most people."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Protein Powder",
    tags: [
      "best protein powder",
      "protein powder",
      "best whey protein",
      "protein powder for muscle gain",
      "third-party tested protein powder",
      "protein powder buying guide"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Protein Powder</span> for Every Goal and Budget
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Seven long-established powders, chosen from the label up: protein per scoop, cost per 25 g of protein, third-party certification and what else is in the tub. One pick per goal, plus an honest note on who can skip protein powder entirely.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#optimum-nutrition-gold-standard-100-whey"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#how-we-picked"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How We Picked
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Answer</a>
          <a href="#choose-the-type" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Whey, Isolate or Plant</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our Top Picks</a>
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. How We Picked</a>
          <a href="#how-much-protein" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How Much Protein You Need</a>
          <a href="#read-the-label" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. How to Read a Label</a>
          <a href="#safety-heavy-metals" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Safety and Heavy Metals</a>
          <a href="#timing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. When to Take It</a>
          <a href="#sweeteners-digestion" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Sweeteners and Digestion</a>
          <a href="#who-can-skip-it" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Who Can Skip It</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Most protein powders are fine, and the differences that matter are printed on the label rather than the front of the tub: how much of each scoop is actually protein, what 25 g of that protein costs you, whether an independent certifier has screened it, and what else rides along in the ingredient list. We ranked seven long-established products on exactly those things. For most people the right answer is a plain, well-certified whey blend at the cheaper end of the market, not the most expensive tub on the shelf.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Answer: Which Protein Powder to Buy
          </h2>

          <p>
            If you want one tub and no homework, buy <strong>Optimum Nutrition Gold Standard 100% Whey</strong>. It gives about 24 g of protein in a scoop of roughly 30 g, per the label at the time of writing, which puts it close to 80% protein by weight. It usually sits at the cheap end of the mid-price tier per gram of protein, buyers widely report that it mixes with a spoon, and Optimum Nutrition states that it carries Informed Choice banned-substance certification. It is not the purest powder on this list, nor the cleanest label. It is simply the one with the fewest reasons not to buy it.
          </p>

          <p>
            Everything else depends on the problem you are trying to solve. If lactose gives you trouble or you are counting every calorie, an isolate such as Dymatize ISO100 strips most of the lactose and fat out. If you avoid dairy, Garden of Life Sport is the plant protein with the strongest certification story. If you compete in a drug-tested sport, Thorne Whey Protein Isolate carries NSF Certified for Sport. If you want nothing in the tub except protein, unflavored Naked Whey lists one ingredient. If price is the only thing that matters, Myprotein Impact Whey on sale is hard to undercut. And if a slow shake before bed is how you close the gap on your daily target, Gold Standard Casein does that job.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Your goal</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Our pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Why it wins</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">One tub, no homework</td>
                    <td class="px-4 py-4 text-gray-700">ON Gold Standard 100% Whey</td>
                    <td class="px-4 py-4 text-gray-700">Dense, certified, mid-price</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lowest cost</td>
                    <td class="px-4 py-4 text-gray-700">Myprotein Impact Whey</td>
                    <td class="px-4 py-4 text-gray-700">Budget tier when on sale</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Low lactose or cutting</td>
                    <td class="px-4 py-4 text-gray-700">Dymatize ISO100</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g protein, minimal carbs and fat</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dairy-free or vegan</td>
                    <td class="px-4 py-4 text-gray-700">Garden of Life Sport</td>
                    <td class="px-4 py-4 text-gray-700">About 30 g protein, NSF certified</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Drug-tested sport</td>
                    <td class="px-4 py-4 text-gray-700">Thorne Whey Protein Isolate</td>
