const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Soy-Free Protein Powder",
          item: `${SITE_URL}/best-soy-free-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best soy-free protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Transparent Labs Grass-Fed Whey Isolate, which uses sunflower lecithin and gives 28 g of protein per scoop per the brand. Naked Whey is the budget pick with no lecithin at all, Klean Isolate suits tested athletes, and Vega Sport Premium Protein is the best soy-free option if you also avoid dairy."
          }
        },
        {
          "@type": "Question",
          "name": "Does whey protein contain soy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey itself is milk protein and contains no soy, but many whey powders add soy lecithin as an emulsifier to help them mix. Those powders must declare soy on the label, usually in a Contains: Milk and Soy statement. Wheys that use sunflower lecithin, or none, such as the four on our list, are soy-free."
          }
        },
        {
          "@type": "Question",
          "name": "Is soy lecithin safe for a soy allergy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Soy lecithin contains only trace soy protein, and many allergists do not ask soy-allergic patients to avoid it. Some highly sensitive people still react, and US law requires it to be labeled as soy. If you have had a severe reaction, avoid it and choose sunflower lecithin or lecithin-free powders, and confirm with your allergist."
          }
        },
        {
          "@type": "Question",
          "name": "Is Optimum Nutrition Gold Standard soy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Per labels and retailer listings we checked at the time of writing, Gold Standard 100% Whey carries a Contains: Milk and Soy statement because it uses soy lecithin. Some listings show sunflower and/or soy lecithin, so check the tub, but treat it as containing soy unless the label you receive says otherwise."
          }
        },
        {
          "@type": "Question",
          "name": "What vegan protein powder is soy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pea-based powders and pea and rice blends are the main soy-free vegan options. Vega Sport Premium Protein, OWYN Pro Elite and NOW Sports Pea Protein contain no soy ingredients per their labels or brands. Many other vegan powders use soy isolate, so read the ingredient list rather than assuming plant-based means soy-free."
          }
        },
        {
          "@type": "Question",
          "name": "Is sunflower lecithin better than soy lecithin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nutritionally they do the same job in tiny amounts, helping powder mix into liquid. Sunflower lecithin's advantage is that sunflower is not one of the nine major US food allergens, so it removes soy from the label. For people avoiding soy for allergy, preference or an elimination diet, sunflower lecithin is the simpler choice."
          }
        },
        {
          "@type": "Question",
          "name": "Does soy protein lower testosterone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Meta-analyses of human clinical trials, including a 2021 review in Reproductive Toxicology, have found no meaningful effect of soy protein or isoflavones on testosterone or estrogen in men at normal intakes. The concern comes mostly from animal studies and rare cases of extreme intake. Soy isolate also supports muscle gain alongside training."
          }
        }
      ],
    },
