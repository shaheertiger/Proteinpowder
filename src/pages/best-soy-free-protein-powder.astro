                    <td class="px-4 py-4 text-gray-700">Sunflower lecithin</td>
                    <td class="px-4 py-4 text-gray-700">Everyday soy-free whey</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Whey (Unflavored)</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">None; whey only</td>
                    <td class="px-4 py-4 text-gray-700">Budget, smoothies</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Klean Athlete Klean Isolate</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">Sunflower lecithin</td>
                    <td class="px-4 py-4 text-gray-700">Tested athletes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Whey Isolate</td>
                    <td class="px-4 py-4 text-gray-700">30 g (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">Sunflower lecithin</td>
                    <td class="px-4 py-4 text-gray-700">Soy-free plus low lactose</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vega Sport Premium Protein</td>
                    <td class="px-4 py-4 text-gray-700">About 30 g</td>
                    <td class="px-4 py-4 text-gray-700">No soy ingredients</td>
                    <td class="px-4 py-4 text-gray-700">Soy-free and dairy-free</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">OWYN Pro Elite</td>
                    <td class="px-4 py-4 text-gray-700">30 g (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">Made without soy (brand)</td>
                    <td class="px-4 py-4 text-gray-700">Multiple allergies</td>
