    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Truvani Protein Review",
          item: `${SITE_URL}/truvani-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Truvani protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a good clean-label organic protein. The vanilla plant protein gives about 20 g from organic pea, pumpkin seed and chia, sweetened only with monk fruit, in roughly 130 calories, per the label. Its weaknesses are the modest dose, a high cost per 25 g and independent reports of detectable heavy metals in its plant protein."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Truvani protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "About 20 g per scoop in both the organic plant protein and the organic whey, per labels at the time of writing. The plant protein runs about 130 calories in vanilla, and the whey about 100. To reach a 25 g serving, use about 1.25 scoops or blend with soy or dairy milk."
          }
        },
        {
          "@type": "Question",
          "name": "Does Truvani make a whey protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Truvani Organic Whey lists three ingredients in vanilla: organic whey protein concentrate, organic vanilla powder and organic monk fruit extract, with about 20 g of protein per scoop. The brand says the milk comes from grass-fed, pasture-raised cows on USDA Organic farms. Vanilla, chocolate and unflavored versions appear on retailer listings."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener does Truvani use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Organic monk fruit extract, with no stevia, no added sugar and no artificial sweeteners, per the labels at the time of writing. That sets Truvani apart from many clean-label proteins, which rely on stevia. Some buyers find monk fruit less bitter than stevia, though plant proteins can still taste earthy, so blending helps."
          }
        },
        {
          "@type": "Question",
          "name": "Does Truvani protein have heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Independent tests published by a lead-safety advocate found lead, cadmium and arsenic in samples of Truvani's chocolate and vanilla plant proteins. Detection is not the same as an unsafe level, and most plant proteins contain some metals. Choose vanilla or the whey, rotate sources, and check with a doctor if you are pregnant."
          }
        },
        {
          "@type": "Question",
          "name": "Is Truvani protein powder USDA Organic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The plant protein is certified USDA Organic, and the brand says its whey comes from certified USDA Organic farms. Organic certification covers farming and processing practices, such as synthetic pesticides. It does not test for heavy metals, so treat it as a sourcing choice rather than a contaminant guarantee."
          }
        },
        {
          "@type": "Question",
          "name": "Is Truvani worth the price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If a five-ingredient organic label and monk fruit sweetening matter to you, yes. On pure value, no: at roughly $2.80 per 25 g of protein for the plant tub, it is one of the pricier plant proteins. Orgain costs less, and Garden of Life Sport Organic delivers more protein per serving with an NSF certification."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
