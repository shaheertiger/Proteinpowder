const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-08", modified: "2026-11-08" });
const title = "Best Protein Powder for PCOS: Low-Sugar, High-Fiber Picks and What the Evidence Says";
const description =
  "The best protein powders for PCOS, compared on sugar, fiber, testing and sweeteners, plus whey vs plant protein and what the research says about inositol.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "thorne-whey-protein-isolate",
    "name": "Thorne Whey Protein Isolate",
    "brand": "Thorne",
    "badge": "Best Overall for PCOS",
    "category": "NSF Certified for Sport whey isolate",
