                <p class="text-3xl font-black text-white">1-2 tbsp</p>
                <p class="text-gray-400 text-xs mt-1">Milk added before a re-spin</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">1/8 tsp</p>
