        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Ninja Creami",
          item: `${SITE_URL}/best-protein-powder-for-ninja-creami/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for Ninja Creami?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Casein and whey-casein blends make the thickest, creamiest pints because they bind water and keep ice crystals small. Optimum Nutrition Gold Standard Casein and PEScience Select are good examples of each. Whey blends work too but usually need a thickener such as xanthan gum or pudding mix."
          }
        },
        {
          "@type": "Question",
          "name": "Why is my Ninja Creami protein ice cream powdery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Protein bases are low in sugar and fat, so they freeze very hard and the first spin often comes out crumbly. Add one to two tablespoons of milk and re-spin. If it stays powdery, switch to casein or a blend, add a pinch of gum, or let the pint temper briefly first."
          }
