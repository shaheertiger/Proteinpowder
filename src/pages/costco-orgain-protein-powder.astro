                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Grass-Fed Whey Protein</td>
                    <td class="px-4 py-4 text-gray-700">about 2 lb</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
