---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Isopure Protein Powder Review",
    "url": "/isopure-protein-powder-review/"
  },
  {
    "title": "Myprotein Review",
    "url": "/myprotein-review/"
  },
  {
    "title": "Is Protein Powder Safe?",
    "url": "/is-protein-powder-safe/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "SEEQ Protein Powder Review: Is the TikTok Clear Whey Worth the Price?";
const description =
  "SEEQ protein powder review: the clear whey isolate's 22 g label, sweeteners, missing certification and cost per 25 g, plus who should buy a cheaper alternative.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "seeq-clear-whey-protein-isolate",
    "name": "SEEQ Clear Whey Protein Isolate",
    "brand": "SEEQ",
    "badge": "The Flagship",
    "category": "Clear whey protein isolate, tub",
    "description": "SEEQ's tub is the brand's main product: a clear whey isolate that mixes with water into a light, fruit-flavored drink. The Amazon listing states 22 g of protein, 4.5 g of BCAAs, 0 g of sugar and 0 g of lactose per scoop, and nutrition databases put a scoop at about 100 calories. Sweeteners appear to vary by listing, so check your flavor's panel.",
    "pros": [
      "22 g of whey isolate protein per scoop, per the label",
      "Roughly 100 calories and 0 g sugar, per databases and the label",
      "Juice-style flavors for people who dislike milky shakes",
      "Sold by the brand's own storefront on Amazon"
    ],
    "cons": [
      "No NSF, Informed Sport or Clean Label Project certification we could find",
      "Premium cost per 25 g of protein",
      "Sweetener system appears to differ between listings"
    ],
    "bottomLine": "A pleasant, lean clear whey that you pay a clear premium for, with no certificate behind it.",
    "specs": {
      "Protein per serving": "22 g (label)",
      "Calories": "About 100 (databases)",
      "Third-party testing": "No certification found",
      "Best for": "People who dislike milky shakes"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0FHQTL57R"
  },
  {
    "id": "seeq-clear-protein-packets-sample-pack",
    "name": "SEEQ Clear Protein Packets Sample Pack (18 Count)",
    "brand": "SEEQ",
    "badge": "Best Way to Try It",
    "category": "Clear whey isolate, single-serve packets",
    "description": "The 18-packet sample box bundles three of SEEQ's best sellers, Blue Razz Freeze, Strawberry Lemonade and Watermelon Wave, per the listing. Each packet carries the same 22 g of protein as a scoop. The listing's ingredients include whey isolate, natural flavors, sucralose, citric and malic acids, spirulina for color and Reb A stevia. It costs more per gram than a tub but lets you find a flavor first.",
    "pros": [
      "Three flavors to test before buying a full tub",
      "22 g of protein per packet, per the label",
      "Portable single-serve format for travel and gym bags"
    ],
    "cons": [
      "Highest cost per 25 g of SEEQ's formats",
      "Contains sucralose and stevia per the listing"
    ],
    "bottomLine": "Buy this first, then commit to a tub of the flavor you actually like.",
    "specs": {
      "Protein per serving": "22 g per packet (label)",
      "Calories": "About 100 (databases)",
      "Third-party testing": "No certification found",
      "Best for": "Sampling flavors, travel"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0F954C9FT"
  },
  {
    "id": "isopure-infusions",
    "name": "Isopure Infusions",
    "brand": "Isopure",
    "badge": "Alternative: Easier to Find",
    "category": "Clear whey isolate powder",
    "description": "Isopure Infusions is the clear version of Isopure's long-running whey isolate line and is widely stocked in US stores and online. It mixes into a light, fruit-flavored drink with about 20 g of protein per scoop and close to zero sugar and fat, per the label at the time of writing. It suits buyers who want a clear whey from a brand with a long isolate track record.",
    "pros": [
      "About 20 g whey isolate protein per scoop, per the label",
      "From a brand known for low-carb isolates for decades",
      "Widely stocked, so easy to compare on price"
    ],
    "cons": [
      "Slightly smaller scoop than SEEQ",
      "Premium cost per 25 g; check certification for your flavor"
    ],
    "bottomLine": "The clear whey to pick if you want a long-established isolate brand you can buy almost anywhere.",
    "specs": {
      "Protein per serving": "About 20 g (label)",
      "Calories": "Low; check label by flavor",
      "Third-party testing": "Check certifier database",
      "Best for": "Store availability, low sugar"
    }
  },
  {
    "id": "thorne-whey-protein-isolate",
    "name": "Thorne Whey Protein Isolate",
    "brand": "Thorne",
    "badge": "Alternative: NSF Certified",
    "category": "Whey protein isolate, flavored",
    "description": "Thorne's whey isolate is the pick for anyone who reads SEEQ's missing certification as a dealbreaker. It delivers about 21 g of protein per scoop from whey isolate with NSF Certified for Sport status, per the brand and NSF at the time of writing. It makes a conventional shake rather than a clear drink, so it trades SEEQ's juice-like texture for documented testing.",
    "pros": [
      "NSF Certified for Sport, per the brand and NSF (verify the flavor)",
      "Whey isolate base with a short ingredient list",
      "No added sugar"
    ],
    "cons": [
      "Not a clear, juice-style drink",
      "Premium cost per 25 g of protein"
    ],
    "bottomLine": "Choose Thorne when verified testing matters more to you than a fruity, transparent drink.",
    "specs": {
      "Protein per serving": "About 21 g (label)",
      "Calories": "Check label by flavor",
      "Third-party testing": "NSF Certified for Sport (verify flavor)",
      "Best for": "Tested athletes, cautious buyers"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "SEEQ Protein Powder Review",
          item: `${SITE_URL}/seeq-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is SEEQ protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As a drink, yes. SEEQ lists 22 g of whey isolate protein, 0 g of sugar and about 100 calories per scoop, and many buyers like its juice-style flavors. Its weaknesses are a premium price, sweeteners that appear to vary between listings and no independent certification we could find. It is a good clear whey, not the best value or the most verified one."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in a scoop of SEEQ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SEEQ's Amazon listing states 22 g of clear whey protein and 4.5 g of BCAAs per scoop, and a supplement database lists the scoop at 28 g. Figures can vary slightly by flavor, so check your tub. That is a solid dose for most adults, a little under the 25 g figure we use to compare protein powders across the site."
          }
        },
        {
          "@type": "Question",
          "name": "Is SEEQ third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We could not find SEEQ in the NSF Certified for Sport, Informed Sport, Informed Choice or Clean Label Project databases at the time of writing, and independent reviewers list it as not third-party tested. That does not mean it is unsafe. It means there is no independent certificate to rely on, which matters most for drug-tested athletes and cautious buyers."
          }
        },
        {
          "@type": "Question",
          "name": "Does SEEQ contain sucralose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some listings say yes. The Amazon stick pack listing names sucralose and Reb A stevia, while a supplement database entry for a tub lists monk fruit and Reb M instead. The formula appears to vary by flavor, format or production run. If you avoid sucralose, read the ingredient panel on the exact product you buy before drinking it."
          }
        },
        {
          "@type": "Question",
          "name": "Where can I buy SEEQ protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SEEQ sells direct from its own store, through its brand storefront on Amazon, at Target in a smaller tub, and in larger tubs and stick packs at Costco and Sam's Club, per those retailers' listings at the time of writing. On Amazon, check that the seller is SEEQ Supply rather than an unknown reseller, which protects you from old or tampered stock."
          }
        },
        {
          "@type": "Question",
          "name": "Is SEEQ good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can help, because a scoop gives 22 g of protein for roughly 100 calories with no sugar, and protein supports fullness and muscle retention during a diet. But it does not burn fat or replace a calorie deficit. Its GLP-1 wording refers to easy protein intake, not to any effect on medication. Ask your prescriber or dietitian for personal advice."
          }
        },
        {
          "@type": "Question",
          "name": "Can I mix SEEQ with milk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is not designed for milk. Clear whey contains acids that can curdle dairy, and the whole point of the format is a transparent, juice-like drink. Mix one scoop with 14 to 16 oz of cold water, shake or froth it, and let it settle for about 30 seconds. If you want a creamy shake, a regular whey is the better buy."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "seeq protein powder",
      "seeq protein",
      "seeq whey protein",
      "seeq protein review"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Clean Protein Picks",
    link: "/best-clean-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Review
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Label-Checked
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          SEEQ Protein Powder <span class="text-[#38BDF8]">Review</span>
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          SEEQ sells one thing: a juice-style clear whey isolate with 22 g of protein a scoop. We checked the label, the sweeteners, the testing and the real cost per 25 g so you know whether it earns a place in your cupboard.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#seeq-clear-whey-protein-isolate"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#label"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Read the Label Breakdown
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#what-is-seeq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. What SEEQ Actually Sells</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our Top Picks</a>
          <a href="#label" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. The Label, Line by Line</a>
          <a href="#sweeteners" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Sweeteners and the Formula Question</a>
          <a href="#cost" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cost per 25 g of Protein</a>
          <a href="#testing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Testing and Certification</a>
          <a href="#taste" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Taste, Mixing and Foam</a>
          <a href="#who" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Who Should Buy It, and Who Should Skip</a>
          <a href="#compare" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. SEEQ vs Other Clear Wheys</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          SEEQ is a good clear whey with a confusing sweetener story, no independent certification and a price that sits at the top of the category. Buy it if you want protein that drinks like a sports drink and you value the flavors. Skip it if you need a tested product or the cheapest gram of whey.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            SEEQ Clear Whey Isolate is a well-made clear protein. Each scoop lists 22 g of protein from whey protein isolate, 0 g of sugar and 0 g of lactose, per the Amazon listing at the time of writing, and nutrition databases put a scoop at roughly 100 calories. That is a genuinely lean way to get protein, and the flavor range is built around fruit and candy profiles that suit people who have given up on milky shakes.
          </p>

          <p>
            The catch is everything around the powder. SEEQ does not carry NSF Certified for Sport, Informed Sport or Clean Label Project certification that we could find, and independent reviewers who have covered it list it as not third-party tested. The sweetener system also appears to differ between listings, which matters if you are avoiding sucralose. And the price per gram of protein is high even by clear whey standards.
          </p>

          <p>
            So the honest answer to whether SEEQ is any good is yes, as a drink. As a value buy or a documented clean protein, it is beaten by products that cost less per gram or carry a certificate. If clean labels are your priority, our <a href="/best-clean-protein-powder/">best clean protein powder</a> guide ranks the products that can prove their testing, and that is where we would send a cautious buyer first.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Good clear whey, premium price, no certificate.</p>
            <p class="text-gray-300 leading-relaxed m-0">Buy SEEQ for the flavor and the light texture. Do not buy it expecting independent testing, a stevia-only label or a budget price per gram of protein.</p>
          </div>

          <p>
            One more framing point before the details. A 22 g scoop is a reasonable dose for most adults, but it is a little under the 25 g figure we use to compare products across the site. That small gap pushes SEEQ's cost per 25 g up further, and it is why the comparison tables later on use cost per 25 g rather than cost per scoop.
          </p>
        </div>

        <div id="what-is-seeq" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. What SEEQ Actually Sells
          </h2>

          <p>
            SEEQ is a Minneapolis-based brand that launched in October 2021, founded by Hannah Perez and Ben Zaver, per the founders' own podcast interviews and business-database records. It grew on TikTok through founder-led videos and street sampling clips before moving into retail. SEEQ launched nationally at Target at the end of December 2024, and it has since appeared at Costco and Sam's Club in larger tubs and stick packs.
          </p>

          <p>
            The product line is narrow. Everything SEEQ sells is a version of its clear whey isolate: full tubs sold direct and on Amazon, a smaller tub made for Target shelves, and single-serve stick packs sold in variety boxes. The flavors rotate, but the core list has included Blue Razz Freeze, Strawberry Lemonade, Watermelon Wave, Mango Pineapple, Fruit Punch and Sour Green Apple, with limited runs such as Juicy Peach and cocktail-inspired flavors.
          </p>

          <p>
            That narrow range is not a flaw in itself. It means the brand has put its effort into one drink rather than a catalog of mediocre tubs. But it also means there is no SEEQ option for people who want a creamy shake, a casein for night-time, a plant protein or an unflavored powder for baking. If you need any of those, you are shopping elsewhere regardless of how much you like the brand.
          </p>

          <p>
            On Amazon, the listings are sold by SEEQ Supply, the brand's own storefront, at the time of writing. That matters for counterfeits and freshness. When you buy a smaller brand's protein on Amazon, check the seller line under the price and avoid third-party resellers with no history, because expired or tampered stock is a real risk with fast-moving viral products.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Format</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Where</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Servings</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Full tub</td>
                    <td class="px-4 py-4 text-gray-700">SEEQ direct, Amazon</td>
                    <td class="px-4 py-4 text-gray-700">About 22-25 per tub, by listing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Retail tub</td>
                    <td class="px-4 py-4 text-gray-700">Target</td>
                    <td class="px-4 py-4 text-gray-700">About 15 per tub</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Large tub</td>
                    <td class="px-4 py-4 text-gray-700">Costco</td>
                    <td class="px-4 py-4 text-gray-700">2.16 lb tub, per the listing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Stick packs</td>
                    <td class="px-4 py-4 text-gray-700">Amazon, Sam's Club</td>
                    <td class="px-4 py-4 text-gray-700">18-count variety boxes</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The SEEQ Range and Two Alternatives
          </h2>

          <p>
            SEEQ is effectively a one-product brand, so the cards below cover its two main formats on Amazon, the tub and the single-serve sample pack, plus two clearly labelled alternatives from other brands. Label figures are per the listing at the time of writing and can vary by flavor, so check the tub you actually buy.
          </p>

          {PRODUCTS.map((product, index) => (
            <div id={product.id} class="scroll-mt-24 mt-12 first:mt-8">
              <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="bg-gray-900 px-6 py-4 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="bg-[#FF4500] text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">
                      {index + 1}
                    </span>
                    {productImages[product.id] && (
                      <img
                        src={productImages[product.id]}
                        alt={product.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="w-10 h-10 rounded-lg bg-white object-contain p-1 shrink-0"
                      />
                    )}
                    <div>
                      <p class="text-white font-black text-lg">{product.name}</p>
                      <p class="text-gray-400 text-xs">{product.category}</p>
                    </div>
                  </div>
                  <span class="bg-[#38BDF8]/20 text-[#38BDF8] px-3 py-1 rounded-full text-xs font-bold hidden sm:block">
                    {product.badge}
                  </span>
                </div>
                <div class="p-6">
                  {product.rating && (
                  <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
