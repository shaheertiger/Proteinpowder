const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "ALOHA Protein Powder Review",
          item: `${SITE_URL}/aloha-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is ALOHA protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Partly. ALOHA says each product is tested by an independent third-party lab for lead, cadmium, mercury and arsenic, and every finished batch is tested to under 5 ppm gluten. It does not publish the results, and the powder carries no sport certification such as NSF Certified for Sport, Informed Sport or Informed Choice. Drug-tested athletes should choose a certified powder instead."
          }
