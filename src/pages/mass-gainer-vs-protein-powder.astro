const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Mass Gainer vs Protein Powder",
          item: `${SITE_URL}/mass-gainer-vs-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is a mass gainer better than whey protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if you cannot eat enough calories. A mass gainer such as Serious Mass adds about 1,250 calories and 50 g of protein per full serving, mostly from maltodextrin, while whey adds about 120 calories and 24 g per scoop. For muscle gain, whey plus food delivers the same protein for less money and less fat gain. Gainers suit true hardgainers with small appetites."
          }
        },
        {
          "@type": "Question",
          "name": "How many calories are in a mass gainer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most big mass gainers list about 1,250 to 1,300 calories per full serving, per their labels at the time of writing: Serious Mass about 1,250, unflavored Naked Mass 1,250 and chocolate Naked Mass about 1,360. Leaner gainers such as Optimum Nutrition Pro Gainer list around 650. Calories vary by flavor and by whether you mix with water or milk."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use protein powder as a mass gainer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Blend one scoop of whey with two cups of whole milk, half a cup of oats, two tablespoons of peanut butter and a banana for about 865 calories and 53 g of protein. At typical grocery prices it costs less per calorie than commercial gainers and gives you more fiber and protein with less maltodextrin. Scale the oats and peanut butter up or down."
          }
        },
        {
          "@type": "Question",
          "name": "Will a mass gainer make me fat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can if the dose is too high. A full 1,250-calorie serving on top of a normal diet is more than double the 300 to 500 calorie surplus most lifters need, so much of it is stored as fat. Use a half serving, weigh yourself weekly, and aim to gain about 0.25 to 0.5% of body weight a week."
          }
        },
        {
          "@type": "Question",
          "name": "Is mass gainer safe for people with diabetes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Talk to your doctor or a registered dietitian first. A full gainer serving contains around 250 g of carbohydrate, mostly maltodextrin, which raises blood glucose quickly even though the sugars line shows only 16 to 20 g. People with diabetes usually do better with a low-sugar protein powder and slower carbohydrates such as oats, fruit and nuts, under medical guidance."
          }
        },
        {
          "@type": "Question",
          "name": "When should I drink a mass gainer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whenever it helps you hit your daily calories; timing matters far less than the total. Many people split a serving into two shakes, one after training and one between meals, which also reduces bloating. Avoid drinking a gainer right before a meal if it kills your appetite, because replacing food with the shake defeats the purpose."
          }
        },
        {
          "@type": "Question",
          "name": "Is mass gainer or whey better for skinny guys?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start with whey and more food, then add a gainer only if that fails. Many skinny lifters simply undereat without realizing it. Track your intake for a week; if you cannot add 300 to 500 calories from food, a half serving of gainer is a convenient fix. If you can eat more, whey plus food is cheaper and leaner."
          }
