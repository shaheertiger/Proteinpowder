                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Eggs, large</td>
                    <td class="px-4 py-4 text-gray-700">3 eggs</td>
                    <td class="px-4 py-4 text-gray-700">18 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lentils, cooked</td>
                    <td class="px-4 py-4 text-gray-700">1 cup</td>
                    <td class="px-4 py-4 text-gray-700">18 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Milk</td>
                    <td class="px-4 py-4 text-gray-700">1 cup</td>
                    <td class="px-4 py-4 text-gray-700">8 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whey protein powder</td>
