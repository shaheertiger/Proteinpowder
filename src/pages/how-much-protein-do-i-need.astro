---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Daily Protein Calculator",
    "url": "/protein-calculator/"
  },
  {
    "title": "When to Take Protein Powder",
    "url": "/when-to-take-protein-powder/"
  },
  {
    "title": "Is Protein Powder Safe?",
    "url": "/is-protein-powder-safe/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-16", modified: "2026-10-16" });
const title = "How Much Protein Do I Need? Daily Targets by Goal";
const description =
  "How much protein do you need a day? Targets in g/kg and g/lb for muscle gain, fat loss, endurance, older adults and pregnancy, with a worked table by weight.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Guides",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "How Much Protein Do I Need",
          item: `${SITE_URL}/how-much-protein-do-i-need/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "How much protein do I need a day to build muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most research supports 1.6 to 2.2 grams per kilogram of body weight per day, or about 0.73 to 1.0 grams per pound. The Morton 2018 meta-analysis found gains plateaued around 1.6 g/kg, with an upper estimate near 2.2 g/kg. Pair that intake with progressive resistance training, because protein without a training stimulus does little for muscle."
          }
        },
        {
          "@type": "Question",
          "name": "Is 1 gram of protein per pound too much?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a healthy adult who trains, no. One gram per pound equals about 2.2 g/kg, the top of the range where studies stopped finding extra benefit for muscle. It is more than most people need, though. If hitting it is a struggle, 0.7 to 0.8 grams per pound captures nearly all the benefit at lower cost and effort."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein do I need to lose weight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you are reasonably lean and lifting, aim toward the higher end, about 1.8 to 2.4 g/kg, to protect muscle in a deficit. If you have a lot of weight to lose, use 1.2 to 1.6 g/kg of a realistic goal weight instead of your current weight. Higher protein also keeps you fuller, which makes the deficit easier to sustain."
          }
        },
        {
          "@type": "Question",
          "name": "Can you eat too much protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For healthy adults there is no clear evidence of harm at intakes up to around 2.2 g/kg, and studies in healthy people have not found kidney damage at higher amounts. The practical downsides of very high intakes are crowding out other foods, digestive discomfort and cost. People with kidney or liver disease need limits set individually by their doctor."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein do older adults need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Expert groups such as PROT-AGE and ESPEN recommend at least 1.0 to 1.2 g/kg per day for healthy adults over 65, and more during illness or recovery. Because older muscle responds less to small doses, aim for 25 to 40 grams per meal and add resistance training. Check with your doctor first if you have reduced kidney function."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need protein powder to hit my target?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Most people can reach their target with meat, fish, eggs, dairy, soy and legumes. Powder is a convenient and often cost-effective way to cover a shortfall of 20 to 50 grams, which is common at higher targets. Add up what your normal meals supply first, then use a scoop or two to close the gap."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein do I need on rest days?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "About the same as on training days. Muscle protein synthesis stays elevated for roughly 24 to 48 hours after resistance training, so recovery continues on rest days. Keeping intake consistent from day to day is simpler and matches what the research tested. You can move carbohydrate up or down with training load, but leave protein steady."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      description: description,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
  ],
};
