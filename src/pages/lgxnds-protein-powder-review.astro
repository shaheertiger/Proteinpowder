    "pros": [
      "28 g of protein per scoop, per the brand",
      "Stevia only, no artificial sweeteners or dyes",
      "Informed Choice certified, per the brand"
    ],
    "cons": [
      "A few more calories per scoop than LGXNDS",
      "Some flavors contain peanuts"
    ],
    "bottomLine": "The swap for anyone who chose LGXNDS for its clean-label claims. Same price, more protein, real certification.",
    "specs": {
      "Protein / serving": "28 g (brand)",
      "Calories": "About 120-130",
      "Third-party testing": "Informed Choice (brand)",
      "Best for": "Clean-label buyers"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0CQ32D39X"
  },
  {
    "id": "dymatize-iso100-hydrolyzed",
    "name": "Dymatize ISO100 Hydrolyzed Whey Isolate, 5 lb",
    "brand": "Dymatize",
    "badge": "Better-Tested Alternative: Bulk",
