---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Whey vs Whey Isolate",
    "url": "/whey-vs-whey-isolate/"
  },
  {
    "title": "Best Protein Powder Without Artificial Sweeteners",
    "url": "/best-protein-powder-without-artificial-sweeteners/"
  },
  {
    "title": "Best NSF Certified Protein Powder",
    "url": "/best-nsf-certified-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-15", modified: "2026-11-15" });
const title = "LGXNDS Premium Whey Isolate Review: 25 g, About $2.20 per 25 g";
const description =
  "LGXNDS Premium Whey Isolate checked against its own label: 25 g protein, sucralose in every flavor, no sport certification found, and about $2.20 per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "lgxnds-premium-whey-isolate-vanilla-ice-cream",
