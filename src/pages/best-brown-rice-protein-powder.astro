                    <td class="px-4 py-4 font-black text-gray-900">PEScience Select Vegan</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">100-110</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
