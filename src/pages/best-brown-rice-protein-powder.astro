            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein/serving</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sugar</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Price tier</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Certification</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Rice</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">Brand-reported heavy-metal testing</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sunwarrior Classic</td>
                    <td class="px-4 py-4 text-gray-700">18-20 g</td>
                    <td class="px-4 py-4 text-gray-700">About 100</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">NutriBiotic Rice Protein</td>
                    <td class="px-4 py-4 text-gray-700">About 12 g (15 g serving)</td>
                    <td class="px-4 py-4 text-gray-700">About 60</td>
                    <td class="px-4 py-4 text-gray-700">Minimal</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Legion Plant+</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                    <td class="px-4 py-4 text-gray-700">130-140</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">Labdoor-certified brand (per Legion)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Thorne Plant Protein</td>
                    <td class="px-4 py-4 text-gray-700">21-22 g</td>
                    <td class="px-4 py-4 text-gray-700">130-140</td>
                    <td class="px-4 py-4 text-gray-700">Low; see label</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Garden of Life Raw Organic Protein</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                    <td class="px-4 py-4 text-gray-700">About 130</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">NSF Gluten-Free, USDA Organic</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Orgain Organic Plant-Based</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">About 150</td>
                    <td class="px-4 py-4 text-gray-700">0-1 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
