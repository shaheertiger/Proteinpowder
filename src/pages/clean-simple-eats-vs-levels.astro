---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Naked vs Optimum Nutrition",
    "url": "/naked-vs-optimum-nutrition/"
  },
  {
    "title": "Isopure vs Levels",
    "url": "/isopure-vs-levels/"
  },
  {
    "title": "Clean Simple Eats vs Isopure",
    "url": "/clean-simple-eats-vs-isopure/"
  },
  {
    "title": "Levels vs Ascent Protein",
    "url": "/levels-vs-ascent-protein/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-22", modified: "2026-11-22" });
const title = "Clean Simple Eats vs Levels: Which Grass-Fed Whey Wins?";
const description =
  "Levels costs about $1.91 per 25 g of protein vs $2.71 for Clean Simple Eats and gives 24 g per scoop vs 20 g; CSE wins on isolate, lactose and flavors.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "clean-simple-eats-vs-levels-levels-grass-fed-whey",
    "name": "Levels Grass-Fed Whey Protein, Vanilla Bean (5 lb)",
    "brand": "Levels",
    "badge": "Best Value and More Protein",
    "category": "Grass-fed whey protein concentrate",
    "description": "Per the Vitacost listing at the time of writing, a 32 g scoop of Vanilla Bean gives 24 g of protein, 130 calories, 3 g of carbohydrate, 2 g of sugar, 2.5 g of fat, 125 mg of sodium and 2.54 g of leucine. It lists six ingredients, sweetened with stevia and monk fruit, and is labeled grass-fed, soy-free and gluten-free. At $129.99 for about 71 servings on Vitacost (checked 1 November 2026) it costs about $1.91 per 25 g of protein.",
    "pros": [
      "About $1.91 per 25 g in the 5 lb tub, 30% less than CSE",
      "24 g of protein per scoop, so one scoop is nearly 25 g",
      "Stevia and monk fruit; no artificial sweeteners; soy-free",
      "Publishes leucine (2.54 g) and BCAAs (5.43 g); Label Score 59 / 100"
    ],
    "cons": [
      "Concentrate: 3 g carbs, 2 g sugar and 2.5 g fat per scoop",
      "No third-party certification we could verify",
      "Brand website redirected to a for-sale page when checked"
    ],
    "bottomLine": "The better buy for anyone who wants grass-fed whey with plant-based sweeteners at a reasonable price per gram. Skip it if you react to lactose or need a certified product.",
    "specs": {
      "Protein / serving": "24 g in 32 g (label)",
      "Sweetener": "Stevia and monk fruit",
      "Third-party testing": "None verified",
      "Cost per 25 g": "About $1.91 ($129.99, 71 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B072M8GTXW"
  },
  {
    "id": "clean-simple-eats-vs-levels-cse-whey",
    "name": "Clean Simple Eats Whey Protein Powder, Brownie Batter (30 servings)",
    "brand": "Clean Simple Eats",
    "badge": "Best for Flavor and Lactose",
    "category": "Grass-fed whey protein isolate",
    "description": "Per the brand's label at the time of writing, a 27 g scoop of Brownie Batter gives 20 g of protein, 100 calories, 2 g of carbohydrate, under 1 g of sugar, 0.5 g of fat and 130 mg of sodium, sweetened with stevia, with a 100 mg digestive enzyme blend. It is made with grass-fed whey isolate and lists coconut milk powder. At $64.99 for 30 servings on the Clean Simple Eats store (checked 1 November 2026) it costs about $2.71 per 25 g.",
    "pros": [
      "Whey isolate: 0.5 g fat and under 1 g sugar per scoop",
      "Stevia only; no artificial sweeteners, gums or xylitol",
      "About 12 flavors, many of them dessert-style",
      "Small digestive enzyme blend (100 mg)"
    ],
    "cons": [
      "About $2.71 per 25 g, roughly 42% more than Levels",
      "20 g of protein per scoop; Label Score 48 / 100",
      "\"Third-party tested\" claim names no certifier"
    ],
    "bottomLine": "Worth the premium if lactose bothers you or you want a dessert-flavored grass-fed shake without sucralose. Skip it if cost per gram or a verifiable certification matters most.",
    "specs": {
      "Protein / serving": "20 g in 27 g (label)",
      "Sweetener": "Stevia",
      "Third-party testing": "Brand claim, no named certifier",
      "Cost per 25 g": "About $2.71 ($64.99, 30 servings, CSE store)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0912XJ8H4"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Clean Simple Eats vs Levels",
          item: `${SITE_URL}/clean-simple-eats-vs-levels/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Clean Simple Eats vs Levels: which is better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Levels Grass-Fed Whey: it gives 24 g of protein per scoop and costs about $1.91 per 25 g, against 20 g and about $2.71 for Clean Simple Eats, per the labels and prices we recorded. Clean Simple Eats is better if lactose bothers you or flavor matters most, since it is an isolate with more dessert flavors."
          }
        },
        {
          "@type": "Question",
          "name": "Is Clean Simple Eats protein whey isolate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Clean Simple Eats Whey Protein is made with grass-fed whey protein isolate, per its label, and adds a 100 mg digestive enzyme blend. Levels Grass-Fed Whey is a whey concentrate. That is why Clean Simple Eats shows 0.5 g of fat and under 1 g of sugar per scoop, against 2.5 g and 2 g for Levels."
          }
        },
        {
          "@type": "Question",
          "name": "Is Levels or Clean Simple Eats third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither has a certification we could verify. Clean Simple Eats says its products are third-party tested but names no certifier. Levels' retail listing mentions a Clean Label Project Purity Award that we could not confirm for this product. Neither appeared in the NSF Certified for Sport database when we checked."
          }
        },
        {
          "@type": "Question",
          "name": "Do Clean Simple Eats and Levels use artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Clean Simple Eats sweetens with stevia leaf extract, and Levels with stevia and monk fruit extract, per their labels. Neither lists sucralose or acesulfame potassium, and neither lists gums. Both also sell unflavored versions with no sweetener, which suit baking and cooking."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for weight loss, Clean Simple Eats or Levels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per scoop, Clean Simple Eats is lighter at 100 calories against 130, but it also has 4 g less protein. Per 25 g of protein the two are close: about 125 calories for Clean Simple Eats and 135 for Levels. Total daily calories decide weight loss, so pick the one you will use consistently."
          }
        },
        {
          "@type": "Question",
          "name": "Is Levels protein still sold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, at the time of writing: Vitacost listed the 5 lb Vanilla Bean tub at $129.99 on 1 November 2026, and our Levels review found active Amazon listings. But the levelsnutrition.com address redirected to a domain-for-sale page when checked, and we could not confirm the brand's current status beyond those retail listings."
          }
        },
        {
          "@type": "Question",
          "name": "Does Clean Simple Eats contain coconut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Brownie Batter label lists coconut milk powder among its ingredients, while declaring only milk as an allergen. Other flavors may differ. If you avoid coconut, read the ingredient list of the exact flavor before buying. Levels Vanilla Bean lists no coconut; its ingredients are whey concentrate, vanilla, sunflower lecithin, salt, stevia and monk fruit."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "clean simple eats vs levels",
      "clean simple eats vs levels protein powder",
      "levels vs clean simple eats",
      "clean simple eats whey vs levels grass fed whey",
      "clean simple eats protein vs levels protein",
      "grass-fed whey isolate vs grass-fed whey concentrate"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Grass-Fed Whey Picks",
    link: "/best-grass-fed-whey-protein/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Clean Simple Eats vs Levels</Fragment>
      Both sell grass-fed whey sweetened with stevia and no artificial sweeteners. Clean Simple Eats uses isolate and sells dessert flavors in 30-serving bags; Levels uses concentrate in 5 lb tubs. Here is how they compare on protein, cost per 25 g, lactose, testing and label.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Two Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#stomach">Isolate vs Concentrate</a>
      <a href="#taste">Taste and Flavors</a>
      <a href="#cse-pros-cons">CSE Strengths and Gaps</a>
      <a href="#levels-pros-cons">Levels Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Levels Grass-Fed Whey is the better buy on value: per the labels and prices in our database, it gives 24 g of protein per scoop and costs about $1.91 per 25 g in the 5 lb tub, against 20 g and about $2.71 for Clean Simple Eats Whey Protein in its 30-serving bag. Clean Simple Eats wins if lactose bothers you or flavor matters most, because it is a whey isolate with a small enzyme blend and a wider dessert-flavor range. Neither is third-party certified. Below we compare the labels, the cost math and who should skip both.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Clean Simple Eats vs Levels: The Short Answer
          </h2>

          <p>
            Levels gives you more protein for less money; Clean Simple Eats gives you an isolate in more flavors. Per the labels we recorded, Levels Vanilla Bean packs 24 g of protein into a 32 g scoop for 130 calories, while Clean Simple Eats Brownie Batter packs 20 g into a 27 g scoop for 100 calories. The two are almost identical in protein density, about 75% and 74% of the powder by weight, so the real differences are price, protein type and flavor.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Clean Simple Eats Whey (Brownie Batter)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Levels Grass-Fed Whey (Vanilla Bean)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein type</td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed whey isolate</td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed whey concentrate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">20 g in 27 g (about 74%)</td>
                    <td class="px-4 py-4 text-gray-700">24 g in 32 g (75%)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbs / sugar / fat</td>
                    <td class="px-4 py-4 text-gray-700">2 g / under 1 g / 0.5 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g / 2 g / 2.5 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweetener</td>
                    <td class="px-4 py-4 text-gray-700">Stevia</td>
                    <td class="px-4 py-4 text-gray-700">Stevia and monk fruit</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Certification</td>
                    <td class="px-4 py-4 text-gray-700">None verified</td>
                    <td class="px-4 py-4 text-gray-700">None verified</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.71 (30-serving bag)</td>
                    <td class="px-4 py-4 text-gray-700">About $1.91 (5 lb tub)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">48 / 100</td>
                    <td class="px-4 py-4 text-gray-700">59 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Levels for value and a full 24 g scoop; pick Clean Simple Eats for an isolate in dessert flavors.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Levels if</strong> you want grass-fed whey without artificial sweeteners at the lowest price per gram of the two, and ordinary whey sits fine with you. <strong>Pick Clean Simple Eats if</strong> whey concentrate gives you gas or bloating, you want the lowest fat and sugar per scoop, or you care most about flavors like Snickerdoodle and Cookies 'N Cream. <strong>Pick neither if</strong> you are drug tested: we could not verify a third-party certification for either brand.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Clean Simple Eats and Levels at a Glance
          </h2>

          <p>
            Start with the one thing you will not compromise on, then read across. Each row pairs a powder with the shopper it serves and the shopper it does not, next to the two numbers we calculate for every product we track: the <a href='/methodology/'>Label Score</a> out of 100 and the cost per 25 g of protein at the dated price in our database.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/levels-grass-fed-whey/'>Levels Grass-Fed Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Value buyers, bulk tubs, stevia fans</td>
                    <td class="px-4 py-4 text-gray-700">You react to lactose or need certification</td>
                    <td class="px-4 py-4 text-gray-700">59</td>
                    <td class="px-4 py-4 text-gray-700">About $1.91</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/clean-simple-eats-whey-protein/'>Clean Simple Eats Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Sensitive stomachs, dessert flavors, low fat</td>
                    <td class="px-4 py-4 text-gray-700">Price per gram matters most</td>
                    <td class="px-4 py-4 text-gray-700">48</td>
                    <td class="px-4 py-4 text-gray-700">About $2.71</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/clean-simple-eats-clear-protein/'>Clean Simple Eats Clear Protein</a></td>
                    <td class="px-4 py-4 text-gray-700">Juice-style shakes in summer</td>
                    <td class="px-4 py-4 text-gray-700">You want a milky shake or low cost</td>
                    <td class="px-4 py-4 text-gray-700">42</td>
                    <td class="px-4 py-4 text-gray-700">About $3.44</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Almost all of the 11-point gap between the two flagships comes from cost. On protein density, the two are within a point (24.1 of 40 for Clean Simple Eats, 25 for Levels). Both score 10 of 10 for amino acid completeness, as every whey does, and neither earns certification points. On sugar and additives Levels scores 12 against 11: our formula gives Clean Simple Eats partial credit because its label prints sugar as "under 1 g" rather than a number. Then cost: 12.1 of 25 for Levels, 3.2 for Clean Simple Eats.
          </p>

          <p>
            We include Clean Simple Eats Clear Protein in the table because it is the brand's other big seller and Levels has no clear protein in our database. For the full range from each brand, see our <a href='/clean-simple-eats-protein-powder-review/'>Clean Simple Eats protein powder review</a> and our <a href='/levels-protein-powder-review/'>Levels protein powder review</a>.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Clean Simple Eats and Levels Products Are We Comparing?
          </h2>

          <p>
            Each brand's flagship is a grass-fed whey, so we compare those: <a href='/protein-powder/clean-simple-eats-whey-protein/'>Clean Simple Eats Whey Protein</a> (Brownie Batter, the chocolate flavor, the label our database recorded) and <a href='/protein-powder/levels-grass-fed-whey/'>Levels Grass-Fed Whey</a> (Vanilla Bean). Label figures are per the labels at the time of writing and vary by flavor. Prices are the ones recorded in our database on 1 November 2026 (the Clean Simple Eats store and Vitacost) and will move. Both cards link through to full label pages in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            Here are the full label figures for each powder, per the labels at the time of writing. Clean Simple Eats figures come from the "new formula" supplement facts image on the brand's Brownie Batter product page; Levels figures come from Vitacost's listing for the 5 lb Vanilla Bean tub. Both brands' numbers shift by flavor, so check the panel of the flavor you buy.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Clean Simple Eats Whey (Brownie Batter)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Levels Grass-Fed Whey (Vanilla Bean)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Scoop size</td>
                    <td class="px-4 py-4 text-gray-700">27 g</td>
                    <td class="px-4 py-4 text-gray-700">32 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">About 74%</td>
                    <td class="px-4 py-4 text-gray-700">About 75%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">100</td>
                    <td class="px-4 py-4 text-gray-700">130</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar</td>
                    <td class="px-4 py-4 text-gray-700">Under 1 g (printed "<1 g")</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat</td>
                    <td class="px-4 py-4 text-gray-700">0.5 g</td>
