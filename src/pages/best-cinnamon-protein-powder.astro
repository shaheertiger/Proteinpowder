const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Cinnamon Protein Powder",
          item: `${SITE_URL}/best-cinnamon-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best cinnamon protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Ghost Whey Cinnabon, which gives 25 g of protein in about 130 calories and lists real Makara cinnamon. Truvani Banana Cinnamon is the best pick with Ceylon cinnamon, Quest Cinnamon Crunch is best for low carb and baking, and vanilla whey isolate plus your own Ceylon gives the most control over the spice."
          }
        },
        {
          "@type": "Question",
          "name": "Is cassia cinnamon in protein powder safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At the small amounts in a typical scoop, cassia is unlikely to be a problem for healthy adults. Coumarin becomes a concern with habitual heavy intake, such as a teaspoon of cassia in a daily shake plus other cinnamon foods. People with liver disease, on liver-processed medication or pregnant should ask their doctor."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between Ceylon and cassia cinnamon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ceylon (Cinnamomum verum) is milder and more floral and contains only trace coumarin. Cassia, the common supermarket cinnamon from Indonesia, Vietnam or China, is stronger and contains much more coumarin. US labels usually just say cinnamon for cassia; brands that use Ceylon nearly always name it."
          }
        },
        {
          "@type": "Question",
          "name": "How much cinnamon can I add to a protein shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A quarter to half a teaspoon is enough for flavor. If you use cassia daily, keep to about a quarter teaspoon, since a full teaspoon of a high-coumarin cassia can reach the tolerable daily intake for many adults. With Ceylon, a half teaspoon a day is not a coumarin concern."
          }
        },
        {
          "@type": "Question",
          "name": "Does cinnamon protein powder lower blood sugar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not in any meaningful way. Trials of cinnamon for blood sugar used 1 to 6 g a day and found modest, inconsistent effects, while a scoop of protein contains a fraction of a gram. A low-sugar protein can help a diabetes-friendly diet, but decisions about blood sugar management belong with your doctor."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a cinnamon protein powder without stevia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Ghost Whey Cinnabon is sweetened with sucralose only, and Truvani Banana Cinnamon uses monk fruit only. Quest Cinnamon Crunch does contain stevia alongside erythritol and sucralose. For no sweetener at all, add Ceylon cinnamon to an unflavored whey such as Naked Whey."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use cinnamon protein powder in oatmeal and baking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it works well. Stir it into oats after they cool slightly so the whey does not clump, and replace no more than about a third of the flour in bakes. Whey and casein blends such as Quest and PEScience stay moister in baking than pure isolates."
