const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Baking",
          item: `${SITE_URL}/best-protein-powder-for-baking/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for baking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most home bakers, a whey and casein blend is the most forgiving choice because casein holds water and softens whey's fast setting. Casein is best for brownies and mug cakes, and pea or plant blends suit dairy-free bakers. Straight whey isolate is the hardest to bake with and is better kept for shakes."
          }
        },
        {
          "@type": "Question",
          "name": "Can you bake with protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Heat changes the protein's shape but not its nutritional value, so baked goods still deliver nearly all the protein on the label. The challenge is texture. Replace only part of the flour, add extra moisture, lower the oven a little and check early, and protein baking works well."
          }
        },
        {
          "@type": "Question",
          "name": "How much flour can I replace with protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A quarter to a third of the flour is a reliable starting point for muffins, pancakes and quick breads. Brownies and mug cakes tolerate up to half. Yeast bread is the least forgiving, with roughly 10 to 15 percent as a practical ceiling before the loaf turns dense and low."
          }
        },
        {
          "@type": "Question",
          "name": "Why are my protein muffins dry and rubbery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually because the batter used whey isolate, too much powder, too little liquid or too long in the oven. Isolate coagulates quickly and has no fat to keep it tender. Switch to a blend or casein, add yogurt or fruit purée, include a little fat and pull the muffins earlier."
          }
        },
        {
          "@type": "Question",
          "name": "Does heat destroy protein in protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Baking denatures protein, but digestion does the same thing, and the amino acids remain available. A small amount of lysine can be tied up in browned crusts through the Maillard reaction, but at normal home baking temperatures and times the effect on overall protein value is small."
          }
        },
        {
          "@type": "Question",
          "name": "Is unflavored or flavored protein powder better for baking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flavored powders are easier because they add sweetness and flavor, but they lock you into one taste and contain non-nutritive sweeteners. Unflavored powder gives full control and works in savory recipes. If you bake often, an unflavored tub plus your own sweetener is the most versatile setup."
          }
        },
