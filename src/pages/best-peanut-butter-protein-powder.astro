                    <td class="px-4 py-4 font-black text-gray-900">PB2 Original Powdered Peanut Butter</td>
                    <td class="px-4 py-4 text-gray-700">6 g (2 tbsp)</td>
                    <td class="px-4 py-4 text-gray-700">60</td>
                    <td class="px-4 py-4 text-gray-700">Check label</td>
