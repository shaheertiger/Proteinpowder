---
import Layout from "../layouts/Layout.astro";
import { SITE_URL } from "../data/authors";
import { CONTACT_EMAIL, SITE_NAME } from "../data/site";

const title = "Terms of Service";
const description = `The terms under which ${SITE_NAME} publishes, and the limits of our advice.`;
const updated = "16 October 2026";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: `${SITE_URL}/terms/`,
  dateModified: "2026-10-16",
};
---

<Layout title={title} description={description} jsonLd={schema}>
  <article class="max-w-3xl mx-auto px-4 py-16 lg:py-24">
    <h1 class="text-4xl font-black text-gray-900 leading-tight mb-3">Terms of Service</h1>
    <p class="text-sm text-gray-500 mb-10">Last updated {updated}</p>

    <div class="space-y-6 text-gray-700 leading-relaxed">
      <h2 class="text-2xl font-black text-gray-900">Using this site</h2>
      <p>The guides here are free to read. You are welcome to quote a short passage with a link back. Republishing a guide in full, or feeding our content to a scraper, is not permitted.</p>

      <h2 class="text-2xl font-black text-gray-900 pt-4">Our advice has limits</h2>
      <p>We research products and report what we find, but we cannot know your health, your diet, your medications or your goals. Nothing on this site is medical, nutritional or dietary advice, and it is not a substitute for advice from a doctor or registered dietitian. Dietary supplements are not intended to diagnose, treat, cure or prevent any disease.</p>
      <p>Talk to a qualified professional before using protein supplements if you have kidney or liver disease, are pregnant or breastfeeding, have a food allergy, are giving supplements to a child, or take prescription medication. Follow the manufacturer's directions and stop using a product that causes a reaction.</p>

      <h2 class="text-2xl font-black text-gray-900 pt-4">Prices and availability</h2>
      <p>Prices and cost-per-serving figures are approximate at the time of writing and move constantly. Nutrition figures are taken from the manufacturer's label at the time of writing and change between flavours and reformulations. The retailer's listing and the label on the product are always the authority on price, availability and current formula.</p>

      <h2 class="text-2xl font-black text-gray-900 pt-4">Affiliate relationships</h2>
      <p>We earn commission on some outbound links, including as a participant in the Amazon Services LLC Associates Program. Commission does not vary between the products within a guide and does not affect rankings. The detail is on <a href="/how-we-test/" class="text-[#1E90FF] font-bold no-underline hover:underline">How We Test</a>.</p>

      <h2 class="text-2xl font-black text-gray-900 pt-4">Third-party sites</h2>
      <p>We link to retailers and manufacturers. We do not control those sites and are not responsible for their content, prices, or privacy practices.</p>

      <h2 class="text-2xl font-black text-gray-900 pt-4">Trademarks</h2>
      <p>Product and brand names are the property of their owners. Naming a product in a guide does not imply any endorsement of this site by its manufacturer.</p>

      <h2 class="text-2xl font-black text-gray-900 pt-4">Contact</h2>
      <p>Questions about these terms go to <a href={`mailto:${CONTACT_EMAIL}`} class="text-[#1E90FF] font-bold no-underline hover:underline">{CONTACT_EMAIL}</a>.</p>

      <p class="text-sm text-gray-500 border-t border-gray-200 pt-6">These terms are written in plain language rather than by a lawyer. If your jurisdiction requires specific terms, have them reviewed.</p>
    </div>
  </article>
</Layout>
