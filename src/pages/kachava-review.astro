const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Ka'Chava Protein Powder Review: Meal Shake or Overpriced Protein?";
const description =
