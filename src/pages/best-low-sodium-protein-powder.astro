const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Low Sodium Protein Powder",
          item: `${SITE_URL}/best-low-sodium-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best low sodium protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, NOW Sports Whey Protein Isolate Unflavored, at about 45 mg of sodium per 24 g of protein per the label, is the best balance of low sodium, price and availability. Klean Isolate is lower at about 30 mg and NSF Certified for Sport, per the brand. For dairy-free, Bob's Red Mill Almond Protein lists about 25 mg."
          }
        },
        {
          "@type": "Question",
          "name": "Which protein powder has the least sodium?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hemp protein is the lowest we found: Nutiva's label lists sodium at or near 0 mg per 30 g serving, though it gives only about 15 g of protein. Among flavored powders, Isopure Infusions lists about 10 to 15 mg per scoop. Unflavored whey isolates typically land between about 30 and 50 mg per serving."
          }
        },
        {
          "@type": "Question",
          "name": "Why does pea protein have so much sodium?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pea protein isolate is usually made by dissolving the protein at high pH, precipitating it with acid and neutralizing it again, and sodium hydroxide is commonly used for those steps, so sodium remains in the powder. Levels vary by supplier, from roughly 100 mg to several hundred milligrams per serving. Flavored blends may add salt too."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey protein high in sodium?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unflavored whey is not. Isolates and concentrates usually list about 30 to 60 mg per serving, because milk naturally contains a little sodium. Flavored whey is often higher, around 100 to 200 mg, because chocolate and dessert flavors add salt. Check the panel for the exact flavor you plan to buy."
          }
        },
        {
          "@type": "Question",
          "name": "How much sodium is low for a protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The FDA allows a low sodium claim at 140 mg or less per serving, very low sodium at 35 mg or less and sodium free under 5 mg. For a protein powder, we treat 50 mg or less per serving as genuinely low, and we compare products on sodium per 25 g of protein."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use protein powder if I have high blood pressure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A low-sodium powder is generally easy to fit into a sodium-restricted diet, since a 45 mg scoop is a small share of a 1,500 to 2,300 mg daily limit. If you take blood pressure medication, have heart failure or a sodium target from your doctor, check with them or a registered dietitian first, and count the shake in your total."
          }
        },
        {
          "@type": "Question",
          "name": "Is low sodium protein powder safe for kidney disease?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not automatically. People with chronic kidney disease may need to limit total protein, potassium and phosphorus as well as sodium, while some on dialysis need more protein. Those targets depend on your stage and lab results, so ask your nephrologist or a renal dietitian whether any protein powder suits you before buying one."
          }
        }
      ],
    },
