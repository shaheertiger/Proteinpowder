const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Best Cheap Protein Powder: Ranked by Real Cost per 25 g of Protein";
const description =
  "The best cheap protein powder, ranked by real cost per 25 g of protein, plus how to buy in bulk, time Subscribe and Save and sales, and spot amino-spiked tubs.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
