    ],
    "bottomLine": "The best value for people who cook with protein or want total control over sweeteners.",
    "specs": {
      "Protein / serving": "About 25 g (2 scoops)",
      "Calories": "About 120",
      "Third-party tested": "Verify current status",
      "Best for": "Unflavored bulk buyers"
    }
  },
  {
    "id": "now-sports-whey-protein-isolate",
    "name": "NOW Sports Whey Protein Isolate (Unflavored)",
    "brand": "NOW Foods",
