---
import Layout from '../layouts/Layout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import { CATEGORIES } from '../data/constants';
import { SITE_NAME, SITE_URL } from '../data/site';

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description: 'Independent protein powder reviews built on the label: protein per scoop, cost per gram, ingredients and third-party testing.',
};

const CHECKS = [
  { value: '25 g', label: 'Cost compared per 25 g of protein' },
  { value: '100%', label: 'Of picks get a cons list' },
  { value: '3rd-party', label: 'Certification checked in the database' },
  { value: '$0', label: 'Paid placements accepted' },
];

const LATEST = [
  { kicker: 'Sizing Guide', title: 'How Much Protein Do I Need?', blurb: 'Grams per kilo by goal, what the RDA misses, and how to split it across meals.', url: '/how-much-protein-do-i-need/' },
  { kicker: 'Comparison', title: 'Whey vs Whey Isolate', blurb: 'What the extra filtering removes, what it costs you per 25 g of protein, and who needs it.', url: '/whey-vs-whey-isolate/' },
  { kicker: 'Safety', title: 'Is Protein Powder Safe?', blurb: 'Heavy metals, label accuracy, banned substances — and the checklist for picking a safer tub.', url: '/is-protein-powder-safe/' },
];
---
<Layout jsonLd={siteSchema}>
  <div class="space-y-20">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-24 lg:pt-28 lg:pb-32 bg-gradient-to-br from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-block mb-4">
              <TrustBadge />
            </div>
            <h1 class="text-5xl lg:text-7xl font-black tracking-tight text-[#333333] mb-6 leading-[1.1]">
              Read the Label. <br />
              <span class="text-[#1E90FF]">Buy the Right Tub.</span>
            </h1>
            <p class="text-xl text-gray-600 mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed">
              {SITE_NAME} ranks protein powders on what actually decides value — protein per scoop, cost per gram, what else is in the tub, and who has independently checked it.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="/best-protein-powder/"
                class="bg-[#FF4500] hover:bg-[#E63E00] text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 shadow-xl hover:shadow-2xl transition-all no-underline"
              >
                See Our Top Picks
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
              <a
                href="/protein-calculator/"
                class="bg-white hover:bg-gray-50 text-[#333333] border-2 border-gray-200 px-8 py-4 rounded-xl font-bold text-lg shadow-sm no-underline text-center"
              >
                Calculate Your Protein
              </a>
            </div>
          </div>
          <div class="mt-16 lg:mt-0 relative">
            <div class="absolute -top-12 -right-12 w-64 h-64 bg-[#1E90FF]/10 rounded-full blur-3xl"></div>
            <div class="relative bg-gray-900 rounded-3xl shadow-2xl border border-gray-800 p-8 lg:p-10">
              <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-6">What we check on every tub</p>
              <ul class="space-y-4 list-none p-0 m-0">
                {[
                  ['Protein per scoop', 'and as a share of the scoop weight'],
                  ['Cost per 25 g of protein', 'not price per tub'],
                  ['Third-party certification', 'looked up in the certifier\'s database'],
                  ['The full ingredient list', 'sweeteners, fillers, gut irritants'],
                  ['Amino spiking', 'protein numbers padded with cheap aminos'],
                ].map(([head, sub]) => (
                  <li class="flex items-start gap-3">
                    <span class="bg-[#FF4500] text-white w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                    </span>
                    <div>
                      <p class="text-white font-bold m-0">{head}</p>
                      <p class="text-gray-400 text-sm m-0">{sub}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF]"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          Browse by Category
        </h2>
        <a href="/best-of/" class="text-[#1E90FF] font-bold hover:underline flex items-center gap-1 no-underline">
          See all
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {CATEGORIES.map(cat => (
          <a
            href={cat.url}
            class="group bg-white border border-gray-100 p-8 rounded-3xl text-center hover:border-[#1E90FF] hover:shadow-xl transition-all no-underline"
          >
            <span class="text-5xl block mb-6 transform group-hover:scale-110 transition-transform">{cat.icon}</span>
            <h3 class="font-bold text-lg text-gray-900 group-hover:text-[#1E90FF]">{cat.name}</h3>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured Guide -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 rounded-3xl overflow-hidden shadow-2xl border border-gray-700">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
          <div class="p-10 lg:p-14 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-6">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
                  #1 Guide
                </span>
              </div>
              <h2 class="text-3xl lg:text-4xl font-black text-white leading-tight mb-4">
                Best Protein Powder:<br/>
                <span class="text-[#1E90FF]">Picks by Goal &amp; Budget</span>
              </h2>
              <p class="text-gray-400 text-lg leading-relaxed mb-8">
                Whey, isolate and plant powders ranked on protein per scoop, cost per 25 g of protein, ingredients and third-party testing — with the trade-offs for every pick.
              </p>
            </div>
            <a
              href="/best-protein-powder/"
              class="inline-flex items-center justify-center gap-2 bg-[#FF4500] hover:bg-[#E63E00] text-white px-8 py-4 rounded-xl font-black text-lg shadow-lg shadow-[#FF4500]/25 transition-all transform hover:-translate-y-0.5 no-underline w-full sm:w-auto text-center"
            >
              Read the Full Guide
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </div>
          <div class="bg-white/5 border-t lg:border-t-0 lg:border-l border-white/10 p-10 lg:p-14 flex flex-col justify-center gap-4">
            <p class="text-gray-400 text-xs font-black uppercase tracking-widest mb-2">More Buying Guides</p>
            {[
              { name: 'Best Whey Protein Isolate', badge: 'Lowest lactose, leanest scoop', url: '/best-whey-protein-isolate/' },
              { name: 'Best Plant-Based Protein Powder', badge: 'Dairy-free and vegan', url: '/best-plant-based-protein-powder/' },
              { name: 'Whey vs Plant Protein', badge: 'Which one suits you', url: '/whey-vs-plant-protein/' },
            ].map((g) => (
              <a href={g.url} class="flex items-center gap-4 bg-white/5 hover:bg-white/10 transition-colors rounded-2xl p-4 border border-white/10 no-underline">
                <div class="flex-1 min-w-0">
                  <p class="font-bold text-white text-sm truncate m-0">{g.name}</p>
                  <span class="text-xs text-[#38BDF8] font-bold">{g.badge}</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500 shrink-0"><path d="m9 18 6-6-6-6"></path></svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Standards -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gray-900 rounded-3xl p-10 lg:p-14 text-white">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-black mb-3">Built on the Label, Not the Marketing</h2>
          <p class="text-gray-400 max-w-xl mx-auto">The rules every guide on this site follows.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          {CHECKS.map((c, i) => (
            <div>
              <p class={`text-4xl font-black ${i % 2 ? 'text-[#1E90FF]' : 'text-[#FF4500]'}`}>{c.value}</p>
              <p class="text-gray-400 text-sm mt-1">{c.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How We're Different -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold">How We're Different From Other Review Sites</h2>
        <p class="text-gray-500 mt-3 max-w-2xl mx-auto">Most protein "reviews" rewrite the front of the tub. We start from the back of it.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-shadow">
          <p class="text-4xl mb-4" aria-hidden="true">🧮</p>
          <h3 class="font-bold text-xl mb-3">We Do the Maths</h3>
          <p class="text-gray-600 leading-relaxed">
            Tub prices hide everything. We compare powders on cost per 25 g of protein, so a cheap tub with a small, weak scoop cannot pass itself off as a bargain.
          </p>
        </div>
        <div class="bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-shadow">
          <p class="text-4xl mb-4" aria-hidden="true">🔬</p>
          <h3 class="font-bold text-xl mb-3">Verification Over Claims</h3>
          <p class="text-gray-600 leading-relaxed">
            "Lab tested" on a tub means nothing on its own. We weigh independent certification such as NSF Certified for Sport and Informed Sport, and we check the listing ourselves.
          </p>
        </div>
        <div class="bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-shadow">
          <p class="text-4xl mb-4" aria-hidden="true">🙅</p>
          <h3 class="font-bold text-xl mb-3">We Tell You When to Skip It</h3>
          <p class="text-gray-600 leading-relaxed">
            Plenty of people already eat enough protein. Our <a href="/protein-calculator/" class="text-[#1E90FF] font-bold no-underline hover:underline">calculator</a> tells you whether you need a powder at all before we tell you which one.
          </p>
        </div>
      </div>
    </section>

    <!-- Latest Guides -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-10 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1E90FF]"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Latest Guides
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {LATEST.map((g) => (
          <a href={g.url} class="group bg-white rounded-3xl border border-gray-200 p-8 hover:shadow-xl transition-all no-underline">
            <span class="bg-[#FF4500]/10 text-[#FF4500] px-3 py-1 rounded-full text-xs font-black uppercase">{g.kicker}</span>
            <h3 class="text-xl font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mt-4 mb-3">{g.title}</h3>
            <p class="text-gray-500 leading-relaxed m-0">{g.blurb}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
