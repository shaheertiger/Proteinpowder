---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Premier Protein vs Optimum Nutrition",
    "url": "/premier-protein-vs-optimum-nutrition/"
  },
  {
    "title": "Ryse vs Ghost Protein",
    "url": "/ryse-vs-ghost-protein/"
  },
  {
    "title": "Whey vs Whey Isolate",
    "url": "/whey-vs-whey-isolate/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Dymatize vs Premier Protein: Certified Isolate vs Cheap Whey";
const description =
  "Premier Protein powder is cheaper, about $1.47 per 25 g vs $2.77 for Dymatize ISO100, but ISO100 is Informed Choice listed and lower in lactose. Full labels.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "dymatize-vs-premier-protein-dymatize-iso100-gourmet-chocolate",
    "name": "Dymatize ISO100 Hydrolyzed Whey Isolate, Gourmet Chocolate (5 lb)",
    "brand": "Dymatize",
    "badge": "Best Certified Isolate",
    "category": "Hydrolyzed whey isolate and whey isolate",
    "description": "Per the Vitacost label at the time of writing, a 32 g scoop of Gourmet Chocolate gives 25 g of protein, 120 calories, 2 g of carbohydrate, 1 g of sugar, 1 g of fat and 180 mg of sodium, from hydrolyzed whey protein isolate and whey protein isolate. It is sweetened with sucralose and stevia and lists soy lecithin. Retailer listings show the Informed Choice logo, and the 5 lb tub holds about 71 servings.",
    "pros": [
      "78% protein by weight, the denser of the two",
      "Isolate only, so very little lactose",
      "Informed Choice logo on retailer listings",
      "About a dozen flavors, including Pebbles and Dunkin'"
    ],
    "cons": [
      "About $2.77 per 25 g at the Vitacost price in our database",
      "Contains soy lecithin (a soy allergen)",
      "Thin, watery shake for people used to blends, per buyer reviews"
    ],
    "bottomLine": "The pick for tested athletes and lactose-sensitive stomachs who will pay more per gram. Skip it if you just want the most protein for the least money.",
    "specs": {
      "Protein / serving": "25 g in 32 g (label)",
      "Calories": "120",
      "Third-party testing": "Informed Choice (retailer listing)",
      "Cost per 25 g": "About $2.77 ($196.72, 71 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B099J2SWXV"
  },
  {
    "id": "dymatize-vs-premier-protein-premier-whey-chocolate-milkshake",
    "name": "Premier Protein 100% Whey Protein Powder, Chocolate Milkshake (24.5 oz)",
    "brand": "Premier Protein",
    "badge": "Best Value",
    "category": "Whey isolate and concentrate blend",
    "description": "Per the Target label at the time of writing, a two-scoop 41 g serving of Chocolate Milkshake gives 30 g of protein, 150 calories, 3 g of carbohydrate, 1 g of sugar, 1 g of fiber, 2 g of fat and 170 mg of sodium, from whey protein isolate and whey protein concentrate. It is sweetened with sucralose and acesulfame potassium, thickened with xanthan gum, and is soy-free. The tub holds about 17 servings.",
    "pros": [
      "About $1.47 per 25 g at the Target price in our database",
      "30 g of protein per serving",
      "Soy-free, with sunflower lecithin instead",
      "Sold in most supermarkets and big-box stores"
    ],
    "cons": [
      "No sport certification found",
      "Contains whey concentrate, so more lactose than an isolate",
      "Small 17-serving tub and only five core flavors"
    ],
    "bottomLine": "The cheaper everyday whey with a bigger serving. Skip it if you are drug-tested or react to lactose.",
    "specs": {
      "Protein / serving": "30 g in 41 g, 2 scoops (label)",
      "Calories": "150",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $1.47 ($29.99, 17 servings, Target)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B06Y5ZG66K"
  },
  {
    "id": "dymatize-vs-premier-protein-premier-shake-chocolate",
    "name": "Premier Protein 30g Protein Shake, Chocolate (11 fl oz cartons)",
    "brand": "Premier Protein",
    "badge": "If You Meant the Shake",
    "category": "Ready-to-drink protein shake",
    "description": "Many people who search \"Premier Protein\" mean the carton, not the tub. Per Premier's Classic shake page at the time of writing, each shake gives 30 g of protein and 160 calories with 1 g of sugar, no added sugar and 24 vitamins and minerals. Dymatize is known for powders, and ISO100 is a powder, so if ready-to-drink is what you want, this card is the one to look at.",
    "pros": [
      "30 g of protein with no mixing",
      "Shelf-stable and sold almost everywhere",
      "Large flavor range, per Premier"
    ],
    "cons": [
      "Costs more per gram than Premier's powder in most of our price checks",
      "No sport certification found",
      "Bulky cases to store"
    ],
    "bottomLine": "The convenience pick when you want protein in a bag, not a shaker. Skip it if you are drug-tested or buying purely on cost per gram.",
    "specs": {
      "Protein / serving": "30 g per carton (Premier)",
      "Calories": "160",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $1.86 in our Nov 20 Amazon check"
    },
    "amazonUrl": "https://www.amazon.com/dp/B07MJL8NXR"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Dymatize vs Premier Protein",
          item: `${SITE_URL}/dymatize-vs-premier-protein/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Dymatize or Premier Protein better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier Protein powder is better value, at about $1.47 per 25 g of protein against about $2.77 for Dymatize ISO100 at the retailer prices in our database. ISO100 is better for drug-tested athletes, because retailer listings show the Informed Choice logo, and for lactose-sensitive stomachs, because it is isolate only. ISO100 scores 64 on our Label Score and Premier 60."
          }
        },
        {
          "@type": "Question",
          "name": "Which has more protein, Dymatize ISO100 or Premier Protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier has more per serving, 30 g against 25 g, per the labels at the time of writing. ISO100 has more per gram of powder: 78 percent protein by weight against 73 percent, because Premier's serving is a larger 41 g, two-scoop portion. Calories per 25 g of protein are almost the same, about 120 against 125."
          }
        },
        {
          "@type": "Question",
          "name": "Is Premier Protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We found no sport certification for Premier Protein powder, such as NSF Certified for Sport or Informed Choice, at the time of writing. Target lists it as gluten-free and kosher without naming a certifier. Dymatize ISO100 listings show the Informed Choice logo. Drug-tested athletes should choose a certified product and confirm the exact flavor in the registry."
          }
        },
        {
          "@type": "Question",
          "name": "Are Dymatize and Premier Protein owned by the same company?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. BellRing Brands lists Premier Protein, Dymatize and PowerBar as its brands. The two are positioned differently, with Premier aimed at everyday shoppers through shakes and supermarket powders and Dymatize aimed at performance nutrition. Their formulas, flavors and certifications are separate, so compare the labels, not the parent company."
          }
        },
        {
          "@type": "Question",
          "name": "Is Dymatize ISO100 or Premier Protein better for lactose intolerance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dymatize ISO100 is the better choice, since its protein is hydrolyzed whey isolate and whey isolate only, which are filtered to remove most lactose. Premier's blend includes whey concentrate, which carries more lactose, and its label does not give an amount. People with severe intolerance or a milk allergy should avoid both and look at plant protein."
          }
        },
        {
          "@type": "Question",
          "name": "Is a Premier Protein shake better than Dymatize ISO100?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only for convenience. Per Premier's website, the Classic shake gives 30 g of protein and 160 calories with 1 g of sugar, ready to drink. ISO100 is a powder with 25 g per scoop, certified per retailer listings and lower in lactose. In our November checks the shake cost about $1.86 per 25 g on Amazon, against about $2.77 for ISO100 at Vitacost."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for weight loss, Dymatize or Premier Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are nearly tied on calories: ISO100 gives 25 g of protein for 120 calories and Premier 30 g for 150, which is about 125 calories per 25 g. Both have 1 g of sugar. Pick Premier if cost keeps you consistent, or ISO100 if whey concentrate bloats you. Total daily calories matter far more than the powder you choose."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "dymatize vs premier protein",
      "premier protein vs dymatize",
      "dymatize iso100 vs premier protein powder",
      "dymatize iso100",
      "premier protein powder",
      "whey protein isolate"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Isolate Picks",
    link: "/best-whey-protein-isolate/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Dymatize vs Premier Protein</Fragment>
      A certified hydrolyzed isolate against a supermarket whey blend with 30 g a serving. Here is how Dymatize ISO100 and Premier Protein powder compare on label, price per gram, testing and stomach comfort, plus where Premier's ready-to-drink shakes fit in.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#shakes">Premier Shakes</a>
      <a href="#same-company">Same Parent Company</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#dymatize-strengths">Dymatize Pros and Cons</a>
      <a href="#premier-strengths">Premier Pros and Cons</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Premier Protein powder is the cheaper whey, at about $1.47 per 25 g of protein against about $2.77 for Dymatize ISO100 at the retailer prices in our database, while ISO100 is the better pick for drug-tested athletes and lactose-sensitive stomachs. What changes the answer is whether you need a certified, isolate-only powder or simply the most protein per dollar. Below we compare the labels, costs, testing, buyer-reported taste and Premier's shakes.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Dymatize vs Premier Protein: The Short Answer
          </h2>

          <p>
            Dymatize ISO100 and Premier Protein powder are both whey, and both come from the same parent company, but they are built for different buyers. <a href="/protein-powder/premier-protein-powder/">Premier Protein 100% Whey</a> is the budget pick: 30 g of protein per two-scoop serving for about $1.47 per 25 g of protein at the Target price in our database. <a href="/protein-powder/dymatize-iso100/">Dymatize ISO100</a> is the specialist: an isolate-only powder with the Informed Choice logo on retailer listings, at about $2.77 per 25 g at the Vitacost price we recorded.
          </p>

          <p>
            <strong>Pick Dymatize ISO100 if</strong> you are a drug-tested athlete, you get bloated on whey concentrate, or you want a leaner powder with more flavor choice. <strong>Pick Premier Protein if</strong> you want the most protein per dollar, a soy-free label, or a 30 g serving without doubling up. <strong>Pick a Premier shake if</strong> you never wanted a powder in the first place and meant the ready-to-drink carton.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Dymatize ISO100</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Premier Protein powder</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per serving</td>
                    <td class="px-4 py-4 text-gray-700">25 g in a 32 g scoop</td>
                    <td class="px-4 py-4 text-gray-700">30 g in a 41 g serving (2 scoops)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein type</td>
                    <td class="px-4 py-4 text-gray-700">Hydrolyzed whey isolate + isolate</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate + concentrate</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.77 (Vitacost)</td>
                    <td class="px-4 py-4 text-gray-700">About $1.47 (Target)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Third-party testing</td>
                    <td class="px-4 py-4 text-gray-700">Informed Choice (retailer listing)</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweeteners</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose, stevia</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose, acesulfame potassium</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">64/100</td>
                    <td class="px-4 py-4 text-gray-700">60/100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Dymatize ISO100 and Premier Protein at a Glance
          </h2>

          <p>
            The quickest way to decide is to match your situation to the column below. Both scores come from our <a href="/methodology/">Label Score</a>, which rates protein density, cost per 25 g, sugar and additives, certification and amino acid disclosure from the label alone. A four-point gap is small, and it hides the fact that each powder wins different parts of the formula.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dymatize ISO100</td>
                    <td class="px-4 py-4 text-gray-700">Tested athletes, lactose-sensitive, cutting</td>
                    <td class="px-4 py-4 text-gray-700">You are on a tight budget or avoid soy</td>
                    <td class="px-4 py-4 text-gray-700">64/100</td>
                    <td class="px-4 py-4 text-gray-700">About $2.77</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Premier Protein powder</td>
                    <td class="px-4 py-4 text-gray-700">Budget buyers, 30 g servings, soy-free</td>
                    <td class="px-4 py-4 text-gray-700">You are drug-tested or lactose-intolerant</td>
                    <td class="px-4 py-4 text-gray-700">60/100</td>
                    <td class="px-4 py-4 text-gray-700">About $1.47</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Premier Protein shake</td>
                    <td class="px-4 py-4 text-gray-700">No-mix convenience</td>
                    <td class="px-4 py-4 text-gray-700">You buy on cost per gram</td>
                    <td class="px-4 py-4 text-gray-700">Not scored (not a powder)</td>
                    <td class="px-4 py-4 text-gray-700">About $1.86 (Amazon, Nov 20)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            ISO100 earns its higher score on protein density, the certification and its disclosed leucine figure. Premier claws points back on price, which is why the two land close together. If you want to see how both rank against every other powder we track, our <a href="/protein-powder-comparison/">protein powder comparison table</a> sorts the whole database by cost per 25 g and Label Score.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Dymatize ISO100 and Premier Protein: The Products Compared
          </h2>

          <p>
            One card per side, using the exact products and label data in our database, plus Premier's 30 g shake for readers who searched the brand name but meant the carton. Prices move weekly, so the cost per 25 g on each card is a snapshot, not a promise.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Dymatize ISO100 and Premier Protein Spec Sheets Side by Side
          </h2>

          <p>
            Here is every label figure in our database for the two flagship flavors: Gourmet Chocolate for ISO100, from the <a href="https://www.vitacost.com/products/dymatize-iso100-hydrolyzed-100-whey-protein-isolate-gourmet-chocolate-5-lb-2-3-kg-66690" rel="nofollow noopener" target="_blank">Vitacost listing</a>, and Chocolate Milkshake for Premier, from the <a href="https://www.target.com/p/premier-protein-100-whey-powder-chocolate-milkshake-24-5oz/-/A-53106191" rel="nofollow noopener" target="_blank">Target listing</a>. Other flavors differ by a gram or a few calories, so check the panel on the tub you actually buy.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Dymatize ISO100 (Gourmet Chocolate)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Premier Protein (Chocolate Milkshake)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Serving size</td>
                    <td class="px-4 py-4 text-gray-700">32 g (1 scoop)</td>
                    <td class="px-4 py-4 text-gray-700">41 g (about 2 scoops)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">78%</td>
                    <td class="px-4 py-4 text-gray-700">73%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                    <td class="px-4 py-4 text-gray-700">150</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
