const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Recovery",
          item: `${SITE_URL}/best-protein-powder-for-recovery/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein for muscle recovery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey protein, particularly isolate or hydrolysate, is the best-studied option because it digests quickly and contains plenty of leucine. A 20 to 40 g serving after training covers the post-workout dose for most people. Casein before bed and a certified plant blend are good alternatives depending on timing and diet."
          }
        },
        {
          "@type": "Question",
          "name": "How long after a workout should I drink a protein shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Within a couple of hours is fine for most people, especially if you ate a protein-rich meal a few hours before training. If you trained fasted, have protein sooner. Research shows total daily protein matters more than the exact timing, so do not stress about the 30-minute window."
          }
        },
        {
          "@type": "Question",
          "name": "Is hydrolyzed whey better for recovery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hydrolyzed whey absorbs slightly faster, but studies have not shown better long-term muscle gain or recovery compared with whey isolate at the same dose. It is worth considering if regular whey upsets your stomach or you train twice a day. Otherwise, isolate is just as effective and usually cheaper."
          }
        },
        {
          "@type": "Question",
          "name": "Are EAAs better than protein powder for recovery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not usually. About 10 g of EAAs can maximally stimulate muscle protein synthesis, but a 20 to 25 g serving of whey supplies the same EAAs plus other amino acids, often at a lower cost. EAAs are useful mainly during training or for people who cannot tolerate a full shake."
          }
        },
        {
          "@type": "Question",
          "name": "Does protein powder help with sore muscles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only a little, if at all. Reviews of the research find small and inconsistent effects of protein on muscle soreness. Protein supports long-term repair and adaptation, which matters more. For soreness, sleep, enough calories, gradual training progression and time make the biggest difference."
          }
        },
        {
          "@type": "Question",
          "name": "Should I add creatine to my recovery shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Creatine monohydrate is one of the best-supported supplements, and the ISSN notes it may enhance recovery as well as strength. Take 3 to 5 g a day; timing is not critical, so adding it to your post-workout shake is a convenient habit. Check with a doctor first if you have kidney disease."
          }
        },
        {
          "@type": "Question",
          "name": "Is tart cherry juice good for recovery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Meta-analyses suggest small benefits for strength recovery and soreness, mostly when concentrate is taken twice daily for several days around a hard event. Because heavy antioxidant use might blunt training adaptations, it is better reserved for competition periods than used daily. It is not a substitute for adequate protein."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
