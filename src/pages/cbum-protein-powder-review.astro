const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "CBUM Protein Powder Review",
          item: `${SITE_URL}/cbum-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is Bum protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bum or CBUM protein powder usually means CBUM Itholate, a whey isolate made by RAW Nutrition with bodybuilder Chris Bumstead, whose nickname is CBum. It is sold as CBUM Itholate, BUM Itholate or RAW Whey Isolate Protein Powder, and it lists 25 g of protein per scoop in dessert-style flavors. Bumstead is described as a co-owner of RAW."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in CBUM Itholate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every Itholate flavor we checked lists 25 g of protein per scoop from whey protein isolate, with 25 servings per tub. Calories vary by flavor because of cereal and cookie inclusions: about 100 for Strawberry Bumcake, about 120 for Vanilla Oatmeal Cookie and about 190 for Chocolate Peanut Butter, per retailer panels at the time of writing."
          }
        },
        {
          "@type": "Question",
          "name": "Is CBUM Itholate whey isolate or a blend?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is whey protein isolate. Retailer panels list micro-filtered whey isolate as the only protein source, which means it is low in lactose and fat compared with whey concentrate blends. The other ingredients vary by flavor and can include cereal pieces, cookie bits, gums, artificial and natural flavors, and sweeteners such as sucralose."
          }
        },
        {
          "@type": "Question",
          "name": "Is CBUM Itholate Informed Sport certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We could not confirm it. RAW says its products carry Informed Sport certification, and its Grass-Fed Whey Isolate is listed by a retailer as Informed Sport tested, but for Itholate we found only Informed Protein batch listings. Tested athletes should check the Informed Sport database for their exact flavor and batch before relying on it."
          }
        },
        {
          "@type": "Question",
          "name": "Does CBUM Itholate have sucralose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most flavors do. The panels we checked list sucralose, sometimes with acesulfame potassium, and flavors with inclusions also contain small amounts of sugar or corn syrup inside the cereal or cookie pieces. If you avoid sucralose, RAW's Grass-Fed Whey Isolate is sweetened with stevia-derived Reb A and Reb M instead, per its label."
          }
        },
        {
          "@type": "Question",
          "name": "Is CBUM Itholate good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be, if you choose a lean flavor. At 25 g of protein for roughly 100 to 120 calories in the leaner flavors, it is a high-protein, low-calorie shake. The richer flavors approach 190 calories, which is less helpful on a tight deficit. Protein helps with fullness, but overall calorie intake is what drives weight loss."
          }
        },
        {
          "@type": "Question",
          "name": "Where is CBUM Itholate cheapest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prices change constantly, but we have seen it from roughly $50 at sporting goods chains to about $75 at the brand store and some online retailers. That is about $2.00 to $3.00 per 25 g of protein, approximately. Check Amazon, warehouse clubs and RAW's multi-buy promotions before paying list price for a single tub."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
