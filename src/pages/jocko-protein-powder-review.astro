];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Jocko Protein Powder Review",
          item: `${SITE_URL}/jocko-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Jocko protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jocko Molk is a good-tasting whey, casein and egg blend with 22 g of protein and about 2.2 g of leucine per scoop, and no sucralose. It is not especially lean, at about 65 percent protein by weight, and names no sport certification. It suits flavor-first buyers rather than those focused on value or testing."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Jocko Molk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Molk powder lists 22 g of protein per 34 g scoop with 120 calories, per the chocolate label on Jocko Fuel's site at the time of writing. The ready-to-drink Molk shakes list 30 g of protein per 355 mL bottle with 180 calories, so the bottles deliver considerably more protein per serving."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener is in Jocko protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jocko uses its own Jocko GOOD Sweetener blend of allulose, Reb M and monk fruit extract in the powders, and Reb M with monk fruit in the shakes. There is no sucralose or aspartame. Allulose does not count toward sugars on US labels and is very low in calories."
          }
        },
        {
          "@type": "Question",
          "name": "Is Jocko protein third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jocko Fuel says independent labs test every batch for purity, potency and safety, but it does not name a lab or certification program on its product pages at the time of writing. Its proteins are not presented as NSF Certified for Sport or Informed Sport, so drug-tested athletes should choose a certified product."
