const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Jocko Protein Powder Review: Molk, Clear Isolate and Plant, Label by Label";
const description =
  "Jocko Fuel Molk protein powder, shakes, Clear Isolate and Plant-Based Protein checked on protein per scoop, sweeteners, testing and cost per 25 g of protein.";

const PRODUCTS: {
  id: string;
