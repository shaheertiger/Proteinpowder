const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Transparent Labs Mass Gainer Review",
          item: `${SITE_URL}/transparent-labs-mass-gainer-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Transparent Labs Mass Gainer third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, per Transparent Labs. The brand says every batch is tested by an independent lab for purity and potency, publishes results through its website footer, and states that Mass Gainer is Informed Choice certified. The tub also prints an Informed Protein seal. We could not load the Informed Choice registry to confirm the listing, so tested athletes should look up the product there before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Is Transparent Labs Mass Gainer healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is one of the cleaner gainers: stevia only, no artificial dyes, 0 g added sugar on three flavors and a dose printed for every ingredient. It is still 770 calories with about 100 g of maltodextrin and 12 g of saturated fat per serving. It is a good tool for healthy adults who need calories, not an everyday health drink for everyone."
          }
        },
        {
          "@type": "Question",
          "name": "Does Transparent Labs Mass Gainer contain lactose, casein or artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It contains whey protein concentrate, which carries some lactose, and sodium caseinate inside the MCT oil powder, so it is not lactose-free or casein-free. It contains no artificial sweeteners, per the label; it is sweetened with stevia extract. The allergen statement lists milk and coconut, plus peanuts in Chocolate Peanut Butter."
          }
        },
        {
          "@type": "Question",
          "name": "Which Transparent Labs Mass Gainer flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyer reviews on the brand's site are most enthusiastic about Chocolate Peanut Butter and Strawberry Cheesecake. Chocolate Glaze is the flagship and the flavor sold on Amazon, and gets steady praise. Sweet Vanilla draws the most mixed comments, with some buyers finding it too sweet. Chocolate Peanut Butter also has the most protein at 55 g, per its label."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common Transparent Labs Mass Gainer complaints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common complaints in buyer reviews are flavor fatigue after weeks of daily use, Sweet Vanilla being too sweet, occasional clumping in a shaker, a scoop that sinks into the powder and accidental subscription sign-ups. From the label, the price is the biggest drawback: 15 servings for $79.99 means a daily user buys two tubs a month."
          }
        },
