                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sweet Vanilla</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Choc. Peanut Butter</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Strawberry Cheesecake</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Serving size</td>
                    <td class="px-4 py-4 text-gray-700">199 g</td>
                    <td class="px-4 py-4 text-gray-700">194 g</td>
                    <td class="px-4 py-4 text-gray-700">201.3 g</td>
                    <td class="px-4 py-4 text-gray-700">192.8 g</td>
                  </tr>
