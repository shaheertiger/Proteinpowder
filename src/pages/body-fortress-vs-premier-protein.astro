---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Optimum Nutrition vs Body Fortress",
    "url": "/optimum-nutrition-vs-body-fortress/"
  },
  {
    "title": "Dymatize vs Premier Protein",
    "url": "/dymatize-vs-premier-protein/"
  },
  {
    "title": "Premier Protein vs Optimum Nutrition",
    "url": "/premier-protein-vs-optimum-nutrition/"
  },
  {
    "title": "Best Walmart Protein Powder",
    "url": "/best-walmart-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Body Fortress vs Premier Protein: Which Budget Whey Wins?";
const description =
  "Body Fortress is cheaper at Walmart, about $0.97 per 25 g of protein vs $1.47 for Premier, but Premier is leaner: 150 vs 180 calories for 30 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "body-fortress-vs-premier-protein-premier-whey-chocolate-milkshake",
    "name": "Premier Protein 100% Whey Protein Powder, Chocolate Milkshake (24.5 oz)",
    "brand": "Premier Protein",
    "badge": "Leaner Pick, Best Online",
    "category": "Whey isolate and concentrate blend",
    "description": "Per Target's label at the time of writing, a 41 g serving of about two scoops gives 30 g of protein, 150 calories, 3 g of carbohydrate, 1 g of sugar, 2 g of fat and 170 mg of sodium, with whey isolate listed first. It is sweetened with sucralose and acesulfame potassium and uses sunflower lecithin, so it is soy-free. At $29.99 for 17 servings at Target on 1 November 2026 it costs about $1.47 per 25 g.",
    "pros": [
      "About 73% protein by weight, 150 calories for 30 g",
      "Only 1 g of sugar and 2 g of fat per serving",
      "Soy-free; flavors mirror Premier's shakes",
      "Steady pricing, about $1.47 to $1.69 per 25 g in our checks"
    ],
    "cons": [
      "No third-party certification we could find",
      "Two scoops per 30 g serving; 17 servings per tub",
      "Artificial flavors plus two artificial sweeteners"
    ],
    "bottomLine": "The better powder of the two and the better buy for most shoppers outside Walmart. Skip it if you shop Walmart and want the lowest possible cost per gram.",
    "specs": {
      "Protein / serving": "30 g in 41 g (label)",
      "Calories": "About 150",
      "Third-party testing": "None found",
      "Cost per 25 g": "About $1.47 ($29.99, 17 servings, Target)"
    }
  },
  {
    "id": "body-fortress-vs-premier-protein-body-fortress-whey-chocolate-3-9lb",
    "name": "Body Fortress Super Advanced Whey Protein, Chocolate (3.9 lb)",
    "brand": "Body Fortress",
    "badge": "Cheapest at Walmart",
    "category": "Whey concentrate and isolate blend",
    "description": "Per the label at the time of writing, one 45 g scoop of chocolate gives 30 g of protein, 180 calories, 7 g of carbohydrate, 3 g of sugar, 4 g of fat and 230 mg of sodium, with about 3.1 g of leucine and added vitamins C and D3 and zinc. Our Body Fortress review found the 3.9 lb tub at $45.28 on Walmart's listing in mid-November, about $0.97 per 25 g, and an NSF/ANSI 173 registry listing.",
    "pros": [
      "About $0.97 per 25 g at Walmart's 3.9 lb price",
      "30 g of protein in a single scoop",
      "Listed in NSF's registry under NSF/ANSI 173",
      "Publishes leucine; adds vitamins C, D3 and zinc"
    ],
    "cons": [
      "Amazon price for the same tub was about $1.74 per 25 g",
      "Maltodextrin and 180 calories per 30 g; 67% protein",
      "Contains soy; buyers often find it thick"
    ],
    "bottomLine": "A real bargain at Walmart's shelf price and an ordinary one elsewhere. Skip it if you buy online, avoid soy or count calories closely.",
    "specs": {
      "Protein / serving": "30 g in 45 g (label)",
      "Calories": "About 180",
      "Third-party testing": "NSF/ANSI 173 registry listing",
      "Cost per 25 g": "About $0.97 ($45.28, 3.9 lb, Walmart)"
    }
  },
  {
    "id": "body-fortress-vs-premier-protein-premier-shake-chocolate-12",
    "name": "Premier Protein 30g Protein Shake, Chocolate (12 x 11 fl oz)",
    "brand": "Premier Protein",
    "badge": "If You Meant the Shake",
    "category": "Ready-to-drink milk protein shake",
    "description": "Per Premier's Classic shake page at the time of writing, each carton gives 30 g of protein, 160 calories and 1 g of sugar with 24 vitamins and minerals, built on milk protein concentrate and calcium caseinate. The 12-pack was $26.74 on Amazon in November, about $1.86 per 25 g: close to both powders' online prices but nearly double Body Fortress at Walmart.",
    "pros": [
      "No shaker, no cleanup, shelf-stable",
      "30 g of protein for 160 calories, per Premier",
      "24 vitamins and minerals added"
    ],
    "cons": [
      "About $1.86 per 25 g, roughly twice Body Fortress at Walmart",
      "Bulky to store; no third-party certification found"
    ],
    "bottomLine": "Worth it for protein on the go. Skip it if you drink a shake at home every day, where either powder costs less.",
    "specs": {
      "Protein / serving": "30 g per carton (Premier)",
      "Calories": "About 160",
      "Third-party testing": "None found",
      "Cost per 25 g": "About $1.86 ($26.74, 12-pack, Amazon)"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Body Fortress vs Premier Protein",
          item: `${SITE_URL}/body-fortress-vs-premier-protein/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Body Fortress or Premier Protein better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier Protein is the better powder for most buyers: 30 g of protein for 150 calories against 180 for Body Fortress, about 73% protein by weight against 67%, no soy, and a Label Score of 60 against 51. Body Fortress is the better deal only at Walmart, where the 3.9 lb tub came to about $0.97 per 25 g against $1.47 for Premier at Target."
          }
        },
        {
          "@type": "Question",
          "name": "Which is cheaper, Body Fortress or Premier Protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the store. At Walmart, Body Fortress's 3.9 lb tub was about $0.97 per 25 g of protein in mid-November, cheaper than Premier's $1.47 at Target. On Amazon the same chocolate tub was about $1.74 against about $1.69 for Premier, though some Body Fortress flavors were cheaper, and at Vitacost Body Fortress was about $1.95. Prices move, so recalculate before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Is Body Fortress third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Partly. Our Body Fortress review found Super Advanced Whey listed in NSF's dietary supplement registry under NSF/ANSI 173, which checks label accuracy and contaminants and audits the facility. We found no NSF Certified for Sport, Informed Sport or Informed Choice listing, so it is not screened for banned substances. Premier Protein powder had no certification we could find."
          }
        },
        {
          "@type": "Question",
          "name": "Does Premier Protein powder taste like the shakes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyers often say it tastes close, and the flavor names, such as Chocolate Milkshake and Vanilla Milkshake, mirror the cartons. The recipes differ, though: the shakes are mostly milk protein concentrate and calcium caseinate, while the powder is whey isolate and concentrate. We have not tasted either, so this reflects buyer reviews, not our own testing."
          }
        },
        {
          "@type": "Question",
          "name": "Which has fewer calories, Body Fortress or Premier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier does. Per the labels at the time of writing, Premier gives 30 g of protein for 150 calories, 3 g of carbohydrate, 1 g of sugar and 2 g of fat. Body Fortress gives 30 g for 180 calories, 7 g of carbohydrate, 3 g of sugar and 4 g of fat. Scaled to 25 g of protein, that is about 125 calories against 150."
          }
        },
        {
          "@type": "Question",
          "name": "Is a Premier Protein shake cheaper than Body Fortress powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A 12-pack of Premier's 30 g chocolate shakes was $26.74 on Amazon in November, about $1.86 per 25 g of protein. Body Fortress's 3.9 lb tub at Walmart's price was about $0.97 per 25 g, roughly half. Against Body Fortress on Amazon, at about $1.74, the gap is small, and the carton wins on convenience."
          }
        },
        {
          "@type": "Question",
          "name": "Does Body Fortress or Premier Protein contain soy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Body Fortress lists soy as an allergen, because its lecithin is soy-derived, per the Vitacost label. Premier uses sunflower lecithin and lists only milk, so it is the soy-free choice of the two. Both contain milk and neither suits a dairy allergy. Check the allergen statement on your tub, since formulas and packaging can change."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "body fortress vs premier protein",
      "body fortress vs premier protein powder",
      "body fortress super advanced whey vs premier protein",
      "premier protein vs body fortress",
      "body fortress whey protein",
      "premier protein 100% whey"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Cheap Protein Powder Picks",
    link: "/best-cheap-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Body Fortress vs Premier Protein</Fragment>
      Two supermarket wheys that both promise 30 g of protein for not much money. Here is what each costs per 25 g at Walmart, Target, Amazon and Vitacost, how the labels differ, which one has a registry listing, and where Premier's bottled shakes fit in.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost by Retailer</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#shake">Premier Shakes</a>
      <a href="#bf-pros-cons">Body Fortress Strengths and Gaps</a>
      <a href="#premier-pros-cons">Premier Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Body Fortress Super Advanced Whey is the cheaper protein if you buy the 3.9 lb tub at Walmart, at about $0.97 per 25 g against about $1.47 for Premier Protein 100% Whey at Target. Online, Premier usually beats the chocolate Body Fortress tubs on price, and it is the leaner powder everywhere. The retailer you shop at changes the answer more than either label does. Below we price both by store, compare the labels, testing and buyer-reported taste, and cover Premier's shakes.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Body Fortress vs Premier Protein: The Short Answer
          </h2>

          <p>
            Premier Protein is the better powder and Body Fortress is the better deal only at Walmart. Per the labels at the time of writing, both give 30 g of protein per serving, but Premier does it in 41 g of powder for 150 calories and Body Fortress in 45 g for 180 calories. Premier scores 60 out of 100 on our Label Score, Body Fortress 51. Body Fortress holds a registry listing for label accuracy that Premier lacks, and neither is certified for sport.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Body Fortress Super Advanced Whey</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Premier Protein 100% Whey</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per serving</td>
                    <td class="px-4 py-4 text-gray-700">30 g in 45 g (67%)</td>
                    <td class="px-4 py-4 text-gray-700">30 g in 41 g (73%)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories / sugar</td>
                    <td class="px-4 py-4 text-gray-700">180 / 3 g</td>
                    <td class="px-4 py-4 text-gray-700">150 / 1 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $0.97 (Walmart, 3.9 lb) to $1.95 (Vitacost, 1.78 lb)</td>
                    <td class="px-4 py-4 text-gray-700">About $1.47 (Target) to $1.69 (Amazon)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Testing</td>
                    <td class="px-4 py-4 text-gray-700">NSF/ANSI 173 registry listing; no sport certification</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Allergens</td>
                    <td class="px-4 py-4 text-gray-700">Milk, soy</td>
                    <td class="px-4 py-4 text-gray-700">Milk</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">51 / 100</td>
                    <td class="px-4 py-4 text-gray-700">60 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Body Fortress at Walmart for price; pick Premier anywhere else for a leaner shake.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Body Fortress if</strong> you can buy the 3.9 lb tub at or near Walmart's price, you want 30 g in one scoop, or you value a contents registry listing. <strong>Pick Premier if</strong> you shop Target or Amazon, count calories, avoid soy, or already like Premier's shakes. <strong>Pick neither if</strong> you are a drug-tested athlete or cannot have dairy.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Body Fortress and Premier Protein at a Glance
          </h2>

          <p>
            Start with where you shop and what you would refuse to give up. The table matches each powder to the buyer it suits and the buyer who should pass, next to the two numbers we publish for every product in our database: the <a href='/methodology/'>Label Score</a> out of 100 and the cost per 25 g of protein.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/premier-protein-powder/'>Premier Protein 100% Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Calorie counters, Target and Amazon shoppers, soy avoiders, fans of Premier shakes</td>
                    <td class="px-4 py-4 text-gray-700">You only shop Walmart and want the absolute lowest price</td>
                    <td class="px-4 py-4 text-gray-700">60</td>
                    <td class="px-4 py-4 text-gray-700">About $1.47 (Target)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/body-fortress-super-advanced-whey/'>Body Fortress Super Advanced Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Walmart shoppers buying the 3.9 lb tub, one-scoop 30 g shakes</td>
                    <td class="px-4 py-4 text-gray-700">You buy chocolate online, avoid soy, or want a thin shake</td>
                    <td class="px-4 py-4 text-gray-700">51</td>
                    <td class="px-4 py-4 text-gray-700">About $0.97 (Walmart, 3.9 lb)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The nine-point Label Score gap comes mostly from protein density and filler. Premier packs about 73% protein by weight against Body Fortress's 67%, and Body Fortress adds maltodextrin, a cheap carbohydrate, third on its ingredient list. Our scoring uses the database price, which for Body Fortress is a small Vitacost tub at about $1.95 per 25 g, so the score does not reflect the Walmart bargain. At Walmart's shelf price the value picture flips, which is why the rest of this page prices both by retailer.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Body Fortress and Premier Protein Products Are We Comparing?
          </h2>

          <p>
            Each brand has one flagship whey, so those are the two we compare: Body Fortress Super Advanced Whey and Premier Protein 100% Whey Protein Powder, both in chocolate. We price Body Fortress in the 3.9 lb tub because that is the size where it is cheapest, and add Premier's 30 g bottled shake as a third card because many people searching this pair mean the carton, not the tub. Prices are snapshots from our November checks and will move. Full labels sit in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            These are the full label figures for the chocolate flavor of each, per the labels at the time of writing. Premier's panel comes from Target's listing for the 24.5 oz Chocolate Milkshake tub. Body Fortress's comes from Vitacost's listing for the 1.78 lb chocolate tub, which gives one-scoop and two-scoop columns; we use the one-scoop figures.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Body Fortress (Chocolate)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Premier Protein (Chocolate Milkshake)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Serving size</td>
                    <td class="px-4 py-4 text-gray-700">45 g (1 scoop)</td>
                    <td class="px-4 py-4 text-gray-700">41 g (about 2 scoops)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">67%</td>
                    <td class="px-4 py-4 text-gray-700">73%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">180</td>
                    <td class="px-4 py-4 text-gray-700">150</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">7 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat</td>
                    <td class="px-4 py-4 text-gray-700">4 g</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sodium</td>
                    <td class="px-4 py-4 text-gray-700">230 mg</td>
                    <td class="px-4 py-4 text-gray-700">170 mg</td>
