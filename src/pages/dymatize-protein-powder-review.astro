---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Optimum Nutrition Protein Powder Review",
    "url": "/optimum-nutrition-protein-powder-review/"
  },
  {
    "title": "Transparent Labs Protein Powder Review",
    "url": "/transparent-labs-protein-powder-review/"
  },
  {
    "title": "Muscle Milk Protein Powder Review",
    "url": "/muscle-milk-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Dymatize Protein Powder Review: ISO100 vs Elite Whey, and When the Isolate Is Worth Paying For";
const description =
  "Dymatize protein powder from the label: ISO100, Elite 100% Whey, Elite Casein and Super Mass Gainer compared on protein, calories, testing and cost per 25 g.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "dymatize-iso100-hydrolyzed",
    "name": "Dymatize ISO100 Hydrolyzed Whey Isolate",
    "brand": "Dymatize",
    "badge": "Best Dymatize Overall",
    "category": "Hydrolyzed whey isolate + whey isolate",
    "description": "ISO100 is Dymatize's flagship and one of the best isolates you can buy. Per the label at the time of writing, a scoop of about 30 to 33 g gives roughly 25 g of protein at 110 to 120 calories, with around 1 g of fat and 1 to 2 g of carbohydrate depending on flavor. It carries the Informed Choice logo, mixes thin and clean per buyers, and comes in a wide flavor range including the Pebbles and Dunkin flavors.",
    "pros": [
      "About 25 g protein for 110-120 calories, per the label",
      "Very low lactose, fat and carbohydrate",
      "Informed Choice logo, per retailer listings",
      "Mixes thin and clean, per buyer reviews"
    ],
    "cons": [
      "Costs more per 25 g than Elite Whey",
      "Sucralose in flavored versions"
    ],
    "bottomLine": "The Dymatize to buy if lactose or tight macros give you a reason to pay for an isolate.",
    "specs": {
      "Protein per serving": "About 25 g (1 scoop)",
      "Calories": "About 110-120",
      "Third-party testing": "Informed Choice (confirm flavor)",
      "Best for": "Lactose-sensitive, cutting"
    }
  },
  {
    "id": "dymatize-elite-100-whey",
    "name": "Dymatize Elite 100% Whey Protein",
    "brand": "Dymatize",
    "badge": "Best Value Dymatize",
    "category": "Whey concentrate, isolate and peptides",
    "description": "Elite 100% Whey gives the same 25 g of protein as ISO100 for less money. Per the label at the time of writing, a scoop of about 34 g lands around 140 calories, with whey concentrate, whey isolate and whey peptides and about 5.5 g of BCAAs. Retailer listings show the Informed Choice logo. It carries more lactose than ISO100, so it suits people who tolerate dairy, and it is usually one of the cheaper tested wheys per 25 g.",
    "pros": [
      "About 25 g protein per scoop, per the label",
      "Usually 20-30 percent cheaper per 25 g than ISO100",
      "Informed Choice logo, per retailer listings"
    ],
    "cons": [
      "More lactose than an isolate",
      "About 140 calories versus 110-120 for ISO100"
    ],
    "bottomLine": "The better-value Dymatize for anyone who does not need an isolate.",
    "specs": {
      "Protein per serving": "About 25 g (1 scoop)",
      "Calories": "About 140",
      "Third-party testing": "Informed Choice (confirm flavor)",
      "Best for": "Everyday whey on a budget"
    }
  },
  {
    "id": "dymatize-elite-casein",
    "name": "Dymatize Elite Casein",
    "brand": "Dymatize",
    "badge": "Best Bedtime Protein",
    "category": "Micellar casein",
    "description": "Elite Casein is Dymatize's slow-digesting protein, built on micellar casein. Per the label at the time of writing, a serving of about 33 to 36 g gives roughly 25 g of protein at 120 to 130 calories. Retailer listings show the Informed Choice logo. It thickens with less liquid, which buyers like for puddings and overnight oats, and it is a sensible choice for a shake before bed or a long gap between meals.",
    "pros": [
      "About 25 g of micellar casein per serving",
      "Thick texture suits puddings and baking",
      "Informed Choice logo, per retailer listings"
    ],
    "cons": [
      "Thick in a shaker with water, per buyers",
      "Timing benefits are modest next to total daily protein"
    ],
    "bottomLine": "Buy it for bedtime shakes and protein desserts, not as your only powder.",
    "specs": {
      "Protein per serving": "About 25 g",
      "Calories": "About 120-130",
      "Third-party testing": "Informed Choice (confirm flavor)",
      "Best for": "Bedtime, puddings"
    }
  },
  {
    "id": "dymatize-super-mass-gainer",
    "name": "Dymatize Super Mass Gainer",
    "brand": "Dymatize",
    "badge": "Best for Hard Gainers",
    "category": "High-calorie mass gainer",
    "description": "Super Mass Gainer is a calorie product. Per the label, a full serving gives roughly 1,200 to 1,300 calories and about 50 g of protein, with most of the rest coming from maltodextrin. Buyers often rate its flavors highly and describe it as smoother than many rival gainers. It suits people who genuinely struggle to eat enough. For anyone else, a regular whey plus more food is the better plan.",
    "pros": [
      "Roughly 1,200-1,300 calories per full serving, per the label",
      "About 50 g protein per serving",
      "Flavors buyers often rate highly"
    ],
    "cons": [
      "Mostly maltodextrin by calories",
      "Easy to gain fat as well as muscle"
    ],
    "bottomLine": "Only for hard gainers; most lifters should start with Elite Whey and more food.",
    "specs": {
      "Protein per serving": "About 50 g",
      "Calories": "About 1,200-1,300",
      "Third-party testing": "Check certifier database",
      "Best for": "Hard gainers"
    }
  },
  {
    "id": "isopure-zero-carb",
    "name": "Isopure Zero Carb Protein Powder",
    "brand": "Isopure",
    "badge": "Alternative: Leanest Isolate",
    "category": "Whey protein isolate",
    "description": "If ISO100's 1 to 2 g of carbohydrate still feels like too much, Isopure Zero Carb is the alternative. Per the label at the time of writing, a scoop gives about 25 g of protein for roughly 100 to 110 calories with essentially no carbohydrate. Buyer opinion on flavor is more mixed than for ISO100, and we could not confirm a sport certification, so tested athletes should stick with Dymatize.",
    "pros": [
      "About 25 g protein for roughly 100-110 calories",
      "Zero or near-zero carbohydrate and sugar",
      "Pure isolate, low in lactose"
    ],
    "cons": [
      "Flavor reviews more mixed than ISO100",
      "No sport certification we could confirm"
    ],
    "bottomLine": "The pick for strict low-carb diets; ISO100 for everyone who wants testing and taste.",
    "specs": {
      "Protein per serving": "About 25 g (1 scoop)",
      "Calories": "About 100-110",
      "Third-party testing": "Check certifier databases",
      "Best for": "Strict low-carb diets"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Dymatize Protein Powder Review",
          item: `${SITE_URL}/dymatize-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Dymatize a good protein brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Dymatize has a long track record, consistent label figures and Informed Choice testing on its main powders per retailer listings. ISO100 is one of the best-selling isolates on the market, and Elite Whey is a strong value whey. The main drawback is sucralose in flavored products. For most lifters, it is one of the safest brands to buy."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between Dymatize ISO100 and Elite Whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both give about 25 g of protein per scoop. ISO100 is all whey isolate, partly hydrolyzed, with very little lactose and about 110 to 120 calories. Elite Whey blends concentrate, isolate and peptides and runs about 140 calories with more lactose. Elite Whey usually costs 20 to 30 percent less per 25 g. Choose ISO100 for dairy sensitivity or strict cuts."
          }
        },
        {
          "@type": "Question",
          "name": "Is Dymatize ISO100 lactose free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not technically, but it is very low in lactose. Whey isolate is filtered to remove most lactose, and ISO100 typically lists under 1 to 2 g of sugar per scoop. Many people who react to regular whey tolerate it well. People with a milk allergy, which is a reaction to milk protein rather than lactose, should avoid it entirely."
          }
        },
        {
          "@type": "Question",
          "name": "Is Dymatize third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Retailer listings show the Informed Choice logo on ISO100, Elite 100% Whey and Elite Casein at the time of writing. Informed Choice is run by the anti-doping lab LGC and tests certified products for banned substances. Drug-tested athletes should verify the specific product and flavor on the Informed Choice website before competing."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns Dymatize?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dymatize is owned by BellRing Brands, which also owns Premier Protein. Post Holdings bought Dymatize in 2014 and moved it into BellRing in 2019, and BellRing is now a separate public company. That connection is why Dymatize sells ISO100 in Post's Fruity Pebbles and Cocoa Pebbles flavors."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener does Dymatize use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ISO100 Gourmet Chocolate ingredient list we found includes sucralose and steviol glycosides, and sucralose is common across Dymatize's flavored powders. Sugar stays low as a result. If you avoid sucralose, Dymatize is not the right brand. Look for unflavored isolates or stevia-only brands instead, and check each flavor's label."
          }
        },
        {
          "@type": "Question",
          "name": "Is Dymatize Elite Casein good before bed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, that is its main job. Micellar casein digests slowly, so a 25 g serving before bed supplies amino acids over several hours. Studies of pre-sleep casein show modest benefits, mostly because it adds to total daily protein. If you already hit your protein target, the timing matters less than consistency. It also makes good pudding."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "dymatize protein powder",
      "dymatize iso100",
      "dymatize elite whey",
      "dymatize review"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Isolate Picks",
    link: "/best-whey-protein-isolate/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Review
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Label-Checked
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Dymatize <span class="text-[#38BDF8]">Protein Powder</span> Review
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          ISO100, Elite 100% Whey, Elite Casein and Super Mass Gainer, read off the label: what each scoop gives you, what the isolate premium buys, and which Dymatize tub fits your goal.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#dymatize-iso100-hydrolyzed"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#iso100-vs-elite"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Range
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#the-brand" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Who Makes Dymatize</a>
          <a href="#range-compared" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Range Side by Side</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Our Top Picks</a>
          <a href="#iso100-vs-elite" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. ISO100 vs Elite 100% Whey</a>
          <a href="#cost-per-25g" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Cost per 25 g of Protein</a>
          <a href="#testing" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Informed Choice Testing</a>
          <a href="#flavors" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Flavors, Sweeteners and Mixing</a>
          <a href="#who-should-skip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Who Should Skip It</a>
          <a href="#how-to-use" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. Matching the Tub to Your Goal</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Dymatize is one of the few big protein brands where every product we checked is worth buying for someone. ISO100 is a top-tier whey isolate: about 25 g of protein for roughly 110 to 120 calories, very low lactose and Informed Choice tested. Elite 100% Whey gives the same 25 g for a little more fat and carbohydrate and usually costs noticeably less per gram. The real question is not whether Dymatize is good. It is whether you need to pay the isolate premium, and for most people the answer is no.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            <strong>Buy ISO100</strong> if you are lactose sensitive, tracking macros closely or simply want the cleanest-mixing whey Dymatize makes. Per the label at the time of writing, a scoop gives about 25 g of protein from hydrolyzed whey isolate and whey isolate, with around 1 g of fat and 1 to 2 g of carbohydrate. It is one of the best isolates on the market and a fixture in our <a href="/best-whey-protein-isolate/">best whey protein isolate</a> rankings.
          </p>

          <p>
            <strong>Buy Elite 100% Whey</strong> if dairy does not bother you and you want the same 25 g dose for less money. It blends concentrate, isolate and whey peptides, lands around 140 calories per scoop and usually costs 20 to 30 percent less per gram than ISO100. For most lifters that is the better deal.
          </p>

          <p>
            <strong>Buy Elite Casein</strong> for a slow-digesting shake before bed or a thick protein pudding. <strong>Buy Super Mass Gainer</strong> only if you genuinely struggle to eat enough; at well over 1,000 calories per full serving it is a weight-gain tool, not a protein powder.
          </p>

          <p>
            Across the range, the consistent strengths are third-party testing, a wide flavor list and reliable label figures. The consistent weakness is sweeteners: the flavored powders we checked use sucralose, with some flavors also listing stevia. If you avoid artificial sweeteners, look elsewhere.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">ISO100 if lactose or macros matter, Elite Whey for everyone else.</p>
            <p class="text-gray-300 leading-relaxed m-0">Both give about 25 g of protein per scoop and both carry Informed Choice testing per retailer listings. Elite Whey usually costs noticeably less per 25 g, so only pay for ISO100 when you have a reason to.</p>
          </div>
        </div>

        <div id="the-brand" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Who Makes Dymatize
          </h2>

          <p>
            Dymatize is a Texas-founded sports nutrition brand that has been making protein powders since the 1990s. Post Holdings acquired it in 2014, and in 2019 Post placed its active nutrition business, including Dymatize and Premier Protein, into BellRing Brands, which is now a separate public company. Dymatize is BellRing's gym-focused brand, while Premier Protein targets everyday shoppers.
          </p>

          <p>
            That shared ownership explains a couple of things you see on the shelf. Dymatize sells ISO100 in Fruity Pebbles and Cocoa Pebbles flavors, a licensing tie to the Post cereal brands, and Dunkin flavors such as Mocha Latte and Cappuccino. If those flavors are why you are here, our <a href="/fruity-pebbles-protein-powder/">Fruity Pebbles protein powder</a> guide covers them in detail.
          </p>

          <p>
            It also explains why Dymatize and Premier Protein feel so different despite the same parent. Premier Protein is a mass-market, ready-to-drink-first brand. Dymatize is built around powders for people who train. If you are deciding between the two, our <a href="/premier-protein-powder-review/">Premier Protein powder review</a> sets the label figures side by side.
          </p>

          <p>
            Dymatize's reputation rests mostly on ISO100, which has been one of the best-selling isolates on Amazon for years. Elite 100% Whey and Elite Casein are older products that are less talked about but just as solid on label figures. Super Mass Gainer is a long-running staple of the gainer category.
          </p>
        </div>

        <div id="range-compared" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Range Side by Side
          </h2>

          <p>
            Here is how the four main Dymatize powders compare on the label figures we checked. Serving weights vary a few grams by flavor, and Dymatize has sold different tub sizes over the years, so use these as typical rather than exact numbers.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Powder</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein / serving</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Serving</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein type</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">ISO100</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">1 scoop (about 30-33 g)</td>
                    <td class="px-4 py-4 text-gray-700">About 110-120</td>
                    <td class="px-4 py-4 text-gray-700">Hydrolyzed isolate + isolate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Elite 100% Whey</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">1 scoop (about 34 g)</td>
                    <td class="px-4 py-4 text-gray-700">About 140</td>
                    <td class="px-4 py-4 text-gray-700">Concentrate, isolate, peptides</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Elite Casein</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 33-36 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120-130</td>
                    <td class="px-4 py-4 text-gray-700">Micellar casein</td>
