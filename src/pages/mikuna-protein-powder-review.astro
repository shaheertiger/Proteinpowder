                    <td class="px-4 py-4 font-black text-gray-900">Protein per serving</td>
                    <td class="px-4 py-4 text-gray-700">20 g in every flavor</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein source</td>
                    <td class="px-4 py-4 text-gray-700">Whole chocho (Lupinus mutabilis) only; no pea, soy or rice</td>
                  </tr>
