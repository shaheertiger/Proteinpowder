const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Mikuna Protein Powder Review",
          item: `${SITE_URL}/mikuna-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Mikuna third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Mikuna publishes Eurofins laboratory reports for Pure Chocho covering lead, cadmium, mercury, arsenic, pesticides, glyphosate, 16 PFAS compounds and gluten, with the December 2025 results showing lead below 0.010 mg/kg and no PFAS or pesticides detected. It says the panel runs twice a year. Mikuna is not NSF Certified for Sport or Informed Sport, so it is not screened for banned substances."
          }
        },
        {
          "@type": "Question",
          "name": "Is Mikuna protein powder healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By label, it is one of the cleanest protein powders: Pure Chocho lists a single ingredient, chocho powder, with 20 g of protein, 8 g of fiber, 0 g of sugar and 0 mg of sodium per serving. Flavored bags add only coconut nectar, monk fruit, sea salt and vanilla or cacao. It does carry 8 to 9 g of fat, so it is higher in calories than an isolate."
          }
        },
        {
          "@type": "Question",
          "name": "Does Mikuna contain lead or heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mikuna's December 2025 Eurofins report on Pure Chocho found lead, cadmium and mercury each below 0.010 mg/kg, or under 0.39 mcg of lead per 39 g scoop, and total arsenic at 0.045 mg/kg. Those are trace levels below Prop 65's 0.5 mcg daily lead benchmark. The product page still carries a Prop 65 lead warning, and flavored versions are not separately reported."
          }
        },
        {
          "@type": "Question",
          "name": "Which Mikuna flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyers most often name Cacao and Vanilla as favorites in the reviews on Mikuna's site, and Cinnamon Horchata has devoted fans who want it back in bag form. Pure Chocho is the pick for cooking, baking and savory recipes because it is unsweetened and nutty. It is also the only flavor covered by the low FODMAP certification and the published lab reports."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common Mikuna complaints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The complaints we saw are about price, availability and texture rather than quality. At about $3.67 per 25 g of protein it costs far more than pea protein. Reviewers repeatedly ask for Cinnamon Horchata to return, and some note the powder does not fully dissolve in water. Praise centers on easy digestion and the short ingredient list."
          }
        },
        {
          "@type": "Question",
          "name": "Does Mikuna contain soy, dairy or gluten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Mikuna's ingredients contain no soy, dairy or gluten, and its December 2025 test found gluten under 3 ppm and no soy DNA in a Pure Chocho sample. However, the label says it is produced in a facility that also handles eggs, wheat, milk, tree nuts, peanuts, soybeans, shellfish and fish, so people with severe allergies should weigh cross-contact risk."
          }
        },
