---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Whey vs Whey Isolate",
    "url": "/whey-vs-whey-isolate/"
  },
  {
    "title": "Premier Protein vs Optimum Nutrition",
    "url": "/premier-protein-vs-optimum-nutrition/"
  },
  {
    "title": "Best Lactose-Free Protein Powder",
    "url": "/best-lactose-free-protein-powder/"
  },
  {
    "title": "Best Low-Carb Protein Powder",
    "url": "/best-low-carb-protein-powder/"
  },
  {
    "title": "Isopure Clear Protein Powder Review",
    "url": "/isopure-clear-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Isopure vs Optimum Nutrition: Pure Isolate or Cheaper Blend?";
const description =
  "Optimum Nutrition is cheaper at about $1.44 per 25 g vs $2.04 and NSF certified; Isopure Zero Carb wins on 0 g carbs and lactose. Labels and prices compared.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "isopure-vs-optimum-nutrition-isopure-zero-carb",
    "name": "Isopure Zero Carb Whey Protein Isolate, Creamy Vanilla (3 lb)",
    "brand": "Isopure",
    "badge": "Best Zero-Carb Isolate",
    "category": "100% whey protein isolate",
    "description": "Isopure Zero Carb gives 25 g of protein in a 31 g scoop with 110 calories, 0 g of carbohydrate, 0 g of sugar, 0.5 g of fat and 190 mg of sodium in Creamy Vanilla, per the Vitacost label at the time of writing. Whey protein isolate is its only protein, with an added vitamin and mineral blend, soy lecithin, xanthan gum and sucralose. A 3 lb tub holds about 44 servings.",
    "pros": [
      "0 g carbohydrate and 0 g sugar per scoop, per the label",
      "100% whey isolate, the lowest-lactose form of whey",
      "81% protein by weight, the highest of the three here",
      "Added vitamin and mineral blend"
    ],
    "cons": [
      "About $2.04 per 25 g, roughly 42% more than Gold Standard",
      "No sport certification found",
      "190 mg sodium and a long ingredient list"
    ],
    "bottomLine": "The isolate to buy if carbs or lactose decide it for you. Skip it if you just want the cheapest 25 g of protein or need a certified powder.",
    "specs": {
      "Protein / serving": "25 g in 31 g (label)",
      "Carbs / sugar": "0 g / 0 g",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $2.04 ($89.79, 44 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000E95HP0"
  },
  {
    "id": "isopure-vs-optimum-nutrition-on-gold-standard-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey, Double Rich Chocolate",
    "brand": "Optimum Nutrition",
    "badge": "Best Value and Certified",
    "category": "Whey isolate, concentrate and hydrolyzed whey blend",
    "description": "Gold Standard 100% Whey gives 24 g of protein in a 31 g scoop with 120 calories, 3 g of carbohydrate, 1 g of sugar, 1.5 g of fat and 130 mg of sodium in Double Rich Chocolate, per the Target label at the time of writing. The protein is a blend led by whey isolate, with whey concentrate and hydrolyzed whey, sweetened with acesulfame potassium. A 3.96 lb tub holds 58 servings.",
    "pros": [
      "About $1.44 per 25 g in the 3.96 lb tub",
      "NSF Certified for Sport (Double Rich Chocolate and Vanilla Ice Cream)",
      "24 flavors listed on the US site",
      "Short ingredient list; Label Score 78/100"
    ],
    "cons": [
      "3 g carbohydrate and 1 g sugar per scoop",
      "Contains whey concentrate, so more lactose than a pure isolate",
      "Label figures vary by lot and tub size"
    ],
    "bottomLine": "The better buy for most people: cheaper per gram, certified and available in almost any flavor. Skip it if you need zero carbs or react to whey concentrate.",
    "specs": {
      "Protein / serving": "24 g in 31 g (label)",
      "Carbs / sugar": "3 g / 1 g",
      "Third-party testing": "NSF Certified for Sport (two flavors)",
      "Cost per 25 g": "About $1.44 ($79.99, 58 servings, Target)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000GISTZ4"
  },
  {
    "id": "isopure-vs-optimum-nutrition-isopure-low-carb",
    "name": "Isopure Low Carb Whey Protein Isolate, Dutch Chocolate (3 lb)",
    "brand": "Isopure",
    "badge": "Isolate in Chocolate",
    "category": "100% whey protein isolate",
    "description": "Isopure Low Carb gives 25 g of protein in a 33 g scoop with 110 calories, 1 g of carbohydrate, 0 g of sugar, 1 g of fat and 210 mg of sodium in Dutch Chocolate, per the Vitacost label at the time of writing. It is the same whey isolate base as Zero Carb with cocoa added, which opens up chocolate and dessert flavors. A 2.98 lb tub holds about 41 servings.",
    "pros": [
      "Chocolate, peanut butter and coconut flavors Zero Carb lacks",
      "Still 100% whey isolate with 0 g sugar",
      "Only 1 g carbohydrate per scoop"
    ],
    "cons": [
      "About $2.39 per 25 g, the most of the three",
      "210 mg sodium per scoop",
      "No sport certification found; Label Score 55/100"
    ],
    "bottomLine": "Worth it only for an isolate in chocolate. Skip it if price matters, because Gold Standard is about $0.95 cheaper per 25 g.",
    "specs": {
      "Protein / serving": "25 g in 33 g (label)",
      "Carbs / sugar": "1 g / 0 g",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $2.39 ($98.03, 41 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000E8ZJGS"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Isopure vs Optimum Nutrition",
          item: `${SITE_URL}/isopure-vs-optimum-nutrition/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Isopure better than Optimum Nutrition?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb is better for carbs and lactose: 25 g of protein with 0 g of carbohydrate and sugar, against 3 g and 1 g for Gold Standard. Optimum Nutrition is better on price and verification: about $1.44 per 25 g versus $2.04, plus an NSF Certified for Sport listing. For most people Gold Standard is the better overall buy."
          }
        },
        {
          "@type": "Question",
          "name": "Which has more protein, Isopure or Gold Standard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb has slightly more: 25 g per 31 g scoop against 24 g per 31 g scoop for Gold Standard 100% Whey, per the labels we recorded. That makes Isopure 81% protein by weight and Gold Standard 77%. Over a day the 1 g difference is trivial; carbohydrate, fat and price separate them far more than protein."
          }
        },
        {
          "@type": "Question",
          "name": "Optimum Nutrition Gold Standard vs Isopure Low Carb: which is better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gold Standard is the better value against Isopure Low Carb. It costs about $1.44 per 25 g against $2.39, carries an NSF certification on two flavors and scores 78/100 to Low Carb's 55. Isopure Low Carb only wins on fat and carbs, at 1 g of each, and on being a pure isolate."
          }
        },
        {
          "@type": "Question",
          "name": "Is Isopure or Gold Standard better for lactose intolerance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb is the safer choice, because it is pure whey isolate and lists 0 g of sugar, where lactose would show up. Gold Standard contains whey concentrate and lists 1 g of sugar per scoop. Neither brand publishes a lactose figure or sells these tubs as lactose-free, and neither suits a milk allergy."
          }
        },
        {
          "@type": "Question",
          "name": "Is Isopure third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We could not find an independent certification for Isopure. A search of the NSF Certified for Sport database for Isopure returned no results on 20 November 2026, and the product listings we read claim none. Gold Standard 100% Whey was listed by NSF in Double Rich Chocolate and Vanilla Ice Cream when we checked."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for keto, Isopure or Optimum Nutrition?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb is the better keto fit, with 0 g of carbohydrate, 0 g of sugar and 0.5 g of fat per scoop on its label. Gold Standard adds 3 g of carbohydrate per serving in Double Rich Chocolate, which is 6 g a day on two scoops. That is manageable on most low-carb plans but tight on a strict 20 g limit."
          }
        },
        {
          "@type": "Question",
          "name": "Is Gold Standard whey isolate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Gold Standard 100% Whey is a blend of whey protein isolate, whey protein concentrate and hydrolyzed whey protein, with isolate listed first and therefore the largest share by weight. Optimum Nutrition does not publish the ratio. The brand sells a separate Gold Standard 100% Isolate for buyers who want isolate only."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "isopure vs optimum nutrition",
      "isopure vs gold standard",
      "optimum nutrition gold standard vs isopure low carb",
      "isopure zero carb vs gold standard",
      "whey isolate vs whey blend"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Isolate Picks",
    link: "/best-whey-protein-isolate/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Isopure vs Optimum Nutrition</Fragment>
      Isopure Zero Carb is pure whey isolate; Gold Standard is an isolate-led blend. We compare labels, lactose, carbs, certification and cost per 25 g to settle which one to buy.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">Product Cards</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#isolate-vs-blend">Isolate vs Blend</a>
      <a href="#lactose">Lactose and Carbs</a>
      <a href="#price">Cost per 25 g</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#low-carb">Gold Standard vs Low Carb</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#strengths">Strengths and Weaknesses</a>
      <a href="#which-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Optimum Nutrition Gold Standard is the better buy for most people: it costs about $1.44 per 25 g of protein against $2.04 for <a href="/protein-powder/isopure-zero-carb/">Isopure Zero Carb</a>, and two of its flavors are NSF Certified for Sport. Isopure wins if you need 0 g of carbs, the lowest lactose or a 100% isolate. Below we compare both labels, Isopure Low Carb, testing and price.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Isopure vs Optimum Nutrition: The Short Answer
          </h2>

          <p>
            Optimum Nutrition Gold Standard is the better buy for most people, and Isopure Zero Carb is the better pick for anyone counting carbs or reacting to lactose. Gold Standard costs about $1.44 per 25 g of protein at the Target price we recorded and is listed in the <a href="https://www.nsfsport.com/" rel="nofollow noopener" target="_blank">NSF Certified for Sport database</a>; Isopure Zero Carb costs about $2.04 per 25 g at Vitacost and has no sport certification we could find. In exchange, Isopure gives 25 g of protein with 0 g of carbohydrate, 0 g of sugar and 0.5 g of fat, per its label.
          </p>

          <p>
            Pick Isopure Zero Carb if you want 100% whey isolate, a zero-carb label or the gentlest option for a lactose-sensitive stomach. Pick Gold Standard if you want the lowest cost per gram, a sport certification, or the widest flavor list. Pick Isopure Low Carb only if you want the chocolate and dessert flavors that Zero Carb does not offer and are happy to pay the most per gram of the three.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Zero Carb</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">ON Gold Standard 100% Whey</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein type</td>
                    <td class="px-4 py-4 text-gray-700">100% whey isolate</td>
                    <td class="px-4 py-4 text-gray-700">Isolate, concentrate and hydrolyzed whey blend</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein / calories</td>
                    <td class="px-4 py-4 text-gray-700">25 g / 110 kcal</td>
                    <td class="px-4 py-4 text-gray-700">24 g / 120 kcal</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbs / sugar</td>
                    <td class="px-4 py-4 text-gray-700">0 g / 0 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g / 1 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Certification</td>
                    <td class="px-4 py-4 text-gray-700">None found</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (two flavors listed)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.04</td>
                    <td class="px-4 py-4 text-gray-700">About $1.44</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">63/100</td>
                    <td class="px-4 py-4 text-gray-700">78/100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Isopure and Optimum Nutrition at a Glance
          </h2>

          <p>
            The three powders below are the ones people actually compare when they type isopure vs gold standard: Isopure's two flagship tubs and Optimum Nutrition's best-seller. All figures come from our product database, which records the label and a dated retail price for each product; the Label Score is our 100-point rating explained on the <a href="/methodology/">methodology</a> page, and cost per 25 g is the retail price divided by the grams of protein in the tub, scaled to 25 g.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Zero Carb</td>
                    <td class="px-4 py-4 text-gray-700">Zero-carb diets, lactose-sensitive stomachs</td>
                    <td class="px-4 py-4 text-gray-700">You want the cheapest protein or a certified powder</td>
                    <td class="px-4 py-4 text-gray-700">63/100</td>
                    <td class="px-4 py-4 text-gray-700">About $2.04</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">ON Gold Standard 100% Whey</td>
                    <td class="px-4 py-4 text-gray-700">Value, drug-tested athletes, flavor variety</td>
                    <td class="px-4 py-4 text-gray-700">You need zero carbs or react to whey concentrate</td>
                    <td class="px-4 py-4 text-gray-700">78/100</td>
                    <td class="px-4 py-4 text-gray-700">About $1.44</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Low Carb</td>
                    <td class="px-4 py-4 text-gray-700">Chocolate and dessert flavors in an isolate</td>
                    <td class="px-4 py-4 text-gray-700">Price matters to you at all</td>
                    <td class="px-4 py-4 text-gray-700">55/100</td>
                    <td class="px-4 py-4 text-gray-700">About $2.39</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The gap in Label Score is mostly about the things Gold Standard does better on paper: a sport certification, a lower cost per gram and a shorter ingredient list. Isopure loses points for its added vitamin and mineral blend, its xanthan gum and its higher sodium, and it gains them back on carbs and fat. The cards below lay out each product in more detail.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Isopure Zero Carb, Gold Standard and Isopure Low Carb Compared
          </h2>

          <p>
            One card per side, plus Isopure Low Carb because so many searches set it against Gold Standard. Every figure is from the label and the dated retail price in our database; Amazon prices change daily, so check the live price before you buy. Database pages: <a href="/protein-powder/isopure-zero-carb/">Isopure Zero Carb</a>, <a href="/protein-powder/optimum-nutrition-gold-standard-whey/">Optimum Nutrition Gold Standard 100% Whey</a> and <a href="/protein-powder/isopure-low-carb/">Isopure Low Carb</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            Here is every label number side by side, taken from the retailer listings named in the last row. Optimum Nutrition's own site shows its supplement facts only as an image, so the Gold Standard numbers come from the <a href="https://www.target.com/p/optimum-nutrition-gold-standard-100-whey-protien-double-chocolate-3-89lbs/-/A-89319296" rel="nofollow noopener" target="_blank">Target listing</a> for the 3.96 lb Double Rich Chocolate tub; the Isopure numbers come from the <a href="https://www.vitacost.com/products/isopure-zero-carb-protein-powder-creamy-vanilla-3-lb-1-36-kg-11460" rel="nofollow noopener" target="_blank">Vitacost listing</a> for the 3 lb Creamy Vanilla tub and the Vitacost listing for Low Carb Dutch Chocolate. Labels change by flavor and by production run, so read the panel on the tub you actually buy.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Zero Carb</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">ON Gold Standard 100% Whey</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Low Carb</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Flavor checked</td>
                    <td class="px-4 py-4 text-gray-700">Creamy Vanilla</td>
                    <td class="px-4 py-4 text-gray-700">Double Rich Chocolate</td>
                    <td class="px-4 py-4 text-gray-700">Dutch Chocolate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per serving</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Scoop size</td>
                    <td class="px-4 py-4 text-gray-700">31 g</td>
                    <td class="px-4 py-4 text-gray-700">31 g</td>
                    <td class="px-4 py-4 text-gray-700">33 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein density</td>
                    <td class="px-4 py-4 text-gray-700">81%</td>
                    <td class="px-4 py-4 text-gray-700">77%</td>
                    <td class="px-4 py-4 text-gray-700">76%</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">110</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
