                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein source</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What we found</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Momentous Essential Whey</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate</td>
                    <td class="px-4 py-4 text-gray-700">Help center states no rennet is used in production</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
