---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Optimum Nutrition Protein Powder Review",
    "url": "/optimum-nutrition-protein-powder-review/"
  },
  {
    "title": "Transparent Labs Protein Powder Review",
    "url": "/transparent-labs-protein-powder-review/"
  },
  {
    "title": "Isopure Protein Powder Review",
    "url": "/isopure-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Rule 1 Protein Powder Review: Is R1 Whey Isolate Worth It?";
const description =
  "Yes for most lifters: Rule 1 R1 Protein gives 25 g of whey isolate protein per scoop for about $1.69 per 25 g on Amazon. Label, testing, flavors and swaps.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "rule-1-protein-powder-review-r1-protein-5lb",
    "name": "Rule 1 R1 Protein Whey Isolate, Milk Chocolate, 71 Servings (5 lb)",
    "brand": "Rule 1 Proteins",
    "badge": "Best Overall",
    "category": "Whey isolate + hydrolyzed whey isolate",
    "description": "R1 Protein is Rule 1's flagship. Per the label at the time of writing, every flavor takes its protein only from whey protein isolate and hydrolyzed whey protein isolate, with no concentrate. A 32.5 g scoop of Milk Chocolate gives 25 g of protein, 120 calories, 3 g of carbs, 0 g of sugar and 0.5 g of fat; vanilla and unflavored scoops run 110 calories. It is sweetened with sucralose and acesulfame potassium and contains soy lecithin. At the $119.99 we saw on Amazon for 71 servings, it works out to about $1.69 per 25 g of protein.",
    "pros": [
      "Protein comes only from whey isolate and hydrolyzed whey isolate, per the label",
      "25 g of protein with 0 to 1 g of sugar in every flavor panel we read",
      "Informed Choice banned-substance testing, per Rule 1",
      "19 flavors listed on the brand site, including Unflavored"
    ],
    "cons": [
      "Two artificial sweeteners in every flavored version",
      "Contains soy (soy lecithin) as well as milk",
      "Small tubs cost about $2.00 to $2.14 per 25 g on Amazon"
    ],
    "bottomLine": "A clean, well-priced isolate in the big tub. Buy the 5 lb size or catch a brand-site sale; the 2 lb tubs on Amazon cost 18% to 27% more per gram.",
    "specs": {
      "Protein / serving": "25 g (label)",
      "Calories": "110 to 120, by flavor",
      "Third-party testing": "Informed Choice (per Rule 1)",
      "Cost per 25 g": "About $1.69 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0FXY568CS"
  },
  {
    "id": "rule-1-protein-powder-review-whey-blend-vanilla-ice-cream",
    "name": "Rule 1 Whey Protein (Whey Blend), Vanilla Ice Cream, 27 Servings (2 lb)",
    "brand": "Rule 1 Proteins",
    "badge": "Vanilla Ice Cream Pick",
    "category": "Whey blend (concentrate, isolate, hydrolyzed isolate)",
    "description": "This is the tub most people mean when they search for Rule 1 Vanilla Ice Cream: the flavor belongs to Rule 1's Whey Protein blend, not to R1 Protein. Per the label at the time of writing, a 33 g scoop gives 24 g of protein, 130 calories, 3 g of carbs, 1 g of sugar and 2 g of fat from whey concentrate, whey isolate and hydrolyzed whey isolate. It adds cellulose gum and xanthan gum for body. At the $44.99 we saw on Amazon for 27 servings, that is about $1.74 per 25 g.",
    "pros": [
      "The only Rule 1 whey tub sold in Vanilla Ice Cream (Source 7 also has it)",
      "24 g of protein from three whey sources, per the label",
      "Informed Choice banned-substance testing, per Rule 1",
      "Large 5 lb tubs drop to about $1.53 per 25 g on Amazon"
    ],
    "cons": [
      "Contains whey concentrate, so more lactose and fat than R1 Protein",
      "Two gums plus two artificial sweeteners",
      "80 mg of cholesterol per scoop, against 0 mg in R1 Protein"
    ],
    "bottomLine": "Buy it for the Vanilla Ice Cream flavor or a lower price per tub. If you want the cleaner isolate, the vanilla in R1 Protein is Vanilla Creme.",
    "specs": {
      "Protein / serving": "24 g (label)",
      "Calories": "130",
      "Third-party testing": "Informed Choice (per Rule 1)",
      "Cost per 25 g": "About $1.74 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B09VMBDPD9"
  },
  {
    "id": "rule-1-protein-powder-review-casein-57-servings",
    "name": "Rule 1 Casein Protein, Vanilla Creme, 57 Servings (4 lb)",
    "brand": "Rule 1 Proteins",
    "badge": "Best Value",
    "category": "Micellar casein",
    "description": "Rule 1 Casein is the cheapest protein per gram in the lineup. Per the label at the time of writing, a 35 g scoop of Chocolate Fudge gives 25 g of protein from micellar casein, 120 calories, 3 g of carbs and under 1 g of sugar, plus 600 mg of calcium. Casein digests slowly, so it suits a shake before bed or a thick pudding rather than a fast post-workout drink. At the $64.99 we saw on Amazon for 57 servings, it costs about $1.14 per 25 g of protein.",
    "pros": [
      "About $1.14 per 25 g at the Amazon price we saw, the lowest in the range",
      "100% of protein from micellar casein, per Rule 1",
      "600 mg of calcium per scoop on the Chocolate Fudge panel"
    ],
    "cons": [
      "240 mg of sodium per scoop, the highest in the lineup",
      "Thick texture by design; not a light shake",
      "Same sucralose, acesulfame potassium and gums as the whey blend"
    ],
    "bottomLine": "The best-value Rule 1 tub if you want a nighttime or meal-replacement protein. Pair it with R1 Protein rather than replacing it.",
    "specs": {
      "Protein / serving": "25 g (label)",
      "Calories": "120",
      "Third-party testing": "Informed Choice (per Rule 1)",
      "Cost per 25 g": "About $1.14 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B076PQPHFM"
  },
  {
    "id": "rule-1-protein-powder-review-alt-dymatize-iso100-5lb",
    "name": "Dymatize ISO100 Hydrolyzed Whey Isolate, Gourmet Vanilla, 76 Servings (5 lb)",
    "brand": "Dymatize",
    "badge": "Closest Competitor",
    "category": "Hydrolyzed whey isolate + whey isolate",
    "description": "ISO100 is built the same way as R1 Protein: hydrolyzed whey isolate and whey isolate, no concentrate. Per the label at the time of writing, a 32 g scoop of Gourmet Chocolate gives 25 g of protein, 120 calories, 2 g of carbs and 1 g of sugar, sweetened with sucralose and stevia. Dymatize promotes Informed Choice testing too. At the $126.75 we saw on Amazon for 76 servings of Gourmet Vanilla, it costs about $1.67 per 25 g, within a few cents of R1 Protein's 5 lb tub.",
    "pros": [
      "Same isolate-plus-hydrolysate structure as R1 Protein",
      "Informed Choice testing, per Dymatize",
      "About $1.67 per 25 g in the 5 lb tub at the Amazon price we saw"
    ],
    "cons": [
      "Contains soy lecithin, like R1 Protein",
      "Smaller tubs cost far more per gram",
      "Servings per 5 lb tub vary by flavor (70 to 76 on the Amazon listings we saw)"
    ],
    "bottomLine": "A coin-flip with R1 Protein on formula and cost. Buy whichever 5 lb tub is cheaper on the day, or whichever flavor you prefer.",
    "specs": {
      "Protein / serving": "25 g (label)",
      "Calories": "About 120",
      "Third-party testing": "Informed Choice (per Dymatize)",
      "Cost per 25 g": "About $1.67 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B00G6QHYZ6"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Rule 1 Protein Powder Review",
          item: `${SITE_URL}/rule-1-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Rule 1 third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, per Rule 1. Its protein pages say each product, including R1 Protein, is Informed Choice certified and regularly tested for banned substances by LGC, the anti-doping lab behind the program. We could not load the Informed Choice registry to confirm the listing on November 21, 2026, so drug-tested athletes should search it for their exact product and flavor before relying on it."
          }
        },
        {
          "@type": "Question",
          "name": "Is Rule 1 protein powder healthy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "R1 Protein is about as lean as whey gets: 25 g of protein, 110 to 120 calories, 0 to 1 g of sugar and 0 to 0.5 g of fat per scoop, per the label. The trade-offs are artificial sweeteners and soy lecithin. It is a sound supplement for healthy adults, but it does not replace whole foods, and people with kidney disease should ask a doctor first."
          }
        },
        {
          "@type": "Question",
          "name": "Does Rule 1 R1 Protein contain lactose or soy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It contains a small amount of lactose, because whey isolate is filtered to remove most but not all of it, and Rule 1 does not call R1 Protein lactose-free. It contains soy in the form of soy lecithin, and the label declares both milk and soy. Many lactose-sensitive people tolerate isolate well, but anyone with a milk or soy allergy should choose another powder."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best Rule 1 flavor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no independent ranking, and we did not taste them, so judge by label and recent buyer reviews of each flavor. Chocolate Fudge is the default flavor on Rule 1's R1 Protein page and is sold in every size, from 1.5 lb to 5 lb. If you want Vanilla Ice Cream, that flavor is only in the Whey Protein blend and Source 7, not R1 Protein. Unflavored suits cooking and smoothies."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common complaints about Rule 1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The issues worth knowing from the labels and listings are practical ones. Every flavored R1 Protein uses sucralose and acesulfame potassium, which some people dislike. Small tubs are expensive per gram on Amazon. And the similar packaging of R1 Protein and the Whey Protein blend leads people to buy the wrong product. Read the front label and compare per 25 g."
          }
        },
        {
          "@type": "Question",
          "name": "Does Rule 1 make its own protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rule 1 says it does. Its Our Story page describes a purpose-built manufacturing facility of more than 250,000 square feet, on-site development labs and a 90,000 square foot distribution center, backed by forty years of manufacturing experience. Most supplement brands use contract manufacturers, so owning production gives Rule 1 direct control over blending, quality checks and labeling, at least by its own account."
          }
        },
        {
          "@type": "Question",
          "name": "Is Rule 1 R1 Protein good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can help as part of a calorie deficit, because 25 g of protein for 110 to 120 calories is an efficient way to raise protein intake, and higher-protein diets help preserve muscle and keep hunger in check while dieting. The powder itself does not burn fat. Count the shake in your daily calories, and use the Unflavored or Vanilla Creme versions for the lowest calories."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "rule 1 protein powder",
      "is rule 1 a good protein powder",
      "rule 1 protein powder vanilla ice cream",
      "rule 1 r1 protein",
      "rule 1 whey protein"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Protein Picks",
    link: "/best-whey-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Brand Review"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Rule 1 Protein Powder Review</Fragment>
      Rule 1 makes a whey isolate (R1 Protein), a three-whey blend, a casein and four other protein powders. We read every supplement-facts panel Rule 1 publishes, checked its testing claims and worked out the cost per 25 g of protein.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#top-picks">The Products</a>
      <a href="#lineup">The Lineup</a>
      <a href="#label">What's in R1 Protein</a>
      <a href="#whey-blend">Whey Blend & Vanilla Ice Cream</a>
      <a href="#third-party-tested">Testing</a>
      <a href="#cost">Cost per 25 g</a>
      <a href="#taste">Taste & Mixing</a>
      <a href="#vs-dymatize">vs Dymatize ISO100</a>
      <a href="#who-should-buy">Who Should Buy</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Rule 1 is a good protein powder brand, and R1 Protein is its best product: 25 g of protein per scoop from whey isolate and hydrolyzed whey isolate only, with 0 to 1 g of sugar and about $1.69 per 25 g in the 5 lb tub on Amazon. The catch: Rule 1's cheaper whey blend sits under a similar label. Below: lineup, labels, testing, cost and swaps.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Rule 1 Protein Powder: The Short Answer
          </h2>

          <p>
            Yes, Rule 1 is a good protein powder brand, and R1 Protein is the one to buy. Per the label at the time of writing, every R1 Protein flavor gives 25 g of protein from whey isolate and hydrolyzed whey isolate, with 110 to 120 calories and 0 to 1 g of sugar per scoop, and Rule 1 says the line is Informed Choice certified. In the 5 lb tub it costs about $1.69 per 25 g of protein at the Amazon price we saw on November 21, 2026, which is in line with Dymatize ISO100 and cheaper than most isolates.
          </p>

          <p>
            <strong>Buy it if</strong> you want a plain, high-protein whey isolate with lots of flavors, you buy in bulk, and sucralose does not bother you. <strong>Skip it if</strong> you avoid artificial sweeteners or soy, you need a dairy-free powder, or you only buy small tubs, where the price per gram climbs to about $2.00 to $2.14 on Amazon. And check the label before you pay: Rule 1's cheaper Whey Protein blend sits next to R1 Protein on the shelf and is a different product.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">R1 Protein by the Numbers</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">25 g</p>
                <p class="text-gray-400 text-xs mt-1">Protein per scoop (label)</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">0-1 g</p>
                <p class="text-gray-400 text-xs mt-1">Sugar per scoop, by flavor</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">$1.69</p>
                <p class="text-gray-400 text-xs mt-1">Per 25 g, 5 lb tub on Amazon</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">19</p>
                <p class="text-gray-400 text-xs mt-1">Flavors on the brand site</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Rule 1 Protein Powders and the Closest Competitor on Amazon
          </h2>

          <p>
            Rule One Proteins sells its own powders on Amazon, so every card below has a live listing. The first three are Rule 1 products; the fourth is Dymatize ISO100, the isolate-plus-hydrolysate powder R1 Protein is most often compared with. Prices are the Amazon prices we saw on November 21, 2026, and they move, especially around Black Friday.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. What Protein Powders Does Rule 1 Make?
          </h2>

          <p>
            Rule 1 currently sells six protein powders plus two mass gainers, per its own protein collection page. R1 Protein is the whey isolate; Whey Protein is a three-whey blend; Casein Protein is micellar casein; Source 7 is a seven-source blend; Clear Whey Isolate is a juice-style clear protein; and Plant Protein is the vegan option. The gainers, Mass Gainer and Clean Gainer, are calorie products rather than everyday protein shakes, and we leave them out of the cost math below.
          </p>

          <p>
            The names cause most of the confusion. Many shoppers call any Rule 1 tub "R1 protein", and both the isolate and the blend wear the R1 logo, but only the tub labeled <strong>R1 Protein Whey Isolate</strong> is the isolate-and-hydrolysate formula. The tub labeled simply <strong>Whey Protein</strong> (often listed by retailers as R1 Whey Blend) adds whey concentrate, which is why it carries 2 to 2.5 g of fat and 80 mg of cholesterol per scoop, against 0 to 0.5 g and 0 mg for R1 Protein.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Rule 1 powder</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein source</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein / scoop</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Brand-site price seen</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">R1 Protein Whey Isolate</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate + hydrolyzed whey isolate</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">$39.99 (1.5 lb) to $114.74 (5 lb)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whey Protein (R1 Whey Blend)</td>
                    <td class="px-4 py-4 text-gray-700">Concentrate + isolate + hydrolyzed isolate</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                    <td class="px-4 py-4 text-gray-700">$35.99 (1.5 lb) to $93.49 (5 lb)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Casein Protein</td>
                    <td class="px-4 py-4 text-gray-700">Micellar casein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">$24.49 (2 lb), $45.49 (4 lb)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Source 7 Protein</td>
                    <td class="px-4 py-4 text-gray-700">Four wheys, casein, milk isolate, pea</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                    <td class="px-4 py-4 text-gray-700">$31.99 (1.8 lb)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Clear Whey Isolate</td>
                    <td class="px-4 py-4 text-gray-700">Clear whey isolate</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">$35.99 (20 servings)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Plant Protein</td>
                    <td class="px-4 py-4 text-gray-700">Pea, sunflower, pumpkin and watermelon seed</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">$20.99 (20 servings)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The brand-site prices in that table are the Black Friday sale prices Rule 1 was showing on November 21, 2026; the regular prices printed beside them were 20% to 30% higher. Protein figures come from Rule 1's product pages and nutrition panels, and they can shift slightly by flavor. Source 7 lists Vanilla Ice Cream among its ten flavors, which matters for one of the questions below.
          </p>

          <p>
            Rule 1 says it makes its own products. Its Our Story page describes a manufacturing facility of over 250,000 square feet, a 90,000 square foot distribution center and forty years of manufacturing experience behind the brand. That is unusual: many protein brands hire contract manufacturers. It does not prove anything about quality on its own, but it does mean one company controls the formula, the blending and the label.
          </p>

          <p>
            For most readers, the choice comes down to the first two rows. R1 Protein is the cleaner, leaner isolate. Whey Protein is cheaper per tub and has the dessert flavors, including Vanilla Ice Cream. Casein is a useful add-on for nighttime, and Plant Protein is the only Rule 1 option if you avoid dairy.
          </p>
        </div>

        <div id="label" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Is in Rule 1 R1 Protein?
          </h2>

          <p>
            R1 Protein contains whey protein isolate, hydrolyzed whey protein isolate, flavoring, sucralose, acesulfame potassium, soy lecithin and sunflower lecithin, per the Chocolate Fudge, Milk Chocolate and Vanilla Creme panels on Rule 1's site at the time of writing. Chocolate flavors add cocoa processed with alkali and a little salt. There is no whey concentrate, no creamer, no added amino acids and no gums in the panels we read.
          </p>

          <p>
            The numbers barely move between flavors. A 32 g scoop of Chocolate Fudge gives 25 g of protein, 120 calories, 0.5 g of fat, 3 g of carbohydrate including 1 g of fiber, 0 g of sugar and 60 mg of sodium. Vanilla Creme comes in a 30 g scoop with 110 calories, 0 g of fat, 1 g of carbohydrate, 1 g of sugar and 45 mg of sodium. Unflavored is the leanest: 29.5 g for 25 g of protein, 110 calories, 0 g of sugar and 40 mg of sodium.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">R1 Protein flavor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Scoop</th>
