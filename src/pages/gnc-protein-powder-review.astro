];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "GNC Protein Powder Review",
          item: `${SITE_URL}/gnc-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is GNC protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GNC AMP Wheybolic is a good, mainstream whey. Per GNC's 2026 label for Wheybolic Original, one scoop gives 25 g of protein in 120 calories with 1 g of sugar and 1 g of fat, much like other good whey. Its value depends on price: on a GNC sale it is competitive; at full price, rivals are usually cheaper per gram."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in GNC AMP Wheybolic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 2026 Wheybolic Original label lists 25 g of protein, 120 calories and 3.1 g of leucine per 32.4 g scoop, and 50 g of protein in 240 calories per two-scoop serving. The large tub holds 52 scoops. Older tubs list 40 g per two scoops; the 2026 Original lists 25 g per scoop, so check which label you have."
          }
        },
        {
          "@type": "Question",
          "name": "Is AMP Wheybolic better than Optimum Nutrition Gold Standard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not on protein quality. The scoops are now nearly identical: Gold Standard lists about 24 g of protein in roughly 120 calories and Wheybolic Original 25 g in 120. Gold Standard usually costs less per 25 g of protein on Amazon and promotes Informed Choice certification on many flavors. AMP Wheybolic can win on price during GNC sales."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between AMP Wheybolic and Wheybolic Ripped?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ripped is the version GNC markets for cutting. Per GNC's listing at the time of writing, it gives 40 g of protein in about 200 calories per two scoops, against 50 g in 240 calories for Wheybolic Original, so it has fewer calories but also less protein. Cutting formulas can include extra ingredients, so read the label. For most people, one scoop of the Original does the same job."
          }
        },
        {
          "@type": "Question",
          "name": "Is GNC Pro Performance 100% Whey still worth buying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We could not confirm the current Pro Performance whey label from a source we could access, so we have not rated it here. If you find it in a GNC store, compare it with AMP Wheybolic and mainstream brands on cost per 25 g of protein using the label on the tub. That calculation decides which is the better value."
          }
        },
        {
          "@type": "Question",
          "name": "Is GNC AMP Wheybolic third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 2026 Wheybolic Original label carries the Informed Choice logo, but we could not confirm the product in the Informed Choice registry ourselves. Drug-tested athletes should check the registry for their exact product, flavor and batch before buying, or choose a product they can find listed, such as Dymatize ISO100, which Dymatize states is Informed Choice certified."
          }
        },
        {
          "@type": "Question",
          "name": "Where can I buy GNC protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mainly at GNC stores and on gnc.com, where sales and member deals change the price often. GNC products also appear at other retailers such as Walmart and with online sellers. If you buy outside GNC, check that the seller is reputable and the product is in date, and compare the cost per 25 g of protein with mainstream wheys on Amazon."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
