---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Whey Protein Powder",
    "url": "/best-whey-protein-powder/"
  },
  {
    "title": "Muscle Milk Protein Powder Review",
    "url": "/muscle-milk-protein-powder-review/"
  },
  {
    "title": "Pure Protein Powder Review",
    "url": "/pure-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-11-19" });
const title = "GNC Protein Powder Review: AMP Wheybolic's New 25 g Scoop";
const description =
  "GNC's AMP Wheybolic is a good whey: the 2026 Original lists 25 g protein and 120 calories per scoop. Worth it on a GNC sale; at full price, rivals cost less.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "gnc-amp-wheybolic",
    "name": "GNC AMP Wheybolic Original Whey Protein Powder",
    "brand": "GNC",
