                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">AMP Wheybolic (Natural flavors)</td>
                    <td class="px-4 py-4 text-gray-700">2 scoops</td>
                    <td class="px-4 py-4 text-gray-700">40 g</td>
                    <td class="px-4 py-4 text-gray-700">About 220</td>
                    <td class="px-4 py-4 text-gray-700">About 25 servings per tub</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
