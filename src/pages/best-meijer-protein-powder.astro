const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Meijer Protein Powder",
          item: `${SITE_URL}/best-meijer-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Does Meijer have its own brand of protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Meijer sells Meijer-brand whey protein powder in 2 lb tubs, listed at $26.99 on Meijer.com in November 2026, in Vanilla and Chocolate, plus Strawberry, Cookies and Cream and a 32 oz Chocolate Peanut Butter Power Blend. Per the label, a serving gives 30 g of protein. Meijer does not name the manufacturer on the listings we saw."
          }
        },
