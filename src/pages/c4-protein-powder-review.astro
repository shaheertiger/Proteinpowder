      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "C4 Protein Powder Review",
          item: `${SITE_URL}/c4-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Does C4 protein powder have caffeine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. C4 Whey Protein contains no caffeine and no stimulants, per the ingredient lists for the US Hershey's Milk Chocolate, Reese's and Vanilla flavors at the time of writing. The caffeine people associate with C4 comes from its pre-workouts and energy drinks, which list 200 mg or more per can. The C4 Sparkling Protein drink is also described as caffeine-free."
