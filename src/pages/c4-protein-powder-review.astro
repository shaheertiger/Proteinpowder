                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat / saturated</td>
                    <td class="px-4 py-4 text-gray-700">2 g / 1.5 g</td>
                    <td class="px-4 py-4 text-gray-700">2.5 g / 2 g</td>
                    <td class="px-4 py-4 text-gray-700">About 2 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sodium</td>
                    <td class="px-4 py-4 text-gray-700">180 mg</td>
                    <td class="px-4 py-4 text-gray-700">190 mg</td>
                    <td class="px-4 py-4 text-gray-700">About 180 mg</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Allergens</td>
