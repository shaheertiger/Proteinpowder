const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Equate Protein Powder",
          item: `${SITE_URL}/equate-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Equate protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Equate protein powder carries no third-party certification: neither the whey nor the plant label lists NSF Certified for Sport, Informed Sport or a Clean Label Project award. Consumer Reports did lab-test the Rich Chocolate whey in January 2026 and found about 0.27 mcg of lead per serving, low enough for daily use by its measure, but that is a single independent test, not a certification."
          }
        },
        {
          "@type": "Question",
          "name": "Is Equate protein powder healthy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Equate whey is a lean, simple protein: 24 g of protein, about 120 calories and 2 g of sugar per scoop, per the label. Its ingredient list is short, though it uses sucralose, acesulfame potassium and carrageenan. The plant powder is sugar-free but high in sodium at 620 mg. People with kidney disease, allergies or other conditions should ask a doctor or dietitian first."
          }
        },
        {
          "@type": "Question",
          "name": "Does Equate whey protein contain artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Equate whey protein powder is sweetened with sucralose and acesulfame potassium, per the label at the time of writing, and the plant-based powder uses erythritol and sucralose. Both are FDA-approved, but if you avoid artificial sweeteners you will need a different tub. The whey also contains milk and a small amount of lactose from its whey concentrate."
          }
        },
        {
          "@type": "Question",
          "name": "Which Equate protein flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyers most consistently recommend Equate whey in Smooth Vanilla, describing a light flavor that mixes well into water, milk, smoothies and coffee. Rich Chocolate splits opinion: some reviewers like it, others call it thin or artificial, especially in water. For the plant powder, chocolate is the flavor with the most reviews. This reflects buyer reports, not our own tasting."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common complaints about Equate protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common complaints are about flavor, not quality: some buyers find the chocolate whey thin or artificial, and only two flavors are offered for each powder. A few report small clumps in cold liquid unless shaken well. Plant-powder buyers sometimes mention a gritty texture or strong sweetness. Shoppers who want certified testing also note that none is published."
          }
        },
        {
          "@type": "Question",
          "name": "Who makes Equate protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Equate is Walmart's private-label brand, and Walmart does not name the contract manufacturer that produces its protein powders on the listing or label information we found. Supp.co lists the whey as made in the USA with globally sourced ingredients. That anonymity is normal for store brands, but it is one reason a third-party certification would add useful assurance here."
          }
        },
        {
          "@type": "Question",
          "name": "Can you buy Equate protein powder on Amazon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, not from Walmart. Equate is sold in Walmart stores and on Walmart.com, which offers shipping and Walmart+ delivery. Any Equate tubs on third-party marketplaces come from resellers. If you prefer Amazon, Optimum Nutrition Gold Standard is the closest match to Equate whey on the label, and Orgain Organic Vegan is the closest to the Equate plant-based powder."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
