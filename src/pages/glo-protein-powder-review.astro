const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Glo Protein Powder Review",
          item: `${SITE_URL}/glo-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Glo protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not that the brand currently states. OURS, the product Glo became, has no NSF Certified for Sport or Informed Sport listing, and its product page makes no third-party testing claim. Gabbi Tuft described the original GLO as third-party tested in her posts, but no lab or results were published. The OURS page also carries a California Prop 65 lead warning."
          }
        },
        {
          "@type": "Question",
          "name": "Is Glo protein powder the same as OURS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, by brand, but not by formula. GLO Ventures now sells OURS Protein Powder, and the old GLO product link redirects to the OURS store. The recipe changed: OURS swaps stevia for allulose and monk fruit and adds collagen, coconut milk powder, myo-inositol and enzymes. Protein went from 24 g to 25 g per serving."
          }
        },
        {
          "@type": "Question",
          "name": "Is Glo protein powder healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Its label is cleaner than most. There are no gums, carrageenan, sucralose, acesulfame potassium or artificial flavors, and each scoop has 0 g of sugar. The trade-offs are a collagen-led protein blend, undisclosed doses of allulose and myo-inositol, 3.5 g of saturated fat in Vanilla, no third-party certification and a Prop 65 warning on the product page."
          }
        },
        {
          "@type": "Question",
          "name": "Does Glo protein powder contain collagen or lactose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes to collagen: hydrolyzed collagen peptides are the first ingredient in every OURS flavor. It is a dairy product, made with milk protein isolate and whey concentrate, so it contains lactose and declares milk as an allergen. The enzyme blend includes lactase, which may help some lactose-sensitive people, but it is not labelled lactose-free."
          }
        },
        {
          "@type": "Question",
          "name": "Which Glo protein flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In recent buyer reviews on the brand's site, Chocolate draws the most praise, described as rich and bittersweet, though some former GLO buyers find it darker and more bitter than before. Salted Caramel is the lowest in calories at 120. Vanilla is the creamiest but the most coconut-forward, which is the flavor note critics mention most."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common complaints about Glo protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most complaints come from long-time GLO customers unhappy with the reformulation: a strong coconut taste, clumping or foam even in a blender, an aftertaste, and excess sweetness. Others mention the $67.99 price, shipping costs and slow replies from customer service. Newer buyers who never tried GLO tend to rate it much higher."
          }
        },
        {
          "@type": "Question",
          "name": "Where can you buy Glo protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
