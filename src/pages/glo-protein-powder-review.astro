---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Be Well by Kelly Protein Powder Review",
    "url": "/be-well-by-kelly-protein-powder-review/"
  },
  {
    "title": "Bloom Protein Powder Review",
    "url": "/bloom-protein-powder-review/"
  },
  {
    "title": "Levels Protein Powder Review",
    "url": "/levels-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-19", modified: "2026-11-19" });
const title = "Glo Protein Powder Review: Is It Now OURS, and Is It Worth It?";
const description =
  "Glo is now OURS: 25 g protein, 120-140 calories, allulose and monk fruit, $2.72 per 25 g. We check the collagen-first label, testing and buyer complaints.";

const PRODUCTS: {
  id: string;
  name: string;
