    "cons": [
      "Still a milk product, so not suitable for a milk allergy",
      "Flavored versions use artificial sweetener, and the unflavored one contains soy lecithin",
      "No NSF or Informed Choice listing we could confirm"
    ],
    "bottomLine": "The first whey to try if lactose is your only problem.",
    "specs": {
      "Protein / serving": "About 25 g (label)",
      "Calories": "About 100-110",
      "Third-party tested": "Check certifier databases",
      "Best for": "Lactose intolerance, low-carb"
    }
  },
  {
