  {
    "title": "Naked Nutrition Protein Powder Review",
    "url": "/naked-nutrition-protein-powder-review/"
  },
  {
    "title": "Swanson Senior Muscle Retention Protein Review",
    "url": "/swanson-senior-muscle-retention-protein-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-18", modified: "2026-11-18" });
const title = "BulkSupplements Casein Protein Powder Review: Is It Tested?";
const description =
  "Yes: BulkSupplements says it third-party lab tests every product. Its casein gives 25 g protein per 30 g, about $1.18 per 25 g. Whey, pea and soy checked too.";

const PRODUCTS: {
  id: string;
