---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Muscle Milk Protein Powder Review",
    "url": "/muscle-milk-protein-powder-review/"
  },
  {
    "title": "Best Cheap Protein Powder",
    "url": "/best-cheap-protein-powder/"
  },
  {
    "title": "Whey vs Whey Isolate",
    "url": "/whey-vs-whey-isolate/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-15", modified: "2026-11-15" });
const title = "MusclePharm Combat Protein Powder Review: Blend or 100% Whey?";
const description =
  "MusclePharm Combat reviewed by label: 5-protein blend vs Combat 100% Whey, cost per 25 g on Amazon, Informed Sport status and how it compares to Gold Standard.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
