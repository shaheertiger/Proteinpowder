    "specs": {
      "Protein / serving": "24 g (label, Chocolate Milk)",
      "Calories": "About 140",
      "Third-party testing": "Informed Sport listed",
      "Best for": "Whey-only buyers, no egg"
    },
    "amazonUrl": "https://www.amazon.com/dp/B01DOHWFGM"
  },
  {
    "id": "musclepharm-rival-on-gold-standard-whey",
