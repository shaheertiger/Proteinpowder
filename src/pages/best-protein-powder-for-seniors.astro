  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Protein Powder",
    tags: [
      "best protein powder for seniors",
      "protein powder for seniors over 70",
      "protein powder for elderly",
      "protein for sarcopenia"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Buyer's Guide"} badge={"Updated November 2026"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Best Protein Powder for Seniors</Fragment>
      Older adults need more protein per meal than younger ones to hold on to muscle. These eight shakes and powders are ranked on dose, leucine, sugar and how easy they are to actually drink every day.
    </ArticleHeader>

    <TableOfContents>
      <a href="#quick-comparison">Quick Comparison</a>
      <a href="#top-picks">Our Top Picks</a>
      <a href="#sarcopenia">Why Needs Rise With Age</a>
      <a href="#how-much-protein">How Much Seniors Need</a>
      <a href="#leucine-per-meal">Leucine Per Meal</a>
      <a href="#over-70">Seniors Over 70</a>
      <a href="#kidney-disease">Kidney Disease Caveat</a>
      <a href="#what-to-look-for">What to Look For</a>
      <a href="#how-to-use">How to Use It</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
