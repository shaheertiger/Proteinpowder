const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Seniors",
          item: `${SITE_URL}/best-protein-powder-for-seniors/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for seniors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most older adults, a ready-to-drink shake with about 30 g of protein and little sugar, such as Ensure Max Protein or Fairlife Nutrition Plan, is the easiest option. For a powder, Optimum Nutrition Gold Standard 100% Whey is the best value. Unflavored whey such as Unjury suits people who would rather stir protein into food. Check with a doctor first if you have kidney disease."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best protein powder for seniors over 70?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "After 70, ease of use matters as much as the label. Ready-to-drink bottles with about 30 g of protein avoid scoops and shakers, and unflavored whey isolates can be stirred into soup, oatmeal or coffee for people with small appetites. Look for low sugar, check added vitamin K if you take warfarin, and ask your doctor about kidney function."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein should a 70-year-old eat a day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The US RDA is 0.8 g per kilogram per day for all adults, but expert groups such as PROT-AGE and ESPEN recommend 1.0 to 1.2 g per kilogram for healthy adults over 65. For a 70 kg (154 lb) person, that is about 70 to 84 g a day, ideally with 25 to 30 g at each main meal. Kidney disease changes these targets."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey protein good for older adults?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey is one of the best protein sources for older adults because it is high in leucine, the amino acid that signals muscle building, and is digested quickly. About 25 g of whey supplies roughly 2.5 g of leucine. Whey isolate is low in lactose, which helps people who have become lactose intolerant with age. People with a milk allergy should choose a plant protein."
          }
        },
        {
          "@type": "Question",
          "name": "Is protein powder safe for seniors with kidney disease?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not without medical guidance. The 2020 KDOQI guideline recommends lower protein intake, around 0.55 to 0.6 g per kilogram per day under supervision, for stable adults with stage 3 to 5 chronic kidney disease not on dialysis. People on dialysis often need more protein. Only a doctor or renal dietitian who knows the lab results should set the target."
          }
        },
        {
          "@type": "Question",
          "name": "Can protein powder help prevent sarcopenia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Protein helps, but it works best combined with resistance exercise. Studies in older adults show strength training improves muscle mass and function, and adequate protein adds to that effect. Observational data from the Health ABC study linked higher protein intake with less lean mass loss over three years. A shake can close a protein gap, but it is not a substitute for exercise."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ensure or a protein powder better for seniors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the person. Ensure Max Protein is easier because it needs no mixing and delivers about 30 g of protein with about 1 g of sugar per bottle. A powder such as Optimum Nutrition costs less per serving and lets you control the base and dose. Classic Ensure, as opposed to Max Protein, is higher in sugar and calories and lower in protein."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
