    "specs": {
      "Protein / serving": "About 25 g",
      "Protein type": "Hydrolyzed + whey isolate",
      "Third-party tested": "Informed Choice (confirm flavor)",
      "Best for": "Cutting, lactose-sensitive"
    }
  },
  {
    "id": "myprotein-impact-whey-protein",
    "name": "Myprotein Impact Whey Protein",
    "brand": "Myprotein",
    "badge": "Best Budget",
    "category": "Whey concentrate",
    "description": "About 20-21 g of protein per 25 g scoop in the US version, per the label, from whey concentrate. Bought on one of the brand's frequent sales, it is consistently among the cheapest ways to buy 25 g of whey protein. It carries more lactose than an isolate and its certification status varies by market, so check the certifier database for the version you buy.",
    "pros": [
