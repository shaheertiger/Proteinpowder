const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for Men",
          item: `${SITE_URL}/best-protein-powder-for-men/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for men?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most men, Optimum Nutrition Gold Standard 100% Whey: about 24 g of protein per scoop, good value per gram and Informed Choice certification, per the brand. Large lifters can use two scoops for a 40 g-plus dose. For cutting, an isolate such as Dymatize ISO100 gives more protein per calorie, and Garden of Life Sport suits dairy-free men."
          }
        },
        {
          "@type": "Question",
          "name": "Do men need a different protein powder than women?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Protein is digested and used the same way in every adult. Men tend to be heavier and carry more muscle, so per-kilogram guidelines produce bigger totals and bigger per-meal doses. The right product depends on your goal, diet and budget. What changes with size is whether you need one scoop or two."
          }
        },
        {
          "@type": "Question",
          "name": "How many grams of protein should a man have in a shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A useful guide is about 0.4 g per kg of body weight per meal. For a 75 kg man that is about 30 g; for a 100 kg man, about 40 g. Research suggests 40 g after heavy whole-body training can stimulate more muscle building than 20 g, so larger lifters can reasonably double their scoop."
          }
        },
        {
          "@type": "Question",
          "name": "Does soy protein lower testosterone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not at normal intakes, according to the evidence. A 2010 meta-analysis and later reviews found that soy protein and isoflavones did not meaningfully alter testosterone in men. Case reports of hormonal effects involve extreme amounts of soy far beyond a daily shake. Soy is a complete protein and a reasonable choice for men."
          }
        },
        {
          "@type": "Question",
          "name": "Are testosterone-boosting protein powders worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no. Ingredients such as tribulus, fenugreek and D-aspartic acid have weak or inconsistent evidence in healthy men, and they are often hidden in proprietary blends. Products sold for male performance also feature in FDA warnings about undeclared ingredients. Buy a plain, certified protein and see a doctor if you suspect low testosterone."
          }
        },
        {
          "@type": "Question",
          "name": "Should men use a mass gainer or regular protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use regular protein if you need more protein; use a gainer only if you cannot eat enough calories to gain weight. Gainers add hundreds of calories, mostly carbohydrate. A homemade shake with whey, oats, banana, peanut butter and whole milk does the same job, usually for less money and with more control."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best protein shake for men on the go?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A ready-to-drink shake such as Fairlife Core Power Elite gives about 42 g of protein in a bottle, per the label, with nothing to mix. It costs much more per gram than powder, so most men are better off keeping it as a backup and using powder day to day. Check certification status if you compete."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Protein Powder",
    tags: [
      "best protein powder for men",
      "best protein shakes for men",
      "protein powder for men"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Buyer's Guide
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Updated October 2026
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          The Best <span class="text-[#38BDF8]">Protein Powder for Men</span>, Sized to Your Body and Goal
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          There is no such thing as male protein. What changes is how big you are, how hard you train and how many calories you need. These six picks cover muscle, cutting, budget, plant-based and grab-and-go, with honest notes on dose.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#optimum-nutrition-gold-standard-100-whey"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#how-we-picked"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            How We Picked
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#short-answer" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Answer</a>
          <a href="#no-mens-protein" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. There Is No Men's Protein</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. Our Top Picks</a>
          <a href="#how-we-picked" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. How We Picked</a>
          <a href="#how-much-protein" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. How Much Protein Men Need</a>
          <a href="#building-muscle" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. Shakes for Building Muscle</a>
          <a href="#cutting" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Shakes for Cutting</a>
          <a href="#weight-gain" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. Hardgainers and Mass Gainers</a>
          <a href="#testosterone-claims" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Testosterone Add-Ins</a>
          <a href="#soy-myth" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. The Soy Myth</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          The best protein powder for men is not a different kind of protein. It is the same whey, casein or plant blend that suits anyone, used in a dose that matches a typically larger body. A 95 kg man who lifts hard may need a 40 g shake where a 60 kg person needs 20 g, and that difference in size, goal and calorie budget is what should drive your choice. Tubs that promise testosterone in every scoop are selling something else.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Answer: Which Protein Powder Men Should Buy
          </h2>

          <p>
            If you want one tub and no homework, buy <strong>Optimum Nutrition Gold Standard 100% Whey</strong>. It gives about 24 g of protein per scoop, per the label at the time of writing, it sits at the cheap end of the mid-price tier per gram of protein, and Optimum Nutrition states that it carries Informed Choice certification. If you are a big lifter who needs 40 g or more in a shake, use two scoops; the economics still work, which is not true of most premium tubs.
          </p>

          <p>
            Everything else depends on your goal. If you are cutting, Dymatize ISO100 gives the most protein per calorie. If price is all that matters, Myprotein Impact Whey on sale is hard to beat. If you avoid dairy, Garden of Life Sport is a certified plant blend with about 30 g per serving. If you need a shake with no mixing, Fairlife Core Power Elite packs about 42 g into a bottle. And if you compete in a drug-tested sport, Thorne Whey Protein Isolate carries NSF Certified for Sport.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Your goal</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Our pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Why</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Build muscle</td>
                    <td class="px-4 py-4 text-gray-700">ON Gold Standard 100% Whey</td>
                    <td class="px-4 py-4 text-gray-700">Good value, certified, easy to double</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cut fat, keep muscle</td>
                    <td class="px-4 py-4 text-gray-700">Dymatize ISO100</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g protein for roughly 110-120 kcal</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Lowest cost</td>
                    <td class="px-4 py-4 text-gray-700">Myprotein Impact Whey</td>
                    <td class="px-4 py-4 text-gray-700">Among the cheapest per 25 g of protein</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dairy-free or vegan</td>
                    <td class="px-4 py-4 text-gray-700">Garden of Life Sport Plant-Based</td>
                    <td class="px-4 py-4 text-gray-700">About 30 g protein, NSF certified</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">No time to mix</td>
                    <td class="px-4 py-4 text-gray-700">Fairlife Core Power Elite</td>
                    <td class="px-4 py-4 text-gray-700">About 42 g protein in one bottle</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Drug-tested sport</td>
                    <td class="px-4 py-4 text-gray-700">Thorne Whey Protein Isolate</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            None of those picks is sold as a men's product, and nothing on the list contains a testosterone blend. That is deliberate. The sections below explain why the label on the tub matters far less than the dose you take, and why some of the claims aimed at men are worth ignoring.
          </p>
        </div>

        <div id="no-mens-protein" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. There Is No Men's Protein: Size, Goal and Calories Decide
          </h2>

          <p>
            Protein powder for men is the same product as protein powder for anyone else. Whey, casein, soy and pea are broken down into amino acids and used to build and repair muscle the same way in every adult body. What makes men's needs look different is mostly arithmetic. Men are, on average, heavier and carry more muscle, so recommendations written per kilogram of body weight produce bigger daily totals and bigger per-meal doses.
          </p>

          <p>
            Size is the first variable. A 70 kg man and a 110 kg man following the same guideline need very different amounts of protein. Goal is the second: someone building muscle, someone cutting and someone maintaining all benefit from different calorie budgets around similar protein targets. Calories are the third: a large, active man may burn 3,000 calories or more a day, which leaves room for a denser shake made with milk, oats or peanut butter, while a man on a hard cut needs the leanest protein per calorie he can find.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE RULE</p>
            <p class="text-xl font-bold text-white mb-3">Pick the protein for your goal, then scale the dose to your body weight.</p>
            <p class="text-gray-300 leading-relaxed m-0">A good whey or plant blend works for everyone. What changes is whether you need one scoop or two, and whether you mix it with water or with a few hundred extra calories.</p>
          </div>

