---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Protein Powder",
    "url": "/best-protein-powder/"
  },
  {
    "title": "Best Protein Drink",
    "url": "/best-protein-drink/"
  },
  {
    "title": "Protein Calculator",
    "url": "/protein-calculator/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-17", modified: "2026-10-17" });
const title = "Best Protein Powder for Men: Dosed by Size, Goal and Budget";
const description =
  "No protein is male-specific. Six real powders and shakes picked for muscle, cutting, budget, plant diets and convenience, with doses scaled to body weight.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "optimum-nutrition-gold-standard-100-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey",
    "brand": "Optimum Nutrition",
    "badge": "Best Overall",
    "category": "Whey blend (isolate + concentrate)",
    "description": "About 24 g of protein per scoop for roughly 120 calories, per the label at the time of writing, at the cheap end of the mid-price tier per gram of protein. Two scoops gives a big lifter close to 48 g in one shake for little more effort than one. Optimum Nutrition states that it carries Informed Choice certification, and buyers widely report that it mixes with a spoon.",
