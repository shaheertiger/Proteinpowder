    "cons": [
      "Premium cost per 25 g of protein",
      "About 21 g per scoop means two scoops for a large dose"
    ],
    "bottomLine": "The pick for drug-tested athletes, where certification matters more than price.",
    "specs": {
      "Protein / serving": "About 21 g",
      "Protein type": "Whey isolate",
      "Third-party tested": "NSF Certified for Sport",
      "Best for": "Drug-tested athletes"
    }
  }
