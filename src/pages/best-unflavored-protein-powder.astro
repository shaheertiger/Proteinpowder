const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Unflavored Protein Powder",
          item: `${SITE_URL}/best-unflavored-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best unflavored protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Naked Whey is the best unflavored protein powder: one ingredient, about 25 g of protein per two-scoop serving, and a mild taste that hides well in food. NOW Sports Whey Isolate is the best-value isolate for coffee and cold drinks, Klean Isolate suits drug-tested athletes, and Naked Pea is the best dairy-free option."
          }
        },
        {
          "@type": "Question",
          "name": "What does unflavored protein powder taste like?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyers describe unflavored whey as mild and faintly milky, similar to powdered milk, with isolate tasting cleaner and thinner than concentrate. Unflavored pea protein tastes earthy, beany and slightly bitter. Neither is pleasant mixed only with water, but both disappear into smoothies, oats, yogurt and baking, which is what they are designed for."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a truly flavorless protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No protein powder is completely tasteless, but unflavored whey isolate comes closest. It has very little fat or lactose, so its mild dairy note is barely noticeable in coffee, smoothies or savory dishes. If you want the best flavorless protein powder for mixing into food, choose an isolate with a one- or two-ingredient label."
          }
        },
        {
          "@type": "Question",
          "name": "Does heating protein powder destroy the protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Heat denatures protein, unfolding its structure, but the amino acids remain intact and your body uses them the same way. It is the same process as cooking an egg. Heat does change texture, which is why protein baked goods can turn dry, but the protein's nutritional value is essentially preserved at normal baking temperatures."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put unflavored whey protein in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and it is one of the most popular uses. To avoid clumps, mix the powder with a little cold milk or creamer first, then stir in coffee that has cooled slightly, or use a handheld frother. Whey isolate dissolves most cleanly. Iced coffee is easiest, because you can shake or blend the powder in directly."
          }
        },
        {
          "@type": "Question",
          "name": "Is unflavored protein powder healthier than flavored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not necessarily healthier, but simpler. Unflavored powders skip sweeteners, flavors and gums, which suits people who dislike or want to avoid them and anyone with a sensitive stomach. The protein itself is the same. What matters more for safety is third-party testing for contaminants, which applies to flavored and unflavored powders alike."
          }
        },
        {
          "@type": "Question",
          "name": "Should I choose unflavored whey or unflavored pea protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose unflavored whey if you tolerate dairy, because it tastes milder, mixes more easily and has more leucine per gram. Choose pea protein if you are vegan, dairy-free or allergic to milk, and plan to use it in recipes with stronger flavors. Plant users should aim for a slightly larger serving, roughly 25-30 g of protein."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
