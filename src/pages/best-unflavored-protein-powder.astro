                    <td class="px-4 py-4 font-black text-gray-900">Whey concentrate</td>
                    <td class="px-4 py-4 text-gray-700">Mild, milky, slightly creamy</td>
                    <td class="px-4 py-4 text-gray-700">Oats, shakes, yogurt, baking</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
