          }
        },
        {
          "@type": "Question",
          "name": "How many tablespoons are in a scoop of protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roughly two to four level tablespoons for a typical 30 gram scoop, but it depends on the powder's density. The reliable way is to weigh your powder: add level tablespoons to a zeroed kitchen scale until you reach the labeled grams, count them, and note the number on the lid for next time."
          }
        },
        {
          "@type": "Question",
          "name": "Is a scoop of protein powder the same as a serving?",
