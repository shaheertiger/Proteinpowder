                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Per scoop (label)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Triple Chocolate</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Vanilla Cream</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Strawberry Smoothie</th>
                  </tr>
                </thead>
                <tbody>
