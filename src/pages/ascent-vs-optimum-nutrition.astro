const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ascent vs Optimum Nutrition",
          item: `${SITE_URL}/ascent-vs-optimum-nutrition/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Ascent better than Optimum Nutrition?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not overall. Ascent is better on sweetener, using stevia instead of acesulfame potassium or sucralose, and on certification breadth, with Informed Sport across its line per Ascent. Optimum Nutrition is better on value and flavor choice, at about $1.49 per 25 g in the 5 lb tub against $1.89 for Ascent at the Amazon prices we saw. Protein and calories are nearly identical."
          }
        },
        {
          "@type": "Question",
          "name": "Which has more protein, Ascent or Gold Standard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ascent has 25 g of protein in a 33 g scoop of chocolate and Gold Standard has 24 g in a 31 g scoop of Double Rich Chocolate, per the labels at the time of writing. Per gram of powder they are almost equal, about 76% and 77% protein. The extra gram in Ascent comes from a slightly bigger scoop, not a richer powder."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ascent Native Fuel the same as Ascent 100% Whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ascent's whey was long marketed as Native Fuel Whey, and the current product is sold as Ascent 100% Whey Protein, still built around native whey isolate. The label we checked lists a native whey isolate and whey isolate blend plus whey concentrate. Older reviews describing Native Fuel as pure isolate may refer to an earlier formula, so read the current label."
          }
        },
        {
          "@type": "Question",
          "name": "Is Optimum Nutrition Gold Standard third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. ON describes Gold Standard 100% Whey as banned-substance tested, and NSF's Certified for Sport registry lists it in Double Rich Chocolate and Vanilla Ice Cream as of November 2026. ON has also promoted Informed Choice on many flavors. Certification varies by flavor and market, so tested athletes should check the exact product in each database before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Does Ascent whey have artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Ascent 100% Whey is sweetened with stevia leaf extract and uses natural flavors, with no sucralose, acesulfame potassium or artificial flavors, per Ascent. Ascent's clear whey adds a small amount of organic cane sugar, about 1 g per scoop. If you dislike stevia's aftertaste, Gold Standard's artificially sweetened formula may suit you better."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for lactose intolerance, Ascent or ON?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ascent says its whey has under 1 g of lactose per serving, while ON does not publish a lactose figure for Gold Standard. Both flagships contain some concentrate, though, so the better choice for real lactose intolerance is a pure isolate such as ON Gold Standard 100% Isolate or Ascent's clear whey. People with a milk allergy should avoid both and ask a doctor about alternatives."
          }
        },
        {
          "@type": "Question",
          "name": "Which is cheaper, Ascent or Optimum Nutrition?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Optimum Nutrition, in big tubs. Gold Standard's 5 lb tub was $105.99 for 74 servings on Amazon, about $1.49 per 25 g, against $50.95 for 27 servings of Ascent, about $1.89. In 2 lb sizes the gap closes: Gold Standard's 2 lb tub came to about $1.93 per 25 g. Prices change often, so recheck on the day you buy."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
