                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Fermentation</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Gas risk</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Gel / viscosity</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Inulin / chicory root</td>
                    <td class="px-4 py-4 text-gray-700">Fast</td>
                    <td class="px-4 py-4 text-gray-700">Higher</td>
                    <td class="px-4 py-4 text-gray-700">Low</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Agave inulin</td>
