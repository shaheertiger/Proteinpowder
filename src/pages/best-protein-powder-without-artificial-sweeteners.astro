const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-08", modified: "2026-11-08" });
const title = "Best Protein Powder Without Artificial Sweeteners: Stevia, Monk Fruit and Unsweetened Picks";
const description =
  "Protein powders without sucralose, ace-K or aspartame, compared on sweetener, protein, certification and taste, plus how to spot sweeteners on a label.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "transparent-labs-grass-fed-whey-protein-isolate",
    "name": "Transparent Labs 100% Grass-Fed Whey Protein Isolate",
    "brand": "Transparent Labs",
    "badge": "Best Overall",
    "category": "Grass-fed whey isolate, stevia-sweetened",
    "description": "Transparent Labs built its whey around a no-artificial-anything promise: the brand states it contains no artificial sweeteners, colors or preservatives, and flavored versions use stevia. Per the brand at the time of writing, a roughly 32 g scoop gives 28 g of protein from grass-fed whey isolate in about 120-150 calories depending on flavor. It is Informed Choice and Informed Protein certified, per the brand, which makes it the rare stevia whey with third-party testing behind it.",
