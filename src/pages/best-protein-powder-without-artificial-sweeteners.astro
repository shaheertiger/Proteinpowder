                    <td class="px-4 py-4 font-black text-gray-900">Monk fruit</td>
                    <td class="px-4 py-4 text-gray-700">Plant-derived</td>
                    <td class="px-4 py-4 text-gray-700">About 100-250x</td>
                    <td class="px-4 py-4 text-gray-700">Monk fruit extract, luo han guo</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Erythritol, xylitol</td>
                    <td class="px-4 py-4 text-gray-700">Sugar alcohol</td>
                    <td class="px-4 py-4 text-gray-700">Less sweet than sugar</td>
