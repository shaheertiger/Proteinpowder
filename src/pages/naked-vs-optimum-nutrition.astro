---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Clean Simple Eats vs Levels",
    "url": "/clean-simple-eats-vs-levels/"
  },
  {
    "title": "Ghost Protein vs Optimum Nutrition",
    "url": "/ghost-vs-optimum-nutrition/"
  },
  {
    "title": "Isopure vs Optimum Nutrition",
    "url": "/isopure-vs-optimum-nutrition/"
  },
  {
    "title": "Premier Protein vs Optimum Nutrition",
    "url": "/premier-protein-vs-optimum-nutrition/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-22", modified: "2026-11-22" });
const title = "Naked vs Optimum Nutrition: Pure Whey or Tested Blend?";
const description =
  "Optimum Nutrition is cheaper at about $1.44 per 25 g of protein vs $1.84 and NSF Certified for Sport; Naked Whey wins on a one-ingredient grass-fed label.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "naked-vs-optimum-nutrition-on-gold-standard-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey, Double Rich Chocolate",
    "brand": "Optimum Nutrition",
    "badge": "Best Value and Sport-Tested",
    "category": "Whey isolate, concentrate and hydrolyzed whey blend",
    "description": "Per the label at the time of writing, a 31 g scoop of Double Rich Chocolate gives 24 g of protein, about 120 calories, 3 g of carbohydrate, 1 g of sugar, 1.5 g of fat and 130 mg of sodium, sweetened with acesulfame potassium. Optimum Nutrition states 5.5 g of BCAAs per scoop. At $79.99 for 58 servings at Target (checked 1 November 2026) it costs about $1.44 per 25 g of protein, and Double Rich Chocolate and Vanilla Ice Cream appear in NSF Certified for Sport listings (checked 19 November 2026).",
    "pros": [
      "About $1.44 per 25 g in the 58-serving tub",
      "NSF Certified for Sport for Double Rich Chocolate and Vanilla Ice Cream",
      "About 24 flavors listed by the brand",
      "Label Score 78 / 100, the higher of the two"
    ],
    "cons": [
      "Acesulfame potassium and artificial flavor",
      "Lists soy (lecithin) as well as milk",
      "Small 1.98 lb tub costs about $2.68 per 25 g at ON's store price"
    ],
    "bottomLine": "The better buy for most people, and the only one of the two for drug-tested athletes. Skip it if you avoid artificial sweeteners or soy, or want a powder with nothing added.",
    "specs": {
      "Protein / serving": "24 g in 31 g (label)",
      "Sweetener": "Acesulfame potassium",
      "Third-party testing": "NSF Certified for Sport (2 flavors, per NSF)",
      "Cost per 25 g": "About $1.44 ($79.99, 58 servings, Target)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000QSNYGI"
  },
  {
    "id": "naked-vs-optimum-nutrition-naked-whey",
    "name": "Naked Whey Unflavored Grass-Fed Whey Protein",
    "brand": "Naked Nutrition",
    "badge": "Best Single-Ingredient Whey",
    "category": "Grass-fed whey protein concentrate, unflavored",
    "description": "Per the label at the time of writing, a 30 g serving (about 2 scoops) of unflavored Naked Whey gives 25 g of protein, 120 calories, 3 g of carbohydrate, 2 g of sugar, 2 g of fat, 135 mg of sodium and 2.98 g of leucine. The only ingredient is whey protein concentrate, which Naked says comes from grass-fed US cows not treated with rBGH or rBST. At $139.99 for 76 servings on Naked's store (checked 1 November 2026) it costs about $1.84 per 25 g.",
    "pros": [
      "One ingredient: no sweetener, flavoring, gums or lecithin",
      "Grass-fed, rBGH-free dairy, per Naked",
      "About 83% protein by weight, the denser powder here",
      "Publishes leucine (2.98 g) and BCAAs (5.87 g)"
    ],
    "cons": [
      "About $1.84 per 25 g, roughly 28% more than Gold Standard",
      "NSF Contents Certified is a brand claim we could not confirm; no sport certification",
      "Unflavored means it tastes of milk; two scoops per serving"
    ],
    "bottomLine": "The pick for smoothies, baking and anyone who reads ingredient lists first. Skip it if you are drug tested, want a ready-flavored shake or buy on price alone.",
    "specs": {
      "Protein / serving": "25 g in 30 g (label)",
      "Sweetener": "None",
      "Third-party testing": "NSF Contents Certified (brand claim, not verified)",
      "Cost per 25 g": "About $1.84 ($139.99, 76 servings, Naked store)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B00XIKPUK4"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Naked vs Optimum Nutrition",
          item: `${SITE_URL}/naked-vs-optimum-nutrition/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Naked vs Optimum Nutrition: which is better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Optimum Nutrition Gold Standard 100% Whey: it costs about $1.44 per 25 g of protein against about $1.84 for Naked Whey, mixes in one scoop, and two flavors are NSF Certified for Sport. Naked Whey is better if you want one ingredient, grass-fed dairy and no sweetener, mostly for smoothies and baking."
          }
        },
        {
          "@type": "Question",
          "name": "Is Naked Whey third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Naked says Naked Whey is NSF Contents Certified, and the badge is on its label image. When our database checked NSF's public listing for Naked's parent company, Naked Whey was not listed, so we treat it as a brand claim. It is not a sport certification and does not test for banned substances."
          }
        },
        {
          "@type": "Question",
          "name": "Is Optimum Nutrition Gold Standard NSF certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in two flavors. Double Rich Chocolate and Vanilla Ice Cream appeared in the NSF Certified for Sport database when we checked on 19 November 2026; the other flavors did not. Certification is product-specific, so check the exact flavor and size on the NSF site before relying on it."
          }
        },
        {
          "@type": "Question",
          "name": "Which has more protein, Naked Whey or Gold Standard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Naked Whey, slightly: 25 g of protein in a 30 g serving against 24 g in a 31 g scoop of Gold Standard Double Rich Chocolate, per the labels at the time of writing. That makes Naked about 83% protein by weight against about 77%. Both come to roughly 120 to 125 calories per 25 g of protein."
          }
        },
        {
          "@type": "Question",
          "name": "Does Gold Standard have artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Double Rich Chocolate label lists acesulfame potassium, along with natural and artificial flavor and sunflower and/or soy lecithin. Other flavors vary, so check the tub. Unflavored Naked Whey has no sweetener of any kind; its only ingredient is whey protein concentrate."
          }
        },
        {
          "@type": "Question",
          "name": "Is Naked Whey good for lactose intolerance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not especially. Naked Whey is 100% whey concentrate, which keeps more lactose than isolate, and it adds no lactase. Gold Standard's blend leads with isolate and shows 1 g of sugar against Naked's 2 g, so it is likely a little gentler. If lactose reliably bothers you, choose a pure whey isolate instead."
          }
        },
        {
          "@type": "Question",
          "name": "Is Naked Whey worth the higher price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is if a one-ingredient, unsweetened, grass-fed label matters to you, and you mainly use protein in smoothies or recipes. The premium is about 40 cents per 25 g, or around $12 a month at one serving a day. If you just want a good-tasting, tested whey at the lowest cost, Gold Standard is the better value."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "naked vs optimum nutrition",
      "naked whey vs optimum nutrition",
      "naked whey vs gold standard whey",
      "optimum nutrition vs naked nutrition",
      "naked nutrition vs optimum nutrition gold standard",
      "grass-fed whey vs gold standard whey"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Whey Protein Picks",
    link: "/best-whey-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Naked vs Optimum Nutrition</Fragment>
      Naked sells one-ingredient grass-fed whey; Optimum Nutrition sells the best-known flavored whey blend in America. Here is how Naked Whey and Gold Standard 100% Whey compare on protein, cost per 25 g, testing, sweeteners and stomach comfort.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Two Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#stomach">Stomach Comfort</a>
      <a href="#naked-pros-cons">Naked Strengths and Gaps</a>
      <a href="#on-pros-cons">ON Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Optimum Nutrition Gold Standard 100% Whey is the better buy for most people: per the labels and prices in our database, it costs about $1.44 per 25 g of protein in the 58-serving tub against about $1.84 for Naked Whey's 5 lb bag, and two of its flavors are listed by NSF Certified for Sport. Naked Whey wins if you want a label with one ingredient, grass-fed dairy and no sweetener, soy or flavoring at all. Below we compare the labels, the cost math, the testing and who should skip both.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Naked vs Optimum Nutrition: The Short Answer
          </h2>

          <p>
            Gold Standard is the cheaper, tested, flavored powder, and Naked Whey is the simpler, denser, unflavored one. Per the labels we recorded, Gold Standard Double Rich Chocolate gives 24 g of protein in a 31 g scoop for about 120 calories, while unflavored Naked Whey gives 25 g in a 30 g serving for 120 calories. The macros are close. What separates them is the price per gram, the sport certification, and what else is in the tub besides whey.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Naked Whey (Unflavored)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">ON Gold Standard (Double Rich Chocolate)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein type</td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed whey concentrate</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate, concentrate and hydrolyzed whey</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per serving</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 30 g (about 83%)</td>
                    <td class="px-4 py-4 text-gray-700">24 g in 31 g (about 77%)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Ingredients</td>
                    <td class="px-4 py-4 text-gray-700">1 (whey protein concentrate)</td>
                    <td class="px-4 py-4 text-gray-700">6, including cocoa, lecithin and flavor</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweetener</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                    <td class="px-4 py-4 text-gray-700">Acesulfame potassium</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Certification</td>
                    <td class="px-4 py-4 text-gray-700">NSF Contents Certified (brand claim)</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (2 flavors)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $1.84 (5 lb bag)</td>
                    <td class="px-4 py-4 text-gray-700">About $1.44 (58-serving tub)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">74 / 100</td>
                    <td class="px-4 py-4 text-gray-700">78 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Optimum Nutrition for price and sport testing; pick Naked for a one-ingredient, unsweetened, grass-fed whey.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Gold Standard if</strong> you want a flavored shake that mixes with water, you are drug tested, or you want the lowest cost per gram of the two. <strong>Pick Naked Whey if</strong> you blend protein into smoothies, oats or baking, avoid artificial sweeteners and soy, or want grass-fed dairy. <strong>Pick neither if</strong> you are lactose intolerant: both contain whey concentrate, and an isolate is the safer bet.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Naked and Optimum Nutrition at a Glance
          </h2>

          <p>
            Start with the one thing you will not compromise on, then read across. Each row pairs a powder with the shopper it serves and the shopper it does not, next to the two numbers we calculate for every product we track: the <a href='/methodology/'>Label Score</a> out of 100 and the cost per 25 g of protein at the dated price in our database.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/optimum-nutrition-gold-standard-whey/'>ON Gold Standard 100% Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Drug-tested athletes, budget buyers, flavor variety</td>
                    <td class="px-4 py-4 text-gray-700">You avoid acesulfame potassium, artificial flavor or soy</td>
                    <td class="px-4 py-4 text-gray-700">78</td>
                    <td class="px-4 py-4 text-gray-700">About $1.44</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/naked-whey/'>Naked Whey (Unflavored)</a></td>
                    <td class="px-4 py-4 text-gray-700">Smoothies, baking, ingredient-list readers</td>
                    <td class="px-4 py-4 text-gray-700">You want a flavored shake or a sport certification</td>
                    <td class="px-4 py-4 text-gray-700">74</td>
                    <td class="px-4 py-4 text-gray-700">About $1.84</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The two scores are four points apart, and they get there in opposite ways. Naked Whey earns more for protein density (33.3 of 40 points against 27.4), because more of each gram of powder is protein. Gold Standard earns more for cost (17.4 of 25 against 12.9) and for certification (10 of 10 against 6). On sugar and additives, Gold Standard edges ahead 13 to 12: our formula docks it for one artificial sweetener, but docks Naked for 2 g of sugar against Gold Standard's 1 g. That sugar in Naked is not added; with one ingredient on the label, it can only be the milk sugar that whey concentrate naturally carries.
          </p>

          <p>
            If you want the full picture for each brand rather than this one pairing, our <a href='/naked-nutrition-protein-powder-review/'>Naked Nutrition protein powder review</a> covers Naked Whey Isolate, Naked Pea and Naked Casein, and our <a href='/optimum-nutrition-protein-powder-review/'>Optimum Nutrition review</a> covers Gold Standard Isolate, Casein and Platinum Hydrowhey.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Naked and Optimum Nutrition Products Are We Comparing?
          </h2>

          <p>
            Each brand sells several powders, so we compare the flagship whey from each: <a href='/protein-powder/naked-whey/'>Naked Whey</a> (unflavored, the version Naked built its name on) and <a href='/protein-powder/optimum-nutrition-gold-standard-whey/'>Gold Standard 100% Whey</a> (Double Rich Chocolate, the flavor with the most complete data in our database). Label figures are per the labels at the time of writing and vary by flavor. Prices are the ones recorded in our database on 1 November 2026 (Naked's own store and Target) and will move. Both cards link through to full label pages in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            Here are the full label figures for each powder, per the labels at the time of writing. Naked Whey's panel comes from the 5 lb nutrition-facts image on Naked's own product page; Gold Standard's comes from Target's listing for the 3.96 lb Double Rich Chocolate tub. Both brands' numbers shift by flavor, and flavored Naked Whey is a different product with a different label.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Naked Whey (Unflavored)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">ON Gold Standard (Double Rich Chocolate)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Serving size</td>
                    <td class="px-4 py-4 text-gray-700">30 g (about 2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">31 g (1 scoop)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">About 83%</td>
                    <td class="px-4 py-4 text-gray-700">About 77%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                    <td class="px-4 py-4 text-gray-700">1.5 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sodium</td>
                    <td class="px-4 py-4 text-gray-700">135 mg</td>
                    <td class="px-4 py-4 text-gray-700">130 mg</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
