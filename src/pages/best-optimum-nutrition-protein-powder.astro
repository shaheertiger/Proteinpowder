const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Optimum Nutrition Protein Powder",
          item: `${SITE_URL}/best-optimum-nutrition-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best Optimum Nutrition protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Gold Standard 100% Whey. It lists about 24 g of protein for roughly 120 calories per scoop, is widely promoted as Informed Choice certified, comes in many well-rated flavors and is frequently discounted. The isolate is better for lactose sensitivity or strict diets, and the casein for evenings."
          }
        },
        {
          "@type": "Question",
          "name": "Is Gold Standard Isolate better than Gold Standard Whey?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is leaner, not more effective. The isolate lists about 25 g of protein for roughly 100 to 110 calories with less lactose, fat and carbohydrate. For muscle gain the two perform similarly at matched doses. Choose the isolate if lactose or calories are a real constraint; otherwise the original is better value."
