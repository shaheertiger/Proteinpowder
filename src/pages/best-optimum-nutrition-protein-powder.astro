const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-17", modified: "2026-10-17" });
const title = "Best Optimum Nutrition Protein Powder: Which ON Tub Fits Your Goal";
const description =
  "Every main Optimum Nutrition protein powder matched to a goal, from Gold Standard Whey and Isolate to Hydrowhey, Casein, Plant, Pro Gainer and Serious Mass.";

const PRODUCTS: {
