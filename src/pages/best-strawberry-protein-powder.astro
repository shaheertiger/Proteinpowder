                    <td class="px-4 py-4 text-gray-700">Natural and artificial flavor</td>
                    <td class="px-4 py-4 text-gray-700">Red 40 lake</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Strawberry</td>
                    <td class="px-4 py-4 text-gray-700">Dried strawberries</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Just Ingredients</td>
                    <td class="px-4 py-4 text-gray-700">Strawberry (with tapioca starch)</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Strawberries & Cream</td>
                    <td class="px-4 py-4 text-gray-700">Strawberry powder plus flavor</td>
                    <td class="px-4 py-4 text-gray-700">Red 40</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Ka'Chava Strawberry</td>
                    <td class="px-4 py-4 text-gray-700">Freeze-dried organic strawberries (brand)</td>
                    <td class="px-4 py-4 text-gray-700">Check label</td>
                  </tr>
