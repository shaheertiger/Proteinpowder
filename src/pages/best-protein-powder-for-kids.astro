                    <td class="px-4 py-4 text-gray-700">8 g</td>
                    <td class="px-4 py-4 text-gray-700">About 180</td>
                    <td class="px-4 py-4 text-gray-700">About 9 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">USDA Organic</td>
                  </tr>
