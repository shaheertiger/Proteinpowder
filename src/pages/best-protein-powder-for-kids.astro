                    <td class="px-4 py-4 text-gray-700">6 g</td>
                    <td class="px-4 py-4 text-gray-700">About 220</td>
                    <td class="px-4 py-4 text-gray-700">About 8 g added (listing)</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None named</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
