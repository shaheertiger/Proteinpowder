---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Protein Powder for Teens",
    "url": "/best-protein-powder-for-teens/"
  },
  {
    "title": "Best Protein Powder",
    "url": "/best-protein-powder/"
  },
  {
    "title": "How Much Protein Do I Need?",
    "url": "/how-much-protein-do-i-need/"
  },
  {
    "title": "Is Protein Powder Safe?",
    "url": "/is-protein-powder-safe/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-08", modified: "2026-11-08" });
const title = "Best Protein Powder for Kids: When Children Need One (and When They Don't)";
const description =
  "The best protein powder for kids, after the food-first check: protein needs by age, when a pediatrician may suggest a shake, kid formulas vs adult powders.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "pediasure-grow-and-gain-shake-mix",
    "name": "PediaSure Grow & Gain Shake Mix",
    "brand": "PediaSure",
    "badge": "Best When a Pediatrician Suggests a Shake",
    "category": "Kids nutrition shake powder (milk protein)",
    "description": "The product pediatricians most often name when a child is not eating enough. Per Abbott at the time of writing, a serving of the powder (49 g, about 1/3 cup, mixed with 3/4 cup water) gives 6 g of protein, about 220 calories and 23 vitamins and minerals. It is a complete-nutrition drink, not a protein supplement: the point is calories, micronutrients and some protein for a child who is falling behind, which is exactly the situation in which a shake is worth using.",
    "pros": [
      "Made for children, with protein in a child-sized dose (6 g per serving, label)",
      "Adds calories and 23 vitamins and minerals, which picky eaters often miss",
      "The shake mix is cheaper per serving than the ready-to-drink bottles",
      "Widely sold, including on Amazon and in most pharmacies"
    ],
    "cons": [
      "About 8 g of added sugar per serving, per retailer listings of the label",
      "Calorie-dense by design, so it is the wrong product for a child who already eats well",
      "Contains milk and soy; not suitable for dairy-free families"
    ],
    "bottomLine": "Use it when a doctor wants your child to gain or catch up, not as an everyday extra.",
