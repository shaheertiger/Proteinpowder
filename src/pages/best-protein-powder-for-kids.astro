    "cons": [
      "Contains almonds, so it is out for tree-nut allergies",
      "Protein per serving varies by formula and is lower than milk-based shakes in some versions",
      "Premium price per serving, and buyer reports on taste are mixed"
    ],
    "bottomLine": "The best-fit kids shake for a milk-allergic or vegan family, as long as nuts are fine.",
    "specs": {
      "Protein per serving": "Varies by formula; check label",
      "Calories": "Varies by formula",
      "Third-party testing": "None named",
      "Best for": "Dairy-free and vegan families"
    }
  },
  {
    "id": "naked-nutrition-naked-whey",
    "name": "Naked Whey Unflavored Grass-Fed Whey",
