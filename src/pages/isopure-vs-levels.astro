---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Levels vs Ascent Protein",
    "url": "/levels-vs-ascent-protein/"
  },
  {
    "title": "Isopure vs Optimum Nutrition",
    "url": "/isopure-vs-optimum-nutrition/"
  },
  {
    "title": "Clean Simple Eats vs Isopure",
    "url": "/clean-simple-eats-vs-isopure/"
  },
  {
    "title": "Ascent vs Optimum Nutrition",
    "url": "/ascent-vs-optimum-nutrition/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Isopure vs Levels: 100% Isolate or Grass-Fed Whey?";
const description =
  "Isopure Zero Carb wins on macros: 0 g carbs and 81% protein vs 3 g and 75% for Levels. Levels costs $1.91 per 25 g vs $2.04, with stevia and no soy.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "isopure-vs-levels-isopure-zero-carb",
    "name": "Isopure Zero Carb Whey Protein Isolate, Creamy Vanilla (3 lb)",
    "brand": "Isopure",
    "badge": "Best for Keto and Lactose",
    "category": "100% whey protein isolate",
    "description": "Per the Vitacost label at the time of writing, a 31 g scoop of Creamy Vanilla gives 25 g of protein, 110 calories, 0 g of carbohydrate, 0 g of sugar, 0.5 g of fat and 190 mg of sodium, sweetened with sucralose and fortified with a vitamin and mineral blend. At $89.79 for about 44 servings on Vitacost (checked 1 November 2026) it costs about $2.04 per 25 g of protein.",
    "pros": [
      "0 g carbohydrate and 0 g sugar per scoop",
      "About 81% protein by weight, the densest of the three",
      "Whey isolate only, so very little lactose",
      "Label Score 63 / 100, highest here"
    ],
    "cons": [
      "Sucralose, artificial flavor and xanthan gum",
      "Lists soy; 190 mg sodium per scoop",
      "No sport certification we could verify"
    ],
    "bottomLine": "The pick for keto dieters, cutters and lactose-sensitive stomachs, at a price close to Levels. Skip it if you avoid sucralose or soy, or want a short, grass-fed label.",
    "specs": {
      "Protein / serving": "25 g in 31 g (label)",
      "Carbs / sugar": "0 g / 0 g",
      "Third-party testing": "None verified",
      "Cost per 25 g": "About $2.04 ($89.79, 44 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000E95HP0"
  },
  {
    "id": "isopure-vs-levels-levels-grass-fed-whey",
    "name": "Levels Grass-Fed Whey Protein, Vanilla Bean (5 lb)",
    "brand": "Levels",
    "badge": "Best Clean Label and Value",
    "category": "Grass-fed whey protein concentrate",
    "description": "Per the Vitacost label at the time of writing, a 32 g scoop of Vanilla Bean gives 24 g of protein, 130 calories, 3 g of carbohydrate, 2 g of sugar, 2.5 g of fat, 125 mg of sodium and 2.54 g of leucine. It lists six ingredients, sweetened with stevia and monk fruit, and Levels labels it grass-fed, soy-free and gluten-free. At $129.99 for about 71 servings on Vitacost (checked 1 November 2026) it costs about $1.91 per 25 g.",
    "pros": [
      "Six ingredients; stevia and monk fruit, no artificial flavors",
      "Grass-fed, hormone-free whey; soy-free",
      "About $1.91 per 25 g in the 5 lb tub",
      "Publishes leucine (2.54 g); nine flavors"
    ],
    "cons": [
      "Concentrate: 3 g carbs, 2 g sugar, 2.5 g fat",
      "75% protein by weight; Label Score 59 / 100",
      "No sport certification we could verify"
    ],
    "bottomLine": "The better buy for anyone who wants grass-fed dairy, plant-based sweeteners and a soy-free label, especially in the 5 lb tub. Skip it if you count every carb or react to small amounts of lactose.",
    "specs": {
      "Protein / serving": "24 g in 32 g (label)",
      "Carbs / sugar": "3 g / 2 g",
      "Third-party testing": "None verified",
      "Cost per 25 g": "About $1.91 ($129.99, 71 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B072M8GTXW"
  },
  {
    "id": "isopure-vs-levels-isopure-low-carb",
    "name": "Isopure Low Carb Whey Protein Isolate, Dutch Chocolate (3 lb)",
    "brand": "Isopure",
    "badge": "Alternative: Chocolate Isolate",
    "category": "100% whey protein isolate with cocoa",
    "description": "Per the Vitacost label at the time of writing, a 33 g scoop of Dutch Chocolate gives 25 g of protein, 110 calories, 1 g of carbohydrate, 0 g of sugar, 1 g of fat and 210 mg of sodium, with the same sucralose, soy lecithin and vitamin blend as Zero Carb. At $98.03 for about 41 servings on Vitacost (checked 1 November 2026) it costs about $2.39 per 25 g.",
    "pros": [
      "Chocolate and dessert flavors Zero Carb lacks",
      "Still 100% isolate with 0 g sugar",
      "25 g of protein per scoop"
    ],
    "cons": [
      "About $2.39 per 25 g, the priciest here",
      "210 mg sodium; Label Score 55 / 100",
      "Sucralose and soy, like Zero Carb"
    ],
    "bottomLine": "Worth it only if you want a chocolate isolate and will not accept Levels' 3 g of carbs. Skip it if price per gram matters: Levels sells a Double Chocolate, and its 5 lb tub runs about $1.91 per 25 g at the vanilla price we recorded.",
    "specs": {
      "Protein / serving": "25 g in 33 g (label)",
      "Carbs / sugar": "1 g / 0 g",
      "Third-party testing": "None verified",
      "Cost per 25 g": "About $2.39 ($98.03, 41 servings, Vitacost)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000E8ZJGS"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Isopure vs Levels",
          item: `${SITE_URL}/isopure-vs-levels/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Isopure better than Levels protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on your priority. Isopure Zero Carb is better for macros, with 25 g of protein, 0 g of carbohydrate and 110 calories per scoop, and a higher Label Score (63 vs 59). Levels is better for ingredients: grass-fed whey, stevia and monk fruit, and no soy. Levels' 5 lb tub is also slightly cheaper, about $1.91 per 25 g against $2.04."
          }
        },
        {
          "@type": "Question",
          "name": "Is Levels whey isolate or concentrate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Levels Grass-Fed Whey is a whey protein concentrate, per its ingredient list, made from grass-fed, hormone-free dairy according to the brand. That is why it carries 3 g of carbohydrate, 2 g of sugar and 2.5 g of fat per scoop. We did not find a Levels whey isolate; the brand's other powder that we track is a micellar casein."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for lactose intolerance, Isopure or Levels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb, because it is pure whey isolate and lists 0 g of sugar, meaning under 0.5 g per scoop. Levels lists 2 g of sugar with no added sugar, so most of that is likely lactose. Neither publishes a lactose figure or claims to be lactose-free, and neither suits a milk allergy."
          }
        },
        {
          "@type": "Question",
          "name": "Is Isopure or Levels third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither has a sport certification we could verify. NSF Certified for Sport returned no Isopure results on 20 November 2026, and we found no Levels listing with NSF, Informed Sport or Informed Choice. Levels mentions a Clean Label Project award, which we could not confirm and which is not banned-substance testing. Drug-tested athletes should choose a certified whey."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for keto, Isopure or Levels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb. It lists 0 g of carbohydrate per scoop, so it adds nothing to a daily carb limit, while Levels lists 3 g per scoop, about 6 g for two shakes. Levels does have more fat, 2.5 g against 0.5 g, but not enough to matter for most keto plans. Isopure Low Carb sits between them at 1 g."
          }
        },
        {
          "@type": "Question",
          "name": "Does Isopure or Levels have artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flavored Isopure Zero Carb and Low Carb use sucralose, an artificial sweetener, plus natural and artificial flavor, per the labels we read. Levels uses stevia leaf extract and monk fruit extract and states no artificial flavors or sweeteners. If you want an Isopure with no sweetener, the Unflavored Zero Carb leaves it out."
          }
        },
        {
          "@type": "Question",
          "name": "Why does Isopure Zero Carb have more sodium than Levels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure lists added salt and a vitamin and mineral blend, and the label shows 190 mg of sodium per scoop against Levels' 125 mg. Low Carb Dutch Chocolate reaches 210 mg. Spread across a day these are modest amounts, but if you track sodium, Levels is the lower option of the two brands."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "isopure vs levels",
      "isopure vs levels protein powder",
      "levels vs isopure",
      "isopure zero carb vs levels grass fed whey",
      "isopure low carb vs levels",
      "whey isolate vs grass-fed whey"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Whey Isolate Picks",
    link: "/best-whey-protein-isolate/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Isopure vs Levels</Fragment>
      Isopure sells pure whey isolate with zero carbs; Levels sells grass-fed whey concentrate on a six-ingredient label. Here is how Isopure Zero Carb, Isopure Low Carb and Levels Grass-Fed Whey compare on macros, lactose, sweeteners, testing and cost per 25 g.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#isolate">Isolate vs Concentrate</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#pros-cons">Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Isopure Zero Carb is the better pick if you count carbs or react to lactose: it gives 25 g of protein with 0 g of carbohydrate and 0 g of sugar, against 24 g with 3 g of carbohydrate and 2 g of sugar in Levels Grass-Fed Whey. Levels wins if you want grass-fed dairy, stevia instead of sucralose and no soy, and its 5 lb tub is slightly cheaper per gram. Neither is third-party certified. Below we compare the labels, the cost math and who should skip both.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Isopure vs Levels: The Short Answer
          </h2>

          <p>
            Isopure Zero Carb has the leaner label and Levels has the simpler one. Per the Vitacost labels we recorded, Isopure Zero Carb packs 25 g of protein into a 31 g scoop for 110 calories, with no carbohydrate or sugar, while Levels packs 24 g into a 32 g scoop for 130 calories, with 3 g of carbohydrate and 2 g of sugar. Levels answers with grass-fed whey, stevia and monk fruit, a soy-free label and a cost per 25 g about 13 cents lower in its 5 lb tub.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Zero Carb</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Levels Grass-Fed Whey</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein type</td>
                    <td class="px-4 py-4 text-gray-700">100% whey protein isolate</td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed whey protein concentrate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 31 g (about 81%)</td>
                    <td class="px-4 py-4 text-gray-700">24 g in 32 g (75%)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbs / sugar</td>
                    <td class="px-4 py-4 text-gray-700">0 g / 0 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g / 2 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweetener</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose</td>
                    <td class="px-4 py-4 text-gray-700">Stevia and monk fruit</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.04 (3 lb tub)</td>
                    <td class="px-4 py-4 text-gray-700">About $1.91 (5 lb tub)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">63 / 100</td>
                    <td class="px-4 py-4 text-gray-700">59 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Isopure for zero carbs and minimal lactose; pick Levels for a grass-fed, sucralose-free, soy-free label.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Isopure Zero Carb if</strong> you are on keto, cutting, or find that ordinary whey upsets your stomach. <strong>Pick Levels if</strong> you want grass-fed dairy, avoid artificial sweeteners or soy, or buy in bulk and want the lowest price of the two. <strong>Pick Isopure Low Carb only if</strong> you want a chocolate isolate and accept paying about $2.39 per 25 g. <strong>Pick neither if</strong> you are drug tested: we found no sport certification for either brand.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Isopure and Levels at a Glance
          </h2>

          <p>
            Start with the one thing you will not compromise on, then read across. Each row below pairs a powder with the shopper it serves and the shopper it does not, next to the two numbers we calculate for every product we track: the <a href='/methodology/'>Label Score</a> out of 100 and the cost per 25 g of protein at the dated price in our database.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/isopure-zero-carb/'>Isopure Zero Carb</a></td>
                    <td class="px-4 py-4 text-gray-700">Keto, cutting, lactose-sensitive stomachs</td>
                    <td class="px-4 py-4 text-gray-700">You avoid sucralose or soy, or want the cheapest whey</td>
                    <td class="px-4 py-4 text-gray-700">63</td>
                    <td class="px-4 py-4 text-gray-700">About $2.04</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/levels-grass-fed-whey/'>Levels Grass-Fed Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Grass-fed buyers, stevia fans, bulk tubs</td>
                    <td class="px-4 py-4 text-gray-700">You track every carb or react to lactose</td>
                    <td class="px-4 py-4 text-gray-700">59</td>
                    <td class="px-4 py-4 text-gray-700">About $1.91</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/isopure-low-carb/'>Isopure Low Carb</a></td>
                    <td class="px-4 py-4 text-gray-700">Chocolate lovers who want an isolate</td>
                    <td class="px-4 py-4 text-gray-700">Price per gram matters to you</td>
                    <td class="px-4 py-4 text-gray-700">55</td>
                    <td class="px-4 py-4 text-gray-700">About $2.39</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The scores are close, and they move for different reasons. Isopure Zero Carb earns its 63 mainly on protein density, since about 81% of each scoop is protein, and loses ground for its long additive list and 190 mg of sodium. Levels earns its 59 on a short ingredient list and a slightly lower cost per gram, and gives points back for being a concentrate that is only 75% protein by weight. Isopure Low Carb trails at 55 because it costs the most per gram and carries the most sodium, 210 mg per scoop.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Isopure and Levels Products Are We Comparing?
          </h2>

          <p>
            Levels sells one whey, so its card is easy: Levels Grass-Fed Whey in the 5 lb Vanilla Bean tub. Isopure sells several, and the two that searchers pit against Levels are Zero Carb (Creamy Vanilla) and Low Carb (Dutch Chocolate), so both get a card, with Zero Carb as the main contender. Every figure below comes from the Vitacost listings recorded in our database on 1 November 2026; prices will move. Each card links to its full label page in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            These are the full label figures as listed on Vitacost when our database recorded them on 1 November 2026: Creamy Vanilla for Isopure Zero Carb, Dutch Chocolate for Isopure Low Carb and Vanilla Bean for Levels. Both brands vary slightly by flavor, so treat the tub in your hand as the final word.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Zero Carb</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Isopure Low Carb</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Levels Grass-Fed Whey</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Scoop size</td>
                    <td class="px-4 py-4 text-gray-700">31 g</td>
                    <td class="px-4 py-4 text-gray-700">33 g</td>
                    <td class="px-4 py-4 text-gray-700">32 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">About 81%</td>
                    <td class="px-4 py-4 text-gray-700">About 76%</td>
                    <td class="px-4 py-4 text-gray-700">75%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">110</td>
                    <td class="px-4 py-4 text-gray-700">110</td>
                    <td class="px-4 py-4 text-gray-700">130</td>
