---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Whey vs Whey Isolate",
    "url": "/whey-vs-whey-isolate/"
  },
  {
    "title": "Dymatize Protein Powder Review",
    "url": "/dymatize-protein-powder-review/"
  },
  {
    "title": "Pro JYM Protein Powder Review",
    "url": "/pro-jym-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-17", modified: "2026-11-17" });
const title = "Syntha 6 Protein Powder Review: Is BSN's Blend Worth It?";
const description =
  "Syntha-6 is a taste pick, not a value pick: 22 g of protein in a 47 g scoop, about $1.80 per 25 g on Amazon. We also check Isolate, Edge and testing.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "syntha-6-review-bsn-syntha-6-original-48",
    "name": "BSN Syntha-6 Original, Strawberry Milkshake, 48 Servings",
    "brand": "BSN",
    "badge": "Best for Taste",
    "category": "Multi-protein milk blend (whey and casein)",
    "description": "The original Syntha-6 is a six-part protein matrix of whey concentrate, calcium caseinate, hydrolyzed whey concentrate, whey isolate, micellar casein and milk protein isolate, plus a sunflower-oil creamer, MCT powder and polydextrose. Per the label at the time of writing, a 47 g scoop gives 22 g of protein, 190 calories, 5 g of fat, 14 g of carbohydrate and 6 g of fiber, sweetened with sucralose and acesulfame potassium. At the $75.99 we saw on Amazon for 48 servings, that is about $1.80 per 25 g of protein.",
    "pros": [
      "Creamy, milkshake-like texture that buyers praise most often",
      "Casein-heavy blend digests more slowly than straight whey",
      "6 g of fiber per scoop, per the label",
      "Wide flavor range, including dessert flavors"
    ],
    "cons": [
      "Only 22 g of protein in a 47 g scoop, about 47% protein by weight",
      "190 calories and 5 g of fat per scoop, more than most whey",
      "No sport certification we could find; artificially sweetened"
    ],
    "bottomLine": "Buy it for the taste and creaminess, as a snack shake or bedtime protein, not for cheap grams.",
    "specs": {
      "Protein / serving": "22 g in 47 g (label)",
      "Calories": "190",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $1.80 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B002DYJ1D8"
  },
  {
    "id": "syntha-6-review-bsn-syntha-6-isolate-48",
    "name": "BSN Syntha-6 Isolate, Chocolate Milkshake, 48 Servings",
    "brand": "BSN",
    "badge": "Leanest Syntha-6",
    "category": "Whey isolate and milk protein isolate blend",
    "description": "Syntha-6 Isolate drops the concentrate and caseinate and keeps two isolates: whey protein isolate and milk protein isolate. Per the label at the time of writing, a 38 g scoop of Chocolate Milkshake gives 25 g of protein, 140 calories, 1.5 g of fat, 7 g of carbohydrate and 2 g of sugar. It still uses a sunflower creamer and sucralose with acesulfame potassium, so the taste profile stays close to the original. At the $88.21 we saw on Amazon for 48 servings, it costs about $1.84 per 25 g.",
    "pros": [
      "25 g of protein in a 38 g scoop, about 66% protein by weight",
      "140 calories and 1.5 g of fat, far leaner than the original",
      "Keeps the creamy Syntha-6 style with less fat"
    ],
    "cons": [
      "About $1.84 per 25 g at the Amazon price we saw, the priciest card here",
      "Still contains a creamer with corn syrup solids",
      "No sport certification we could find"
    ],
    "bottomLine": "The Syntha-6 to buy if you like the brand but want whey-isolate macros.",
    "specs": {
      "Protein / serving": "25 g in 38 g (label)",
      "Calories": "140",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $1.84 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B00926EVVW"
  },
  {
    "id": "syntha-6-review-bsn-syntha-6-edge-48",
    "name": "BSN Syntha-6 Edge, Vanilla Milkshake, 48 Servings",
    "brand": "BSN",
    "badge": "Best-Value Syntha-6",
    "category": "Whey and casein blend with hydrolyzed whey isolate",
    "description": "Syntha-6 Edge sits between the other two. Per the Chocolate Milkshake label at the time of writing, a 40 g scoop gives 24 g of protein, 160 calories, 4 g of fat and 6 g of carbohydrate from whey concentrate, whey isolate, hydrolyzed whey isolate, calcium caseinate, micellar casein and milk protein concentrate. The vanilla tub on Amazon weighs 3.86 lb for 48 servings, so its scoop is a little lighter; check the panel. At the $75.89 we saw, that works out to about $1.65 per 25 g.",
    "pros": [
      "Cheapest Syntha-6 per gram of protein at the prices we saw",
      "24 g of protein with about 2 g of sugar, per the label",
      "Keeps some casein, so it is still a thick shake"
    ],
    "cons": [
      "Gum blend includes carrageenan, which some buyers avoid",
      "Fewer flavors than the original",
      "Artificially sweetened and no sport certification found"
    ],
    "bottomLine": "The best balance in the Syntha-6 range: more protein and fewer calories than the original for less money per gram.",
    "specs": {
      "Protein / serving": "24 g (label)",
      "Calories": "About 160 (chocolate label)",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $1.65 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B01DY8NO7K"
  },
  {
    "id": "syntha-6-review-alt-on-gold-standard-5lb",
    "name": "Optimum Nutrition Gold Standard 100% Whey, Double Rich Chocolate, 5 lb",
    "brand": "Optimum Nutrition",
    "badge": "Better-Value Alternative",
    "category": "Whey blend (isolate listed first)",
    "description": "Gold Standard comes from Glanbia, the same parent company as BSN, and it is the obvious alternative if you want more protein per scoop and per dollar. Per the label at the time of writing, a 31 g scoop gives 24 g of protein and about 120 calories, with roughly 74 servings in the 5 lb tub. Optimum Nutrition promotes Informed Choice testing on many flavors. At the $105.99 we saw on Amazon, that is about $1.49 per 25 g of protein, the lowest on this list.",
    "pros": [
      "About $1.49 per 25 g at the Amazon price we saw",
      "24 g of protein in a 31 g scoop, about 77% protein by weight",
      "Informed Choice testing promoted by the brand (check your flavor)"
    ],
    "cons": [
      "Thinner and less dessert-like than Syntha-6, buyers report",
      "No slow-digesting casein in the blend",
      "Artificially sweetened, like Syntha-6"
    ],
    "bottomLine": "Pick Gold Standard if protein per dollar and a testing claim matter more than a thick milkshake texture.",
    "specs": {
      "Protein / serving": "24 g in 31 g (label)",
      "Calories": "About 120",
      "Third-party testing": "Informed Choice (brand)",
      "Cost per 25 g": "About $1.49 (Amazon price seen)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000QSNYGI"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Syntha-6 Protein Powder Review",
          item: `${SITE_URL}/syntha-6-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is BSN Syntha-6 third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We found no sport certification for Syntha-6. The Amazon titles and retailer label pages we checked at the time of writing make no NSF Certified for Sport, Informed Sport or Informed Choice claim, only GMP manufacturing in the USA. Its sister brand Optimum Nutrition does promote Informed Choice testing. Drug-tested athletes should choose a powder they can find in a certifier's public database."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in a scoop of Syntha-6?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per the label at the time of writing, Syntha-6 Original gives 22 g of protein in a 47 g scoop with 190 calories. Syntha-6 Isolate gives 25 g in a 38 g scoop with 140 calories, and Syntha-6 Edge gives 24 g in about a 40 g scoop with about 160 calories. Figures vary slightly by flavor, so check your tub's panel."
          }
        },
        {
          "@type": "Question",
          "name": "Is Syntha-6 healthy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a reasonable protein source but not a clean-label one. The original contains a sunflower creamer with corn syrup solids, maltodextrin, MCT powder, polydextrose, cellulose gum, sucralose and acesulfame potassium, with only 1 g of added sugar. It also delivers 6 g of fiber. People wanting a short ingredient list or no artificial sweeteners should look elsewhere."
          }
        },
        {
          "@type": "Question",
          "name": "Does Syntha-6 contain egg, casein or lactose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The current US Syntha-6 label we checked contains casein (calcium caseinate and micellar casein) and lactose-containing whey concentrate, and states milk and soy as allergens. It no longer lists egg, although older formulas did. Syntha-6 Isolate still contains milk protein isolate and sodium caseinate. None of the versions suit people who are allergic to milk."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best Syntha-6 flavor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In buyer reviews, Chocolate Milkshake and Vanilla Ice Cream are the most popular and most widely stocked flavors, with Cookies and Cream, Chocolate Peanut Butter and Strawberry Milkshake also well liked. That is buyer feedback, not our own tasting. If you are trying the brand for the first time, start with a smaller tub of a chocolate or vanilla flavor."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common complaints about Syntha-6?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyer reviews most often mention low protein per scoop for the size of the tub, rising prices, and flavors that seemed to change after a reformulation. Some buyers report clumping when powder goes into the shaker before the liquid, and a few find the fiber and sweeteners hard on digestion. Praise centers on the thick, milkshake-like taste."
          }
        },
        {
          "@type": "Question",
          "name": "Is Syntha-6 good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Syntha-6 Original is not the best choice for weight loss, because it carries about 216 calories per 25 g of protein. Syntha-6 Isolate, at 140 calories for 25 g, is a much better fit, and Edge sits in between. The fiber can help with fullness, but total daily calories and protein decide weight loss, not any one powder."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "syntha 6 protein powder",
      "bsn syntha-6 protein powder",
      "bsn protein powder",
      "syntha-6 isolate",
      "syntha six protein powder",
      "syntha-6 edge"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Whey Protein Picks",
    link: "/best-whey-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Brand Review"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Syntha 6 Protein Powder Review</Fragment>
      BSN Syntha-6 is one of the best-known milkshake-style protein powders. This review reads the label for the Original, Isolate and Edge tubs, works out the real cost per 25 g of protein and says who should buy it.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#top-picks">The Products</a>
      <a href="#whats-in-it">What Is in Syntha-6?</a>
      <a href="#protein-density">Why Only 22 g?</a>
      <a href="#versions">Original vs Isolate vs Edge</a>
      <a href="#third-party-tested">Third-Party Testing</a>
      <a href="#cost">Cost per 25 g</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#vs-gold-standard">Syntha-6 vs Gold Standard</a>
      <a href="#who-should-buy">Who Should Buy It</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          BSN Syntha-6 is a creamy multi-protein blend that buyers like for taste, but it gives only 22 g of protein in a 47 g scoop, about $1.80 per 25 g at the Amazon price we saw. Whether it suits you depends on whether you want a dessert-like shake or the most protein per dollar. We cover the label, all three versions, testing and cheaper swaps.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Syntha 6 Protein Powder: The Short Answer
          </h2>

          <p>
            BSN Syntha-6 is a good-tasting but low-density protein powder: per the label at the time of writing, the original gives 22 g of protein, 190 calories and 5 g of fat in a 47 g scoop, and costs about $1.80 per 25 g of protein at the Amazon price we saw. It is a dessert-style shake first and an efficient protein source second.
          </p>

          <p>
            <strong>Buy it if</strong> you want a thick, creamy shake you will actually drink, you like a casein-heavy blend for a slow-digesting snack or bedtime protein, and you do not mind paying a little more per gram for flavor. <strong>Skip it if</strong> you are counting calories, want 25 g or more of protein per scoop, or need a powder with a sport certification for drug-tested competition. For most of those buyers, <a href="/best-whey-protein-powder/">a straight whey from our best whey protein list</a> is the better buy.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-4">Syntha-6 Original by the Numbers</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-3xl font-black text-white">22 g</p>
                <p class="text-gray-400 text-xs mt-1">Protein per 47 g scoop</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">47%</p>
                <p class="text-gray-400 text-xs mt-1">Protein by weight</p>
              </div>
              <div>
                <p class="text-3xl font-black text-white">190</p>
                <p class="text-gray-400 text-xs mt-1">Calories per scoop</p>
              </div>
              <div>
                <p class="text-3xl font-black text-[#38BDF8]">$1.80</p>
                <p class="text-gray-400 text-xs mt-1">Per 25 g protein (Amazon)</p>
              </div>
            </div>
          </div>

          <p>
            If you like the brand but not those numbers, the range has two better-built options. Syntha-6 Isolate gives 25 g of protein in 140 calories, and Syntha-6 Edge gives 24 g in about 160 calories and was the cheapest Syntha-6 per gram at the prices we saw. The cards below compare all three with Optimum Nutrition Gold Standard, made by the same parent company.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Syntha-6 Tubs and the Alternative Worth Comparing
          </h2>

          <p>
            Three Syntha-6 versions from BSN's current Amazon range, plus the whey that beats them on cost per gram. Label figures are per the label at the time of writing and vary by flavor; prices are the Amazon prices we saw on 17 November 2026 and change often.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="whats-in-it" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. What Is in BSN Syntha-6 Protein Powder?
          </h2>

          <p>
            Syntha-6 Original is a blend of six milk proteins plus a creamer, fiber and MCT oil powder. Per the Chocolate Milkshake label listed at Vitacost at the time of writing, the protein matrix is whey protein concentrate, calcium caseinate, hydrolyzed whey protein concentrate, whey protein isolate, micellar casein and milk protein isolate. That is where the name comes from: six protein sources, mixed so that some digest quickly and some slowly.
          </p>

          <p>
            Behind the protein comes a long list of texture and flavor ingredients: polydextrose (a soluble fiber), a sunflower-oil creamer made with corn syrup solids and sodium caseinate, cocoa, natural and artificial flavor, MCT powder, maltodextrin, salt, lecithin and cellulose gum. It is sweetened with acesulfame potassium and sucralose. The label lists 1 g of added sugar and 3 g of total sugar per scoop, so it is low in sugar despite the dessert flavors.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Per 47 g scoop (Chocolate Milkshake)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">190</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat (saturated)</td>
                    <td class="px-4 py-4 text-gray-700">5 g (2 g)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate / fiber</td>
                    <td class="px-4 py-4 text-gray-700">14 g / 6 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar (added)</td>
                    <td class="px-4 py-4 text-gray-700">3 g (1 g)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sodium</td>
                    <td class="px-4 py-4 text-gray-700">240 mg</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweeteners</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose, acesulfame potassium</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Allergens stated</td>
                    <td class="px-4 py-4 text-gray-700">Milk, soy</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            One common question is whether Syntha-6 contains egg. Older versions of the formula listed egg albumen in the protein blend, and many reviews online still say so. The current US label we checked lists only milk proteins and states that the powder contains milk and soy, with no egg. Labels change and international versions differ, so anyone with an egg allergy should read the panel on the tub in hand rather than a review written years ago.
          </p>

          <p>
            The fiber and fat are the parts that make Syntha-6 feel more like a light meal than a plain protein shake. Six grams of fiber per scoop is a lot for a protein powder, which is why it shows up in our <a href="/best-protein-powder-with-fiber/">protein powder with fiber guide</a>. The trade-off is that every gram of creamer, fiber and MCT powder is a gram that is not protein, which is the subject of the next section. Our database page for <a href="/protein-powder/bsn-syntha-6/">BSN Syntha-6</a> holds the same label figures used here, and the <a href="/brands/bsn/">BSN brand page</a> lists the other BSN products we track.
          </p>
        </div>

        <div id="protein-density" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Why Does Syntha-6 Have Only 22 g of Protein in a 47 g Scoop?
          </h2>

          <p>
            Syntha-6 Original is only about 47% protein by weight: 22 g of protein in a 47 g scoop, per the label. The other 25 g is creamer, fiber, MCT powder, maltodextrin, cocoa and flavor. A typical whey such as Optimum Nutrition Gold Standard is around 77% protein by weight (24 g in 31 g), and a good whey isolate runs higher still.
          </p>

          <p>
            That gap matters in two ways. First, calories. To get 25 g of protein from Syntha-6 Original you take in about 216 calories, against about 125 for Gold Standard and 140 for Syntha-6 Isolate. If you drink two shakes a day to hit a protein target, the original adds roughly 180 extra calories a day compared with a lean whey. For someone trying to gain weight that is a bonus; for someone cutting it is a cost.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Powder</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein / scoop</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein by weight</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories per 25 g protein</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Syntha-6 Original</td>
                    <td class="px-4 py-4 text-gray-700">22 g in 47 g</td>
                    <td class="px-4 py-4 text-gray-700">47%</td>
                    <td class="px-4 py-4 text-gray-700">About 216</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Syntha-6 Edge (chocolate)</td>
                    <td class="px-4 py-4 text-gray-700">24 g in 40 g</td>
                    <td class="px-4 py-4 text-gray-700">60%</td>
                    <td class="px-4 py-4 text-gray-700">About 167</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Syntha-6 Isolate</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 38 g</td>
                    <td class="px-4 py-4 text-gray-700">66%</td>
                    <td class="px-4 py-4 text-gray-700">140</td>
                  </tr>
