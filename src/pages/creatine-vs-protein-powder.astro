const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Creatine vs Protein Powder",
          item: `${SITE_URL}/creatine-vs-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is creatine better than protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither is better overall because they do different jobs. Creatine monohydrate adds strength and power by raising muscle phosphocreatine, while protein powder is a food that helps you reach your daily protein target. If you already eat about 1.6 g of protein per kg of body weight, creatine adds more. If you fall short, protein powder fixes the bigger gap first."
          }
        },
        {
          "@type": "Question",
          "name": "Can I mix creatine with my protein shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Stirring 3 to 5 g of unflavored creatine monohydrate into a protein shake is a convenient way to take both, and there is no known interaction between them. The ISSN creatine review notes that taking creatine with carbohydrate or protein may slightly improve how much muscle retains. Just remember to take creatine on rest days too, even without a shake."
          }
        },
        {
          "@type": "Question",
          "name": "Does creatine make you gain weight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Creatine often adds about 1 to 2 kg in the first week, mostly water held inside muscle cells, according to the ISSN position stand. Over months, any further weight gain mostly reflects added muscle from harder training. Creatine contains no calories, so it does not cause fat gain. If you compete in a weight class, avoid loading close to a weigh-in."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need protein powder if I take creatine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if you cannot reach your daily protein target from food. Creatine does not supply protein, so you still need about 1.4 to 2.0 g per kg of body weight a day if you train hard, per the ISSN protein position stand. Meat, fish, eggs, dairy and legumes can cover that. Protein powder is simply a convenient, inexpensive way to close the gap."
          }
        },
        {
          "@type": "Question",
          "name": "Is creatine bad for your kidneys?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In healthy people taking recommended doses, research reviews including the 2017 ISSN position stand and a 2021 ISSN paper on creatine myths have not found kidney damage. Creatine does raise blood creatinine, which can affect kidney test results, so tell your doctor. People with kidney disease or taking kidney-affecting medications should get medical advice before using it."
          }
        },
        {
          "@type": "Question",
          "name": "Should I take creatine before or after a workout?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It matters little. Some small studies suggest a slight edge for taking creatine after training, but reviews conclude daily consistency is far more important than timing, because creatine works by keeping muscle stores full. Taking 5 g with your post-workout protein shake is an easy routine, and on rest days take it with any meal you never skip."
          }
        },
        {
          "@type": "Question",
          "name": "Can teenagers take creatine or protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Teenagers can usually meet their protein needs from food, and protein powder is a food, so a shake is generally fine as part of a balanced diet. Creatine is different: most research involves adults, and many sports bodies advise caution for under-18s. A teenager should talk to a doctor or registered dietitian before using creatine."
          }
