const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Sugar-Free Protein Powder",
          item: `${SITE_URL}/best-sugar-free-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best sugar-free protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb is our overall pick, with 0 g of sugar, essentially no carbohydrate and about 25 g of protein per scoop on its label. Naked Whey Isolate is the best option without sweeteners, and OWYN Pro Elite is the best sugar-free vegan powder. Check the panel for your flavor, since sugar can vary slightly."
          }
        },
        {
          "@type": "Question",
          "name": "What does sugar free mean on a protein powder label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under FDA rules, sugar free, zero sugar or no sugar means less than 0.5 g of sugars per serving and no sugar ingredients unless marked as trivial. If the product is not also low or reduced in calories, it must say so, for example not for weight control. A 0 g panel figure can mean anything under 0.5 g."
          }
        },
        {
          "@type": "Question",
          "name": "Is no added sugar the same as sugar free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. No added sugar means no sugars were added during processing, but natural sugars such as lactose can remain. A whey concentrate labeled no added sugar may still contain 2 to 3 g of sugar per scoop. Sugar free requires under 0.5 g of total sugars per serving, whatever the source."
          }
        },
        {
          "@type": "Question",
          "name": "Does whey protein have sugar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey contains lactose, milk's natural sugar. Whey concentrate usually has 2 to 3 g per serving, while whey isolate is filtered to remove most of it and often shows 0 g or under 1 g. Flavored wheys may also add sugar, so check both the sugar and added sugars lines and the ingredient list."
          }
        },
        {
          "@type": "Question",
          "name": "Are sugar alcohols in protein powder bad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for most people in small amounts, but they can cause gas, bloating or loose stools, especially xylitol and maltitol. Erythritol has little effect on blood sugar, though a 2023 study linked high blood levels with heart events, an association not shown to be causal. If you are sensitive, choose a powder without them."
          }
        },
        {
          "@type": "Question",
          "name": "Is sugar-free protein powder good for diabetics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be a useful option, but sugar is only one factor. Check total carbohydrate, watch for maltodextrin and consider what you mix it with. Protein can also affect insulin. People with diabetes, especially those on insulin or similar medication, should check with their doctor or dietitian and test their own response."
          }
        },
        {
          "@type": "Question",
          "name": "Is sugar-free protein powder keto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most sugar-free whey isolates fit a keto diet easily, with 0 to 3 g of total carbohydrate per scoop. Powders sweetened with erythritol usually fit too, since erythritol is generally excluded from net carbs. Avoid products with maltodextrin or large amounts of maltitol, and check total carbs, not just sugar."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
