                    <td class="px-4 py-4 font-black text-gray-900">Naked Whey Isolate Unflavored (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">OWYN Pro Elite (2 scoops)</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 180</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Garden of Life Raw Organic Protein</td>
                    <td class="px-4 py-4 text-gray-700">22 g</td>
                    <td class="px-4 py-4 text-gray-700">About 130</td>
                    <td class="px-4 py-4 text-gray-700">0 g (has erythritol)</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">NSF Contents Certified (per brand)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Quest Chocolate Milkshake</td>
