const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "XO Jacqui Protein Powder Review",
          item: `${SITE_URL}/xo-jacqui-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is XO Jacqui protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not that we could find. XO Jacqui calls its protein certified clean and 100 percent natural, but we found no NSF, Informed Choice, Informed Sport or Clean Label Project listing, and no published heavy-metal results. Because brown rice protein can carry more heavy metals than whey, it is worth asking the brand for a certificate of analysis before buying regularly."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in XO Jacqui menopause protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "XO Jacqui says each serving gives 15 g of protein from organic brown rice. Label data we found shows a 22 g serving with about 85 calories, 4 g of carbohydrate and 1 g of sugar. The brand says a larger scoop, about a third of a cup, raises the protein to roughly 21 g, though the tub then lasts fewer servings."
          }
        },
        {
          "@type": "Question",
          "name": "Is XO Jacqui healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Its ingredient list is short and clean: brown rice protein, cacao, wild yam, beetroot, chasteberry and monk fruit in the chocolate flavor, with no gums, oils or artificial sweeteners. That is a genuine strength. What it lacks is published contaminant testing and a full nutrition panel, and the botanicals may not suit everyone taking medication."
          }
        },
        {
          "@type": "Question",
          "name": "Does XO Jacqui contain soy, dairy or estrogen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "XO Jacqui says the powder is soy-free, gluten-free, GMO-free and estrogen-free, and its ingredients are plant-based with no dairy. It is sweetened with monk fruit and has no stevia or sucralose. It does contain wild yam and, in the chocolate flavor, chasteberry, which are botanicals rather than hormones but are worth discussing with your doctor."
