const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-19", modified: "2026-11-19" });
const title = "XO Jacqui Protein Powder Review: Menopause Support Claims";
const description =
  "XO Jacqui menopause protein gives 15 g of brown rice protein per scoop, about $3.78 per 25 g at $68. We check wild yam, chasteberry, testing and swaps.";

const PRODUCTS: {
  id: string;
