---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Transparent Labs Protein Powder Review",
    "url": "/transparent-labs-protein-powder-review/"
  },
  {
    "title": "Ascent Protein Powder Review",
    "url": "/ascent-protein-powder-review/"
  },
  {
    "title": "Vega Protein Powder Review",
    "url": "/vega-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Naked Protein Powder Review: Single-Ingredient Whey, Pea and Casein Ranked";
const description =
  "Naked Nutrition protein reviewed by label: Naked Whey vs the isolate, Naked Pea and Casein, what NSF Contents Certified covers, and cost per 25 g of protein.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "naked-nutrition-naked-whey",
    "name": "Naked Whey (Grass-Fed Whey Protein)",
    "brand": "Naked Nutrition",
    "badge": "Best Overall Naked",
    "category": "Single-ingredient grass-fed whey",
