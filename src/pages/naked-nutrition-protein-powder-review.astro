    "specs": {
      "Protein / serving": "26 g (brand)",
      "Serving size": "2 scoops",
      "Third-party testing": "NSF Contents Certified (brand)",
      "Best for": "Before bed, puddings, baking"
    },
    "amazonUrl": "https://www.amazon.com/dp/B00NBILDQ8"
  },
  {
    "id": "naked-nutrition-naked-whey-isolate",
    "name": "Naked Whey Isolate",
    "brand": "Naked Nutrition",
    "badge": "Best for Lactose Sensitivity",
    "category": "Grass-fed whey protein isolate",
    "description": "Naked Whey Isolate is sourced from pasture-raised cows in New Zealand, per the brand. The unflavored version has two ingredients, whey protein isolate and sunflower lecithin. A two-scoop serving gives 30 g of protein in about 120 calories, with zero sugar and only about 0.1 g of lactose, per Naked. The brand says its nutrition values are verified by an independent third party. It is the most expensive Naked whey per gram.",
