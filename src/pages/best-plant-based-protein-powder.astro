---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Whey vs Plant Protein",
    "url": "/whey-vs-plant-protein/"
  },
  {
    "title": "How Much Protein Do I Need?",
    "url": "/how-much-protein-do-i-need/"
  },
  {
    "title": "When to Take Protein Powder",
    "url": "/when-to-take-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-16", modified: "2026-10-16" });
const title = "Best Plant-Based Protein Powder: 6 Picks Worth Buying";
const description =
  "Six plant-based protein powders ranked by protein per scoop, leucine, cost per 25 g and third-party testing, plus why plant users need a slightly bigger scoop.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "plant-garden-of-life-sport",
    "name": "Garden of Life Sport Organic Plant-Based Protein",
    "brand": "Garden of Life",
    "badge": "Best Overall",
    "category": "Multi-source blend (pea, navy bean, lentil, garbanzo)",
