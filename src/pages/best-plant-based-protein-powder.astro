    "pros": [
      "About 30 g of protein per serving, a full leucine-matched dose",
      "NSF Certified for Sport, per the brand at the time of writing",
      "Widely reported as one of the easier plant proteins to drink straight"
    ],
    "cons": [
      "Mid-to-premium cost per 25 g of protein",
      "Not organic, if that matters to you"
    ],
    "bottomLine": "A proven, certified 30 g plant protein that is a near tie with our top pick.",
    "specs": {
      "Protein / serving": "About 30 g (label, varies by flavor)",
      "Calories": "About 160 (flavor-dependent)",
      "Third-party tested": "NSF Certified for Sport (verify flavor)",
      "Best for": "Endurance and strength athletes"
    }
  },
  {
    "id": "plant-now-sports-pea-protein",
    "name": "NOW Sports Pea Protein (Unflavored)",
    "brand": "NOW",
    "badge": "Best Budget",
    "category": "Single-source pea protein isolate",
    "description": "NOW's unflavored pea protein delivers about 24 g of protein per scoop with nothing added, at one of the lowest costs per 25 g in the category. NOW runs its own in-house testing lab, which is more than most budget brands can say. It tastes like plain pea protein, so it works best blended into smoothies, oats or baking rather than mixed with water.",
    "pros": [
      "Budget-tier cost per 25 g of protein at typical retail prices",
      "No sweeteners, gums or flavorings",
      "Large tubs bring the cost per gram down further"
