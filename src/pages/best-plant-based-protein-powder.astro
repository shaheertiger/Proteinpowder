    ],
    "bottomLine": "Pleasant and widely available, but buy it for taste, not for protein value.",
    "specs": {
      "Protein / serving": "About 21 g (label, 2 scoops)",
      "Calories": "About 150",
      "Third-party tested": "No sport certification confirmed",
      "Best for": "Beginners and casual use"
    }
  },
  {
    "id": "plant-momentous-essential",
    "name": "Momentous Essential Plant-Based Protein",
    "brand": "Momentous",
    "badge": "Best for Tested Athletes",
    "category": "Pea and brown rice blend",
    "description": "Momentous built its name on certification, and its plant protein carries both NSF Certified for Sport and Informed Sport status, per the brand at the time of writing. That double coverage is the main reason to pay its premium price. At about 20 g of protein per serving, you need roughly one and a half servings to match a 25 g whey scoop on leucine, which pushes the effective cost higher still.",
    "pros": [
      "NSF Certified for Sport and Informed Sport, per the brand (verify flavor)",
      "Short ingredient list built on a complementary pea and rice blend",
      "Strong fit for athletes in drug-tested sport"
    ],
