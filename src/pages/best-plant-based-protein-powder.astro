      "Best for": "Drug-tested athletes"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Plant-Based Protein Powder",
          item: `${SITE_URL}/best-plant-based-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is plant-based protein as good as whey for building muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At matched doses, mostly yes. Trials comparing pea, rice or soy protein with whey during resistance training have found broadly similar gains in muscle and strength, and a 12-week study found vegans and omnivores eating about 1.6 g/kg per day gained at similar rates. Whey wins gram for gram on leucine, so plant users should simply take a slightly bigger scoop, around 30-35 g."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best plant protein source?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Soy isolate and pea protein are the strongest single sources, with soy closest to dairy on digestibility scores. Blends of pea with rice, or with other legumes and seeds, cover each other's limiting amino acids and are the safest default. Hemp and rice alone are weaker as a main protein source and work better as part of a blend or as a smoothie booster."
          }
        },
        {
          "@type": "Question",
          "name": "Do plant-based protein powders have heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many contain small amounts, and independent testing has found plant powders carry more lead on average than dairy ones, with chocolate flavors tending higher. The risk is cumulative, not acute. Choose a third-party tested product, favor unflavored or vanilla if you take several servings daily, and talk to a doctor first if you are pregnant or have kidney disease."
          }
        },
        {
          "@type": "Question",
          "name": "How many grams of plant protein should be in a shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aim for about 30-35 g of plant protein per shake, which supplies roughly the 2.5 g of leucine you would get from 25 g of whey. Older adults can go toward 35-40 g. If your powder lists 20 g per serving, use one and a half servings after training, or pair a single serving with a meal that adds protein of its own."
          }
        },
        {
          "@type": "Question",
          "name": "Is pea protein a complete protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pea protein contains all nine essential amino acids, but methionine is relatively low, so on digestibility scores it ranks below whey and soy. In practice, at a 25-35 g dose and alongside a varied diet that includes grains, nuts or soy, the shortfall is small. Pea and rice blends close the gap entirely, which is why they are so common."
          }
        },
        {
          "@type": "Question",
          "name": "Can plant protein powder cause bloating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for some people. The usual causes are added ingredients rather than the protein itself: sugar alcohols such as erythritol, fibers such as inulin, and gums such as xanthan or guar. Large single servings and fast drinking can contribute too. An unflavored single-ingredient pea isolate is the simplest way to test whether the protein or the extras are the problem."
          }
        },
        {
          "@type": "Question",
          "name": "Are plant protein powders safe during pregnancy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many people use protein powder during pregnancy, but because of the heavy-metal findings in plant powders, this is a question for your doctor or a registered dietitian rather than a label. If you are cleared to use one, choose a third-party tested product, prefer unflavored or vanilla, keep it to one serving a day, and get most of your protein from whole foods."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
