      "Third-party tested": "Brand in-house lab testing",
      "Best for": "Budget buyers and smoothies"
    }
  },
  {
    "id": "plant-naked-pea",
    "name": "Naked Pea Protein",
    "brand": "Naked Nutrition",
    "badge": "Best Single Ingredient",
