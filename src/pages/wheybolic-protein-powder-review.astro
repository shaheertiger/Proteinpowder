const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-15", modified: "2026-11-15" });
const title = "Wheybolic Protein Powder Review: Old vs New Formula, Cost and Testing";
const description =
  "GNC AMP Wheybolic reviewed by label: what changed in the New Wheybolic, 25 g scoops, Informed Choice testing, cost per 25 g at Amazon vs GNC, and rivals.";

