const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Wheybolic Protein Powder Review",
          item: `${SITE_URL}/wheybolic-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Wheybolic protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The New Wheybolic is a good whey. Per GNC's labels, each scoop gives 25 g of protein in about 120 calories, the protein comes from whey isolate and whey protein, and GNC says it is Informed Choice certified. Its weakness is price. On Amazon it costs about $2.31 per 25 g at the price we saw, so it is best bought at GNC on sale."
