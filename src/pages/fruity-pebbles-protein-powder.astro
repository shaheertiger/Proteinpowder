const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Fruity Pebbles Protein Powder",
          item: `${SITE_URL}/fruity-pebbles-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Who makes Fruity Pebbles protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dymatize makes it under license from Post Consumer Brands, which owns the Pebbles cereals. The flavor appears in Dymatize ISO100 whey isolate, Super Mass Gainer and the Performance Protein Shake. Dymatize is owned by BellRing Brands, the company behind Premier Protein, which was spun out of Post Holdings and completed its separation in 2022. Other brands sell cereal flavors, but not the Pebbles license."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Fruity Pebbles protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ISO100 Fruity Pebbles lists 25 g of protein per 30 g scoop, with about 120 calories, 2 g of carbohydrate and 1 g of sugar, per Dymatize's label at the time of writing. Some retailer listings show 110 calories for the same product. The mass gainer version is very different, at about 52 g of protein and 1,280 calories per 333 g serving."
          }
        },
        {
          "@type": "Question",
          "name": "Is Fruity Pebbles protein powder healthy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ISO100 version has a strong nutrition profile: mostly protein, very little sugar or fat, and over 2.5 g of leucine per scoop. It does contain sucralose, stevia, artificial flavors and color additives, which some people prefer to avoid. For most healthy adults it is a reasonable supplement. Anyone with a medical condition, pregnancy or kidney disease should ask a doctor or dietitian first."
          }
        },
        {
          "@type": "Question",
          "name": "Does Fruity Pebbles protein powder contain Red 3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It has historically used color additives, and Dymatize's product page says ingredient statements may vary while it transitions to a formula without Red No. 3. The FDA revoked Red No. 3 for food in January 2025 and gave manufacturers until January 2027 to reformulate. If this matters to you, check the ingredient list on the tub you receive."
          }
        },
        {
          "@type": "Question",
          "name": "Is Fruity Pebbles protein good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
