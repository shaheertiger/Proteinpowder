import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Protein Powder for Women",
    "url": "/best-protein-powder-for-women/"
  },
  {
    "title": "Best Protein Powder for Pregnancy",
    "url": "/best-protein-powder-for-pregnancy/"
  },
  {
    "title": "Best Protein Powder Without Heavy Metals",
