    }
  },
  {
    "id": "huel-black-edition",
    "name": "Huel Black Edition",
    "brand": "Huel",
    "badge": "Best for Extra Calories",
    "category": "High-protein complete meal powder",
    "description": "Breastfeeding raises calorie needs, and Huel Black Edition is the most efficient way here to drink a real meal. Per Huel's label at the time of writing, a 90 g serving gives about 400 calories and 40 g of plant protein from pea and brown rice, with fiber, fats and 27 vitamins and minerals. It is sweetened with stevia and a little coconut sugar and comes in 17-meal bags, including an unflavored version.",
    "pros": [
      "About 400 calories and 40 g of protein per serving, per the label",
      "A full meal you can drink one-handed during a feed",
      "Fiber and fat keep you full far longer than a plain protein shake"
    ],
    "cons": [
