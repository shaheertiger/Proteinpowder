];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-08", modified: "2026-11-08" });
const title = "Best Protein Powder for Breastfeeding: Calories, Protein and the Truth About Lactation Add-Ins";
const description =
  "The best protein powders for breastfeeding, compared on protein, calories, testing and sweeteners, plus what the evidence says about fenugreek and lactation blends.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "ritual-essential-protein-pregnancy-postpartum",
    "name": "Ritual Essential Protein Daily Shake Pregnancy & Postpartum",
    "brand": "Ritual",
    "badge": "Best Overall for Breastfeeding",
    "category": "Pea protein shake formulated for pregnancy and lactation",
    "description": "Ritual designed this shake for pregnancy and lactation and suggests using it through breastfeeding. Per its label and listings at the time of writing, a roughly 30-31 g serving gives 20 g of organic pea protein in about 115-120 calories, with 250 mg of choline and no added sugar. Ritual describes it as free of stevia and sugar alcohols, and it contains no galactagogue herbs such as fenugreek. It does not replace a postnatal or prenatal vitamin.",
    "pros": [
      "250 mg of choline, a nutrient whose Adequate Intake rises to 550 mg during lactation",
      "No fenugreek or other lactation herbs, so nothing that could upset you or the baby",
      "Dairy-free, useful if your baby's doctor has asked you to cut cow's milk",
      "No added sugar per retailer listings"
