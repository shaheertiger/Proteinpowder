---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Clean Simple Eats vs Just Ingredients",
    "url": "/clean-simple-eats-vs-just-ingredients/"
  },
  {
    "title": "Orgain vs Truvani",
    "url": "/orgain-vs-truvani/"
  },
  {
    "title": "Best Protein Powder for Smoothies",
    "url": "/best-protein-powder-for-smoothies/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "FlavCity vs Clean Simple Eats: Smoothie Mix or Whey Isolate?";
const description =
  "Clean Simple Eats wins on protein value: $2.71 per 25 g of whey isolate vs $3.00 for FlavCity, whose 25 g includes 10 g of collagen. Labels, testing, cost.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "flavcity-vs-clean-simple-eats-flavcity-chocolate",
    "name": "FlavCity Protein Smoothie, Chocolate (20 servings)",
    "brand": "FlavCity",
    "badge": "Best Breakfast Smoothie",
    "category": "Whey, collagen and milk protein smoothie mix",
    "description": "FlavCity's Chocolate Protein Smoothie lists 25 g of protein in a 49.5 g scoop with 200 calories, 13 g of carbohydrate, 3 g of fiber, 3 g of sugar and 4 g of fat, per the brand's nutrition panel at the time of writing. The brand says about 10 g of each scoop is grass-fed collagen; the rest comes from grass-fed whey concentrate, milk protein concentrate and yeast protein, with banana, coconut milk, cocoa, stevia, cordyceps and reishi.",
    "pros": [
      "Breakfast-style shake: fruit, fat and 3 g of fiber already in the bag",
      "Stevia only, with 0 g added sugar per the brand",
      "Grass-fed whey and milk protein base",
      "Sold on its own site, Amazon, Target and TikTok Shop"
    ],
    "cons": [
      "About 10 g of the 25 g is collagen, an incomplete protein",
      "Only about 51% protein by weight; 200 calories a scoop",
      "No third-party testing claim; Prop 65 warning for lead and cadmium"
    ],
    "bottomLine": "A convenient real-ingredient breakfast smoothie, but a costly and diluted way to buy protein. Skip it if you are counting protein per dollar or per calorie.",
    "specs": {
      "Protein / serving": "25 g in 49.5 g (about 10 g collagen, per brand)",
      "Calories": "200",
      "Third-party testing": "None claimed",
      "Cost per 25 g": "$3.00 ($59.99, 20 servings, brand site)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0C5FJ9GHD"
  },
  {
    "id": "flavcity-vs-clean-simple-eats-cse-brownie-batter",
    "name": "Clean Simple Eats Whey Protein, Brownie Batter (30 servings)",
    "brand": "Clean Simple Eats",
    "badge": "Best Protein Value",
    "category": "Grass-fed whey isolate, stevia-sweetened",
    "description": "Clean Simple Eats Brownie Batter lists 20 g of grass-fed whey isolate protein in a 27 g scoop with 100 calories, 2 g of carbohydrate, under 1 g of sugar and 0.5 g of fat, per the current-formula label at the time of writing. The six-ingredient list adds cocoa, natural flavors, sea salt, coconut milk powder and stevia, plus a 100 mg enzyme blend, with no xylitol or xanthan gum.",
    "pros": [
      "All whey isolate: about 74% protein by weight",
      "100 calories per scoop, under 1 g sugar",
      "Cheaper than FlavCity per scoop ($2.17) and per 25 g ($2.71) in the 30-serving bag",
      "Short label with stevia and a big dessert-flavor range"
    ],
    "cons": [
      "Only 20 g of protein per scoop",
      "Smaller bags cost $3.12 to $3.75 per 25 g",
      "Third-party testing is a brand claim with no named certifier"
    ],
    "bottomLine": "The better protein powder of the two: more complete protein per calorie and per dollar. Skip it if you want 25 g in a single scoop or need a named sport certification.",
    "specs": {
      "Protein / serving": "20 g in 27 g (whey isolate)",
      "Calories": "100",
      "Third-party testing": "Brand claim; no certifier named",
      "Cost per 25 g": "$2.71 ($64.99, 30 servings, brand site)"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "FlavCity vs Clean Simple Eats",
          item: `${SITE_URL}/flavcity-vs-clean-simple-eats/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is FlavCity or Clean Simple Eats better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean Simple Eats is better as a protein powder and FlavCity is better as a ready-made breakfast smoothie. Clean Simple Eats gives 20 g of whey isolate in 100 calories for about $2.71 per 25 g; FlavCity gives 25 g of protein, about 10 g of it collagen, in 200 calories for $3.00 per 25 g at brand-site prices. For most buyers, Clean Simple Eats is the better value."
          }
        },
        {
          "@type": "Question",
          "name": "Clean Simple Eats vs FlavCity: which has more protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FlavCity lists more total protein, 25 g per scoop against 20 g for Clean Simple Eats, per their chocolate labels. But FlavCity says about 10 g of its scoop is collagen, an incomplete protein, so it carries roughly 15 g of complete protein. Clean Simple Eats has about 20 g of complete whey isolate protein, so it wins on the protein that builds muscle."
          }
        },
        {
          "@type": "Question",
          "name": "Is FlavCity protein a protein powder or a meal replacement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FlavCity sits in between. It is a whey-based powder with banana, coconut milk, cocoa and mushroom powders added, so a scoop has 200 calories, 13 g of carbohydrate, 3 g of fiber and 4 g of fat. That is more than a plain protein powder but less than a full meal-replacement shake. Mixed with milk, it works as a light breakfast."
          }
        },
        {
          "@type": "Question",
          "name": "Are FlavCity and Clean Simple Eats third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither has a named certification such as NSF Certified for Sport or Informed Choice. Clean Simple Eats says its protein is third-party tested but does not name the lab or publish results. FlavCity makes no testing claim and its bag carries a California Prop 65 warning for lead and cadmium, which is a notice, not a measured result."
          }
        },
        {
          "@type": "Question",
          "name": "Which is cheaper, FlavCity or Clean Simple Eats?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean Simple Eats is cheaper in its 30-serving bag: about $2.17 per scoop and $2.71 per 25 g of protein at $64.99. FlavCity costs $3.00 per scoop and per 25 g at $59.99 for 20 servings on its site. FlavCity's Amazon store price of $50.99 brings it to about $2.55, and Clean Simple Eats' smaller bags cost more per gram."
          }
        },
        {
          "@type": "Question",
          "name": "Which is better for weight loss, FlavCity or Clean Simple Eats?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clean Simple Eats is usually the better choice for weight loss because it gives 20 g of protein in only 100 calories, against FlavCity's 25 g in 200 calories. Protein per calorie drives satiety on a diet. FlavCity can still work if it replaces a full breakfast, since its fiber and fat make it more filling than a lean shake."
          }
        },
        {
          "@type": "Question",
          "name": "Do FlavCity and Clean Simple Eats use artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Both are sweetened with stevia only, per their labels at the time of writing: FlavCity uses organic stevia Reb A and stevia Reb M, and Clean Simple Eats uses stevia leaf extract. Neither lists sucralose, acesulfame potassium or sugar alcohols, and Clean Simple Eats says its current formula is xylitol-free. If stevia's aftertaste bothers you, neither one avoids it."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "flavcity vs clean simple eats",
      "clean simple eats vs flavcity",
      "flavcity protein smoothie vs clean simple eats whey",
      "flavcity protein smoothie",
      "clean simple eats whey protein",
      "clean protein powder"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Clean Protein Picks",
    link: "/best-clean-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">FlavCity vs Clean Simple Eats</Fragment>
      One is a whey-and-collagen smoothie mix with banana, coconut milk and mushrooms; the other is a plain, stevia-sweetened whey isolate. Here is what that difference means for protein per scoop, calories, cost per 25 g and testing.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Two Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#protein-smoothie">What a Protein Smoothie Is</a>
      <a href="#protein-per-scoop">Protein per Scoop</a>
      <a href="#cost">Cost per 25 g</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#by-goal">By Goal</a>
      <a href="#strengths">Strengths and Weaknesses</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Clean Simple Eats Whey Protein is the better buy for most people: it costs about $2.71 per 25 g of protein against $3.00 for the FlavCity Protein Smoothie at brand-site prices, and all of its protein is whey isolate. FlavCity wins only if you want a ready-made breakfast smoothie with collagen, fruit and fat in the bag. Below we compare both chocolate labels line by line, explain what a protein smoothie really is, and check cost, testing and buyer-reported taste.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. FlavCity vs Clean Simple Eats: The Short Answer
          </h2>

          <p>
            Clean Simple Eats is the better protein powder and FlavCity is the better meal-style smoothie; they are not really the same kind of product. Per their chocolate labels at the time of writing, a Clean Simple Eats scoop gives 20 g of grass-fed whey isolate in 100 calories, while a FlavCity scoop gives 25 g of protein in 200 calories, about 10 g of which the brand says is collagen. Clean Simple Eats also costs less per scoop ($2.17 against $3.00) and less per 25 g of protein ($2.71 against $3.00) at brand-site prices.
          </p>

          <p>
            Pick Clean Simple Eats if you want the most whey protein per dollar and per calorie, a short six-ingredient label, or a powder to bake with. Pick FlavCity if you want one scoop to replace a blended breakfast, like the idea of collagen with your whey, and do not mind paying more for banana, coconut milk and mushroom powders. Pick neither if you need a sport certification: neither brand names a certifier.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">FlavCity Protein Smoothie</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Clean Simple Eats Whey</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">25 g (about 10 g collagen, per brand)</td>
                    <td class="px-4 py-4 text-gray-700">20 g, all whey isolate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories per scoop</td>
                    <td class="px-4 py-4 text-gray-700">200</td>
                    <td class="px-4 py-4 text-gray-700">100</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g protein</td>
                    <td class="px-4 py-4 text-gray-700">$3.00 (brand site)</td>
                    <td class="px-4 py-4 text-gray-700">$2.71 (brand site, 30-serving bag)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweetener</td>
                    <td class="px-4 py-4 text-gray-700">Stevia (Reb A and Reb M)</td>
                    <td class="px-4 py-4 text-gray-700">Stevia</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Third-party certification</td>
                    <td class="px-4 py-4 text-gray-700">None named</td>
                    <td class="px-4 py-4 text-gray-700">Brand says tested; no certifier named</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">23 / 100</td>
                    <td class="px-4 py-4 text-gray-700">48 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare FlavCity and Clean Simple Eats at a Glance
          </h2>

          <p>
            The quickest way to settle FlavCity vs Clean Simple Eats is to decide what job the scoop has to do. If it is a protein top-up after training or in oats, Clean Simple Eats does more with less. If it is breakfast in a shaker, FlavCity brings the calories, fat and fiber a breakfast needs. The Label Score below is our 100-point rating of each label, explained on our <a href="/methodology/">methodology page</a>.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href="/protein-powder/clean-simple-eats-whey-protein/">Clean Simple Eats Whey Protein</a></td>
                    <td class="px-4 py-4 text-gray-700">Lean whey isolate, baking, low-calorie shakes</td>
                    <td class="px-4 py-4 text-gray-700">You want 25 g in one scoop or need a named certification</td>
                    <td class="px-4 py-4 text-gray-700">48</td>
                    <td class="px-4 py-4 text-gray-700">$2.71</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href="/protein-powder/flavcity-protein-smoothie/">FlavCity Protein Smoothie</a></td>
                    <td class="px-4 py-4 text-gray-700">Grab-and-go breakfast smoothie with collagen</td>
                    <td class="px-4 py-4 text-gray-700">You count protein per dollar or want only complete protein</td>
                    <td class="px-4 py-4 text-gray-700">23</td>
                    <td class="px-4 py-4 text-gray-700">$3.00</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. FlavCity Protein Smoothie and Clean Simple Eats Whey, Card by Card
          </h2>

          <p>
            One card per side, using each brand's chocolate flavor so the labels compare like for like: FlavCity Chocolate and Clean Simple Eats Brownie Batter. Label figures come from each brand's nutrition panel at the time of writing; prices are brand-site prices checked in November 2026 and will move.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            Here are both chocolate labels line by line, per each brand's Supplement or Nutrition Facts panel at the time of writing. Other flavors differ slightly, so check the panel of the exact flavor you buy.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">FlavCity Protein Smoothie (Chocolate)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Clean Simple Eats Whey (Brownie Batter)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Scoop size</td>
                    <td class="px-4 py-4 text-gray-700">49.5 g</td>
                    <td class="px-4 py-4 text-gray-700">27 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">About 51%</td>
                    <td class="px-4 py-4 text-gray-700">About 74%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">200</td>
                    <td class="px-4 py-4 text-gray-700">100</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">13 g (3 g fiber)</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar</td>
                    <td class="px-4 py-4 text-gray-700">3 g (0 g added, per brand)</td>
                    <td class="px-4 py-4 text-gray-700">Under 1 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat</td>
                    <td class="px-4 py-4 text-gray-700">4 g</td>
                    <td class="px-4 py-4 text-gray-700">0.5 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sodium</td>
                    <td class="px-4 py-4 text-gray-700">200 mg</td>
                    <td class="px-4 py-4 text-gray-700">130 mg</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein sources</td>
                    <td class="px-4 py-4 text-gray-700">Whey concentrate, collagen, milk protein concentrate, yeast protein</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweeteners</td>
                    <td class="px-4 py-4 text-gray-700">Organic stevia (Reb A), stevia (Reb M)</td>
                    <td class="px-4 py-4 text-gray-700">Stevia leaf extract</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Certification</td>
                    <td class="px-4 py-4 text-gray-700">None named; Prop 65 warning for lead and cadmium</td>
                    <td class="px-4 py-4 text-gray-700">Brand says third-party tested; no certifier named</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Servings and size</td>
                    <td class="px-4 py-4 text-gray-700">20-serving bag</td>
                    <td class="px-4 py-4 text-gray-700">30-serving bag (also 20 and 10)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Price (brand site)</td>
                    <td class="px-4 py-4 text-gray-700">$59.99</td>
                    <td class="px-4 py-4 text-gray-700">$64.99</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g protein</td>
                    <td class="px-4 py-4 text-gray-700">$3.00</td>
                    <td class="px-4 py-4 text-gray-700">$2.71</td>
