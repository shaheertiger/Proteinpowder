const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-18", modified: "2026-11-18" });
const title = "Serious Mass Protein Powder Review: 1,260 Calories, Worth It?";
const description =
  "Serious Mass gives about 1,260 calories, 50 g protein, 253 g carbs and 5 g creatine per 2-scoop serving, per ON. Sugar, testing, cost per 25 g and swaps.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "serious-mass-review-on-serious-mass-6lb-vanilla",
