const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Serious Mass Review",
          item: `${SITE_URL}/serious-mass-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Serious Mass third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We found no product-level third-party certification for Serious Mass. The label and US product page do not show an Informed Choice, Informed Sport or NSF Certified for Sport mark. ON says its facilities hold Informed Choice, NSF, ISO and BRCGS certifications and run over 100,000 quality checks a year. Tested athletes may prefer Pro Gainer, whose label shows a Banned Substance Tested mark."
          }
        },
        {
          "@type": "Question",
          "name": "Is Serious Mass healthy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Serious Mass is reasonable for lean, active adults who need extra calories, but it is not a health food. A full serving has 253 g of carbohydrate, mostly fast-digesting maltodextrin, 30 g of sugars, 680 mg of sodium and artificial sweeteners. It suits hard gainers who train; it does not suit people with diabetes, prediabetes or those trying to stay lean."
          }
        },
        {
          "@type": "Question",
          "name": "Does Serious Mass contain creatine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The current Serious Mass label lists 5 g of creatine monohydrate per full 340 g serving, which matches the standard daily dose used in research. A half serving gives 2.5 g. If you already take creatine separately, you do not need to add another full scoop on top of a full Serious Mass serving."
          }
        },
        {
          "@type": "Question",
          "name": "Does Serious Mass contain lactose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It does. All of the protein in Serious Mass comes from whey protein concentrate, which naturally contains lactose, and the label states that it contains milk and soy. ON does not publish a lactose figure. People with lactose intolerance often report bloating, so a gainer built on whey isolate or a lactose-free option is a safer choice."
          }
        },
        {
          "@type": "Question",
          "name": "Which Serious Mass flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chocolate is the flavor buyers praise most often, followed by Chocolate Peanut Butter. Vanilla gets mixed reviews, with some buyers describing a typical artificial vanilla taste that improves when blended with banana or peanut butter. Banana and Strawberry draw the most divided feedback. These are buyer reports, not our own tasting."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common Serious Mass complaints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common complaints are bloating and gas, especially at the full serving, clumping when mixed in a shaker instead of a blender, and the huge serving volume. Some buyers also mention breakouts, an overly sweet taste in certain flavors and a scoop buried in the bag. The most common praise is that it helps people gain weight reliably."
          }
        },
        {
          "@type": "Question",
          "name": "How much weight can you gain with Serious Mass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That depends on your total diet, not the shake alone. One full serving adds about 1,260 calories a day, roughly 8,800 a week, which can drive a gain of around 0.5 kg a week or more if the rest of your diet stays the same. Combine it with resistance training so more of the gain is muscle, and reduce the dose if fat gain is too fast."
          }
        }
