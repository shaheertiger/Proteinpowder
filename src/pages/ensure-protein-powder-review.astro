  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ensure Protein Powder Review",
          item: `${SITE_URL}/ensure-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Ensure protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ensure Max Protein 3-in-1 Muscle Support is described by Abbott as NSF Contents Certified and independently tested for quality and safety. That confirms the label contents but is not NSF Certified for Sport. Ensure Original powder has no third-party certification that we could find; it is made under food-safety rules by Abbott, which does not publish heavy-metal results for it."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ensure protein powder healthy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends which one. The 3-in-1 is a reasonable protein supplement: 30 g of protein, about 2 g of sugar and creatine plus HMB, per Abbott. The Original powder is a calorie supplement with 13 g of added sugar and corn syrup as its first ingredient. Neither is a meal on its own. Ask a doctor or dietitian if you have a medical condition."
          }
        },
        {
          "@type": "Question",
          "name": "Does Ensure powder contain lactose or sugar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ensure Original powder contains milk and soy, is labeled suitable for lactose intolerance and has 13 g of added sugar per serving. The 3-in-1 lists about 2 g of sugar per serving; its protein source and sweeteners were not published online when we checked, so read the tub. Neither is suitable for people with galactosemia or a milk allergy."
          }
        },
        {
          "@type": "Question",
          "name": "Which Ensure powder flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is not enough buyer feedback on the 3-in-1 yet to call a winner between chocolate and vanilla. Choose chocolate for drinking with water or milk and vanilla for oatmeal, yogurt and fruit smoothies. For the Original powder, vanilla is the only US flavor Abbott lists, and one published review described it as very mild. We have not tasted either."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common complaints about Ensure powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Early buyers of the 3-in-1 complain that a 28 oz tub makes only 15 servings, which feels small for the price. For the Original powder and Ensure's shakes, buyer reviews most often mention blandness, sweetness and price, with occasional reports of an off taste. Praise centres on smooth mixing and the convenience of a trusted pharmacy brand."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ensure powder the same as the Ensure shake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Ensure Original powder gives 250 calories and 9 g of protein per serving, while the bottled Original shake has different figures, per Abbott. The 3-in-1 powder is a new product with creatine and HMB that no Ensure bottle contains. The Max Protein bottle matches the 3-in-1 on protein at 30 g but has no creatine."
          }
        },
        {
          "@type": "Question",
          "name": "Can seniors take Ensure Max Protein 3-in-1 every day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many healthy older adults can, and the directions are one serving a day. But creatine and a 30 g protein dose are not right for everyone. Anyone with kidney disease, diabetes, heart failure on a fluid limit, or several prescriptions should ask their doctor or a registered dietitian first. This is general information, not medical advice."
          }
