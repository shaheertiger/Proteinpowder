---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Ryse vs Ghost Protein",
    "url": "/ryse-vs-ghost-protein/"
  },
  {
    "title": "Premier Protein vs Optimum Nutrition",
    "url": "/premier-protein-vs-optimum-nutrition/"
  },
  {
    "title": "Ascent vs Optimum Nutrition",
    "url": "/ascent-vs-optimum-nutrition/"
  },
  {
    "title": "Isopure vs Optimum Nutrition",
    "url": "/isopure-vs-optimum-nutrition/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Ghost Protein vs Optimum Nutrition: Which Whey Is Worth It?";
const description =
  "Optimum Nutrition wins for most: about $1.44 per 25 g of protein vs $2.12 for Ghost Whey, plus NSF certification. Ghost wins on enzymes and flavors.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "ghost-vs-optimum-nutrition-on-gold-standard-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey, Double Rich Chocolate",
    "brand": "Optimum Nutrition",
    "badge": "Best Value and Tested",
    "category": "Whey isolate, concentrate and hydrolyzed whey blend",
    "description": "Per the label at the time of writing, a 31 g scoop of Double Rich Chocolate gives 24 g of protein, about 120 calories, 3 g of carbohydrate, 1 g of sugar, 1.5 g of fat and 130 mg of sodium, sweetened with acesulfame potassium. Optimum Nutrition states 5.5 g of BCAAs per scoop. At $79.99 for 58 servings at Target (checked 1 November 2026) it costs about $1.44 per 25 g of protein, and Double Rich Chocolate appears in NSF's Certified for Sport listings.",
    "pros": [
      "About $1.44 per 25 g in the 58-serving tub",
      "About 77% protein by weight, the denser scoop of the two",
      "Double Rich Chocolate and Vanilla Ice Cream are NSF Certified for Sport",
      "About 24 flavors; Label Score 78 / 100"
    ],
    "cons": [
      "Lists soy (lecithin) as well as milk",
      "Small 1.98 lb tub costs about $2.68 per 25 g at ON's store price",
      "24 g per scoop, so 25 g takes slightly more than one scoop"
    ],
    "bottomLine": "The better buy for most people: more protein per gram, a lower cost per gram in the big tub and an NSF listing. Skip it if you avoid soy or only ever buy small tubs.",
    "specs": {
      "Protein / serving": "24 g in 31 g (label)",
      "Calories": "About 120",
      "Third-party testing": "NSF Certified for Sport (2 flavors, per NSF)",
      "Cost per 25 g": "About $1.44 ($79.99, 58 servings, Target)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B000QSNYGI"
  },
  {
    "id": "ghost-vs-optimum-nutrition-ghost-whey",
    "name": "GHOST Whey Protein (2 lb)",
    "brand": "GHOST",
    "badge": "Best for Flavors and Enzymes",
    "category": "Whey isolate, concentrate and hydrolyzed isolate blend",
    "description": "Per the label at the time of writing, a 35 g rounded scoop of Milk Chocolate gives 25 g of protein, about 130 calories, 4 g of carbohydrate, 2 g of sugar, 1.5 g of fat and 180 mg of sodium, sweetened with sucralose only. It adds a digestive enzyme blend with lactase, bromelain and proteases, and Ghost labels it soy-free and gluten-free. At $54.99 for 26 servings on Ghost's store (checked 1 November 2026) it costs about $2.12 per 25 g.",
    "pros": [
      "Digestive enzymes including lactase",
      "Soy-free and gluten-free, per Ghost",
      "Licensed cereal and dessert flavors such as Lucky Charms and Cinnabon",
      "Full 25 g of protein in one scoop"
    ],
    "cons": [
      "About $2.12 per 25 g, roughly 47% more than Gold Standard's big tub",
      "No sport certification claimed or found",
      "Gums, artificial flavor and 180 mg sodium; Label Score 48 / 100"
    ],
    "bottomLine": "Worth the premium only if the enzymes, the soy-free label or the cereal flavors matter to you. Skip it if you are drug tested or want the most protein for your money.",
    "specs": {
      "Protein / serving": "25 g in 35 g (label)",
      "Calories": "About 130",
      "Third-party testing": "No sport certification found",
      "Cost per 25 g": "About $2.12 ($54.99, 26 servings, Ghost store)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B01N9BO3SE"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ghost vs Optimum Nutrition",
          item: `${SITE_URL}/ghost-vs-optimum-nutrition/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Ghost protein better than Optimum Nutrition?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most buyers, no. Optimum Nutrition Gold Standard gives more protein per gram of powder (about 77% vs 71%), costs about $1.44 per 25 g of protein in the 58-serving tub against about $2.12 for Ghost, and has two NSF Certified for Sport flavors. Ghost is better if you want added lactase, a soy-free label or licensed cereal flavors."
          }
        },
        {
          "@type": "Question",
          "name": "How does Ghost protein powder vs Optimum Nutrition compare on calories?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They are close. Per the labels at the time of writing, Ghost Whey has 130 calories with 25 g of protein, and Gold Standard has 120 calories with 24 g. Scaled to 25 g of protein, Gold Standard comes to about 125 calories, slightly leaner. Ghost also has 1 g more sugar and 50 mg more sodium per scoop."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ghost Whey third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We found no sport certification for Ghost Whey. Ghost's product page claims none, and our Ghost review found no listing with NSF Certified for Sport, Informed Choice or Informed Sport at the time of writing. Some Ghost drinks carry NSF listings, but those cover only the named products. Drug-tested athletes should choose a certified whey instead."
          }
        },
        {
          "@type": "Question",
          "name": "Is Optimum Nutrition Gold Standard NSF certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some flavors are. We confirmed Double Rich Chocolate and Vanilla Ice Cream in the NSF Certified for Sport listings on 19 November 2026. Other flavors were not listed when we checked. Optimum Nutrition also calls Gold Standard banned-substance tested on its US page, but if you are tested, check your exact flavor in NSF's database before buying."
          }
        },
        {
          "@type": "Question",
          "name": "Which mixes better, Ghost or Gold Standard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both should mix with a shaker bottle, according to buyer reviews and their labels. Each uses lecithin, which helps powder disperse in water. Ghost also adds cellulose and xanthan gums, which give a thicker shake that some buyers prefer. We have not run our own mixing test on either, so treat this as buyer feedback rather than a lab result."
          }
        },
        {
          "@type": "Question",
          "name": "Does Ghost Whey or Gold Standard have soy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gold Standard lists soy as an allergen because it may use soy lecithin, per the label we read. Ghost uses sunflower lecithin and labels Ghost Whey soy-free. Both contain milk. If you avoid soy for allergy reasons, Ghost is the one of the two that fits, but always check the allergen statement on your tub."
          }
        },
        {
          "@type": "Question",
          "name": "Why is Ghost protein more expensive than Optimum Nutrition?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ghost sells smaller tubs at a higher price per serving: $54.99 for 26 servings, or about $2.12 per 25 g, against $79.99 for 58 servings of Gold Standard at Target, about $1.44. Ghost's licensed flavors and added enzymes are part of what buyers pay for. In small tubs the gap narrows, and ON's 1.98 lb tub can cost more."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Comparisons",
    tags: [
      "ghost protein vs optimum nutrition",
      "ghost protein powder vs optimum nutrition",
      "ghost whey vs gold standard whey",
      "optimum nutrition vs ghost",
      "ghost whey protein",
      "optimum nutrition gold standard whey"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Best Whey Protein Picks",
    link: "/best-whey-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Head-to-Head"} badge={"Label-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Ghost Protein vs Optimum Nutrition</Fragment>
      Ghost Whey and Optimum Nutrition Gold Standard 100% Whey are two of the most searched whey blends in the US. Here is how they compare on protein per scoop, cost per 25 g, third-party testing, ingredients and what buyers say about taste.
    </ArticleHeader>

    <TableOfContents>
      <a href="#short-answer">Short Answer</a>
      <a href="#at-a-glance">At a Glance</a>
      <a href="#top-picks">The Two Products</a>
      <a href="#spec-sheets">Spec Sheets</a>
      <a href="#protein">Protein per Scoop</a>
      <a href="#cost">Cost per Gram</a>
      <a href="#testing">Third-Party Testing</a>
      <a href="#label">Cleaner Label</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#stomach">Stomach Comfort</a>
      <a href="#ghost-pros-cons">Ghost Strengths and Gaps</a>
      <a href="#on-pros-cons">ON Strengths and Gaps</a>
      <a href="#which-to-buy">Which to Buy</a>
      <a href="#skip-both">Who Should Skip Both</a>
      <a href="#sources">Sources and Updates</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Optimum Nutrition Gold Standard 100% Whey is the better buy for most people: it costs about $1.44 per 25 g of protein in the 58-serving tub against about $2.12 for Ghost Whey, and two of its flavors are NSF Certified for Sport. Ghost wins if you want digestive enzymes, a soy-free label or its licensed cereal flavors. Below we compare the labels, the cost math, testing, taste reports and who should skip both.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="short-answer" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Ghost Protein vs Optimum Nutrition: The Short Answer
          </h2>

          <p>
            Gold Standard 100% Whey wins on price, protein density and testing, while Ghost Whey wins on extras. Per the labels at the time of writing, Ghost gives 25 g of protein in a 35 g scoop and Gold Standard gives 24 g in a 31 g scoop, both at 120 to 130 calories. At the prices in our database, Gold Standard costs about a third less per gram of protein, and it is the only one of the two with an NSF Certified for Sport listing.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Factor</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">GHOST Whey</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">ON Gold Standard 100% Whey</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein per scoop</td>
                    <td class="px-4 py-4 text-gray-700">25 g in 35 g (71%)</td>
                    <td class="px-4 py-4 text-gray-700">24 g in 31 g (77%)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Cost per 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.12</td>
                    <td class="px-4 py-4 text-gray-700">About $1.44 (58-serving tub)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sport certification</td>
                    <td class="px-4 py-4 text-gray-700">None claimed or found</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (2 flavors)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweetener</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose</td>
                    <td class="px-4 py-4 text-gray-700">Acesulfame potassium</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Extras</td>
                    <td class="px-4 py-4 text-gray-700">Enzymes incl. lactase</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Label Score</td>
                    <td class="px-4 py-4 text-gray-700">48 / 100</td>
                    <td class="px-4 py-4 text-gray-700">78 / 100</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pick Optimum Nutrition for value and testing; pick Ghost for enzymes and flavors.</p>
            <p class="text-gray-300 leading-relaxed m-0"><strong>Pick Gold Standard if</strong> you want the lowest cost per gram, you are drug tested, or you drink a shake every day and buy big tubs. <strong>Pick Ghost if</strong> plain whey bloats you and you want added lactase, you avoid soy, or you want cereal-milk and Cinnabon-style flavors. <strong>Pick neither if</strong> you cannot have dairy at all: both are milk-based.</p>
          </div>
        </div>

        <div id="at-a-glance" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Compare Ghost and Optimum Nutrition at a Glance
          </h2>

          <p>
            The quickest way to choose is to start with what you would refuse to give up. The table below puts each powder against the buyer it suits and the buyer who should pass, alongside the two numbers we publish for every product in our database: the <a href='/methodology/'>Label Score</a> out of 100 and the cost per 25 g of protein.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Pick</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Skip it if</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Label Score</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/optimum-nutrition-gold-standard-whey/'>ON Gold Standard 100% Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Daily shakes on a budget, tested athletes, flavor variety</td>
                    <td class="px-4 py-4 text-gray-700">You avoid soy or buy only small tubs</td>
                    <td class="px-4 py-4 text-gray-700">78</td>
                    <td class="px-4 py-4 text-gray-700">About $1.44</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900"><a href='/protein-powder/ghost-whey/'>GHOST Whey</a></td>
                    <td class="px-4 py-4 text-gray-700">Dessert and cereal flavors, lactose-sensitive stomachs</td>
                    <td class="px-4 py-4 text-gray-700">You are drug tested or count every dollar</td>
                    <td class="px-4 py-4 text-gray-700">48</td>
                    <td class="px-4 py-4 text-gray-700">About $2.12</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            The 30-point gap in Label Score comes mostly from two places. Gold Standard packs more protein per gram of powder, and it holds a sport certification that Ghost Whey does not. Cost per 25 g also favours Gold Standard. Ghost loses a few further points for its gums and artificial flavor, which our <a href='/methodology/'>methodology</a> counts as additives. None of this says Ghost is unsafe; it says the Gold Standard label delivers more protein for the money with independent testing behind it.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. Which Ghost and Optimum Nutrition Products Are We Comparing?
          </h2>

          <p>
            Each brand sells several powders, so we compare the flagship whey from each: Ghost Whey and Gold Standard 100% Whey. Label figures are for Ghost Milk Chocolate and Gold Standard Double Rich Chocolate. Prices are the ones recorded in our database on 1 November 2026 (Ghost's own store and Target) and will move. Both cards link to the full label pages in our <a href='/protein-powder-comparison/'>protein powder comparison database</a>.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="spec-sheets" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. Spec Sheets Side by Side
          </h2>

          <p>
            Here are the full label figures for each powder, per the labels at the time of writing. Ghost's panel comes from the back-of-tub image on Ghost's product page for Milk Chocolate; Gold Standard's comes from Target's listing for the 3.96 lb Double Rich Chocolate tub. Both brands' numbers shift slightly by flavor.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Spec</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">GHOST Whey (Milk Chocolate)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">ON Gold Standard (Double Rich Chocolate)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">24 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Scoop size</td>
                    <td class="px-4 py-4 text-gray-700">35 g (1 rounded scoop)</td>
                    <td class="px-4 py-4 text-gray-700">31 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein by weight</td>
                    <td class="px-4 py-4 text-gray-700">71%</td>
                    <td class="px-4 py-4 text-gray-700">77%</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">130</td>
                    <td class="px-4 py-4 text-gray-700">120</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Carbohydrate</td>
                    <td class="px-4 py-4 text-gray-700">4 g</td>
                    <td class="px-4 py-4 text-gray-700">3 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sugar</td>
                    <td class="px-4 py-4 text-gray-700">2 g</td>
                    <td class="px-4 py-4 text-gray-700">1 g</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fat</td>
                    <td class="px-4 py-4 text-gray-700">1.5 g</td>
                    <td class="px-4 py-4 text-gray-700">1.5 g</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sodium</td>
                    <td class="px-4 py-4 text-gray-700">180 mg</td>
                    <td class="px-4 py-4 text-gray-700">130 mg</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein sources</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate, whey concentrate, hydrolyzed whey isolate</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate, whey concentrate, hydrolyzed whey</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweeteners</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose</td>
                    <td class="px-4 py-4 text-gray-700">Acesulfame potassium</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Allergens</td>
                    <td class="px-4 py-4 text-gray-700">Milk</td>
                    <td class="px-4 py-4 text-gray-700">Milk, soy (lecithin)</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Certification</td>
                    <td class="px-4 py-4 text-gray-700">None claimed or found</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport (Double Rich Chocolate, Vanilla Ice Cream)</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Servings</td>
                    <td class="px-4 py-4 text-gray-700">26 (2 lb)</td>
