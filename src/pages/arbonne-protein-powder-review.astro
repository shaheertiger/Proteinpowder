const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Arbonne Protein Powder Review",
          item: `${SITE_URL}/arbonne-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Arbonne third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Arbonne does not name NSF Certified for Sport, Informed Sport, Informed Choice or similar independent testing for its FeelFit or Simply1 protein shakes, and it does not publish batch lab results. The company is a Certified B Corporation and the shakes are listed as vegan and Non-GMO Project Verified, but those are sourcing and company-practice certifications, not contaminant or banned-substance testing."
          }
        },
        {
          "@type": "Question",
          "name": "Is Arbonne protein powder healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By ingredient list, it is cleaner than many shakes: no artificial colors, flavors or sweeteners, and formulated without gluten, dairy, soy or high fructose corn syrup, per Arbonne. Simply1 has under 1 g of sugar. The open questions are heavy metals, since Arbonne publishes no test data for its pea-based protein, and the price. Clean label does not mean independently tested."
          }
        },
        {
          "@type": "Question",
          "name": "Does Arbonne protein contain sugar or stevia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both, depending on the version. Simply1 is sweetened with stevia leaf extract only and has under 1 g of sugar per serving, per its label. The original FeelFit and the older Essentials Protein Shake Mix used cane sugar plus stevia, with reviewers reporting about 7 g of sugar a serving. If you avoid stevia entirely, neither current Arbonne shake will suit you."
          }
        },
        {
          "@type": "Question",
          "name": "Which Arbonne protein flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In the buyer and customer reviews we read, chocolate and coffee come up most often as favorites, with the original sugar-sweetened FeelFit described as better tasting than stevia-only Simply1. Vanilla is described as mild and best in smoothies with fruit. Strawberry is newer and has fewer reviews. This is buyer feedback, not our tasting; flavor preference with stevia varies a lot."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common complaints about Arbonne protein shakes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Price is the most common complaint by far: about $101 for 30 servings on Amazon, or roughly $4.21 per 25 g of protein. Buyers also mention a strong stevia aftertaste in Simply1, pressure from consultants to join autoship or the business, a thick texture if the shake sits, and occasional bloating in the first week, possibly from fiber or the probiotics."
          }
        },
        {
          "@type": "Question",
          "name": "Is Arbonne protein powder vegan and dairy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Arbonne describes its FeelFit and Simply1 shakes as vegan and formulated without dairy, gluten or soy, and product databases list them with vegan and Non-GMO Project marks. The protein comes from peas, cranberries and rice. Anyone with a severe allergy should still read the allergen statement on the bag, since facility and formula details can change between batches and regions."
          }
        },
        {
          "@type": "Question",
          "name": "Can I drink Arbonne protein shakes while pregnant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ask your doctor or midwife first. FeelFit shakes contain a full vitamin and mineral blend, and the original version adds probiotics, so they can overlap with a prenatal vitamin. Arbonne itself limits intake to two shakes a day. The same caution applies to anyone with kidney disease, food allergies or prescription medication: check the full label with a doctor or registered dietitian."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
