const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-16", modified: "2026-11-16" });
const title = "Arbonne Protein Powder Review: Ingredients, Testing and Cost";
const description =
  "No: Arbonne names no NSF or Informed Sport testing for its FeelFit shakes. Each has 20 g of vegan protein at about $4.21 per 25 g on Amazon. Label and swaps.";

const PRODUCTS: {
  id: string;
