  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "isopure-zero-carb",
    "name": "Isopure Zero Carb Protein Powder",
    "brand": "Isopure",
    "badge": "Best Overall for GLP-1",
