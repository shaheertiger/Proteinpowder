const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Protein Powder for GLP-1",
          item: `${SITE_URL}/best-protein-powder-for-glp-1/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best protein powder for GLP-1 users?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isopure Zero Carb is our top pick because it packs about 25 g of protein into roughly 100 calories with almost no fat, per the label, and mixes thin. Unjury Unflavored is best for stirring into food, and clear whey is often easiest on queasy days. Ask your prescriber or dietitian about your target first."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein should I eat on semaglutide or tirzepatide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 2025 joint advisory from four US nutrition and obesity societies suggests targets based on adjusted body weight, about 1.5 g per kilogram of fat-free mass, or an absolute target of roughly 80 to 120 g a day. Your needs depend on your size and health, so agree a number with your prescriber or a dietitian."
          }
        },
        {
          "@type": "Question",
          "name": "Do GLP-1 medications cause muscle loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some of the weight lost on any large weight loss is lean mass. In the STEP 1 semaglutide trial, a DXA substudy found about 38 percent of weight lost was lean mass, which includes water and organs as well as muscle. Adequate protein and regular strength training are the main ways to limit it."
          }
        },
        {
          "@type": "Question",
          "name": "Can protein shakes help with GLP-1 nausea?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can make it easier to keep protein up while nauseous, but they do not treat nausea. Very cold, thin drinks such as clear whey, sipped slowly, or small savory options are often easier than creamy shakes. Persistent vomiting, inability to keep fluids down or severe pain need prompt contact with your prescriber."
          }
        },
        {
          "@type": "Question",
          "name": "Is whey or plant protein better on a GLP-1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whey isolate is usually the most practical, with high protein per calorie, very little fat and lactose, and a thin texture. A single-ingredient pea isolate is a good dairy-free alternative, though it is thicker and earthier. Choose whichever your stomach tolerates best, and avoid sugar alcohols in either."
          }
        },
        {
          "@type": "Question",
          "name": "Should I drink protein shakes instead of meals on a GLP-1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no, unless your clinician has prescribed a structured meal replacement plan. Whole foods supply vitamins, minerals and fiber that shakes lack, and reduced intake already raises the risk of deficiencies. Most people do best with protein-focused small meals plus one or two shakes to close the gap."
          }
        },
        {
          "@type": "Question",
          "name": "Is it safe to take protein powder with Ozempic, Wegovy or Zepbound?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no known interaction between protein powder and these medications, and nutrition societies encourage adequate protein during treatment. People with kidney disease, diabetes on other medicines, pancreatitis history or pregnancy should check with their doctor first, and anyone with severe side effects should contact their prescriber."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Protein Powder",
    tags: [
      "best protein powder for glp 1",
      "protein powder for glp-1",
      "protein on semaglutide",
      "protein powder for ozempic",
      "glp-1 muscle loss"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Buyer's Guide"} badge={"Research-Checked"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Best Protein Powder for GLP-1</Fragment>
      Seven protein options for people on semaglutide, tirzepatide and similar medications, ranked on how much protein they deliver in a small, gentle serving.
    </ArticleHeader>

    <TableOfContents>
      <a href="#quick-comparison">Comparison Table</a>
      <a href="#how-we-picked">How We Picked</a>
      <a href="#top-picks">Our Top Picks</a>
      <a href="#why-protein-matters">Why Protein Matters</a>
      <a href="#how-much-protein">How Much Protein</a>
      <a href="#what-to-look-for">What to Look For</a>
      <a href="#nausea-friendly">Nausea-Friendly Protein</a>
      <a href="#strength-training">Strength Training</a>
      <a href="#safety">Safety & Food First</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          The best protein powder for GLP-1 users is a dense, low-fat whey isolate that delivers a lot of protein in a small, thin drink, and Isopure Zero Carb does that best, with about 25 g of protein for roughly 100 calories per the label. When appetite is low and nausea comes and goes, format matters as much as the label: Unjury stirs into food, clear whey is easier on queasy days, and savory broth helps when sweet stops appealing. Protein needs on these medications are real, so we also summarize what the 2025 joint nutrition advisory says. This is not medical advice; your prescriber or dietitian sets your targets.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="quick-comparison" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. GLP-1 Protein Options Compared
          </h2>

          <p>
            The short version first. These are the seven products we rank, with the label numbers that matter when your appetite is small. Price tier reflects cost per 25 g of protein at typical retail prices when we checked: budget, mid or premium. All figures come from each brand's label at the time of writing and vary by flavor.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein / scoop</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sugar</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Price tier</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Certification</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Isopure Zero Carb</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 100</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Unjury Unflavored</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">About 90</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">None listed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Myprotein Clear Whey Isolate</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">About 80-90</td>
                    <td class="px-4 py-4 text-gray-700">Low (check flavor)</td>
                    <td class="px-4 py-4 text-gray-700">Mid</td>
                    <td class="px-4 py-4 text-gray-700">Check database</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Unjury Chicken Soup</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">About 90</td>
                    <td class="px-4 py-4 text-gray-700">0 g</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">None listed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Dymatize ISO100</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 110-120</td>
                    <td class="px-4 py-4 text-gray-700">About 1 g</td>
                    <td class="px-4 py-4 text-gray-700">Mid to premium</td>
                    <td class="px-4 py-4 text-gray-700">Informed Choice</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Fairlife Nutrition Plan (bottle)</td>
                    <td class="px-4 py-4 text-gray-700">About 30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 150</td>
                    <td class="px-4 py-4 text-gray-700">About 2 g</td>
                    <td class="px-4 py-4 text-gray-700">Premium</td>
                    <td class="px-4 py-4 text-gray-700">None confirmed</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Naked Pea (unflavored)</td>
                    <td class="px-4 py-4 text-gray-700">27 g</td>
                    <td class="px-4 py-4 text-gray-700">About 120</td>
                    <td class="px-4 py-4 text-gray-700">About 2 g</td>
                    <td class="px-4 py-4 text-gray-700">Budget</td>
                    <td class="px-4 py-4 text-gray-700">NSF Contents Certified (per brand)</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Every product here delivers at least about 20 g of protein per 100 calories, with little fat and little or no sugar. That combination matters on a GLP-1 medication such as semaglutide or tirzepatide, where appetite is reduced and every bite has to work harder. Isopure Zero Carb is our overall pick because it packs about 25 g of protein into a small, thin shake. Unjury is best for stirring protein into food, clear whey and savory Unjury are best on queasy days, and Naked Pea is the dairy-free option.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">NOT MEDICAL ADVICE</p>
            <p class="text-xl font-bold text-white mb-3">Your prescriber and dietitian set your targets.</p>
            <p class="text-gray-300 leading-relaxed m-0">This guide compares products and summarizes published research. It does not replace advice from the clinician managing your medication. If you have kidney disease, diabetes, a history of pancreatitis, are pregnant or have severe side effects, agree your protein plan with your doctor or a registered dietitian first.</p>
          </div>
        </div>

        <div id="how-we-picked" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. How We Picked the Best Protein Powder for GLP-1
          </h2>

          <p>
            This ranking is built on label analysis, certification status and published research, not a clinical trial or a hands-on taste test. We did not drink every product, and where we mention taste, texture or tolerance we are reporting what buyers commonly say. Our general approach is on our <a href="/how-we-test/">how we test</a> page. For this guide, we weighted the criteria around the specific problems people describe on GLP-1 medications.
          </p>

          <p>
            Protein density came first: grams of protein per serving and per 100 calories, because a suppressed appetite leaves little room. Second was volume and texture, meaning whether a product can be taken in a small amount of liquid or stirred into food rather than demanding a large, thick shake. Third was gut tolerance on paper: low fat, low lactose, and no sugar alcohols such as erythritol or maltitol, which commonly cause bloating and loose stools and can pile on top of medication side effects.
          </p>

          <p>
            Fourth was variety of format, because many people find that what they can tolerate changes week to week, especially around dose increases. A clear drink, a savory broth and an unflavored powder that hides in food solve different problems. Finally, we looked for independent testing such as Informed Choice or NSF certification, and say clearly where we could not confirm any. Anyone taking a product every day for months benefits from that assurance.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Best Protein Powders for GLP-1 Users, Ranked
