const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-01", modified: "2026-11-01" });
const title = "Best Protein Powder for GLP-1: Small, Dense, Gentle Picks";
const description =
  "The best protein powder for GLP-1 users, ranked on protein per small serving, fat, sugar alcohols and nausea-friendly formats, with what the 2025 advisory says.";

const PRODUCTS: {
