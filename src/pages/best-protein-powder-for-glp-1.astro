    ],
    "bottomLine": "The pick for nauseous days, when the idea of a creamy shake is the problem.",
    "specs": {
      "Protein / serving": "About 20 g (label)",
      "Calories": "About 80-90",
      "Third-party tested": "Check certifier database",
      "Best for": "Nausea, hot days"
    }
  },
  {
    "id": "unjury-chicken-soup-high-whey-protein",
    "name": "Unjury Chicken Soup High Whey Protein Powder",
    "brand": "Unjury",
    "badge": "Best Savory Option",
