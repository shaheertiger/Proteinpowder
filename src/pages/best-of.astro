---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, SITE_URL } from '../data/site';

// Every published guide, by category. The daily publishing run adds a row here
// for each new page (see .claude/skills/daily-publish/SKILL.md). Category ids are
// the anchors the home page category tiles link to.
const categories = [
  {
    name: 'Protein Powder Rankings',
    id: 'rankings',
    guides: [
      { title: 'Best Protein Powder', description: 'Our overall picks by goal and budget — ranked on protein per scoop, cost per 25 g of protein, ingredients and third-party testing.', badge: '#1 Guide', url: '/best-protein-powder/' },
      { title: 'Protein Powder Comparison', description: 'The best-known powders side by side: protein per scoop, serving size, sweeteners and certification in one table.', badge: 'Comparison', url: '/protein-powder-comparison/' },
      { title: 'Protein Powder Brands', description: 'The major brands, what each is known for, their flagship powders and how seriously they take testing.', badge: 'Brand Guide', url: '/protein-powder-brands/' },
      { title: 'Best Tasting Protein Powder', description: 'The vanilla, chocolate and plant powders buyers rate highest for flavor — and how to make any powder taste better.', badge: "Buyer's Guide", url: '/best-tasting-protein-powder/' },
      { title: 'Best Unflavored Protein Powder', description: 'Sweetener-free powders for cooking, baking, coffee and smoothies, with the shortest ingredient lists.', badge: "Buyer's Guide", url: '/best-unflavored-protein-powder/' },
      { title: 'Best Protein Powder for Smoothies', description: 'Powders that blend smoothly, suit fruit and keep the calorie math sensible.', badge: "Buyer's Guide", url: '/best-protein-powder-for-smoothies/' },
      { title: 'Best Protein Drink', description: 'Ready-to-drink protein shakes compared on protein per bottle, sugar, sweeteners and cost against powder.', badge: "Buyer's Guide", url: '/best-protein-drink/' },
      { title: 'Best Cheap Protein Powder', description: 'The best cheap protein powders ranked on cost per 25 g of protein, plus how to spot amino spiking and underdosed blends that make a low price a false economy.', badge: "Buyer's Guide", url: '/best-cheap-protein-powder/' },
      { title: 'Highest Protein Powder', description: 'The highest protein powders ranked by protein per scoop, per calorie and by weight, with why oversized scoops inflate the headline number and how isolate compares.', badge: "Buyer's Guide", url: '/best-high-protein-powder/' },
      { title: 'Best Optimum Nutrition Protein Powder', description: 'Every main Optimum Nutrition protein powder matched to a goal, from Gold Standard Whey and Isolate to Hydrowhey, Casein, Plant, Pro Gainer and Serious Mass.', badge: "Buyer's Guide", url: '/best-optimum-nutrition-protein-powder/' },
      { title: 'Best Casein Protein Powder', description: 'The best casein protein powders, ranked on label and certification, with micellar vs calcium caseinate explained and what pre-sleep protein research shows.', badge: "Buyer's Guide", url: '/best-casein-protein-powder/' },
      { title: 'Best Collagen Protein Powder', description: 'The best collagen peptides, ranked on label and testing, plus why collagen is an incomplete protein, what skin and joint studies show, and when to buy whey.', badge: "Buyer's Guide", url: '/best-collagen-protein-powder/' },
      { title: 'Best Egg White Protein Powder', description: 'The best egg white protein powders, ranked on label analysis, with how egg protein compares with whey on leucine, how it bakes, and who should avoid it.', badge: "Buyer's Guide", url: '/best-egg-white-protein-powder/' },
      { title: 'Best Beef Protein Powder', description: 'The best beef protein powders, ranked on label analysis, with a candid look at beef isolate\'s collagen-heavy amino acid profile, added aminos and who it suits.', badge: "Buyer's Guide", url: '/best-beef-protein-powder/' },
      { title: 'Best Meal Replacement Protein Powder', description: 'The best meal replacement protein powders, judged on calories, protein, fiber, fat and vitamins, plus why a protein shake is not a meal and when to use one.', badge: "Buyer's Guide", url: '/best-meal-replacement-protein-powder/' },
      { title: 'Best Protein Powder for Coffee', description: 'The best protein powders for coffee, hot or iced, with why whey clumps in a hot mug, when collagen is the better choice and the mixing method that actually works.', badge: "Buyer's Guide", url: '/best-protein-powder-for-coffee/' },
      { title: 'Best Protein Powder for Baking', description: 'The best protein powder for baking, judged on how it behaves in the oven: whey-casein blends, casein and plant powders, plus substitution ratios that work.', badge: "Buyer's Guide", url: '/best-protein-powder-for-baking/' },
      { title: 'Best Protein Powder for Ninja Creami', description: 'The best protein powder for Ninja Creami pints: why casein and blends freeze thicker than whey, how xanthan and pudding mix help, and how to fix icy results.', badge: "Buyer's Guide", url: '/best-protein-powder-for-ninja-creami/' },
    ],
  },
  {
    name: 'By Goal',
    id: 'goals',
    guides: [
      { title: 'Best Protein Powder for Muscle Gain', description: 'What actually drives muscle growth, the dose per shake that matters, and the powders worth using to get there.', badge: "Buyer's Guide", url: '/best-protein-powder-for-muscle-gain/' },
      { title: 'Do Protein Supplements Build Muscle?', description: 'What the research shows supplements add, who benefits, and when a shake does nothing at all.', badge: 'Evidence', url: '/do-protein-supplements-build-muscle/' },
      { title: 'Best Protein Powder for Weight Loss', description: 'Protein per calorie, satiety and keeping muscle in a deficit — the powders that fit a cut.', badge: "Buyer's Guide", url: '/best-protein-powder-for-weight-loss/' },
      { title: 'Best Protein Powder for Weight Gain', description: 'Mass gainers against whey plus real food — calories, sugar load and cost per 1,000 kcal.', badge: "Buyer's Guide", url: '/best-protein-powder-for-weight-gain/' },
      { title: 'Best Protein Powder for Women', description: 'Why "women\'s protein" is mostly marketing, and the criteria that actually matter when you choose.', badge: "Buyer's Guide", url: '/best-protein-powder-for-women/' },
      { title: 'Best Protein Powder for Men', description: 'Bigger bodies, bigger doses — and why testosterone add-ins are not worth paying for.', badge: "Buyer's Guide", url: '/best-protein-powder-for-men/' },
      { title: 'Best Protein Powders for Athletes', description: 'The best protein powders for athletes, led by NSF Certified for Sport and Informed Sport picks, with ISSN dosing and how needs differ for strength and endurance.', badge: "Buyer's Guide", url: '/best-protein-powder-for-athletes/' },
      { title: 'Best Low Carb Protein Powder', description: 'The best low carb and keto protein powders, ranked by net carbs per scoop, with how isolates, concentrates and sugar alcohols change the numbers on the label.', badge: "Buyer's Guide", url: '/best-low-carb-protein-powder/' },
      { title: 'Best Protein Powder for GLP-1 Users', description: 'Protein shakes and powders for people on Ozempic, Wegovy, Zepbound and other GLP-1 drugs: small servings, gentle on nausea, with protein targets and safety notes.', badge: "Buyer's Guide", url: '/best-protein-powder-for-glp-1/' },
      { title: 'Best Protein Powder for Diabetics', description: 'Protein powders and shakes for diabetes, chosen for low sugar and carbs, with what the whey-before-meals research shows and when to check with your care team.', badge: "Buyer's Guide", url: '/best-protein-powder-for-diabetics/' },
      { title: 'Best Protein Powder for Seniors', description: 'Protein powders and shakes for older adults, chosen for per-meal dose, leucine and ease of use, with PROT-AGE and ESPEN targets and kidney and medication cautions.', badge: "Buyer's Guide", url: '/best-protein-powder-for-seniors/' },
      { title: 'Best Protein Powder for Women Over 50', description: 'The best protein powder for women over 50, picked for a full 25-30 g dose per meal, plus how menopause changes muscle and bone and why lifting matters as much as protein.', badge: "Buyer's Guide", url: '/best-protein-powder-for-women-over-50/' },
      { title: 'Best Protein Powder for Pregnancy', description: 'The best protein powder for pregnancy, chosen on third-party contaminant screening and short labels, plus how much protein you need and what to ask your OB first.', badge: "Buyer's Guide", url: '/best-protein-powder-for-pregnancy/' },
      { title: 'Best Protein Powder for Teens', description: 'The best protein powder for teens, limited to NSF and Informed Choice certified picks with no stimulants, plus when a teen actually needs one and when food is enough.', badge: "Buyer's Guide", url: '/best-protein-powder-for-teens/' },
    ],
  },
  {
    name: 'Whey Protein',
    id: 'whey',
    guides: [
      { title: 'Best Whey Protein Isolate', description: 'The leanest, lowest-lactose whey powders compared on protein per scoop, cost per gram and certification.', badge: "Buyer's Guide", url: '/best-whey-protein-isolate/' },
      { title: 'Best Whey Protein Powder', description: 'Concentrate, blends, isolate and hydrolysate ranked on value, lactose and cost per 25 g of protein.', badge: "Buyer's Guide", url: '/best-whey-protein-powder/' },
      { title: 'Best Clear Protein Powder', description: 'Juice-like clear whey isolates: what they are, when they beat a milkshake-style powder, and the trade-offs.', badge: "Buyer's Guide", url: '/best-clear-protein-powder/' },
      { title: 'Whey vs Whey Isolate', description: 'What the extra filtering removes, what it costs per 25 g of protein, and who actually needs isolate.', badge: 'Comparison', url: '/whey-vs-whey-isolate/' },
    ],
  },
  {
    name: 'Plant Protein',
    id: 'plant',
    guides: [
      { title: 'Best Plant-Based Protein Powder', description: 'Pea, soy and blended vegan powders ranked on amino acid profile, protein per scoop, heavy-metal testing and value.', badge: "Buyer's Guide", url: '/best-plant-based-protein-powder/' },
      { title: 'Best Pea Protein Powder', description: 'Single-source pea isolates compared on amino acids, digestibility, heavy-metal testing and texture.', badge: "Buyer's Guide", url: '/best-pea-protein-powder/' },
      { title: 'Whey vs Plant Protein', description: 'Leucine, digestibility, muscle-building evidence, digestion and cost — which one suits you.', badge: 'Comparison', url: '/whey-vs-plant-protein/' },
      { title: 'Best Dairy-Free Protein Powder', description: 'The best dairy-free protein powders, from plant blends to egg white and beef isolate, and why lactose-free whey is not safe for anyone with a milk allergy.', badge: "Buyer's Guide", url: '/best-dairy-free-protein-powder/' },
    ],
  },
  {
    name: 'Protein Basics',
    id: 'basics',
    guides: [
      { title: 'Protein Calculator', description: 'Your daily target in grams, per meal, and how many scoops it takes to close the gap.', badge: 'Tool', url: '/protein-calculator/' },
      { title: 'How Much Protein Do I Need?', description: 'Grams per kilo by goal, per-meal targets, and when the RDA is not enough.', badge: 'Guide', url: '/how-much-protein-do-i-need/' },
      { title: 'When to Take Protein Powder', description: 'The anabolic window, before bed, morning or post-workout — what the research actually supports.', badge: 'Guide', url: '/when-to-take-protein-powder/' },
      { title: 'Best Type of Protein Powder', description: 'Whey concentrate, isolate, hydrolysate, casein, egg, beef, soy, pea, rice, blends and collagen explained, with a decision table by goal, budget and diet.', badge: "Guide", url: '/types-of-protein-powder/' },
      { title: 'Highest Quality Protein', description: 'What makes a protein high quality, how PDCAAS and DIAAS scores work, and how whey, milk, egg, soy, pea and collagen rank for amino acids and digestibility.', badge: "Evidence", url: '/highest-quality-protein/' },
      { title: 'Muscle Protein Synthesis Supplements', description: 'What actually raises muscle protein synthesis: the leucine threshold, protein per meal, whey vs EAAs vs BCAAs, and what creatine and HMB really do for muscle.', badge: "Evidence", url: '/muscle-protein-synthesis-supplements/' },
    ],
  },
  {
    name: 'Safety & Labels',
    id: 'safety',
    guides: [
      { title: 'Best Clean Protein Powder', description: '"Clean" is unregulated — so we rank on checkable criteria: certification, heavy-metal testing, short labels, organic status.', badge: "Buyer's Guide", url: '/best-clean-protein-powder/' },
      { title: 'Is Protein Powder Safe?', description: 'Heavy metals, label accuracy, banned substances, and who should talk to a doctor first.', badge: 'Safety', url: '/is-protein-powder-safe/' },
      { title: 'What Is in Protein Powder? How to Read the Label, Line by Line', description: 'What is in protein powder? A line-by-line walk through a real label: protein sources, blends, amino spiking, sweeteners, gums, flavors and real red flags.', badge: "Labels", url: '/what-is-in-protein-powder/' },
      { title: 'Best Protein Powder for Sensitive Stomach', description: 'The best protein powders for a sensitive stomach, chosen for low lactose and short labels, plus the five ingredients most likely to cause bloating and gas.', badge: "Buyer's Guide", url: '/best-protein-powder-for-sensitive-stomach/' },
      { title: 'Best Gluten-Free Protein Powder', description: 'The best gluten-free protein powders, with certified options for celiac disease, what the FDA 20 ppm label really means, and the oat and malt ingredients to watch.', badge: "Buyer's Guide", url: '/best-gluten-free-protein-powder/' },
    ],
  },
];

const allGuides = categories.flatMap(c => c.guides);
const pageDescription = 'Every protein powder guide we publish: rankings, whey and plant comparisons, intake and timing, and label safety. Independent, no paid placements.';

const bestOfSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Best Lists', item: `${SITE_URL}/best-of/` },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: `All Protein Powder Guides | ${SITE_NAME}`,
      description: pageDescription,
      url: `${SITE_URL}/best-of/`,
    },
    {
      '@type': 'ItemList',
      name: `All Protein Powder Guides | ${SITE_NAME}`,
      description: pageDescription,
      itemListElement: allGuides.map((guide, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'Article',
          name: guide.title,
          description: guide.description,
          url: `${SITE_URL}${guide.url}`,
        },
      })),
    },
  ],
};
---
<Layout
  title="All Protein Powder Guides"
  description={pageDescription}
  jsonLd={bestOfSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <header class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-50 text-yellow-700 text-sm font-black uppercase tracking-widest border border-yellow-200 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
        Updated Regularly
      </div>
      <h1 class="text-4xl lg:text-7xl font-black text-[#333333] mb-6 tracking-tight">
        All <span class="text-[#1E90FF]">Protein Powder</span> Guides
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-8">
        {allGuides.length} guides covering whey, isolate and plant protein, how much you need, when to take it, and how to tell a safe tub from a risky one. No sponsored picks.
      </p>

      <!-- Quick Navigation -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {categories.map(cat => (
          <a href={`#${cat.id}`} class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-bold text-gray-700 hover:bg-[#1E90FF] hover:text-white hover:border-[#1E90FF] transition-colors no-underline">
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Methodology -->
      <div class="max-w-3xl mx-auto bg-gray-50 border border-gray-200 rounded-2xl p-6 text-left">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-[#1E90FF]/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm mb-1">How We Pick</p>
            <p class="text-gray-600 text-sm leading-relaxed">
              Every powder is judged on its full nutrition panel, its cost per 25 g of protein, its ingredient list and its third-party certification — not on the claims on the front of the tub. <a href="/how-we-test/" class="text-[#1E90FF] font-bold no-underline hover:underline">Read our full process</a>.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Categorized Guides -->
    {categories.map(category => (
      <section id={category.id} class="mb-16 scroll-mt-24">
        <h2 class="text-2xl lg:text-3xl font-black text-[#333333] mb-8 pb-4 border-b-2 border-gray-200">
          {category.name}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {category.guides.map(guide => (
            <a
              href={guide.url}
              class="block bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-[#1E90FF]/30 transition-all group no-underline"
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="bg-[#FF4500]/10 text-[#FF4500] px-2.5 py-0.5 rounded-full text-xs font-black uppercase">
                  {guide.badge}
                </span>
              </div>
              <h3 class="text-lg font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-2">
                {guide.title}
              </h3>
              <p class="text-gray-500 text-sm mb-4 leading-relaxed">{guide.description}</p>
              <div class="flex items-center gap-1 text-[#1E90FF] text-sm font-bold">
                Read Guide
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- ========== WHY TRUST OUR PICKS ========== -->
    <section class="mt-8 mb-8">
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl overflow-hidden">
        <div class="p-10 lg:p-14">
          <h2 class="text-3xl font-black text-white mb-6">Why Trust Our Guides?</h2>
          <p class="text-gray-400 leading-relaxed mb-6">
            Every powder is scored on the same five questions:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">1</span>
              <p class="font-bold text-white text-sm">Protein Quality (30%)</p>
              <p class="text-gray-400 text-xs">Protein per scoop, share of the scoop, amino acid profile, no spiking.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">2</span>
              <p class="font-bold text-white text-sm">Verification (25%)</p>
              <p class="text-gray-400 text-xs">Third-party certification and published testing for contaminants.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">3</span>
              <p class="font-bold text-white text-sm">Value (20%)</p>
              <p class="text-gray-400 text-xs">Cost per 25 g of protein at typical retail prices.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">4</span>
              <p class="font-bold text-white text-sm">Ingredients (15%)</p>
              <p class="text-gray-400 text-xs">Sweeteners, added sugar, fillers and common gut irritants.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">5</span>
              <p class="font-bold text-white text-sm">Buyer Feedback (10%)</p>
              <p class="text-gray-400 text-xs">Recurring complaints about taste, mixing and digestion.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
