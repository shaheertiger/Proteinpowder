      // affiliate-batch:start
      { title: "Best Bone Broth Protein Powder", description: "The best bone broth protein powders ranked on protein per scoop, sourcing and cost per 25 g, plus why broth protein is mostly collagen and when whey is better.", badge: "Buyer's Guide", url: '/best-bone-broth-protein-powder/' },
      { title: "Best Collagen Protein Powder", description: "The best collagen protein powders ranked on dose, certification and cost, plus why collagen lacks tryptophan and how it really compares with whey for muscle.", badge: "Buyer's Guide", url: '/best-collagen-protein-powder/' },
      { title: "Best Organic Protein Powder", description: "The best organic protein powder picks, from organic whey to pea and hemp, checked for the USDA seal, protein per scoop, sweeteners, testing and cost per 25 g.", badge: "Buyer's Guide", url: '/best-organic-protein-powder/' },
      { title: "Best Casein Protein Powder", description: "The best casein protein powder picks, all micellar, ranked on protein per scoop, testing and cost per 25 g, plus what the bedtime casein research really shows.", badge: "Buyer's Guide", url: '/best-casein-protein-powder/' },
      { title: "Best Beef Protein Powder", description: "Best beef protein powder picks, label-checked on protein per scoop, collagen content, leucine, lead testing and cost per 25 g, plus when whey is the better buy.", badge: "Buyer's Guide", url: '/best-beef-protein-powder/' },
      // affiliate-batch:end
    ],
  },
  {
    name: 'Brand Reviews',
    id: 'brands',
    guides: [
      // affiliate-batch:start
      { title: "Myprotein Review", description: "Is Myprotein any good? Impact Whey, Impact Whey Isolate and Clear Whey compared on label protein, scoop size, testing, cost per 25 g and US Amazon availability.", badge: "Brand Review", url: '/myprotein-review/' },
      { title: "MuscleBlaze Review", description: "Is MuscleBlaze any good? Biozyme, Whey Gold and Raw Whey compared on label protein, testing claims and cost per 25 g, plus where it is sold and US alternatives.", badge: "Brand Review", url: '/muscleblaze-protein-review/' },
      { title: "Orgain Protein Powder Review", description: "Orgain protein powder from the label: the 21 g organic plant tub, the 30 g vegan, grass-fed whey and Simple compared on protein, sweeteners, lead and cost.", badge: "Brand Review", url: '/orgain-protein-powder-review/' },
      { title: "Isopure Protein Powder Review", description: "Isopure protein powder from the label: Zero Carb, Low Carb, Unflavored and Clear compared on protein, calories, sweeteners, testing and cost per 25 g.", badge: "Brand Review", url: '/isopure-protein-powder-review/' },
      { title: "Equip Protein Powder Review", description: "Equip Prime Protein from the label: 21 g of grass-fed beef protein, the flavors and sweeteners, the Consumer Reports lead result, and the real cost per 25 g.", badge: "Brand Review", url: '/equip-protein-powder-review/' },
      { title: "FlavCity Protein Powder Review", description: "FlavCity protein powder from the label: grass-fed whey, 10 g collagen, stevia and mushrooms, the plant-based version, the Prop 65 note and cost per 25 g.", badge: "Brand Review", url: '/flavcity-protein-powder-review/' },
      { title: "Clean Simple Eats Protein Review", description: "Clean Simple Eats protein powder reviewed on the label: 20 g of grass-fed whey isolate, stevia, the new formula, the smaller tubs and the real cost per 25 g.", badge: "Brand Review", url: '/clean-simple-eats-protein-powder-review/' },
      { title: "Ryse Protein Review", description: "Ryse protein powder reviewed on the label: Loaded Protein's 25 g whey blend, the Clear whey isolate, the sweeteners, the licensed flavors and the cost per 25 g.", badge: "Brand Review", url: '/ryse-protein-powder-review/' },
      { title: "Just Ingredients Protein Review", description: "Just Ingredients protein powder reviewed on the label: 22 g from whey, pea, chia and collagen, stevia and monk fruit, heavy-metal questions and cost per 25 g.", badge: "Brand Review", url: '/just-ingredients-protein-powder-review/' },
      { title: "Truvani Protein Review", description: "Truvani protein powder reviewed on the label: the organic pea-based flagship, the new organic whey, monk fruit, heavy-metal reports and the cost per 25 g.", badge: "Brand Review", url: '/truvani-protein-powder-review/' },
      { title: "Ka'Chava Review", description: "Our Ka'Chava review reads the label, not the hype: 25 g of plant protein, 240 calories, about $4 to $4.70 a shake, and who should buy cheaper protein instead.", badge: "Brand Review", url: '/kachava-review/' },
      { title: "Premier Protein Powder Review", description: "Premier Protein powder gives 30 g of whey for about 150 calories per the label. We price it per 25 g, compare it with the shakes and say who should buy it.", badge: "Brand Review", url: '/premier-protein-powder-review/' },
      { title: "Ghost Protein Powder Review", description: "Ghost Whey, Clear Whey and Vegan V2 compared on the label: protein per scoop, sweeteners, testing status and cost per 25 g, plus which Ghost flavors to buy.", badge: "Brand Review", url: '/ghost-protein-powder-review/' },
      { title: "Optimum Nutrition Review", description: "ON protein powder reviewed tub by tub: Gold Standard Whey, Isolate, Platinum Hydrowhey, Casein and Plant, compared on label, testing and cost per 25 g.", badge: "Brand Review", url: '/optimum-nutrition-protein-powder-review/' },
      { title: "SEEQ Protein Powder Review", description: "SEEQ protein powder review: the clear whey isolate's 22 g label, sweeteners, missing certification and cost per 25 g, plus who should buy a cheaper alternative.", badge: "Brand Review", url: '/seeq-protein-powder-review/' },
      { title: "Huel Protein Powder Review", description: "Huel protein powder review: Complete Protein vs Black Edition label-checked, cost per 25 g, sweeteners and testing, and who should buy a plain protein instead.", badge: "Brand Review", url: '/huel-protein-powder-review/' },
      { title: "Levels Protein Powder Review", description: "Levels protein powder review: grass-fed whey and micellar casein label-checked, monk fruit, testing gaps and cost per 25 g against Naked and Transparent Labs.", badge: "Brand Review", url: '/levels-protein-powder-review/' },
      { title: "Garden of Life Protein Powder Review", description: "Garden of Life protein powder review: Sport and Raw Organic label-checked, which NSF badge means sport testing, and cost per 25 g against Vega and Naked Pea.", badge: "Brand Review", url: '/garden-of-life-protein-powder-review/' },
      { title: "Vega Protein Powder Review", description: "Vega protein powder reviewed by label: what Sport Premium became, which of the four tubs to buy, NSF status, sweeteners and real cost per 25 g of protein.", badge: "Brand Review", url: '/vega-protein-powder-review/' },
      { title: "Transparent Labs Protein Review", description: "Transparent Labs protein reviewed by label: 28 g grass-fed whey isolate, Informed Choice status, the rest of the range, and what it really costs per 25 g.", badge: "Brand Review", url: '/transparent-labs-protein-powder-review/' },
      { title: "Ascent Protein Powder Review", description: "Ascent protein reviewed by label: what native whey means on today's tub, why the casein is the standout, Informed Sport status and the real cost per 25 g.", badge: "Brand Review", url: '/ascent-protein-powder-review/' },
      { title: "Naked Nutrition Protein Review", description: "Naked Nutrition protein reviewed by label: Naked Whey vs the isolate, Naked Pea and Casein, what NSF Contents Certified covers, and cost per 25 g of protein.", badge: "Brand Review", url: '/naked-nutrition-protein-powder-review/' },
      { title: "Momentous Protein Powder Review", description: "Momentous whey isolate, plant protein and Recovery checked label by label: NSF certification, cost per 25 g of protein, which tub to buy and who should skip it.", badge: "Brand Review", url: '/momentous-protein-powder-review/' },
      { title: "Legion Protein Powder Review", description: "Legion Whey+, Casein+, Plant+ and whey concentrate compared on protein per scoop, Labdoor testing and cost per 25 g of protein, and who should shop elsewhere.", badge: "Brand Review", url: '/legion-protein-powder-review/' },
      { title: "Jocko Protein Powder Review", description: "Jocko Fuel Molk protein powder, shakes, Clear Isolate and Plant-Based Protein checked on protein per scoop, sweeteners, testing and cost per 25 g of protein.", badge: "Brand Review", url: '/jocko-protein-powder-review/' },
      { title: "OWYN Protein Powder Review", description: "OWYN Pro Elite and original plant protein powders and shakes checked on protein, sugar, allergen claims and cost per 25 g of protein, with who should buy which.", badge: "Brand Review", url: '/owyn-protein-powder-review/' },
      { title: "Muscle Milk Protein Powder Review", description: "Muscle Milk protein powder, label by label: Pro Series, Genuine, 100% Whey and Zero compared on protein per scoop, calories, sweeteners and cost per 25 g.", badge: "Brand Review", url: '/muscle-milk-protein-powder-review/' },
      { title: "Sunwarrior Protein Powder Review", description: "Sunwarrior protein powder reviewed from the label: Warrior Blend, Active, Classic and Classic Plus compared on protein per scoop, testing and cost per 25 g.", badge: "Brand Review", url: '/sunwarrior-protein-powder-review/' },
      { title: "Dymatize Protein Powder Review", description: "Dymatize protein powder from the label: ISO100, Elite 100% Whey, Elite Casein and Super Mass Gainer compared on protein, calories, testing and cost per 25 g.", badge: "Brand Review", url: '/dymatize-protein-powder-review/' },
      { title: "Pure Protein Powder Review", description: "Pure Protein 100% Whey reviewed from the label: protein per scoop, calories, sweeteners and cost per 25 g, plus how its shakes, bars and cheaper rivals compare.", badge: "Brand Review", url: '/pure-protein-powder-review/' },
      { title: "Bloom Protein Powder Review", description: "Bloom's Whey Isolate and new Clear Protein checked against the label: protein per scoop, the collagen catch, sweeteners, cost per 25 g and better-value picks.", badge: "Brand Review", url: '/bloom-protein-powder-review/' },
      { title: "Thorne Protein Powder Review", description: "Thorne's whey isolate, plant protein, Collagen Fit and RecoveryPro checked label by label: what NSF certification buys, cost per 25 g, and who should skip it.", badge: "Brand Review", url: '/thorne-protein-powder-review/' },
      { title: "Devotion Protein Powder Review", description: "Devotion Nutrition's whey-casein protein checked by label: 20 g per scoop, why it bakes well, which flavor to buy, cost per 25 g, and who should skip it.", badge: "Brand Review", url: '/devotion-protein-powder-review/' },
      { title: "PEScience Protein Powder Review", description: "PEScience Select Protein and Select Vegan checked by label: 24 g per scoop, the casein-whey formula, which flavor to start with and cost per 25 g of protein.", badge: "Brand Review", url: '/pescience-protein-powder-review/' },
      { title: "Puori Protein Powder Review", description: "Our Puori PW1 review checks the label, the Clean Label Project testing and cost per 25 g of protein, and says which flavor to buy and who should skip it.", badge: "Brand Review", url: '/puori-protein-powder-review/' },
      { title: "CBUM Protein Powder Review", description: "Our CBUM Itholate review reads the RAW Nutrition label, flavor by flavor, checks testing and cost per 25 g, and says which RAW protein to buy or skip.", badge: "Brand Review", url: '/cbum-protein-powder-review/' },
      { title: "Quest Protein Powder Review", description: "Our Quest protein powder review compares each flavor on protein per calorie and cost per 25 g, and says which tub suits weight loss and who should skip it.", badge: "Brand Review", url: '/quest-protein-powder-review/' },
      { title: "Unjury Protein Powder Review", description: "Our Unjury review reads each whey label, from Chocolate to Chicken Soup, compares cost per 25 g, and explains what bariatric patients should check first.", badge: "Brand Review", url: '/unjury-protein-powder-review/' },
      { title: "Paleovalley Bone Broth Protein Review", description: "Paleovalley Bone Broth Protein reviewed from the label: 13 g scoops, grass-fed beef bones, monk fruit flavors, cost per 25 g and who should buy whey instead.", badge: "Brand Review", url: '/paleovalley-bone-broth-protein-review/' },
      { title: "Ballerina Farm Protein Powder Review", description: "Ballerina Farm Farmer Protein reviewed from the label: grass-fed whey, collagen, colostrum and hemp, stevia and monk fruit, cost per 25 g and who should skip.", badge: "Brand Review", url: '/ballerina-farm-protein-powder-review/' },
      { title: "Happy Viking Protein Powder Review", description: "Happy Viking reviewed from the label: 30 g pea and rice protein, 10 g fiber, cane sugar and ashwagandha, the old 20 g packs to avoid and the real cost per 25 g.", badge: "Brand Review", url: '/happy-viking-protein-powder-review/' },
      { title: "GNC Protein Powder Review", description: "GNC protein powder reviewed from the label: AMP Wheybolic's 40 g two-scoop serving, Ripped and the bottled shake, cost per 25 g and when ON or ISO100 wins.", badge: "Brand Review", url: '/gnc-protein-powder-review/' },
      { title: "Ritual Protein Review", description: "Ritual protein powder reviewed on the label: the 20 g pea Daily Shake, the pregnancy version, its sweeteners, its testing claims and the real cost per 25 g.", badge: "Brand Review", url: '/ritual-protein-powder-review/' },
      { title: "Oath Protein Review", description: "Oath Nutrition reviewed on the label: the 20 g Clear Whey Isolate, the 25 g Whey Protein, sweeteners, what the testing claims cover and the real cost per 25 g.", badge: "Brand Review", url: '/oath-protein-powder-review/' },
      { title: "ProDough Protein Review", description: "ProDough protein reviewed on the label: the 25 g whey isolate, the beef and plant powders, the baking mixes, what is not disclosed and the real cost per 25 g.", badge: "Brand Review", url: '/prodough-protein-powder-review/' },
      // affiliate-batch:end
    ],
  },
];

const allGuides = categories.flatMap(c => c.guides);
const pageDescription = 'Every protein powder guide we publish: rankings, whey and plant comparisons, intake and timing, and label safety. Independent, no paid placements.';

const bestOfSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Best Lists', item: `${SITE_URL}/best-of/` },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: `All Protein Powder Guides | ${SITE_NAME}`,
      description: pageDescription,
      url: `${SITE_URL}/best-of/`,
    },
    {
      '@type': 'ItemList',
      name: `All Protein Powder Guides | ${SITE_NAME}`,
      description: pageDescription,
      itemListElement: allGuides.map((guide, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'Article',
          name: guide.title,
          description: guide.description,
          url: `${SITE_URL}${guide.url}`,
        },
      })),
    },
  ],
};
---
<Layout
  title="All Protein Powder Guides"
  description={pageDescription}
  jsonLd={bestOfSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <header class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-50 text-yellow-700 text-sm font-black uppercase tracking-widest border border-yellow-200 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
        Updated Regularly
      </div>
      <h1 class="text-4xl lg:text-7xl font-black text-[#333333] mb-6 tracking-tight">
        All <span class="text-[#1E90FF]">Protein Powder</span> Guides
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-8">
        {allGuides.length} guides covering whey, isolate and plant protein, how much you need, when to take it, and how to tell a safe tub from a risky one. No sponsored picks.
      </p>

      <!-- Quick Navigation -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {categories.map(cat => (
          <a href={`#${cat.id}`} class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-bold text-gray-700 hover:bg-[#1E90FF] hover:text-white hover:border-[#1E90FF] transition-colors no-underline">
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Methodology -->
      <div class="max-w-3xl mx-auto bg-gray-50 border border-gray-200 rounded-2xl p-6 text-left">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-[#1E90FF]/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E90FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm mb-1">How We Pick</p>
            <p class="text-gray-600 text-sm leading-relaxed">
              Every powder is judged on its full nutrition panel, its cost per 25 g of protein, its ingredient list and its third-party certification — not on the claims on the front of the tub. <a href="/how-we-test/" class="text-[#1E90FF] font-bold no-underline hover:underline">Read our full process</a>.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Categorized Guides -->
    {categories.map(category => (
      <section id={category.id} class="mb-10 md:mb-16 scroll-mt-24">
        <h2 class="text-2xl lg:text-3xl font-black text-[#333333] mb-0 md:mb-8 pb-3 md:pb-4 border-b-2 border-gray-200">
          {category.name}
        </h2>
        <!-- Phones: a compact tappable list. md and up: cards. -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-6">
          {category.guides.map(guide => (
            <a
              href={guide.url}
              class="flex items-center gap-3 py-4 border-b border-gray-200 md:block md:bg-white md:border md:border-gray-200 md:rounded-2xl md:p-6 md:shadow-sm md:hover:shadow-xl md:hover:border-[#1E90FF]/30 transition-all group no-underline"
            >
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 mb-1 md:mb-3">
                  <span class="text-[#C93500] md:bg-[#FF4500]/10 md:text-[#FF4500] md:px-2.5 md:py-0.5 rounded-full text-[10px] md:text-xs font-black uppercase tracking-wide md:tracking-normal">
                    {guide.badge}
                  </span>
                </div>
                <h3 class="text-base md:text-lg font-black text-gray-900 group-hover:text-[#1E90FF] transition-colors mb-1 md:mb-2 leading-snug">
                  {guide.title}
                </h3>
                <p class="text-gray-500 text-sm m-0 md:mb-4 leading-relaxed line-clamp-2 md:line-clamp-none">{guide.description}</p>
                <div class="hidden md:flex items-center gap-1 text-[#1E90FF] text-sm font-bold">
                  Read Guide
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="md:hidden shrink-0 text-gray-400" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- ========== WHY TRUST OUR PICKS ========== -->
    <section class="mt-8 mb-8">
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl overflow-hidden">
        <div class="p-10 lg:p-14">
          <h2 class="text-3xl font-black text-white mb-6">Why Trust Our Guides?</h2>
          <p class="text-gray-400 leading-relaxed mb-6">
            Every powder is scored on the same five questions:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">1</span>
              <p class="font-bold text-white text-sm">Protein Quality (30%)</p>
              <p class="text-gray-400 text-xs">Protein per scoop, share of the scoop, amino acid profile, no spiking.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">2</span>
              <p class="font-bold text-white text-sm">Verification (25%)</p>
              <p class="text-gray-400 text-xs">Third-party certification and published testing for contaminants.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">3</span>
              <p class="font-bold text-white text-sm">Value (20%)</p>
              <p class="text-gray-400 text-xs">Cost per 25 g of protein at typical retail prices.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">4</span>
              <p class="font-bold text-white text-sm">Ingredients (15%)</p>
              <p class="text-gray-400 text-xs">Sweeteners, added sugar, fillers and common gut irritants.</p>
            </div>
            <div class="bg-white/5 rounded-xl p-4">
              <span class="bg-[#FF4500] text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm font-black mb-2">5</span>
              <p class="font-bold text-white text-sm">Buyer Feedback (10%)</p>
              <p class="text-gray-400 text-xs">Recurring complaints about taste, mixing and digestion.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
