    "pros": [
      "Added soluble fiber for fullness",
      "100 calories per serving (brand)",
      "Unsweetened base, so you control the flavor"
    ],
    "cons": [
      "Only 20 g of protein per serving",
      "About $3.04 per 25 g, the highest of these four",
      "Green tea extract adds little you could not get from a cup of tea"
    ],
