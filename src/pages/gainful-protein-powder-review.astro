    "bottomLine": "A clean, short-label vegan option, but buyers worried about lead should look at the brand's own caveat first.",
    "specs": {
      "Protein / serving": "23 g (brand)",
      "Calories": "120",
      "Third-party testing": "Brand claim only; no seal",
      "Cost per 25 g": "$2.28 (42 servings) to $2.64 (14)"
    }
