    "specs": {
      "Protein / serving": "20 g (brand)",
      "Calories": "100",
      "Caffeine": "About 5 mg (brand)",
      "Cost per 25 g": "About $3.04 (14-serving tub)"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Gainful Protein Powder Review",
          item: `${SITE_URL}/gainful-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Gainful third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gainful says it is. The brand states that it tests every lot of raw ingredients and finished products, including heavy-metal screening, and uses NSF-certified cGMP manufacturing facilities. It does not name the lab or publish results, and we found no Gainful product on the NSF Certified for Sport or Informed Sport databases. Tested athletes should choose a product with one of those certifications."
          }
        },
        {
          "@type": "Question",
          "name": "Is Gainful protein powder healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most healthy adults, yes. The tubs are unflavored and unsweetened with very short ingredient lists; Isolate-Only Whey is just whey isolate and sunflower lecithin, with 25 g of protein and 100 calories per the brand. The caveats are the Prop 65 lead warning, which applies most to the plant formulas, and the price. It is a food, not medicine."
          }
        },
        {
          "@type": "Question",
          "name": "Does Gainful protein contain lead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Like most protein powders, Gainful products contain trace lead, mainly from soil. The brand says its whey proteins test well below the strict California Prop 65 lead threshold, while its plant proteins test below the FDA interim reference level but occasionally slightly exceed Prop 65. A Prop 65 warning appears on its product pages for that reason."
          }
        },
        {
          "@type": "Question",
          "name": "Is Gainful lactose free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isolate-Only Whey is close. Gainful describes it as virtually lactose free, with 98 to 99 percent lactose removed depending on which part of the page you read, which many people with mild intolerance handle well. Everyday Whey contains whey concentrate and micellar casein, so it has more lactose. The plant formulas contain no dairy at all."
          }
        },
        {
          "@type": "Question",
          "name": "Which Gainful flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gainful tubs are unflavored; flavor comes from eight packets. In buyer reviews, Cinnamon Toast and Caffe Mocha come up most often as favorites, and Fortune's reviewer picked the same two. Rich Chocolate and Madagascar Vanilla are the safe choices. The variety packs are the cheapest way to find out which you like before buying a full box."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common Gainful complaints?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Trustpilot reviews, the most common complaints are about subscriptions: charges after cancelling, a hard-to-find cancel option and gifts that started a subscription. Buyers also report slow shipping, unhelpful support and a high price per serving. The common praise is for taste, the short label, the quiz and the flavor packets."
          }
        },
        {
          "@type": "Question",
          "name": "Is Gainful worth the money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only at a discount, for most people. At list price Gainful costs $2.28 to $3.04 per 25 g of protein, more than certified isolates such as Transparent Labs at around $1.95. With a 30 percent promotional code, Isolate-Only Whey drops below $2 per 25 g, which is fair for a two-ingredient isolate. Without one, you are mostly paying for the flavor-packet system."
          }
        }
      ],
    },
