const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Pea Protein Powder",
          item: `${SITE_URL}/best-pea-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is pea protein a complete protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Pea protein contains all nine essential amino acids, so it meets the technical definition of a complete protein. Its limiting amino acids are methionine and cysteine, which are lower than in dairy, egg or soy. A varied diet with grains, nuts and seeds covers that gap easily, and pea and rice blends address it inside the tub."
          }
        },
        {
          "@type": "Question",
          "name": "Is pea protein as good as whey for building muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be, if you take enough. Pea has slightly less leucine per gram, so you need about 30 to 35 g per shake to match a 25 g whey scoop. Trials comparing matched doses of pea and whey in people doing resistance training, including work by Babault and colleagues, have found broadly similar gains in muscle thickness and strength."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between pea protein isolate and concentrate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Isolate is made by wet extraction, which removes most of the starch, fiber and fermentable sugars and leaves roughly 80 to 85 percent protein. Concentrate is usually made by dry air classification and keeps more carbohydrate and fiber, landing around 50 to 60 percent protein. Isolates deliver more protein per calorie and are generally easier to digest."
          }
        },
        {
          "@type": "Question",
          "name": "Does pea protein contain heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most plant proteins contain trace heavy metals, because crops absorb lead, cadmium and arsenic from soil. Independent testing has found plant powders average more lead than whey, though individual products vary widely. Choose a brand with NSF Certified for Sport or Informed Sport status, or published batch results, and favor vanilla or unflavored over chocolate."
          }
        },
        {
          "@type": "Question",
          "name": "Does pea protein cause bloating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pea protein isolate is usually easier on the stomach than whole peas, because processing removes most of the fermentable sugars that cause gas. When buyers report bloating, added fibers like inulin, sugar alcohols such as erythritol, or gums are frequent culprits. Try a single-ingredient unflavored isolate, take it with food, and start with a half serving if you are sensitive."
          }
        },
        {
          "@type": "Question",
          "name": "Can I take pea protein if I am allergic to peanuts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Possibly, but check with an allergist first. Peas and peanuts are both legumes, and some people with a peanut allergy react to pea protein. Pea is not one of the major US food allergens that must be declared, so read ingredient lists carefully, including on products that do not advertise pea on the front of the label."
          }
        },
        {
          "@type": "Question",
          "name": "How much pea protein should I take per day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on your total protein target, not the powder alone. Most active adults do well between 1.4 and 2.0 g per kilogram of body weight per day, per the ISSN position stand, with one or two pea shakes of about 30 to 35 g filling gaps. People with kidney disease or who are pregnant should agree a target with their doctor or dietitian."
          }
        }
      ],
    },
