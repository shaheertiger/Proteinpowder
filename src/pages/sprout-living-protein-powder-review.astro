      "Protein / serving": "22 g (panel)",
      "Calories": "150",
      "Added sugar": "0 g",
      "Cost per 25 g": "About $3.78 (1 lb list price)"
    }
  },
  {
    "id": "sprout-living-simple-protein-pumpkin-seed-1lb",
