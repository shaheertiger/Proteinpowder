---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Plant-Based Protein Powder",
    "url": "/best-plant-based-protein-powder/"
  },
  {
    "title": "Best Organic Protein Powder",
    "url": "/best-organic-protein-powder/"
  },
  {
    "title": "Garden of Life Protein Powder Review",
    "url": "/garden-of-life-protein-powder-review/"
  },
  {
    "title": "Sunwarrior Protein Powder Review",
    "url": "/sunwarrior-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Sprout Living Protein Powder Review: Is Epic Protein Clean?";
const description =
  "Mostly yes: Epic Protein is USDA Organic with 20 to 26 g of plant protein and no gums. The brand says every batch is third-party tested but posts no results.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "sprout-living-epic-protein-original-unflavored",
    "name": "Sprout Living Epic Protein, Original (Unflavored), 1 lb",
    "brand": "Sprout Living",
    "badge": "Best Sprout Living Pick",
    "category": "Organic multi-source plant protein, unsweetened",
    "description": "The cleanest and best-value Epic Protein. Per the label, two rounded scoops (38 g) give 26 g of protein, 140 calories, 4 g of fat, 5 g of carbohydrate, 4 g of fiber, 1 g of sugar with 0 g added, 310 mg of sodium and 5 mg of iron. The ingredients are an organic blend of yellow pea, pumpkin seed, sunflower seed, cranberry seed and chia seed protein, plus organic Jerusalem artichoke inulin. A 1 lb bag holds about 12 servings and lists at $34.95, about $2.80 per 25 g.",
    "pros": [
      "26 g of protein in a 38 g serving (label)",
      "Six organic ingredients, no sweetener, no gums",
      "USDA Organic, Certified Vegan, kosher and Whole30 Approved",
      "Lowest cost per 25 g in the Epic range"
    ],
    "cons": [
      "About $2.80 per 25 g at list price",
      "Earthy, plain taste on its own",
      "No published heavy-metal results"
    ],
    "bottomLine": "The Sprout Living to buy: the most protein, the fewest ingredients and the lowest cost per gram in the Epic line.",
    "specs": {
      "Protein / serving": "26 g (label)",
      "Calories": "140",
      "Added sugar": "0 g",
      "Cost per 25 g": "About $2.80 (1 lb list price)"
    },
    "amazonUrl": "https://www.amazon.com/dp/B01MXVJT1S"
  },
  {
    "id": "sprout-living-epic-protein-vanilla-lucuma",
    "name": "Sprout Living Epic Protein, Vanilla Lucuma, 1 lb",
    "brand": "Sprout Living",
    "badge": "Best Flavored Pick",
    "category": "Organic plant protein with superfoods",
    "description": "Vanilla Lucuma adds a flavor and superfood blend to the same protein base. Per the label, a 38 g serving gives 20 g of protein, 150 calories, 3 g of fat, 13 g of carbohydrate, 3 g of fiber and 7 g of sugar, 4 g of it added from organic coconut sugar, with organic stevia leaf, lucuma, Ceylon cinnamon, acerola, baobab, vanilla bean, banana and Himalayan salt. Sodium is 350 mg. At $34.95 for about 12 servings it costs about $3.64 per 25 g.",
    "pros": [
      "Sweetened with coconut sugar and stevia leaf, no sugar alcohols",
      "Real vanilla bean, no natural flavors (label)",
      "Easy to blend into smoothies and oats"
    ],
    "cons": [
      "Only 20 g of protein in a 38 g scoop",
      "4 g of added sugar per serving",
      "About $3.64 per 25 g of protein"
    ],
    "bottomLine": "The flavored Epic to try first, if you accept fewer grams of protein per scoop in exchange for a whole-food flavor.",
    "specs": {
      "Protein / serving": "20 g (label)",
      "Calories": "150",
      "Added sugar": "4 g (coconut sugar)",
      "Cost per 25 g": "About $3.64 (1 lb list price)"
    }
  },
  {
    "id": "sprout-living-epic-protein-chocolate-maca",
    "name": "Sprout Living Epic Protein, Chocolate Maca, 1 lb",
    "brand": "Sprout Living",
    "badge": "Best Chocolate Option",
    "category": "Organic plant protein with cacao and maca",
    "description": "Chocolate Maca uses the same base with organic cacao, maca, cinnamon, lucuma and banana, sweetened with organic coconut sugar and stevia leaf. Per the label, a 38 g serving gives 20 g of protein, 150 calories, 4 g of fat, 11 g of carbohydrate, 3 g of fiber and 6 g of sugar, 4 g of it added, with 340 mg of sodium. It lists at $34.95 per 1 lb bag, about $3.64 per 25 g. Cacao tends to raise heavy-metal readings in any protein powder.",
    "pros": [
      "Real cacao and maca, no natural flavors",
      "No gums or sugar alcohols",
      "Buyers describe it as less gritty than many plant proteins"
    ],
    "cons": [
      "Cacao is a known source of cadmium and lead in the category",
      "20 g of protein per 38 g serving",
      "About $3.64 per 25 g"
    ],
    "bottomLine": "Pick it if you want chocolate, but if heavy metals worry you, vanilla or Original is the safer choice.",
    "specs": {
      "Protein / serving": "20 g (label)",
      "Calories": "150",
      "Added sugar": "4 g (coconut sugar)",
      "Cost per 25 g": "About $3.64 (1 lb list price)"
    }
  },
  {
    "id": "sprout-living-epic-protein-real-sport",
    "name": "Sprout Living Epic Protein, Real Sport, 1 lb",
    "brand": "Sprout Living",
    "badge": "Recovery Formula",
    "category": "Organic plant protein with recovery botanicals",
    "description": "Real Sport is the training version, with coconut water, tart cherry, turmeric, ginger, black pepper, ashwagandha and reishi and chaga mushrooms, sweetened with stevia leaf and banana. The nutrition panel shows 22 g of protein, 150 calories, 9 g of carbohydrate, 5 g of sugar with 0 g added, 380 mg of sodium and 90 mg of vitamin C per 38 g serving; the product page copy says 24 g, so check your bag. At $39.95 for about 12 servings it costs about $3.78 per 25 g at the label figure.",
    "pros": [
      "No added sugar (label)",
      "Electrolytes from coconut water and salt",
      "Organic and Certified Vegan"
    ],
    "cons": [
      "Panel says 22 g of protein, page copy says 24 g",
      "Contains ashwagandha, not suitable for everyone",
      "The most expensive Epic per 25 g"
    ],
