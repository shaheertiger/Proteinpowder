---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Naked Nutrition Protein Powder Review",
    "url": "/naked-nutrition-protein-powder-review/"
  },
  {
    "title": "Orgain Protein Powder Review",
    "url": "/orgain-protein-powder-review/"
  },
  {
    "title": "Whey vs Plant Protein",
    "url": "/whey-vs-plant-protein/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Vega Protein Powder Review: Which Tub to Buy After the Rename";
const description =
  "Vega protein powder reviewed by label: what Sport Premium became, which of the four tubs to buy, NSF status, sweeteners and real cost per 25 g of protein.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "vega-sport-premium-protein",
    "name": "Vega Protein + Recovery (formerly Vega Sport Premium Protein)",
    "brand": "Vega",
    "badge": "Best Overall Vega",
    "category": "Pea, pumpkin seed and sunflower seed protein blend",
    "description": "This is the product most people still search for as Vega Sport. Vega renamed it Protein + Recovery and says the formula is unchanged. Per the label at the time of writing it gives 30 g of protein in a scoop of about 42-44 g, roughly 170-180 calories depending on flavor. It is sweetened with stevia, and it adds tart cherry and a Bacillus subtilis probiotic. It is NSF Certified for Sport, which makes it the strongest pick in the range for tested athletes.",
    "pros": [
      "30 g of protein per scoop, a full dose without doubling up",
      "NSF Certified for Sport, per Vega (check your flavor on the NSF database)",
      "Pea isolate plus seed proteins, with no added sugar",
      "The XL tub brings cost per 25 g down sharply"
    ],
    "cons": [
      "Premium cost per 25 g if you buy the standard 19-serving tub",
      "Stevia aftertaste is a common complaint in buyer reviews"
    ],
    "bottomLine": "The Vega to buy if you train hard, get drug tested, or just want 30 g of plant protein in one scoop.",
    "specs": {
      "Protein / serving": "30 g (label, varies slightly by flavor)",
      "Calories": "About 170-180",
      "Third-party testing": "NSF Certified for Sport",
      "Best for": "Athletes, post-workout"
    },
    "amazonUrl": "https://www.amazon.com/dp/B016D9IGRA"
  },
  {
    "id": "vega-protein-creatine",
    "name": "Vega Protein + Creatine",
    "brand": "Vega",
    "badge": "Best for Lifters",
    "category": "Pea and organic brown rice protein with creatine",
    "description": "Protein + Creatine puts 30 g of pea and brown rice protein and 3 g of creatine monohydrate in one scoop of about 48 g, per the label at the time of writing. That is roughly 190 calories. It carries Informed Choice certification, not NSF. Unlike the rest of the range it contains organic cane sugar alongside stevia, so check the sugar line if you are counting. It suits lifters who would otherwise buy creatine separately.",
    "pros": [
      "30 g of protein plus a standard 3 g creatine dose",
      "Informed Choice certified, per Vega",
      "Cheaper per 25 g of protein than Protein + Recovery's standard tub"
    ],
    "cons": [
      "Contains organic cane sugar as well as stevia",
      "Doubling servings also doubles the creatine, so it is a poor second shake"
    ],
    "bottomLine": "Good value if you already take creatine daily. Pointless if you do not.",
    "specs": {
      "Protein / serving": "30 g (label)",
      "Calories": "About 190",
      "Third-party testing": "Informed Choice",
      "Best for": "Lifters who take creatine"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0DWV9BD4R"
  },
  {
    "id": "vega-essential-protein",
    "name": "Vega Essential Protein",
    "brand": "Vega",
    "badge": "Best Value Vega",
    "category": "Pea protein, flavored",
    "description": "Essential Protein is Vega's everyday, lower-cost tub. Per the label at the time of writing, a two-scoop serving of about 46 g gives 25 g of pea protein and roughly 170 calories, with no added sugar and a few grams of fiber. It is sweetened with stevia. It drops the sport certification, the probiotic and the recovery extras, and it is the cheapest way to get Vega's flavor system per gram of protein.",
    "pros": [
      "Lowest cost per 25 g in the Vega range at typical prices",
      "25 g of protein with 0 g of sugar, per the label",
      "Widely sold on Amazon and in grocery stores"
    ],
    "cons": [
      "No NSF or Informed certification",
      "Two scoops per serving, so a tub goes quicker than it looks"
    ],
    "bottomLine": "The smart buy for daily smoothies if you do not need a sport certification.",
    "specs": {
      "Protein / serving": "25 g (label)",
      "Calories": "About 170",
      "Third-party testing": "No sport certification",
      "Best for": "Everyday shakes, budget"
    },
    "amazonUrl": "https://www.amazon.com/dp/B0BRMHJK9R"
  },
  {
    "id": "vega-protein-supergreens",
    "name": "Vega Protein + Supergreens",
    "brand": "Vega",
    "badge": "Best Breakfast Shake",
    "category": "Plant protein with kale, alfalfa, broccoli and spinach",
    "description": "Formerly sold as Protein and Greens, this version gives 25 g of plant protein and about 4 g of fiber in a scoop of about 46 g, per retailer labels at the time of writing, which list roughly 180 calories. The greens are kale, alfalfa, broccoli and spinach. It is a breakfast shake rather than a training product, and the greens are a small amount, not a substitute for eating vegetables.",
    "pros": [
      "25 g of protein plus some fiber in one scoop",
      "No added sugar, per Vega",
      "Small tubs make it easy to try"
    ],
    "cons": [
      "Small 11-13 serving tubs push cost per 25 g up",
      "No sport certification"
    ],
    "bottomLine": "A pleasant morning shake, but you are paying extra for a modest amount of greens.",
    "specs": {
      "Protein / serving": "25 g (label)",
      "Calories": "About 180",
      "Third-party testing": "No sport certification",
      "Best for": "Breakfast, meal add-on"
    }
  },
  {
    "id": "naked-nutrition-naked-pea",
    "name": "Naked Pea Protein",
    "brand": "Naked Nutrition",
    "badge": "Alternative: Cheapest Plant Gram",
    "category": "Single-ingredient yellow pea protein",
    "description": "If what you like about Vega is just the pea protein, Naked Pea is the cheaper way to get it. It has one ingredient, yellow pea protein from US and Canadian farms, and the brand lists 27 g of protein and about 120 calories per two-scoop serving. Naked says the unflavored version is NSF Contents Certified and third-party tested for heavy metals. It tastes earthy on its own, so it suits smoothies, not a water shaker.",
    "pros": [
      "Under a dollar per 25 g of protein in the 5 lb bag at list price",
      "One ingredient, no sweeteners or gums",
      "27 g of protein in about 120 calories, per the brand"
    ],
    "cons": [
      "Earthy and thick in plain water, as buyers commonly report",
      "No NSF Certified for Sport or Informed certification"
    ],
    "bottomLine": "Buy this instead of Vega if you blend your shakes and care most about cost per gram.",
    "specs": {
      "Protein / serving": "27 g (brand)",
      "Calories": "About 120",
      "Third-party testing": "NSF Contents Certified (brand)",
      "Best for": "Smoothies, baking, budget"
    },
    "amazonUrl": "https://www.amazon.com/dp/B00NBIUGA2"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Vega Protein Powder Review",
          item: `${SITE_URL}/vega-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Vega Sport Premium Protein discontinued?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not exactly. Vega renamed it Protein + Recovery and says the formula is unchanged: 30 g of protein from pea, pumpkin seed and sunflower seed, with tart cherry and a probiotic. Retailers sometimes still list it under the old name. The label at the time of writing still shows NSF Certified for Sport, but check the flavor in NSF's database."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Vega protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the tub. Protein + Recovery and Protein + Creatine have 30 g per scoop. Essential Protein and Protein + Supergreens have 25 g per serving, and Essential takes two scoops to get there. All-in-One Nutrition has 20 g. These figures come from the label at the time of writing and vary slightly by flavor."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener does Vega use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The flagship Protein + Recovery, Essential Protein and Supergreens are sweetened with stevia leaf extract and have no added sugar, per Vega. Protein + Creatine is different: its label lists organic cane sugar as well as stevia. None of the range uses sucralose, aspartame or acesulfame potassium, according to the ingredient lists at the time of writing."
          }
        },
        {
          "@type": "Question",
          "name": "Is Vega protein good for building muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you take enough. A 30 g scoop of Protein + Recovery provides a dose that research suggests is enough to stimulate muscle protein synthesis in most adults, and the blend has a complete amino acid profile. Muscle growth still depends mostly on training and total daily protein. The powder just makes your daily target easier to hit."
          }
        },
        {
          "@type": "Question",
          "name": "Does Vega protein contain heavy metals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All plant proteins contain trace heavy metals from soil, and Vega does not publish batch results on its product pages. Protein + Recovery's NSF Certified for Sport status includes contaminant screening, which is the best assurance in the range. If heavy metals are your priority, choose the certified product and check the flavor in NSF's database before you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Is Vega protein good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can help, as any protein powder can, because protein is filling and a 170-190 calorie shake can replace a less filling snack. Essential Protein is the most sensible choice for this at about 170 calories for 25 g. No powder causes weight loss by itself. Your overall calorie intake and diet quality decide that."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns Vega now?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vega was founded in Canada, bought by WhiteWave Foods in 2015, and became part of Danone when Danone acquired WhiteWave. In June 2021 Danone sold Vega to funds managed by the US private equity firm WM Partners, and terms were not disclosed. The core products continued, with some renamed in later years."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "vega protein powder",
      "vega sport protein",
      "vega protein review",
      "vega premium sport"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Plant Protein Picks",
    link: "/best-plant-based-protein-powder/",
  }}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker="Brand Review" badge="Label-Checked" author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Vega Protein Powder Review</Fragment>
      Vega Sport Premium is now Protein + Recovery. Here is what changed, what did not, and which of Vega's four protein tubs is actually worth the money.
    </ArticleHeader>

    <TableOfContents>
      <a href="#verdict">The Short Verdict</a>
      <a href="#lineup">The Vega Range</a>
      <a href="#top-picks">Our Top Picks</a>
      <a href="#label">What Is in the Tub</a>
      <a href="#cost">Cost per 25 g</a>
      <a href="#testing">Certifications</a>
      <a href="#taste">Taste and Mixing</a>
      <a href="#compare">Vega vs Other Brands</a>
      <a href="#who">Who Should Buy It</a>
      <a href="#use">How to Use It</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          Vega is a good plant protein brand with a confusing lineup. The product most people mean by Vega Sport is now Protein + Recovery. It is still the best tub Vega sells, and it still costs more than it needs to unless you buy the big one.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict on Vega
          </h2>

          <p>
            Vega is still one of the better plant protein brands you can buy in a regular store. But the range has been renamed and reshuffled, and most of the confusion people bring to search comes from that. The product almost everyone means by Vega Sport is now sold as <strong>Vega Protein + Recovery</strong>. Vega says it is the same formula under a new name: 30 g of protein from pea, pumpkin seed and sunflower seed, NSF Certified for Sport, and sweetened with stevia.
          </p>

          <p>
            Our ranking is simple. Protein + Recovery is the flagship and the one to buy if you train seriously or are tested. Protein + Creatine is good value for lifters who already take creatine. Essential Protein is the budget daily tub. Protein + Supergreens is a breakfast product you can skip unless you like the idea of a few greens in your shake. We rank them on the label, certification status and cost per 25 g of protein. We have not tasted them, so where we mention taste we are reporting buyer feedback.
          </p>

          <p>
            The weak spot is price. A standard 19-serving tub of Protein + Recovery lists at roughly $65 on Vega's own store, which works out to almost $3 per 25 g of protein. The 44-serving XL tub cuts that to about $1.70, and Amazon and grocery prices often undercut the brand store. If you pay list price for small tubs, Vega is one of the more expensive plant proteins you can buy.
          </p>

          <p>
            If cost per gram is all you care about, a single-ingredient pea isolate will beat any Vega product by a wide margin. What Vega gives you for the extra money is flavor, a thinner and more drinkable shake according to buyer reports, and, on the flagship, a sport certification. Our full ranking of the category is in the <a href="/best-plant-based-protein-powder/">best plant-based protein powders</a> guide. This page covers which Vega tub to pick, if any.
          </p>
        </div>

        <div id="lineup" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Vega Range, Explained
          </h2>

          <p>
            Vega currently sells four main protein powders on its US store, plus an All-in-One meal-style shake. The naming has changed in the last couple of years, which is why search results and older reviews disagree. <strong>Protein + Recovery</strong> is the old Sport Premium Protein. <strong>Protein + Supergreens</strong> is the old Protein and Greens, which Vega says now has more protein and fiber. <strong>Essential Protein</strong> and <strong>Protein + Creatine</strong> make up the rest of the protein lineup.
          </p>

          <p>
            The four tubs are built for different jobs. Protein + Recovery is the performance product: 30 g of protein, about 12 g of essential amino acids according to Vega, tart cherry, and a heat-stable probiotic. Protein + Creatine has the same 30 g of protein from a pea and brown rice blend, plus 3 g of creatine monohydrate. Essential Protein is the plain everyday tub at 25 g. Supergreens adds a small greens blend to 25 g of protein.
          </p>

          <p>
            All-in-One Nutrition is the odd one out. It gives 20 g of organic plant protein along with vitamins, minerals, probiotics, fiber and greens, and it is priced like a meal replacement. A large 18-serving bag lists at about $70 on Vega's store, which comes to nearly $5 per 25 g of protein. If you want a protein powder, it is the wrong product. If you want a meal shake, compare it with our <a href="/kachava-review/">Ka'Chava review</a> before you buy.
          </p>

          <p>
            A brief note on who owns Vega, since buyers ask. Vega started as a Canadian brand. WhiteWave Foods bought it in 2015 in a deal widely reported at around $550 million, and Danone took it over when it acquired WhiteWave. In June 2021 Danone sold Vega to funds managed by the US private equity firm WM Partners. Owners have changed, but the core product has stayed recognizably the same pea-led formula.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Certification</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Sweetener</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein + Recovery</td>
                    <td class="px-4 py-4 text-gray-700">30 g</td>
                    <td class="px-4 py-4 text-gray-700">About 170-180</td>
                    <td class="px-4 py-4 text-gray-700">NSF Certified for Sport</td>
                    <td class="px-4 py-4 text-gray-700">Stevia</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein + Creatine</td>
                    <td class="px-4 py-4 text-gray-700">30 g + 3 g creatine</td>
                    <td class="px-4 py-4 text-gray-700">About 190</td>
                    <td class="px-4 py-4 text-gray-700">Informed Choice</td>
                    <td class="px-4 py-4 text-gray-700">Cane sugar + stevia</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Essential Protein</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 170</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                    <td class="px-4 py-4 text-gray-700">Stevia</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein + Supergreens</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">About 180</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                    <td class="px-4 py-4 text-gray-700">No added sugar</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">All-in-One Nutrition</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">Meal-style</td>
                    <td class="px-4 py-4 text-gray-700">None</td>
                    <td class="px-4 py-4 text-gray-700">Check label</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Every figure in that table comes from the label or Vega's product page at the time of writing, and the numbers vary by flavor. Vega also changes formulas when it renames products, so check the panel on the tub you actually buy. It matters most for Protein + Creatine, the only one with cane sugar on the ingredient list.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Vega Powders Worth Considering
          </h2>

          <p>
            Four Vega products, flagship first, plus one cheaper alternative for buyers who only want the pea protein. Label figures are per the label or brand page at the time of writing and vary by flavor. We have not tasted these products, and any taste notes are buyer feedback.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="label" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            4. What Is Actually in the Tub
          </h2>

          <p>
            Start with the protein. On Protein + Recovery the blend is pea protein, pumpkin seed protein and organic sunflower seed protein. Vega's FAQ says the pea is an isolate and the two seed proteins are concentrates. Pea gives the blend its leucine and lysine. The seed proteins add methionine, which pea is low in. Together they make a more complete amino acid profile than pea alone, though at 30 g a serving the gap barely matters.
          </p>

          <p>
            The rest of the ingredient list is short. The chocolate version lists cocoa, natural flavors, stevia leaf extract, sea salt and xanthan gum. The vanilla, mocha, berry and peanut butter versions follow the same pattern. Berry adds strawberry powder and beet root for color, and peanut butter adds peanut flour. There is no added sugar, no sugar alcohol and no artificial sweetener. Stevia does the sweetening, and that is the main thing buyers either love or put up with.
          </p>

          <p>
            Protein + Creatine reads differently. Its blend is pea protein and organic brown rice protein, and the label also lists organic cane sugar, a sunflower oil creamer made with maltodextrin and modified starch, natural flavors and stevia. That is not a dealbreaker, but it is a different product philosophy from the flagship, and it explains the slightly higher calories. If you chose Vega because the flagship has no added sugar, read this label before switching.
          </p>

          <p>
            Essential Protein is pea protein with acacia gum, coconut oil powder, stevia, natural flavors, sea salt, xanthan gum and rosemary extract, per retailer labels at the time of writing. The acacia gum is where the fiber comes from. The coconut oil powder is there for creaminess. Neither is a concern, but they do make the serving larger than the protein alone would be, which is why it takes two scoops to reach 25 g.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">ALLERGEN NOTE</p>
            <p class="text-xl font-bold text-white mb-3">Made in a shared facility</p>
            <p class="text-gray-300 leading-relaxed m-0">Vega states that its powders are made in a facility that also processes milk, soy, peanuts, eggs, tree nuts and sesame, and may contain traces of soy. That is normal for the category, but if you have a severe allergy, it matters more than the vegan label. Talk to your doctor or an allergist before relying on any shared-facility powder.</p>
          </div>
        </div>

        <div id="cost" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            5. Cost per 25 g of Protein
          </h2>

          <p>
            Price per tub tells you very little because Vega's servings, scoop sizes and tub sizes all differ. The fair comparison is cost per 25 g of protein. The table below uses Vega's own list prices at the time of writing, which are usually the highest you will pay. Amazon, Subscribe and Save, and grocery promotions often run 15-30% lower, so treat these as approximate ceilings, not quotes.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product and size</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">List price (approx.)</th>
