      "Best for": "Budget plant protein"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Happy Viking Protein Powder Review",
          item: `${SITE_URL}/happy-viking-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Happy Viking protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a good vegan meal shake. The reformulated version lists 30 g of pea and brown rice protein, 10 g of fiber and about 250 calories per serving, with a broad vitamin and superfood premix. As a pure protein powder it is expensive, at roughly $3 to $3.40 per 25 g of protein, and it contains added cane sugar and ashwagandha."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Happy Viking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The current formula lists 30 g of plant protein per two-scoop serving of about 63 g, per the brand at the time of writing. Older products, including some single-serve packs still on Amazon and earlier ready-to-drink bottles, list about 20 g. Check the title or nutrition panel for 30 g to be sure you are buying the current version."
          }
        },
        {
          "@type": "Question",
          "name": "Did Venus Williams create Happy Viking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Happy Viking was created by Venus Williams, who says plant-based, high-protein nutrition helped her manage an autoimmune disease and recover as an athlete. The brand lists investors including Michelle Wie West and Megan Rapinoe. The shake was reformulated in late 2025 around 30 g of protein and 10 g of fiber per serving."
          }
        },
        {
          "@type": "Question",
          "name": "Is Happy Viking a meal replacement?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, that is how the brand now positions it. A serving provides about 250 calories with protein, fiber, MCT fat and a vitamin and mineral premix, and becomes a 300 to 350-calorie meal with plant milk. That makes it suitable for replacing a breakfast or lunch, but heavy as an extra shake on top of normal meals."
          }
        },
        {
          "@type": "Question",
          "name": "What sweetener is in Happy Viking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cane sugar and Reb M, a stevia-derived sweetener, per the label at the time of writing. A serving has about 5 g of added sugar. The 2025 reformulation removed the erythritol used in older versions. If you avoid all added sugar or manage blood sugar, factor in those 5 g or choose an unsweetened plant protein instead."
          }
        },
        {
          "@type": "Question",
          "name": "Is Happy Viking third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We could not find a third-party certification such as NSF Certified for Sport, Informed Choice or Clean Label Project on the brand page or Amazon listings at the time of writing. Drug-tested athletes should choose a certified plant protein, such as Garden of Life Sport. Anyone concerned about heavy metals can ask the brand for its latest test results."
          }
        },
        {
          "@type": "Question",
          "name": "Where can I buy Happy Viking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On Happy Viking's own site, which offers a 10 percent subscription discount and a 30-day money-back guarantee per the brand, and on Amazon, which lists the 15-serving Everyday Bags, travel packs and samplers. Amazon also still lists older 20 g packs, so check the protein figure in the title before ordering."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
