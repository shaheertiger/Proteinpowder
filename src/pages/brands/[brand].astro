---
// Brand hub: every powder a brand makes that is in the label database, in the
// shared table, with the brand-level questions people search for answered from
// the rows.
import Layout from "../../layouts/Layout.astro";
import ProductTable from "../../components/db/ProductTable.astro";
import { BRANDS, PRODUCTS, MEDIANS, TYPES, fmt, money } from "../../lib/db.mjs";
import { SITE_NAME, SITE_URL } from "../../data/site";

export function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { brand: b.slug }, props: { b } }));
}

const { b } = Astro.props as { b: any };
const rows = b.products;
const n = rows.length;
const best = rows[0];
const mostProtein = [...rows].sort((x: any, y: any) => y.proteinG - x.proteinG)[0];
const priced = rows.filter((p: any) => p.costPer25 != null);
const cheapest = [...priced].sort((x: any, y: any) => x.costPer25 - y.costPer25)[0];
const certified = rows.filter((p: any) => p.diets.includes("certified"));
const plant = rows.filter((p: any) => p.family === "plant");
const typesMade = [...new Set(rows.map((p: any) => TYPES[p.proteinType].name.toLowerCase()))];
const artificial = rows.filter((p: any) => p.artificial.length);
const metals = rows.filter((p: any) => p.heavyMetals);
const avgScore = Math.round(rows.reduce((a: number, p: any) => a + p.score.total, 0) / n);
const dbAvg = Math.round(PRODUCTS.reduce((a: number, p: any) => a + p.score.total, 0) / PRODUCTS.length);
const list = (xs: string[]) => (xs.length <= 1 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);

const title = n > 1 ? `${b.name} Protein Powders: All ${n} Compared by Label` : `${b.name} Protein Powder: Label, Price and Score`;
const description = `Every ${b.name} protein powder in our database with protein per scoop, calories, sugar, cost per 25 g of protein, certification and Label Score${best ? `. Top: ${best.name} (${best.score.total}/100)` : ""}.`;

const faq: [string, string][] = [
  [
    `Is ${b.name} protein powder good?`,
    `${b.name}'s ${n > 1 ? `${n} powders in our database average a Label Score of ${avgScore}` : `powder scores ${avgScore}`} out of 100, against a database average of ${dbAvg}. ${best.fullName} scores highest at ${best.score.total}, with ${fmt(best.proteinG)} g of protein per ${fmt(best.servingSizeG)} g serving.`,
  ],
  [
    `Is ${b.name} third-party tested?`,
    certified.length
      ? `${certified.length} of ${n} ${b.name} powders carry a sport certification: ${list(certified.map((p: any) => `${p.name} (${p.certifications.filter((c: string) => /Informed|NSF|BSCG/.test(c)).join(", ")})`))}. Certification is per product, so check the registry for the one you buy.`
      : `None of the ${b.name} powders in our database carry Informed Choice, Informed Sport, NSF Certified for Sport or BSCG certification that we could confirm. Tested athletes should choose a certified powder.`,
  ],
  [
    `Which ${b.name} protein powder has the most protein?`,
    `${mostProtein.fullName}, with ${fmt(mostProtein.proteinG)} g of protein per ${fmt(mostProtein.servingSizeG)} g serving (${Math.round(mostProtein.proteinPct * 100)}% protein by weight) in the ${mostProtein.labelFlavor} flavor.`,
  ],
  [
    `Does ${b.name} use artificial sweeteners?`,
    artificial.length
      ? `${artificial.length} of ${n} use at least one: ${list(artificial.map((p: any) => `${p.name} (${p.artificial.join(", ")})`))}. ${n - artificial.length ? `The other ${n - artificial.length} do not.` : ""}`
      : `None of the ${b.name} flavors we track use sucralose, acesulfame potassium or aspartame.`,
  ],
  [
    `Does ${b.name} protein powder have lead?`,
    metals.length
      ? metals.map((p: any) => `${p.name}: ${p.heavyMetals}`).join(" ")
      : `We have no public third-party heavy-metal results for ${b.name} powders. Ask the brand for a certificate of analysis for your lot.`,
  ],
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "Brands", item: `${SITE_URL}/brands/` },
        { "@type": "ListItem", position: 3, name: b.name, item: `${SITE_URL}${b.url}` },
      ],
    },
    { "@type": "Brand", "@id": `${SITE_URL}${b.url}#brand`, name: b.name, ...(b.website ? { url: b.website } : {}) },
    {
      "@type": "ItemList",
      name: `${b.name} protein powders`,
      numberOfItems: n,
      itemListElement: rows.map((p: any, i: number) => ({ "@type": "ListItem", position: i + 1, url: `${SITE_URL}${p.url}`, name: p.fullName })),
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <div data-article-header class="max-w-5xl mx-auto px-4 pb-16">
    <nav aria-label="Breadcrumb" class="text-xs text-gray-500 pt-5 mb-4">
      <a href="/" class="text-gray-500 no-underline hover:text-[#0b64c0]">Home</a> ›
      <a href="/brands/" class="text-gray-500 no-underline hover:text-[#0b64c0]">Brands</a> › {b.name}
    </nav>
    <p class="text-[11px] md:text-xs font-black uppercase tracking-widest m-0 mb-3 text-[#C93500]">Brand · {n} {n === 1 ? "powder" : "powders"}</p>
    <h1 class="text-[1.875rem] leading-[1.15] md:text-5xl font-black tracking-tight text-gray-900 m-0 mb-4">
      {n > 1 ? `${b.name} Protein Powders Compared` : `${b.name} Protein Powder`}
    </h1>
    <p class="text-[1.0625rem] md:text-xl leading-relaxed text-gray-600 m-0 mb-3 max-w-3xl">
      {b.about || `${b.name} makes ${list(typesMade)} protein powder${n > 1 ? "s" : ""}.`}
      {" "}{n > 1 ? `Here are all ${n} we track, ranked by Label Score.` : "Here is how its label scores against the rest of the database."}
    </p>
    <p class="text-xs text-gray-500 m-0 mb-8">We earn a commission if you buy through our retailer links. It never changes a score.</p>

    <ProductTable rows={rows} rank={false} caption={`${b.name} protein powders`} />

    <div class="prose max-w-3xl mt-12">
      <h2 class="text-2xl font-black text-gray-900">{b.name} at a glance</h2>
      <p>
        {n > 1 ? `Across ${n} powders, ${b.name} averages` : `${b.name}'s powder scores`} a Label Score of <strong>{avgScore}/100</strong>, {avgScore >= dbAvg ? "above" : "below"} the database average of {dbAvg}.
        {" "}The best-scoring is <a href={best.url}>{best.fullName}</a> at {best.score.total}, with {fmt(best.proteinG)} g of protein per {fmt(best.servingSizeG)} g serving ({Math.round(best.proteinPct * 100)}% protein, against a database median of {Math.round(MEDIANS.proteinPct * 100)}%).
        {cheapest && <> The cheapest per gram is <a href={cheapest.url}>{cheapest.name}</a> at {money(cheapest.costPer25)} per 25 g of protein ({cheapest.price.retailer}, {cheapest.price.checked}); the database median is {money(MEDIANS.costPer25)}.</>}
      </p>
      <p>
        {certified.length
          ? `${certified.length} of ${n} carry a sport certification, so ${certified.length === n ? "every" : "some"} ${b.name} powder${certified.length === n ? " is" : "s are"} batch-tested for banned substances by an independent lab.`
          : `No ${b.name} powder in our database carries a sport certification we could confirm.`}
        {" "}{plant.length ? `${plant.length} ${plant.length === 1 ? "is" : "are"} plant-based.` : `All are ${typesMade.length === 1 ? typesMade[0] : "animal-based"}.`}
        {" "}{artificial.length ? `${artificial.length} use artificial sweeteners.` : "None use artificial sweeteners."}
      </p>
      {rows.map((p: any) => (
        <>
          <h3 class="text-lg font-black text-gray-900"><a href={p.url} class="text-gray-900">{p.name}</a></h3>
          <p>
            {p.description || `${TYPES[p.proteinType].name} protein.`} {fmt(p.proteinG)} g of protein, {fmt(p.calories)} calories and {p.sugarG == null ? "unlisted" : `${fmt(p.sugarG)} g of`} sugar per {fmt(p.servingSizeG)} g serving ({p.labelFlavor}). Label Score {p.score.total}/100, #{p.rank} of {PRODUCTS.length} overall.
          </p>
        </>
      ))}
      {b.review && <p>Want the long version? Read our full <a href={b.review}>{b.name} review</a>.</p>}
      {b.website && <p>Brand site: <a href={b.website} rel="nofollow noopener" target="_blank">{b.website.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a></p>}
    </div>

    <section id="faq" class="max-w-3xl mt-12 scroll-mt-24">
      <h2 class="text-2xl font-black text-gray-900 mb-4">{b.name} FAQ</h2>
      <div class="faq-list">
        {faq.map(([q, a]) => (
          <details class="faq-item">
            <summary><h3>{q}</h3></summary>
            <div class="faq-answer"><p>{a}</p></div>
          </details>
        ))}
      </div>
    </section>

    <p class="max-w-3xl mt-10 text-sm"><a href="/brands/" class="text-[#0b64c0] font-bold">All brands</a> · <a href="/protein-powder/" class="text-[#0b64c0] font-bold">All protein powders ranked</a> · <a href="/compare/" class="text-[#0b64c0] font-bold">Compare two powders</a></p>
  </div>
</Layout>
