---
import Layout from "../../layouts/Layout.astro";
import { BRANDS, PRODUCTS } from "../../lib/db.mjs";
import { SITE_NAME, SITE_URL } from "../../data/site";
import BrandGuide from "../../components/BrandGuide.astro";

const title = `Protein Powder Brands: ${BRANDS.length} Rated by Label and Testing`;
const description = `The most trusted protein powder brands: Optimum Nutrition, Dymatize, Thorne and Garden of Life lead. Who makes what, who tests, and ${BRANDS.length} brands ranked.`;
const rows = BRANDS.map((b: any) => ({
  ...b,
  avg: Math.round(b.products.reduce((a: number, p: any) => a + p.score.total, 0) / b.products.length),
  certified: b.products.filter((p: any) => p.diets.includes("certified")).length,
})).sort((a: any, b: any) => b.avg - a.avg || a.name.localeCompare(b.name));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "Brands", item: `${SITE_URL}/brands/` },
      ],
    },
    {
      "@type": "CollectionPage",
      name: title,
      description,
      url: `${SITE_URL}/brands/`,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: rows.length,
        itemListElement: rows.map((b: any, i: number) => ({ "@type": "ListItem", position: i + 1, url: `${SITE_URL}${b.url}`, name: b.name })),
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What are the best protein powder brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Brands with strong habits include Optimum Nutrition and Dymatize for mainstream whey, Thorne and Klean Athlete for NSF Certified for Sport products, Transparent Labs and Naked Nutrition for label transparency, NOW Foods for certified budget options, and Garden of Life for certified plant protein. The best choice still depends on the specific product, so check its label and certification."
          }
        },
        {
          "@type": "Question",
          "name": "Which protein powder brand is the most trusted?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trust comes from independent certification, full ingredient disclosure and a clean recall history rather than size. Brands such as Thorne and Klean Athlete certify much of their sports lines through NSF Certified for Sport, which makes them popular with drug-tested athletes. Even with those brands, verify the specific product in the certifier's database before you buy."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns Optimum Nutrition?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Optimum Nutrition is owned by Glanbia, the Irish nutrition company, which also owns Isopure. Shared ownership does not mean the brands share formulas or factories, but it does mean they sit within the same corporate group. Supplement brands are bought and sold fairly often, so check current ownership if it matters to your decision."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most popular protein shake brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Among ready-to-drink options, Premier Protein is one of the best-selling protein shake brands in US mass retail, with 30 g of protein per carton per its label. Orgain, Isopure and several store brands also sell ready-to-drink shakes. Shakes are convenient, but powder is almost always cheaper per 25 g of protein and contains fewer additives."
          }
        },
        {
          "@type": "Question",
          "name": "Are cheap protein powder brands safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Price alone does not decide safety. Budget brands such as Myprotein and NOW Foods sell well-made products, and NOW has carried Informed Sport certification on many NOW Sports products. What matters is the specific product: a clear ingredient list, no amino spiking, and ideally a named third-party certification you can verify. Check plant powders especially carefully for heavy-metal testing."
          }
        },
        {
          "@type": "Question",
          "name": "Is Costco's Kirkland protein any good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kirkland Signature protein products can be good value, but Costco does not always disclose the contract manufacturer, and house brands rarely carry sports certifications. Read the label, compare protein per serving with the serving size, and calculate cost per 25 g. Costco also sells name brands like Orgain and Premier Protein in large packs, which are worth comparing."
          }
        },
        {
          "@type": "Question",
          "name": "Does a brand need NSF certification to be good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Many good products carry no sports certification, and certification is granted product by product rather than to whole brands. For drug-tested athletes, an NSF Certified for Sport or Informed Sport listing is essential. For everyone else, it is a strong extra layer of assurance, and more valuable for plant powders, which tend to test higher for heavy metals."
          }
        }
      ],
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <div data-article-header class="max-w-5xl mx-auto px-4 pb-16">
    <nav aria-label="Breadcrumb" class="text-xs text-gray-500 pt-5 mb-4">
      <a href="/" class="text-gray-500 no-underline hover:text-[#0b64c0]">Home</a> › Brands
    </nav>
    <h1 class="text-[1.875rem] leading-[1.15] md:text-5xl font-black tracking-tight text-gray-900 m-0 mb-4">Protein Powder Brands</h1>
    <p class="text-[1.0625rem] md:text-xl leading-relaxed text-gray-600 m-0 mb-8 max-w-3xl">
      {BRANDS.length} brands and {PRODUCTS.length} powders, ranked by the average Label Score of the products we track. Each brand page lists every powder with its full label numbers. Below the table is our written guide to the fourteen biggest names: what each is known for, who tests, and how to judge a brand you do not know.
    </p>
    <div class="overflow-x-auto border border-gray-200 rounded-2xl">
      <table class="w-full text-sm text-left">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-4 py-3 font-bold text-gray-600">Brand</th>
            <th class="px-4 py-3 font-bold text-gray-600">Powders</th>
            <th class="px-4 py-3 font-bold text-gray-600">Best scoring</th>
            <th class="px-4 py-3 font-bold text-gray-600">Sport-certified</th>
            <th class="px-4 py-3 font-bold text-gray-600">Avg. score</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((b: any) => (
            <tr class="border-b border-gray-100">
              <td class="px-4 py-3"><a href={b.url} class="font-bold text-gray-900 no-underline hover:text-[#1E90FF]">{b.name}</a></td>
              <td class="px-4 py-3 tabular-nums">{b.products.length}</td>
              <td class="px-4 py-3"><a href={b.products[0].url} class="text-gray-700 no-underline hover:text-[#1E90FF]">{b.products[0].name}</a> <span class="text-gray-400">({b.products[0].score.total})</span></td>
              <td class="px-4 py-3 tabular-nums">{b.certified}/{b.products.length}</td>
              <td class="px-4 py-3 font-black tabular-nums">{b.avg}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <article class="relative overflow-hidden">
    <BrandGuide />
  </article>
</Layout>
