const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Pumpkin Spice Protein Powder",
          item: `${SITE_URL}/best-pumpkin-spice-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best pumpkin spice protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Among the pumpkin flavors listed on Amazon when we checked, RYSE Loaded in Little Debbie Pumpkin Spice Rolls. Per the label it gives 25 g of whey protein per scoop in about 130 calories, and it was the cheapest per gram here at about $44.99. Naked Shake is the best dairy-free pick, Truvani the organic one, and Be Well by Kelly the pea-free one."
          }
        },
        {
          "@type": "Question",
          "name": "Is pumpkin spice protein powder available all year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not. Most pumpkin flavors, including RYSE Pumpkin Spice Rolls, Naked Shake Pumpkin Spice, Orgain Pumpkin Spice and PEScience Pumpkin Pie, are described by their brands or by supplement news as seasonal or limited. They tend to appear in late summer and thin out by winter. Outside the season, a vanilla powder with pumpkin purée and pumpkin pie spice is the most reliable substitute."
          }
        },
        {
          "@type": "Question",
          "name": "Does pumpkin spice protein powder contain real pumpkin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most do not. Pumpkin spice flavor comes mainly from cinnamon, nutmeg, ginger and cloves, plus natural flavors. Be Well by Kelly is an exception, listing organic pumpkin powder per its product listing, and Truvani says its pumpkin note comes from organic pumpkin seed powder. For real pumpkin in any shake, add a quarter cup of plain canned purée and blend it."
          }
        },
        {
          "@type": "Question",
          "name": "How do I make a pumpkin spice protein shake with vanilla powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Blend one scoop of vanilla protein, a quarter cup of plain canned pumpkin purée, half a teaspoon of pumpkin pie spice, 8 to 10 oz of milk and a handful of ice for about 30 seconds. Add a teaspoon of maple syrup if your vanilla is lightly sweetened, and a pinch of salt to sharpen the spice."
          }
        },
        {
          "@type": "Question",
          "name": "Can I put pumpkin spice protein powder in coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with care. Very hot coffee can make whey clump, so mix the powder with a few ounces of cold milk first, then pour in the coffee, or let the coffee cool slightly. Iced lattes are easier, since cold liquid dissolves whey isolates cleanly. A handheld frother helps either way and takes only a few seconds."
