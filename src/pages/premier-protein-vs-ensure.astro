const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Premier Protein vs Ensure",
          item: `${SITE_URL}/premier-protein-vs-ensure/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Premier Protein or Ensure better?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither is better overall; they suit different goals. Premier Protein and Ensure Max Protein both give 30 g of protein and 1 g of sugar for 150 to 160 calories, and Premier was slightly cheaper per 25 g at the prices we saw. Ensure Plus is better when someone needs calories to gain weight. Ensure Original is a light nutrition drink with only 9 g of protein."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ensure Max Protein the same as Premier Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nearly. Both have 30 g of protein from milk protein concentrate and calcium caseinate, 1 g of sugar, and sucralose plus acesulfame potassium, per their labels. Ensure Max Protein has 150 calories, 4 g of fiber and 11 mcg of vitamin D; Premier has 160 calories, about 2 g of fiber in chocolate and 6 mcg of vitamin D. Flavor and price are the practical differences."
          }
        },
        {
          "@type": "Question",
          "name": "Can seniors drink Premier Protein instead of Ensure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if the goal is more protein rather than more calories. A Premier shake adds 30 g of protein for 160 calories. If an older adult is losing weight or eating very little, Ensure Plus at 350 calories is usually more useful. Seniors with kidney disease, diabetes or several medications should ask their doctor or a registered dietitian which shake to use and how often."
          }
        },
        {
          "@type": "Question",
          "name": "Which has less sugar, Premier Protein or Ensure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier Protein and Ensure Max Protein tie at 1 g of total sugar and 0 g added, per their labels. The classic Ensure drinks have much more: Ensure Original vanilla lists 10 g of total sugar with 9 g added, and Ensure Plus dark chocolate lists 19 g with 18 g added, per Abbott. If sugar is the concern, stick to the 30 g shakes."
          }
        },
        {
          "@type": "Question",
          "name": "Is Premier Protein or Ensure better for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier Protein or Ensure Max Protein, not Ensure Plus or Original. The 30 g shakes deliver a lot of protein for 150 to 160 calories, which helps with fullness and with keeping muscle during a calorie deficit. Premier is slightly cheaper per 25 g of protein at the prices we saw. Pair either with food rather than using it as a whole meal."
          }
        },
        {
          "@type": "Question",
          "name": "Is Premier Protein or Ensure good for diabetics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 30 g shakes are the gentler option, with 4 to 6 g of carbohydrate and 1 g of sugar per label, but neither brand markets them as diabetes products. Ensure Plus and Original contain 32 to 47 g of carbohydrate and can spike blood sugar. Abbott sells Glucerna for people with diabetes. Ask your doctor or dietitian before adding any shake to a diabetes plan."
          }
        },
        {
          "@type": "Question",
          "name": "Which is cheaper, Premier Protein or Ensure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premier Protein, narrowly: about $2.23 a shake and $1.86 per 25 g of protein at the $26.74 Amazon price we saw for a 12-pack, against about $2.33 and $1.94 for Ensure Max Protein. Ensure Original is cheaper per bottle at about $1.48 but costs about $4.12 per 25 g of protein. Warehouse clubs often beat both on Premier."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
