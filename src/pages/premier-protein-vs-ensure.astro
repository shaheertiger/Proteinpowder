---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Premier Protein Powder Review",
    "url": "/premier-protein-powder-review/"
  },
  {
    "title": "Muscle Milk vs Premier Protein",
    "url": "/muscle-milk-vs-premier-protein/"
  },
  {
    "title": "Best Meal Replacement Shake",
    "url": "/best-meal-replacement-shake/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-16", modified: "2026-11-16" });
const title = "Premier Protein vs Ensure: Which Shake Fits Your Goal?";
const description =
  "Premier Protein and Ensure Max Protein both give 30 g protein and 1 g sugar; Ensure Plus adds 350 calories for weight gain. Labels, price and who each suits.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "premier-protein-vs-ensure-premier-30g-shake-chocolate-12pk",
