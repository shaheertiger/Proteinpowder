---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Organic Protein Powder",
    "url": "/best-organic-protein-powder/"
  },
  {
    "title": "Best Protein Powder for Sensitive Stomach",
    "url": "/best-protein-powder-for-sensitive-stomach/"
  },
  {
    "title": "Best Gluten-Free Protein Powder",
    "url": "/best-gluten-free-protein-powder/"
  },
  {
    "title": "Best Paleo Protein Powder",
    "url": "/best-paleo-protein-powder/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best Greens Protein Powder: Real Veg Doses vs Label Hype";
const description =
  "The best greens protein powders compared on protein, calories, sweeteners and cost, plus how small the greens doses really are, heavy-metal risk and when to buy protein and vegetables separately.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "vega-protein-supergreens",
    "name": "Vega Protein + Supergreens",
    "brand": "Vega",
    "badge": "Best Overall",
    "category": "Pea protein with powdered greens",
