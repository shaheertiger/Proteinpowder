    ],
    "cons": [
      "Earthier taste than Vega or Orgain, by most accounts",
      "Probiotic and greens doses are inside blends, not itemized",
      "20 g is on the low side after hard training"
    ],
    "bottomLine": "Pick it if calories matter most and you want the broadest named vegetable list in a pure protein powder.",
    "specs": {
      "Protein per serving": "20 g per scoop (label)",
      "Calories": "About 100-110 (varies by retailer label)",
      "Greens on label": "Spinach, kale, broccoli, alfalfa, carrot, beet",
      "Best for": "Low-calorie shakes and smoothies"
    }
  },
  {
    "id": "happy-viking-plant-protein-triple-chocolate",
    "name": "Happy Viking High Protein Meal, Triple Chocolate",
    "brand": "Happy Viking",
    "badge": "Most Protein",
    "category": "Plant protein meal with superfood blends",
    "description": "Formerly sold as Plant-Based Protein + 100 Superfoods, now sold as High Protein Meal. Per the brand label at the time of writing (Triple Chocolate), a 63 g serving gives 30 g of pea and brown rice protein, 250 calories, 10 g of fiber and 5 g of sugar, with superfood, vegetable, ancient-grain and probiotic blends, plus KSM-66 ashwagandha. Other flavors run 240-250 calories.",
