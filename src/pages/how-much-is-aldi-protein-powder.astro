>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Cost Breakdown"} badge="Research-Backed" author={author} dates={dates} label="Our standards">
      <Fragment slot="title">How Much Is Aldi Protein Powder?</Fragment>
