                    <td class="px-4 py-4 text-gray-700">200</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">PB2 Original</td>
                    <td class="px-4 py-4 text-gray-700">13 g</td>
                    <td class="px-4 py-4 text-gray-700">6 g</td>
                    <td class="px-4 py-4 text-gray-700">60</td>
                    <td class="px-4 py-4 text-gray-700">No, a flavoring</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">PB2 Pure Peanut Powder</td>
                    <td class="px-4 py-4 text-gray-700">13 g</td>
                    <td class="px-4 py-4 text-gray-700">6 g</td>
                    <td class="px-4 py-4 text-gray-700">About 60</td>
                    <td class="px-4 py-4 text-gray-700">No, a flavoring</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">PB2 with Cocoa</td>
                    <td class="px-4 py-4 text-gray-700">13 g</td>
                    <td class="px-4 py-4 text-gray-700">4 g</td>
                    <td class="px-4 py-4 text-gray-700">50</td>
