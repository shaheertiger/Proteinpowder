          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "1st Phorm Protein Powder Review",
          item: `${SITE_URL}/1st-phorm-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is 1st Phorm protein powder third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Selected flavors of Level-1, Phormula-1, Phormula-1 Natural and Phormula-1 Clear are NSF Certified for Sport, per the NSF database in November 2026. 1st Phorm says its other products are made in an SQF-certified, FDA-inspected facility and tested by independent labs, and its pages show an Informed Choice Trusted badge. Level-1 Natural and Vegan Power Pro were not in the NSF database we searched."
          }
