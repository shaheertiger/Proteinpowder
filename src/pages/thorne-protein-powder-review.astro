                    <td class="px-4 py-4 font-black text-gray-900">Plant Protein</td>
                    <td class="px-4 py-4 text-gray-700">About $49, 20 servings</td>
                    <td class="px-4 py-4 text-gray-700">About 21-22 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.60-2.90</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Collagen Fit</td>
                    <td class="px-4 py-4 text-gray-700">About $56, 30 scoops</td>
                    <td class="px-4 py-4 text-gray-700">About 14 g</td>
                    <td class="px-4 py-4 text-gray-700">About $3.20-3.40</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">RecoveryPro</td>
                    <td class="px-4 py-4 text-gray-700">About $56, 12 scoops</td>
