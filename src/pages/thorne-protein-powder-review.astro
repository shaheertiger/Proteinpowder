                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Approx. cost per 25 g</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Whey Protein Isolate</td>
                    <td class="px-4 py-4 text-gray-700">About $65, 30 scoops</td>
                    <td class="px-4 py-4 text-gray-700">About 21 g</td>
                    <td class="px-4 py-4 text-gray-700">About $2.40-2.70</td>
