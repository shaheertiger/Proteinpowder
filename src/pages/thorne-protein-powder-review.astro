          }
        },
        {
          "@type": "Question",
          "name": "Where is the safest place to buy Thorne?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy from Thorne's own site, Amazon listings sold by Thorne or Amazon, practitioner platforms such as Fullscript, or established retailers. We found lookalike sites listing Thorne products far below normal prices, which is a classic counterfeit sign. Check the seller, the seal and the printed lot number, and avoid deals that look too good to be real."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
