---
import Layout from "../layouts/Layout.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { amazonLink } from "../data/affiliate";
import TrustBadge from "../components/TrustBadge.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecGrid from "../components/SpecGrid.astro";
import productImages from "../data/product-images.json";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Optimum Nutrition Protein Powder Review",
    "url": "/optimum-nutrition-protein-powder-review/"
  },
  {
    "title": "Premier Protein Powder Review",
    "url": "/premier-protein-powder-review/"
  },
  {
    "title": "Pure Protein Powder Review",
    "url": "/pure-protein-powder-review/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-10-19", modified: "2026-10-19" });
const title = "Muscle Milk Protein Powder Review: Which Tub Is Worth It, and Which Is Just Calories";
const description =
  "Muscle Milk protein powder, label by label: Pro Series, Genuine, 100% Whey and Zero compared on protein per scoop, calories, sweeteners and cost per 25 g of protein.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "muscle-milk-pro-series-protein-powder",
    "name": "Muscle Milk Pro Series Protein Powder",
    "brand": "Muscle Milk",
    "badge": "Best Muscle Milk Overall",
    "category": "Milk protein and whey blend, 50 g serving",
    "description": "Pro Series is the reason to buy Muscle Milk. Per the label at the time of writing, a two-scoop serving of about 82 g delivers 50 g of protein from a blend of milk proteins, caseinates and whey, at roughly 300 to 320 calories depending on flavor, with about 3 g of sugar. The brand lists it as NSF Certified for Sport. One scoop is a normal 25 g dose, which makes the tub stretch a long way.",
    "pros": [
      "About 50 g protein per two-scoop serving, per the label",
      "NSF Certified for Sport, per the brand",
      "One of the lowest certified costs per 25 g we found",
      "Single scoop gives a standard 25 g dose"
    ],
    "cons": [
      "Sweetened with acesulfame potassium and sucralose",
      "Mixed buyer feedback on vanilla and strawberry flavors",
      "Milk-protein blend is not low-lactose"
    ],
    "bottomLine": "The best-value Muscle Milk tub and a strong certified pick for anyone who needs a lot of protein.",
    "specs": {
      "Protein per serving": "About 50 g (2 scoops)",
      "Calories": "About 300-320",
      "Third-party testing": "NSF Certified for Sport (brand)",
      "Best for": "High protein targets, value"
    }
  },
  {
    "id": "muscle-milk-genuine-protein-powder",
    "name": "Muscle Milk Genuine Protein Powder",
    "brand": "Muscle Milk",
    "badge": "Best for Weight Gain",
    "category": "Milk protein blend with added carbs and fat",
    "description": "Genuine is the original creamy Muscle Milk shake. Per the label at the time of writing, two scoops of about 70 g give 32 g of protein at roughly 270 to 280 calories, with around 9 g of fat and 21 g of carbohydrate but only 2 to 4 g of sugar. The protein comes from milk protein isolate, whey concentrate and calcium caseinate, and maltodextrin and creamer give it the thick texture buyers like.",
    "pros": [
      "About 32 g protein per serving, per the label",
      "Creamy texture buyers consistently praise",
      "Wide flavor range",
      "NSF Certified for Sport, per the brand"
    ],
    "cons": [
      "Under half its calories come from protein",
      "Maltodextrin, creamer and artificial sweeteners",
      "Wrong tool for a cut"
    ],
    "bottomLine": "Buy it to add easy calories while bulking, not as a lean everyday protein.",
    "specs": {
      "Protein per serving": "About 32 g (2 scoops)",
      "Calories": "About 270-280",
      "Third-party testing": "NSF Certified for Sport (brand)",
      "Best for": "Hard gainers, bulking"
    }
  },
  {
    "id": "muscle-milk-100-whey-protein-powder",
    "name": "Muscle Milk 100% Whey Protein Powder with Probiotics",
    "brand": "Muscle Milk",
    "badge": "Best Everyday Whey",
    "category": "Whey protein with added probiotic",
    "description": "The 100% Whey is Muscle Milk's straight whey product and the leanest scoop in the range. Per the retailer label at the time of writing, one scoop gives about 27 g of protein at roughly 130 calories, with a Bacillus subtilis probiotic added. It uses the same acesulfame potassium and sucralose sweetener pair as the rest of the line. It suits buyers who want a normal single-scoop whey from a brand they can find in any store.",
    "pros": [
      "About 27 g protein per scoop for around 130 calories",
      "Straight whey rather than a milk-protein blend",
      "Single-scoop serving is simple to dose"
    ],
    "cons": [
      "Probiotic adds little for most buyers",
      "Fewer flavors and patchier availability than Pro Series"
    ],
    "bottomLine": "A sensible daily whey if you like the brand, though Pro Series at one scoop is often cheaper.",
    "specs": {
      "Protein per serving": "About 27 g (1 scoop)",
      "Calories": "About 130",
      "Third-party testing": "NSF claim applies to brand powders; check database",
      "Best for": "Everyday post-workout shakes"
    }
  },
  {
    "id": "muscle-milk-zero-protein-powder",
    "name": "Muscle Milk Zero Sugar Protein Powder",
    "brand": "Muscle Milk",
    "badge": "Lightest Option",
    "category": "Low-calorie milk protein powder",
    "description": "Zero is Muscle Milk's light shake: two scoops give about 15 g of protein for roughly 100 calories with zero sugar, per the label at the time of writing. That is lean, but it is also a small dose, and the label itself carries a note that it should not be used for weight reduction. Sweeteners include sucralose and acesulfame potassium alongside stevia. You need nearly two servings to reach 25 g, which pushes its cost per gram to the top of the range.",
    "pros": [
      "About 100 calories per serving with zero sugar",
      "Easy, light shake for people who do not want a big dose"
    ],
    "cons": [
      "Only about 15 g protein per two scoops",
      "Highest cost per 25 g in the range",
      "Still uses artificial sweeteners"
    ],
    "bottomLine": "Skip it for muscle gain; one scoop of Pro Series gives more protein for similar calories.",
    "specs": {
      "Protein per serving": "About 15 g (2 scoops)",
      "Calories": "About 100",
      "Third-party testing": "NSF claim applies to brand powders; check database",
      "Best for": "Light protein drinks"
    }
  },
  {
    "id": "optimum-nutrition-gold-standard-100-whey",
    "name": "Optimum Nutrition Gold Standard 100% Whey",
    "brand": "Optimum Nutrition",
    "badge": "Alternative: Leaner Whey",
    "category": "Whey blend (isolate + concentrate)",
    "description": "If you want a straight whey with fewer texture additives than Muscle Milk, Gold Standard is the obvious alternative. Per the label at the time of writing, a scoop of roughly 30 g gives about 24 g of protein at around 120 calories, with whey isolate listed first in the blend. It is promoted as Informed Choice certified and comes in a far wider flavor range. It usually costs a little more per 25 g than Pro Series.",
    "pros": [
      "About 24 g protein for around 120 calories, per the label",
      "Whey isolate listed first; less filler than Genuine",
      "Promoted as Informed Choice certified"
    ],
    "cons": [
      "Usually pricier per 25 g than Pro Series",
      "Flavored versions use artificial sweeteners"
    ],
    "bottomLine": "The pick if you want a leaner, more widely loved whey than anything in the Muscle Milk range.",
    "specs": {
      "Protein per serving": "About 24 g (1 scoop)",
      "Calories": "About 120",
      "Third-party testing": "Informed Choice (confirm flavor)",
      "Best for": "Everyday whey, flavor choice"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Muscle Milk Protein Powder Review",
          item: `${SITE_URL}/muscle-milk-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Muscle Milk protein powder good for building muscle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, as long as you pick the right tub. Pro Series and 100% Whey both deliver a full dose of protein with most of their calories coming from protein, which is what matters for muscle gain. Genuine works too but adds a lot of carbohydrate and fat. Total daily protein and consistent training matter far more than which Muscle Milk product you choose."
          }
        },
        {
          "@type": "Question",
          "name": "Is Muscle Milk real milk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The powders are built on milk proteins, including milk protein isolate or concentrate, caseinates and whey, so they are dairy products and carry a milk allergen warning. They are not simply dried milk, though. Maltodextrin, creamer, oils, flavors and sweeteners are added for texture and taste. None of the powders are suitable for vegans or people with a milk allergy."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in a scoop of Muscle Milk Pro Series?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The labelled Pro Series serving is two scoops of about 82 g, which gives about 50 g of protein at the time of writing. That means one scoop is roughly 25 g of protein, a standard single dose. Calories run about 300 to 320 for the full serving depending on flavor, so a single scoop is roughly half that."
          }
        },
        {
          "@type": "Question",
          "name": "Is Muscle Milk NSF Certified for Sport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per the brand, its protein powders are NSF Certified for Sport, and retailer listings for Pro Series and Genuine repeat the claim. The program screens for more than 270 banned substances and checks label accuracy. If you are a drug-tested athlete, confirm your exact product and flavor in the NSF Certified for Sport database before buying, because status can vary."
          }
        },
        {
          "@type": "Question",
          "name": "Does Muscle Milk have artificial sweeteners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The flavored powders we checked list acesulfame potassium and sucralose, and Zero also lists stevia. These sweeteners are approved for use in food in the US and keep sugar low, around 2 to 4 g per serving in most flavors. If you avoid artificial sweeteners, Muscle Milk is not the brand for you; look for unflavored or stevia-only powders."
          }
        },
        {
          "@type": "Question",
          "name": "Is Muscle Milk good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not especially. Genuine is too calorie-dense for most cutting diets, and Zero gives so little protein per serving that it does a poor job of keeping you full. If you are losing weight, a single scoop of Pro Series or the 100% Whey is the better choice from this brand, or look at a lean isolate. This is general information, not medical advice."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns Muscle Milk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muscle Milk is made by CytoSport. Hormel Foods bought CytoSport in 2014, and PepsiCo acquired it from Hormel in 2019, so the brand is now part of PepsiCo. That is why Muscle Milk shakes and powders are so widely distributed, from grocery stores and gas stations to Amazon and warehouse clubs, and why discounts are frequent."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Brand Reviews",
    tags: [
      "muscle milk protein powder",
      "muscle milk powder",
      "muscle milk review",
      "muscle milk pro series"
    ],
  }}
  jsonLd={schema}
  stickyCta={{
    text: "See Our Top Muscle-Gain Picks",
    link: "/best-protein-powder-for-muscle-gain/",
  }}
>
  <article class="relative overflow-hidden">
    <!-- Hero Section -->
    <div class="bg-gray-900 py-16 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, #38BDF8 0, transparent 45%), radial-gradient(circle at 80% 60%, #FF4500 0, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <div class="flex justify-center mb-6">
          <TrustBadge />
        </div>
        <div class="flex justify-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FF4500]/20 text-[#FF4500] text-xs font-black uppercase tracking-widest border border-[#FF4500]/30">
            Brand Review
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-widest border border-green-500/20">
            Label-Checked
          </span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black text-white leading-tight mb-8">
          Muscle Milk <span class="text-[#38BDF8]">Protein Powder</span> Review
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
          Four Muscle Milk powders, read off the label: how much protein each scoop really gives you, what the extra calories are made of, and which tub earns its place in a muscle-building diet.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#muscle-milk-pro-series-protein-powder"
            class="px-8 py-4 bg-[#FF4500] hover:bg-[#E63E00] text-white font-black rounded-xl shadow-lg transition-all no-underline"
          >
            See Our #1 Pick
          </a>
          <a
            href="#cost-per-25g"
            class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl border border-white/10 no-underline"
          >
            Compare the Range
          </a>
        </div>
      </div>
    </div>

    <!-- Author & Meta -->
    <div class="max-w-3xl mx-auto px-4 pt-12">
      <div class="flex items-center gap-6 border-b border-gray-100 pb-8">
        <div class="flex items-center gap-3">
          <AuthorAvatar size={48} />
          <div>
            <p class="text-sm font-bold text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500 uppercase tracking-widest">{author.role}</p>
          </div>
        </div>
        <div class="h-10 w-px bg-gray-200 hidden sm:block"></div>
        <div class="hidden sm:block">
          <p class="text-sm font-bold text-gray-900">Last Updated</p>
          <p class="text-xs text-gray-500">{dates.display}</p>
        </div>
        <div class="hidden sm:block ml-auto">
          <SocialProof />
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8">
        <h2 class="text-lg font-black text-gray-900 mb-4 flex items-center gap-2">
          In This Guide
        </h2>
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <a href="#verdict" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">1. The Short Verdict</a>
          <a href="#the-brand" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">2. Who Makes Muscle Milk</a>
          <a href="#range-compared" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">3. The Range Side by Side</a>
          <a href="#top-picks" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">4. Our Top Picks</a>
          <a href="#cost-per-25g" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">5. Cost per 25 g of Protein</a>
          <a href="#protein-blend" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">6. What Is in the Protein Blend</a>
          <a href="#calories" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">7. Where the Calories Come From</a>
          <a href="#certification" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">8. NSF Certification</a>
          <a href="#who-should-skip" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">9. Who Should Skip It</a>
          <a href="#how-to-use" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">10. How to Use It for Muscle Gain</a>
          <a href="#mistakes" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">11. Common Mistakes</a>
          <a href="#faq" class="text-sm text-gray-600 hover:text-[#1E90FF] no-underline py-1 font-medium">12. FAQ</a>
        </nav>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="text-2xl font-medium text-gray-900 mb-8 italic">
          Muscle Milk is a good protein powder brand with one great product and three that only make sense for specific people. The Pro Series packs 50 g of milk protein into a two-scoop serving and carries NSF Certified for Sport, which makes it one of the cheapest certified routes to a lot of protein. Genuine is a creamy, higher-fat shake that works best as a calorie top-up. The 100% Whey is a sensible everyday scoop. Zero gives you only 15 g of protein per serving and is the one we would skip.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="verdict" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. The Short Verdict
          </h2>

          <p>
            If you only read one paragraph, read this one. <strong>Buy the Muscle Milk Pro Series</strong> if you want a lot of protein for the money and you train hard enough to use 50 g in a sitting, or you are happy to split the serving into two single-scoop shakes of about 25 g each. It is the product in the range where the label, the price and the certification line up.
          </p>

          <p>
            Buy <strong>Genuine</strong> only if you are trying to gain weight and actively want the extra fat and carbohydrate. At roughly 270 to 280 calories for 32 g of protein, it behaves more like a light mass shake than a lean protein powder, and that is fine if you know that is what you are buying. If you are cutting, it is the wrong tub.
          </p>

          <p>
            The <strong>100% Whey</strong> is a perfectly reasonable everyday whey at about 27 g of protein for around 130 calories per scoop, with a probiotic added. <strong>Zero</strong> is where the range loses us: 15 g of protein per two-scoop serving means you need almost two servings to reach a useful dose, and the cost per gram climbs to the top of the range.
          </p>

          <p>
            Compared with the rest of the market, Muscle Milk is not the cleanest label and not the best-tasting brand by buyer consensus, but it is widely stocked, often discounted on Amazon and certified across its powder line. For a full ranking against other brands, see our guide to the <a href="/best-protein-powder-for-muscle-gain/">best protein powder for muscle gain</a>.
          </p>

          <div class="bg-gray-900 text-white rounded-2xl p-6 lg:p-8 my-8">
            <p class="text-xs font-black uppercase tracking-widest text-[#38BDF8] mb-3">THE VERDICT</p>
            <p class="text-xl font-bold text-white mb-3">Pro Series is the one to buy. Zero is the one to skip.</p>
            <p class="text-gray-300 leading-relaxed m-0">Pro Series gives you about 50 g of protein per two-scoop serving at one of the lowest certified costs per 25 g we found. Zero gives you 15 g per two scoops, so you pay far more for every gram of protein.</p>
          </div>
        </div>

        <div id="the-brand" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. Who Makes Muscle Milk
          </h2>

          <p>
            Muscle Milk is made by CytoSport, a California sports-nutrition company that built the brand around a creamy, milk-based shake. Hormel Foods bought CytoSport in 2014, and PepsiCo acquired it from Hormel in 2019. That ownership is why you now see Muscle Milk next to Gatorade and other PepsiCo drinks in gas stations and grocery fridges.
          </p>

          <p>
            The brand today is better known for its ready-to-drink shakes than its powders, and that matters when you shop. Search results, store shelves and Amazon listings mix the two together, and the bottled shakes have different protein figures from the tubs. This review covers the powders only. If you want a bottle in the fridge, compare shakes against tubs on cost per gram first, because the powder is almost always cheaper.
          </p>

          <p>
            Muscle Milk positions itself as a mainstream, gym-floor brand rather than a clean-label or premium one. You will not find grass-fed claims, organic seals or single-ingredient tubs here. What you will find is a lot of protein per serving, a long ingredient list built for texture, and two artificial sweeteners, acesulfame potassium and sucralose, across the flavored range.
          </p>

          <p>
            That positioning is not a criticism on its own. Most people buying a 5 lb tub of protein want it to taste like a milkshake, mix easily and not cost a fortune. Muscle Milk is built for that buyer. Readers who want a short ingredient list should look at our <a href="/best-clean-protein-powder/">best clean protein powder</a> picks instead.
          </p>
        </div>

        <div id="range-compared" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. The Range Side by Side
          </h2>

          <p>
            Muscle Milk sells four powders in tubs at the time of writing: Pro Series, Genuine, 100% Whey with probiotics and Zero. They look similar on the shelf, all in the same black-and-color branding, but they are very different products. The table below puts the key label numbers in one place so you can see the gap between them before reading the cards.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Powder</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein / serving</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Serving</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Calories</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Pro Series</td>
                    <td class="px-4 py-4 text-gray-700">About 50 g</td>
                    <td class="px-4 py-4 text-gray-700">2 scoops (about 82 g)</td>
                    <td class="px-4 py-4 text-gray-700">About 300-320</td>
                    <td class="px-4 py-4 text-gray-700">Big doses, value</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Genuine</td>
                    <td class="px-4 py-4 text-gray-700">About 32 g</td>
                    <td class="px-4 py-4 text-gray-700">2 scoops (about 70 g)</td>
                    <td class="px-4 py-4 text-gray-700">About 270-280</td>
                    <td class="px-4 py-4 text-gray-700">Weight gain</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
