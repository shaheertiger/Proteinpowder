          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Be Well by Kelly Protein Powder Review",
          item: `${SITE_URL}/be-well-by-kelly-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Be Well by Kelly protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a well-made, very clean beef protein: one to three ingredients, monk fruit as the only sweetener, and 23 to 24 g of protein per scoop, per the brand. Its weaknesses are price, at about $2.35 per 25 g, a collagen-heavy amino acid profile and no published testing. It suits dairy-free buyers who value a short label more than cost."
