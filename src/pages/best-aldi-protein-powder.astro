const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best Aldi Protein Powder",
          item: `${SITE_URL}/best-aldi-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best Aldi protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most shoppers it is Elevation by Millville whey protein blend, because it is the only powder in Aldi's core range and it is cheap. Per the label it gives 30 g of protein per serving. In the 2 lb tub at around $20 it costs roughly $0.80 to $0.95 per 25 g of protein, which beats most name brands sold in supermarkets."
          }
