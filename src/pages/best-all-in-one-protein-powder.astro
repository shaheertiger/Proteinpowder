---
import Layout from "../layouts/Layout.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ProductCard from "../components/ProductCard.astro";
import MoreInCategory from "../components/MoreInCategory.astro";
import { AUTHORS, DEFAULT_AUTHOR, authorSchema } from "../data/authors";
import { SITE_NAME, SITE_URL } from "../data/site";
import QuickPicks from "../components/QuickPicks.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { pageDates } from "../data/dates";

const moreInCategory = [
  {
    "title": "Best Protein Powder With Probiotics",
    "url": "/best-protein-powder-with-probiotics/"
  },
  {
    "title": "Best Protein Powder With Fiber",
    "url": "/best-protein-powder-with-fiber/"
  },
  {
    "title": "Best Organic Protein Powder",
    "url": "/best-organic-protein-powder/"
  },
  {
    "title": "Best Whole Food Protein Powder",
    "url": "/best-whole-food-protein-powder/"
  },
  {
    "title": "Best Protein Powder for Weight Loss",
    "url": "/best-protein-powder-for-weight-loss/"
  }
];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-09", modified: "2026-11-09" });
const title = "Best All-in-One Protein Powder: Protein, Greens, Vitamins";
const description =
  "The best all-in-one protein powder on Amazon: Ka'Chava, Orgain, Vega and more ranked on protein, greens, vitamins and price, and if one scoop replaces three.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "kachava-chocolate",
    "name": "Ka'Chava All-In-One Nutrition Shake, Chocolate",
    "brand": "Ka'Chava",
    "badge": "Best Overall",
    "category": "Plant protein, superfood, vitamin and probiotic blend",
    "description": "Ka'Chava is the shake that defines the category. Per a retailer label at the time of writing (Chocolate), a 62 g serving gives 25 g of protein from pea and brown rice, 240 calories, 6 g of fiber and 7 g of sugar (4 g added), with a long greens and superfoods blend, added vitamins and minerals, probiotics and enzymes. Ka'Chava says it tests ingredients for heavy metals, pesticides and microbes. It is the most complete label here and also the most expensive per serving.",
    "pros": [
      "25 g of plant protein with added vitamins, minerals, fiber and probiotics",
      "The most complete all-in-one label of the six",
      "Brand describes in-house and outside testing for heavy metals and microbes"
    ],
    "cons": [
      "Roughly $4 to $4.70 per serving, the most expensive pick",
      "About 4 g of added sugar from coconut nectar",
      "Proprietary superfood blend, so you cannot see how much of each ingredient you get"
    ],
    "bottomLine": "The best true all-in-one if the price works for you; treat it as a light meal, not a post-workout scoop.",
    "specs": {
      "Protein / serving": "25 g (label)",
      "Calories": "240",
      "What's included": "Greens, vitamins, minerals, fiber, probiotics",
      "Best for": "Light meal replacement"
    }
  },
  {
    "id": "orgain-organic-protein-50-superfoods",
    "name": "Orgain Organic Protein + 50 Superfoods",
    "brand": "Orgain",
    "badge": "Best Value",
    "category": "Organic plant protein with superfoods and probiotics",
    "description": "Orgain's superfoods version adds an organic fruit, vegetable and greens blend and probiotics to its best-selling plant protein. The retailer panel we read listed 21 g of protein, 160 calories and 8 g of fiber per two-scoop serving, with 1 billion probiotics from five species including Bacillus coagulans, per the brand. It is certified organic, widely stocked and costs well under half of Ka'Chava per serving. It does not carry Ka'Chava's full added vitamin and mineral panel, so it is protein plus superfoods rather than a complete nutrition shake.",
    "pros": [
      "21 g of plant protein and 8 g of fiber per the retailer panel",
      "Probiotics and a superfood blend at a mid-range price",
      "USDA organic and easy to find on Amazon"
    ],
    "cons": [
      "No comprehensive added vitamin and mineral panel like Ka'Chava's",
      "Superfood amounts are small and not individually disclosed",
      "Sweetened mainly with stevia, which some buyers dislike"
    ],
    "bottomLine": "The best value if you want protein, fiber and some greens without paying meal-shake prices.",
    "specs": {
      "Protein / serving": "21 g (retailer panel)",
      "Calories": "About 160",
      "What's included": "Superfood blend, fiber, probiotics",
      "Best for": "Daily shake on a budget"
    }
  },
  {
    "id": "vega-organic-all-in-one-shake",
    "name": "Vega Organic All-in-One Shake",
    "brand": "Vega",
    "badge": "Best Lighter All-in-One",
    "category": "Organic plant protein with greens, vitamins and probiotics",
    "description": "This is the successor to Vega One, long the best-known plant all-in-one, which has been renamed and reformulated; retailers list some old Vega One flavors as discontinued. Retailer listings at the time of writing give about 20 g of protein from pea, sunflower and pumpkin seed per scoop at roughly 150 to 160 calories, with greens, about 4 g of fiber, probiotics and vitamins and minerals sourced partly from fruits and vegetables. Labels differ between versions, so read the panel image on the exact listing.",
    "pros": [
      "About 20 g of protein in roughly 150 to 160 calories, per listings",
      "Greens, fiber, probiotics and vitamins in one organic scoop",
      "Lighter than Ka'Chava, so it fits as a snack rather than a meal"
    ],
    "cons": [
      "Recent rename means old and new labels coexist on Amazon",
      "Less protein than Ka'Chava or Vega's protein-first powders",
      "Probiotic and vitamin figures vary between listings"
    ],
    "bottomLine": "A lighter, organic all-in-one for people who want the Vega One formula's breadth in fewer calories.",
    "specs": {
      "Protein / serving": "About 20 g (listing)",
      "Calories": "About 150-160",
      "What's included": "Greens, vitamins, fiber, probiotics",
      "Best for": "Lighter daily all-in-one"
    }
  },
  {
    "id": "amazing-grass-protein-superfood",
    "name": "Amazing Grass Protein Superfood",
    "brand": "Amazing Grass",
    "badge": "Best Greens-First Blend",
    "category": "Organic plant protein with greens and fruits",
    "description": "Amazing Grass started as a greens powder company, and Protein Superfood is its greens powder with protein built in. The brand says a serving delivers 20 g of protein from an organic blend of pea, hemp, chia and quinoa, along with seven greens and two servings of fruits and vegetables. Third-party nutrition databases put a scoop at roughly 110 to 140 calories depending on flavor and label version. It is certified organic and kosher pareve. It is not fortified with a full vitamin and mineral panel.",
    "pros": [
      "20 g of protein from a four-source organic plant blend, per the brand",
      "Seven greens plus fruit and vegetable powders",
      "Certified organic and kosher pareve"
    ],
    "cons": [
      "Calorie and serving figures vary between label versions",
      "Grassy flavor that buyers say needs a blender and fruit",
      "No comprehensive vitamin and mineral fortification"
    ],
    "bottomLine": "The pick if greens matter more to you than vitamins and you want a shorter, organic ingredient list.",
    "specs": {
      "Protein / serving": "20 g (brand)",
      "Calories": "About 110-140 by version",
      "What's included": "Greens, fruit and vegetable powders",
      "Best for": "Greens-first smoothies"
    }
  },
  {
    "id": "orgain-organic-protein-greens",
    "name": "Orgain Organic Protein + Greens",
    "brand": "Orgain",
    "badge": "Best Budget Greens",
    "category": "Organic plant protein with greens",
    "description": "Orgain's greens version of its best-selling plant powder is the cheapest way to get protein and a meaningful greens serving in one scoop. Per the retailer label at the time of writing (Vanilla Bean), a 49 g two-scoop serving gives 21 g of protein from pea, brown rice and chia, 150 calories, 1 g of sugar and 5 g of erythritol, with organic spinach, broccoli and kale. The brand describes the greens as roughly 15 spinach leaves, 2 broccoli florets and half a cup of kale per serving.",
    "pros": [
      "21 g of protein and only 1 g of sugar per the label",
      "Greens quantified in kitchen terms by the brand",
      "Usually one of the cheapest organic protein-and-greens options"
    ],
    "cons": [
      "Greens only, with no added vitamins or probiotics",
      "Contains erythritol, which can upset some stomachs",
      "Earthy taste that buyers say works better blended"
    ],
    "bottomLine": "The budget pick if you want protein and greens and already take a multivitamin.",
    "specs": {
      "Protein / serving": "21 g (label)",
      "Calories": "150",
      "What's included": "Spinach, broccoli and kale",
      "Best for": "Lowest-cost protein plus greens"
    }
  },
  {
    "id": "huel-complete-protein",
    "name": "Huel Complete Protein",
    "brand": "Huel",
    "badge": "Best Lean Protein With Vitamins",
    "category": "Plant protein with added vitamins and minerals",
    "description": "Huel Complete Protein comes at all-in-one from the other side: a lean protein powder with a full vitamin and mineral panel and no superfood list. Huel's US label lists a 29 g scoop with 20 g of protein from pea, faba bean and brown rice protein, about 110 calories, 0 g of sugar and 27 added vitamins and minerals. It is sweetened with sucralose in the US formula. It suits people who want micronutrient insurance in a post-workout shake without meal-shake calories.",
    "pros": [
      "27 added vitamins and minerals in about 110 calories, per Huel",
      "20 g of protein with 0 g of sugar",
      "Thinner and lighter than meal-style all-in-ones"
    ],
    "cons": [
      "No greens or probiotics",
      "Sweetened with sucralose in the US formula",
      "Stacking it with a multivitamin can double up some nutrients"
    ],
    "bottomLine": "The best all-in-one for lifters who want vitamins with their protein and nothing else.",
    "specs": {
      "Protein / serving": "20 g (brand label)",
      "Calories": "About 110",
      "What's included": "27 vitamins and minerals",
      "Best for": "Post-workout with micronutrients"
    }
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Best All-in-One Protein Powder",
          item: `${SITE_URL}/best-all-in-one-protein-powder/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "What is the best all-in-one protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most people, Ka'Chava is the best all-in-one protein powder: 25 g of plant protein, added vitamins and minerals, greens, 6 g of fiber and probiotics in about 240 calories, per the label at the time of writing. It costs roughly $4 to $4.70 per serving. Orgain Organic Protein + 50 Superfoods is the better value."
          }
        },
        {
          "@type": "Question",
          "name": "Can an all-in-one shake replace a meal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some can replace a light meal. Ka'Chava, at about 240 calories with protein, fiber and vitamins, works as a small breakfast or lunch, especially blended with milk or fruit. Most all-in-ones are 110 to 160 calories, which is a snack. For a full meal, a dedicated meal replacement with 300 to 400 calories is better."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ka'Chava worth the money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is worth it if it replaces a protein powder, a greens powder and a multivitamin, or a breakfast you would otherwise buy. It is not worth it just for protein, since it costs several times more per 25 g of protein than whey. Compare its price per serving with the cost of buying those products separately."
          }
        },
        {
          "@type": "Question",
          "name": "Do I still need a multivitamin with an all-in-one protein powder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually not if your all-in-one is fortified, such as Ka'Chava, Vega's All-in-One or Huel Complete Protein. Taking both can push some nutrients toward upper limits. Greens-only blends such as Orgain Protein + Greens are not fortified, so they do not replace a multivitamin. Ask your doctor if you have specific deficiencies."
          }
        },
        {
          "@type": "Question",
          "name": "What happened to Vega One?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vega One appears to have been renamed and reformulated as Vega's Organic All-in-One Shake, and retailers list several old Vega One flavors as discontinued. Listings for both can still appear on Amazon, with different nutrition panels. Read the label image on the listing and the bag you receive, and treat the bag as the final word."
          }
        },
        {
          "@type": "Question",
          "name": "Are all-in-one protein powders safe for daily use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most healthy adults, a reputable all-in-one at the labeled serving is reasonable daily. Choose brands that describe heavy-metal testing, because plant and greens ingredients can carry lead and cadmium. If you are pregnant, take medication or have a medical condition, ask your doctor or a registered dietitian before using one every day."
          }
        },
        {
          "@type": "Question",
          "name": "Are all-in-one protein powders good for weight loss?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They can help because protein and fiber keep you fuller, and a 150 to 240 calorie shake can replace a higher-calorie breakfast. They do not burn fat on their own, and adding one on top of your usual meals adds calories. Fit it into your daily calorie and protein targets, and see our weight loss protein guide."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
      },
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: dates.published,
    modifiedTime: dates.modified,
    author: author.name,
    section: "Specialty Protein",
    tags: [
      "all in one protein powder",
      "best all in one protein powder",
      "all in one nutrition shake",
      "protein powder with greens and vitamins",
      "superfood protein powder"
    ],
  }}
  jsonLd={schema}
>
  <article class="relative overflow-hidden">
    <ArticleHeader kicker={"Buyer's Guide"} badge={"Updated November 2026"} author={author} dates={dates} mobileAd={false}>
      <Fragment slot="title">Best All-in-One Protein Powder</Fragment>
      Six protein, greens and vitamin blends ranked on what the label actually delivers per scoop, what the superfood list adds, sugar and sweeteners and cost per serving, plus who should skip them.
    </ArticleHeader>

    <TableOfContents>
      <a href="#quick-comparison">Quick Comparison</a>
      <a href="#top-picks">Our Top Picks</a>
      <a href="#what-is-all-in-one">What Counts as All-in-One</a>
      <a href="#vs-meal-replacement">vs Meal Replacement</a>
      <a href="#replace-multivitamin">Can It Replace a Multivitamin?</a>
      <a href="#worth-the-price">Worth the Price?</a>
      <a href="#safety">Safety and Who Should Skip</a>
      <a href="#buying-on-amazon">Buying on Amazon</a>
      <a href="#how-we-picked">How We Picked</a>
      <a href="#mistakes">Common Mistakes</a>
      <a href="#faq">FAQ</a>
    </TableOfContents>

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 pb-16 lg:pb-24">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed">
        <p class="lede">
          The best all-in-one protein powder for most people is <strong>Ka'Chava</strong>: 25 g of plant protein, a full vitamin and mineral panel, greens, fiber and probiotics in one 240-calorie scoop, per the label at the time of writing. It is expensive, at roughly $4 to $4.70 per serving, so if you mainly want protein with some greens and a lower price, <strong>Orgain Organic Protein + 50 Superfoods</strong> is the better value.
        </p>

        <QuickPicks products={PRODUCTS} />

        <div id="quick-comparison" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            1. Quick Comparison: The Best All-in-One Protein Powders
          </h2>

          <p>
            The short version: Ka'Chava is the most complete all-in-one and works as a light meal, Orgain Protein + 50 Superfoods is the best value, Vega's All-in-One Shake is the lighter organic option, Amazing Grass Protein Superfood leads with greens, Orgain Protein + Greens is the budget greens pick and Huel Complete Protein is the lean option with vitamins and no superfoods. Nothing here replaces vegetables on a plate. All figures are per the label or retailer listing at the time of writing and vary by flavor.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Product</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Protein per serving</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What's included</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Best for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Ka'Chava</td>
                    <td class="px-4 py-4 text-gray-700">25 g</td>
                    <td class="px-4 py-4 text-gray-700">Greens, vitamins, minerals, fiber, probiotics</td>
                    <td class="px-4 py-4 text-gray-700">Light meal</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Orgain Protein + 50 Superfoods</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">Superfoods, fiber, probiotics</td>
                    <td class="px-4 py-4 text-gray-700">Best value</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Vega Organic All-in-One</td>
                    <td class="px-4 py-4 text-gray-700">About 20 g</td>
                    <td class="px-4 py-4 text-gray-700">Greens, vitamins, fiber, probiotics</td>
                    <td class="px-4 py-4 text-gray-700">Lighter all-in-one</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Amazing Grass Protein Superfood</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">Greens, fruit and vegetable powders</td>
                    <td class="px-4 py-4 text-gray-700">Greens-first</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Orgain Protein + Greens</td>
                    <td class="px-4 py-4 text-gray-700">21 g</td>
                    <td class="px-4 py-4 text-gray-700">Spinach, broccoli, kale</td>
                    <td class="px-4 py-4 text-gray-700">Budget greens</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Huel Complete Protein</td>
                    <td class="px-4 py-4 text-gray-700">20 g</td>
                    <td class="px-4 py-4 text-gray-700">27 vitamins and minerals</td>
                    <td class="px-4 py-4 text-gray-700">Lean, post-workout</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>
            Two picks we deliberately left out are worth naming. Huel Black Edition is a popular high-protein meal powder, but Consumer Reports' 2025 testing put its lead at about 1,288% of the group's level of concern per serving and advised avoiding it. Garden of Life Sport's plant protein measured about 564%, and CR suggested limiting it. Our <a href="/best-protein-powder-without-heavy-metals/">best protein powder without heavy metals</a> guide covers that testing in full.
          </p>
        </div>

        <!-- Picks -->
        <div id="top-picks" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            2. The Best All-in-One Protein Powders, Ranked
          </h2>

          <p>
            These six are ranked on protein per serving, how complete the rest of the label is (vitamins and minerals, greens, fiber, probiotics), sugar and sweeteners, transparency about testing, and cost per serving. We did not lab-test them; picks rest on labels, brand statements and published research, and taste and mixing notes are buyer reports, as explained on our <a href="/how-we-test/">how we test</a> page. Figures are per the label at the time of writing and vary by flavor.
          </p>

          {PRODUCTS.map((product, index) => (
            <ProductCard product={product} rank={index + 1} />
          ))}
        </div>

        <div id="what-is-all-in-one" class="scroll-mt-24">
          <h2 class="text-3xl font-black text-gray-900 mt-16 mb-6">
            3. What Is an All-in-One Protein Powder?
          </h2>

          <p>
            There is no regulated definition, which is why the term covers products that are quite different. In practice, an all-in-one protein powder combines a protein base, usually plant protein, with at least two of the following: added vitamins and minerals, a greens or superfood blend, fiber, probiotics, digestive enzymes and sometimes adaptogens or mushrooms. The pitch is that one scoop replaces a protein powder, a greens powder and a multivitamin.
          </p>

          <p>
            The labels sort into three rough groups. Full nutrition shakes such as Ka'Chava and Vega's All-in-One have protein, greens, a vitamin and mineral panel, fiber and probiotics, and sit closer to a meal. Protein-plus-superfoods powders such as the two Orgain picks and Amazing Grass add greens and fruit powders, sometimes probiotics, but little or no vitamin fortification. And fortified protein powders such as Huel Complete Protein add vitamins and minerals to a lean protein without the superfood list.
          </p>

          <div class="overflow-hidden border border-gray-200 rounded-2xl my-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Feature</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Ka'Chava</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Vega All-in-One</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Orgain 50 Superfoods</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Amazing Grass</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Orgain Greens</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Huel Complete</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein 20 g+</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Added vitamins and minerals</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Not a full panel</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">No</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Greens or superfoods</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
                    <td class="px-4 py-4 text-gray-700">Yes</td>
