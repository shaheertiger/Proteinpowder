  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "banza-chickpea-pasta-variety-pack",
    "name": "Banza Chickpea Pasta, Cavatappi, 8 oz",
    "brand": "Banza",
    "badge": "Best Overall",
