const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Ryse Protein Review",
          item: `${SITE_URL}/ryse-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Ryse protein powder good?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ryse Loaded Protein is a good flavored whey. It delivers about 25 g of protein per scoop from whey isolate and concentrate in roughly 130 to 150 calories, per retailer labels. Buyers rate its licensed flavors highly. Its weak points are artificial sweeteners, no confirmed sport certification and a mid-to-upper price per 25 g of protein."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ryze protein powder the same as Ryse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Most searches for Ryze protein powder are misspellings of Ryse, the sports nutrition brand that makes Loaded Protein and Clear Protein. Ryze is a separate company known for mushroom coffee. When shopping, check that the listing says RYSE and shows the protein tub you want."
          }
        },
        {
          "@type": "Question",
          "name": "How much protein is in Ryse Loaded Protein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "About 25 g per scoop across flavors, per retailer labels at the time of writing, with calories ranging from about 130 to 150 because scoop weights differ. Ryse Clear Protein lists about 22 g per serving, and Loaded Plant Protein about 20 g. Check the panel on your flavor, because figures shift slightly between versions."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ryse Loaded Protein whey isolate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a blend. Retailers describe whey isolate as the primary source, but the ingredient list also includes whey concentrate. That is common and fine for most people. Ryse Clear Protein is described as 100% ultra-filtered whey isolate, so choose that, or a dedicated isolate, if you need very low lactose."
          }
        },
        {
          "@type": "Question",
          "name": "What sweeteners are in Ryse protein?",
