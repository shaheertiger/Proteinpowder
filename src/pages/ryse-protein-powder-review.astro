                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">Loaded Protein (per scoop)</th>
                    <th class="px-4 py-4 font-bold text-gray-600 text-sm">What it means</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein</td>
                    <td class="px-4 py-4 text-gray-700">About 25 g</td>
                    <td class="px-4 py-4 text-gray-700">A full standard serving</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Calories</td>
                    <td class="px-4 py-4 text-gray-700">About 130 to 150</td>
                    <td class="px-4 py-4 text-gray-700">Varies by flavor and scoop weight</td>
                  </tr>
                  <tr class="bg-white border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Protein source</td>
                    <td class="px-4 py-4 text-gray-700">Whey isolate and concentrate</td>
                    <td class="px-4 py-4 text-gray-700">A blend, not a pure isolate</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Sweeteners</td>
                    <td class="px-4 py-4 text-gray-700">Sucralose, acesulfame K</td>
                    <td class="px-4 py-4 text-gray-700">Artificial; avoid if sensitive</td>
                  </tr>
