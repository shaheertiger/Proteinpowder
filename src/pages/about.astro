---
import Layout from "../layouts/Layout.astro";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import { AUTHORS, DEFAULT_AUTHOR, SITE_URL } from "../data/authors";
import { CONTACT_EMAIL, FOUNDED, SITE_NAME } from "../data/site";

const title = `About ${SITE_NAME}`;
const description =
  "Who writes these protein powder guides, how the site is funded, and the editorial rules we hold ourselves to.";

const author = AUTHORS[DEFAULT_AUTHOR];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "About", item: `${SITE_URL}/about/` },
      ],
    },
    {
      "@type": "AboutPage",
      name: title,
      description,
      url: `${SITE_URL}/about/`,
      mainEntity: {
        "@type": "Organization",
        name: SITE_NAME,
        url: SITE_URL,
        email: CONTACT_EMAIL,
        foundingDate: FOUNDED,
        description,
      },
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={schema}>
  <article class="max-w-3xl mx-auto px-4 py-16 lg:py-24">
    <p class="text-xs font-black uppercase tracking-widest text-[#FF4500] mb-4">About Us</p>
    <h1 class="text-4xl lg:text-5xl font-black text-gray-900 leading-tight mb-6">
      We read the label, do the maths, and tell you which tub to buy
    </h1>
    <p class="text-xl text-gray-600 leading-relaxed mb-10">
      {SITE_NAME} publishes buying guides and plain-English explainers for protein powder — whey, isolate, casein and plant — and the questions people ask before spending money on one.
    </p>

    <h2 class="text-2xl font-black text-gray-900 mb-4">Why the site exists</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Search for the best protein powder and you get the same ten bestsellers reshuffled across a dozen sites, each one "the cleanest" and "the best tasting". None of it answers the questions that decide whether a tub is good value: how much protein is in a scoop once you take the flavouring out, what that protein costs per 25 grams, whether anyone independent has checked the label, and whether you need protein powder at all.
    </p>
    <p class="text-gray-700 leading-relaxed mb-10">
      We started in {FOUNDED} to write the guide we wanted to read before buying: the number on the nutrition panel that matters, the ingredient that explains the stomach ache, and a straight answer about which one to buy — including when the answer is "the cheap one is fine".
    </p>

    <h2 class="text-2xl font-black text-gray-900 mb-4">What we promise</h2>
    <div class="grid sm:grid-cols-2 gap-4 mb-12">
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <p class="font-black text-gray-900 mb-2">Every product gets a cons list</p>
        <p class="text-sm text-gray-600 m-0">Including the one we rank first. A guide with no criticism in it is an advert.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <p class="font-black text-gray-900 mb-2">Nobody can buy a ranking</p>
        <p class="text-sm text-gray-600 m-0">No sponsored placements, no paid reviews, no pre-publication approval for brands.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <p class="font-black text-gray-900 mb-2">We say when you do not need it</p>
        <p class="text-sm text-gray-600 m-0">Plenty of people already eat enough protein. We would rather tell you than sell you a tub.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <p class="font-black text-gray-900 mb-2">We show our working</p>
        <p class="text-sm text-gray-600 m-0">Each guide states what we checked and why — see <a href="/how-we-test/" class="text-[#1E90FF] font-bold no-underline hover:underline">How We Test</a>.</p>
      </div>
    </div>

    <h2 class="text-2xl font-black text-gray-900 mb-4">How we are funded</h2>
    <p class="text-gray-700 leading-relaxed mb-10">
      Affiliate commission and advertising, and nothing else. When you buy through a link here we may earn a share of the sale at no extra cost to you. Commission does not vary between the products inside a guide, so it cannot decide a ranking. The full detail is on <a href="/how-we-test/" class="text-[#1E90FF] font-bold no-underline hover:underline">How We Test</a>.
    </p>

    <h2 class="text-2xl font-black text-gray-900 mb-4">What we are not</h2>
    <p class="text-gray-700 leading-relaxed mb-10">
      We are not your doctor or dietitian. Our guides explain the published evidence and what is on the label; they are not personal medical or dietary advice. If you have kidney disease, are pregnant, have a food allergy or take medication, talk to a qualified professional before changing what you eat.
    </p>

    <h2 class="text-2xl font-black text-gray-900 mb-6">The team</h2>
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 lg:p-8 mb-10">
      <div class="flex items-start gap-4">
        <AuthorAvatar author={author.slug} size={56} />
        <div>
          <p class="text-lg font-black text-gray-900 mb-1">
            <a href={`/authors/${author.slug}/`} class="text-gray-900 no-underline hover:text-[#1E90FF]">{author.name}</a>
          </p>
          <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-3">{author.role}</p>
          <p class="text-sm text-gray-700 leading-relaxed m-0">{author.short}</p>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-8">
      <p class="text-gray-700 leading-relaxed m-0">
        Questions, corrections, or a powder you think we have got wrong — <a href="/contact/" class="text-[#1E90FF] font-bold no-underline hover:underline">get in touch</a>. We read everything.
      </p>
    </div>
  </article>
</Layout>
