                    <td class="px-4 py-4 font-black text-gray-900">Calories per serving</td>
                    <td class="px-4 py-4 text-gray-700">About 60 to 70</td>
                    <td class="px-4 py-4 text-gray-700">About 110 to 160</td>
                  </tr>
                  <tr class="bg-gray-50 border-b border-gray-100">
                    <td class="px-4 py-4 font-black text-gray-900">Evidence for</td>
                    <td class="px-4 py-4 text-gray-700">Joint pain (modest), skin (disputed)</td>
                    <td class="px-4 py-4 text-gray-700">Muscle size, strength, daily protein</td>
                  </tr>
