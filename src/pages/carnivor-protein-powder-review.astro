const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Best Lists",
          item: `${SITE_URL}/best-of/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Carnivor Protein Powder Review",
          item: `${SITE_URL}/carnivor-protein-powder-review/`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is Carnivor third-party tested?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, per MuscleMeds. The brand says Carnivor is Informed Choice certified, tested for over 200 substances on the WADA banned list and made in a GMP-compliant facility, and the Informed Choice logo is on the label. MuscleMeds appears on Informed Choice's certified-brands list, but we could not confirm the exact product listing, so drug-tested athletes should check their flavor and batch on the registry."
          }
        },
        {
          "@type": "Question",
          "name": "Is Carnivor protein powder healthy and clean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a reasonable protein source but not a clean-label product. A scoop gives 23 g of protein with 0 g of fat and sugar, per the label, but the ingredients include maltodextrin, artificial flavors, sucralose, acesulfame potassium, xanthan gum and a multi-ingredient antifoam. If clean means few ingredients and no artificial sweeteners, choose an unflavored beef isolate instead."
          }
        },
        {
          "@type": "Question",
          "name": "Does Carnivor contain creatine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Chocolate label lists creatine monohydrate inside the CARNIVOR-BPI blend, along with BCAAs and keto-acid intermediates, but MuscleMeds does not print how much creatine each scoop contains. If you want a dependable creatine dose, typically 3 to 5 g a day in research, take creatine monohydrate separately so you know exactly what you are getting."
          }
        },
        {
          "@type": "Question",
          "name": "Is Carnivor protein powder good for the carnivore diet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for a strict carnivore diet. Despite the name, Carnivor contains maltodextrin, cocoa or fruit flavorings, artificial sweeteners, sunflower lecithin and soybean oil in its antifoam. People on the carnivore diet usually want a one-ingredient beef isolate with no sweetener, such as Be Well by Kelly Unflavored or Equip Prime Unflavored, per those brands."
          }
        },
        {
          "@type": "Question",
          "name": "Which Carnivor flavor is best?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chocolate has by far the most buyer reviews and is generally described as the safe choice. Many beef-protein buyers also like the fruity flavors, such as Fruit Punch and Rocket Pop, because they taste like a juice drink when mixed with water. Creamy flavors can taste thin in water. These are buyer reports; we have not tasted Carnivor."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most common complaints about Carnivor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buyer reviews most often mention foaming and clumping, an odd smell before mixing, and stomach upset or diarrhea for a minority of people. Others criticize the long ingredient list, particularly maltodextrin and sucralose, and some mention the Prop 65 lead warning or rising prices. Praise centers on lactose-free digestion, decent taste in Chocolate and good value."
          }
        },
        {
          "@type": "Question",
          "name": "Does Carnivor contain dairy, lactose or gluten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No dairy or lactose, per MuscleMeds, because the protein comes from beef rather than milk. The jar also says it is gluten-free, sugar-free and fat-free and contains no gelatin. It does list refined soybean oil in its antifoam blend, so anyone with a soy allergy should check the current label or ask MuscleMeds before buying."
          }
        }
      ],
    },
    {
      "@type": "Article",
      headline: title,
      author: authorSchema(),
      datePublished: dates.published,
      dateModified: dates.modified,
      publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
    },
    {
      "@type": "ItemList",
      name: title,
      numberOfItems: PRODUCTS.length,
      itemListElement: PRODUCTS.map((product, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: product.name,
        url: new URL(`#${product.id}`, Astro.url).toString(),
      })),
    },
    ...PRODUCTS.map((product) => ({
      "@type": "Product",
      name: product.name,
      description: product.description,
      brand: {
        "@type": "Brand",
        name: product.brand ?? product.name.split(" ")[0],
