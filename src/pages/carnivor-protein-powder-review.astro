];
const author = AUTHORS[DEFAULT_AUTHOR];
const dates = pageDates(Astro.url.pathname, { published: "2026-11-21", modified: "2026-11-21" });
const title = "Carnivor Protein Powder Review: Is It Third-Party Tested?";
const description =
  "Yes: MuscleMeds says Carnivor is Informed Choice certified. 23 g beef protein a scoop, about $1.11 per 25 g, but sweeteners make it not carnivore-diet strict.";

const PRODUCTS: {
  id: string;
  name: string;
  brand?: string;
  badge: string;
  category: string;
  description: string;
  pros: string[];
  cons: string[];
  bottomLine: string;
  specs?: Record<string, string>;
  rating?: number;
  reviewCount?: number;
  amazonUrl?: string;
}[] = [
  {
    "id": "carnivor-protein-powder-review-musclemeds-carnivor-chocolate",
    "name": "MuscleMeds Carnivor Beef Protein Isolate, Chocolate, 56 Servings",
    "brand": "MuscleMeds",
    "badge": "The Reviewed Product",
    "category": "Hydrolyzed beef protein isolate",
    "description": "The product this review covers. Per the Chocolate label at the time of writing, a 36.4 g scoop gives 23 g of protein, 120 calories, 0 g of fat, 7 g of carbohydrate (2 g fiber), 0 g of sugar and 370 mg of sodium, with 56 servings per tub. The protein blend also lists creatine monohydrate, added BCAAs and keto-acid intermediates, and the shake is sweetened with acesulfame potassium and sucralose. MuscleMeds says it is Informed Choice certified. At the $57.27 we saw on Amazon on November 21, 2026, that is about $1.11 per 25 g of protein.",
    "pros": [
      "About $1.11 per 25 g at the Amazon price we saw, the cheapest beef isolate we track",
